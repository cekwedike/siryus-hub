---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Reels"
  description="Showreel and motion work from SIRYUS and collaborators."
>
  <h1>Reels</h1>
  <p class="marketing-lede">Motion, film, and energy. Stock imagery below stands in until your own reel is cut.</p>
  <div style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin: 1.5rem 0;">
    <img src="https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=600&q=80&auto=format&fit=crop" alt="" width="600" height="400" loading="lazy" style="width:100%;border-radius:10px;object-fit:cover;aspect-ratio:3/2;" />
    <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600&q=80&auto=format&fit=crop" alt="" width="600" height="400" loading="lazy" style="width:100%;border-radius:10px;object-fit:cover;aspect-ratio:3/2;" />
    <img src="https://images.unsplash.com/photo-1485846234645-a62644f84728?w=600&q=80&auto=format&fit=crop" alt="" width="600" height="400" loading="lazy" style="width:100%;border-radius:10px;object-fit:cover;aspect-ratio:3/2;" />
  </div>
  <p><a href="/contact">Book a conversation</a> about video or motion.</p>
</BaseLayout>
