---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/blog.css';
import { urlFor } from '../../lib/sanity';
import { getAllPosts, getPostBySlug, type BlogPostSummary } from '../../lib/queries';
import { portableTextToBlogHtml } from '../../lib/portableTextHtml';
import { portableTextToPlainText } from '../../lib/portableTextPlain';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts
    .filter((p) => p.slug?.current)
    .map((p) => ({ params: { slug: p.slug.current } }));
}

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

if (!post?.slug?.current) {
  return Astro.redirect('/blog');
}

const pageTitle = post.seoTitle?.trim()
  ? post.seoTitle.trim()
  : `${post.title} | Siryus Hub Blog`;
const pageDescription = post.seoDescription?.trim() ? post.seoDescription : post.excerpt;

const canonicalUrl = `https://www.siryushub.com/blog/${post.slug.current}`;

let ogImagePath = '/images/og-default.png';
if (post.coverImage) {
  try {
    ogImagePath = urlFor(post.coverImage).width(1200).height(630).url();
  } catch {
    ogImagePath = '/images/og-default.png';
  }
}

const bodyHtml = portableTextToBlogHtml(post.body ?? []);
const plain = portableTextToPlainText(post.body ?? []);
const wordCount = plain.trim().split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.ceil(wordCount / 200));

function formatDate(iso: string) {
  try {
    return new Date(iso).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    return '';
  }
}

const datePublishedIso = (() => {
  try {
    return new Date(post.publishedAt).toISOString();
  } catch {
    return post.publishedAt;
  }
})();

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  author: {
    '@type': 'Person',
    name: post.author,
  },
  datePublished: datePublishedIso,
  publisher: {
    '@type': 'Organization',
    name: 'Siryus Creative Media Ltd',
  },
};

if (post.coverImage) {
  try {
    articleSchema.image = urlFor(post.coverImage).width(1200).height(630).url();
  } catch {
    /* keep schema without image */
  }
}

const allForRelated = await getAllPosts();
const related: BlogPostSummary[] = allForRelated
  .filter((p) => p._id !== post._id)
  .slice(0, 3);

function relatedCover(p: BlogPostSummary) {
  if (!p.coverImage) return null;
  try {
    return urlFor(p.coverImage).width(400).height(250).url();
  } catch {
    return null;
  }
}

let heroCover: string | null = null;
if (post.coverImage) {
  try {
    heroCover = urlFor(post.coverImage).width(960).url();
  } catch {
    heroCover = null;
  }
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  ogImage={ogImagePath}
  ogType="article"
  schema={articleSchema}
>
  <article class="blog-page" itemscope itemtype="https://schema.org/Article">
    <meta itemprop="datePublished" content={datePublishedIso} />
    <section class="blog-bleed blog-post-hero" aria-labelledby="post-title">
      <div class="blog-inner">
        {post.category ? <span class="blog-badge">{post.category}</span> : null}
        <h1 id="post-title" class="blog-post-hero__title">{post.title}</h1>
        <div class="blog-post-hero__meta-row">
          <span class="blog-card__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <span itemprop="name">{post.author}</span>
          </span>
          <time class="blog-card__date" datetime={post.publishedAt}>
            {formatDate(post.publishedAt)}
          </time>
          <span class="blog-read-time">{readMinutes} min read</span>
        </div>
        {
          heroCover ? (
            <div class="blog-post-hero__cover">
              <img
                src={heroCover}
                alt={(() => {
                  const img = post.coverImage as { alt?: string } | null;
                  const fromCms = typeof img?.alt === 'string' ? img.alt.trim() : '';
                  return fromCms || `Cover image for ${post.title}`;
                })()}
                width="960"
                height="540"
                loading="eager"
                decoding="async"
                itemprop="image"
              />
            </div>
          ) : null
        }
      </div>
    </section>

    <section class="blog-bleed blog-post-body-wrap" aria-label="Article body">
      <div
        class="blog-post-body"
        set:html={bodyHtml}
      />
    </section>

    <footer class="blog-bleed blog-post-footer">
      <div class="blog-inner">
        <p class="blog-post-footer__bio">Written by {post.author} for Siryus Hub.</p>
        <a class="blog-post-footer__back" href="/blog">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            ><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg
          >
          Back to Blog
        </a>
      </div>
    </footer>

    {
      related.length > 0 ? (
        <section class="blog-bleed blog-related" aria-labelledby="related-heading">
          <div class="blog-inner">
            <h2 id="related-heading" class="blog-section__title">
              More From the Blog
            </h2>
            <div class="blog-related__grid">
              {related.map((p) => {
                const href = `/blog/${p.slug?.current ?? ''}`;
                const thumb = relatedCover(p);
                return (
                  <a class="blog-related-card morph-clay-card" href={href} data-astro-prefetch>
                    <div class="blog-related-card__thumb">
                      {thumb ? (
                        <img src={thumb} alt={`Cover image for ${p.title}`} width="400" height="250" loading="lazy" decoding="async" />
                      ) : null}
                    </div>
                    <div class="blog-related-card__body">
                      {p.category ? <span class="blog-badge">{p.category}</span> : null}
                      <h3 class="blog-related-card__title">{p.title}</h3>
                      <time class="blog-card__date" datetime={p.publishedAt}>
                        {formatDate(p.publishedAt)}
                      </time>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      ) : null
    }
  </article>
</BaseLayout>
