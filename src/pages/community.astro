---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindDecorButton from '../components/WindDecorButton.astro';
---

<BaseLayout
  title="Siryus Community - For Independent Creatives"
  description="Join the Siryus community. A space for independent artists, marketers and makers to connect, share work and grow together across Africa and beyond."
  canonical="https://www.siryushub.com/community"
>
  <div class="community-page">
    <section class="community-bleed community-hero community-reveal" aria-labelledby="community-hero-heading">
      <div class="community-hero__photo-layer" aria-hidden="true">
        <img
          class="community-hero__photo"
          src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1920&q=80&auto=format&fit=crop"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          decoding="async"
        />
        <div class="community-hero__photo-scrim"></div>
      </div>
      <div class="community-hero__glow" aria-hidden="true"></div>
      <div class="community-hero__clay community-hero__clay--a" aria-hidden="true"></div>
      <div class="community-hero__clay community-hero__clay--b" aria-hidden="true"></div>
      <div class="community-inner community-hero__shell">
        <div class="morph-hero-glass-panel community-hero__card">
          <div class="community-hero__card-glow" aria-hidden="true"></div>
          <div class="community-hero__inner">
            <span class="community-hero__label">Community</span>
            <h1 id="community-hero-heading" class="community-hero__title">You Found Your People.</h1>
            <p class="community-hero__sub">
              A community for independent creatives who are building something real and want to do it alongside people who get
              it.
            </p>
            <div class="community-hero__avatars" aria-hidden="true">
              <span class="morph-hero-social-ring community-hero__avatar"></span>
              <span class="morph-hero-social-ring community-hero__avatar"></span>
              <span class="morph-hero-social-ring community-hero__avatar"></span>
              <span class="morph-hero-social-ring community-hero__avatar"></span>
              <span class="morph-hero-social-ring community-hero__avatar"></span>
              <span class="morph-hero-social-ring community-hero__avatar"></span>
            </div>
            <WindDecorButton
              href="https://www.instagram.com/siryus.am"
              class="community-hero__cta"
            >
              Join the community
            </WindDecorButton>
          </div>
        </div>
      </div>
    </section>

    <section class="community-bleed community-what community-reveal" aria-labelledby="community-what-heading">
      <div class="community-inner">
        <h2 id="community-what-heading" class="community-section-title">What this community is</h2>
        <div class="community-what__grid">
          <article class="morph-clay-card community-pillar">
            <div class="community-pillar__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                ><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg
              >
            </div>
            <h3 class="community-pillar__heading">Real Conversations</h3>
            <p class="community-pillar__body">
              No highlight reels. No performance. Just honest conversations about the craft, the business, and the journey.
            </p>
          </article>
          <article class="morph-clay-card community-pillar">
            <div class="community-pillar__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                ><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg
              >
            </div>
            <h3 class="community-pillar__heading">Shared Resources</h3>
            <p class="community-pillar__body">
              Tools, templates, strategies, and insights from people who are actually in it. Curated and contributed by the
              community.
            </p>
          </article>
          <article class="morph-clay-card community-pillar">
            <div class="community-pillar__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                ><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg
              >
            </div>
            <h3 class="community-pillar__heading">Mutual Growth</h3>
            <p class="community-pillar__body">
              We celebrate each other here. Drops, milestones, wins big and small. Your growth is good for all of us.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="community-bleed community-who community-reveal" aria-labelledby="community-who-heading">
      <div class="community-inner community-who__inner">
        <h2 id="community-who-heading" class="community-section-title">Who You Will Find Here</h2>
        <ul class="community-who__list" role="list">
          <li>Independent musicians and artists</li>
          <li>Content creators and digital marketers</li>
          <li>Music producers and sound engineers</li>
          <li>Brand builders and creative entrepreneurs</li>
          <li>Photographers, videographers, and designers</li>
        </ul>
      </div>
    </section>

    <section class="community-bleed community-join community-reveal" aria-labelledby="community-join-heading">
      <div class="community-inner">
        <h2 id="community-join-heading" class="community-section-title community-section-title--center">
          Getting In Is Simple
        </h2>
        <div class="community-join__steps">
          <article class="community-step morph-clay-card">
            <p class="community-step__num">01</p>
            <h3 class="community-step__heading">Follow Us</h3>
            <p class="community-step__copy">
              Start by following Siryus on our social platforms. That is where the community conversation lives right now.
            </p>
          </article>
          <article class="community-step morph-clay-card">
            <p class="community-step__num">02</p>
            <h3 class="community-step__heading">Reach Out</h3>
            <p class="community-step__copy">
              Send us a message and introduce yourself. Tell us what you are working on and what you are looking for.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="community-bleed community-cta-band community-reveal" aria-labelledby="community-cta-heading">
      <div class="community-inner community-cta-band__inner">
        <h2 id="community-cta-heading" class="community-cta-band__heading">Come As You Are.</h2>
        <p class="community-cta-band__copy">
          You do not need a big following or a finished project. Just show up.
        </p>
        <WindDecorButton href="https://www.instagram.com/siryus.am" class="community-cta-band__btn">Join Now</WindDecorButton>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.community-reveal');
    if (reduce) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<style>
  .community-page {
    margin-left: calc(-1 * var(--about-pad, 1rem));
    margin-right: calc(-1 * var(--about-pad, 1rem));
    width: calc(100% + 2 * var(--about-pad, 1rem));
    max-width: none;
  }

  .community-bleed {
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .community-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .community-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.65s ease,
      transform 0.65s ease;
  }

  .community-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero: warm stock + clay blobs + glass invitation card */
  .community-hero {
    position: relative;
    overflow: hidden;
    background: #0a0908;
    padding: var(--space-20) 0 var(--space-16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .community-hero__photo-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .community-hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    opacity: 0.38;
    filter: saturate(1.15);
    transform: scale(1.02);
  }

  .community-hero__photo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 7, 6, 0.55) 0%,
      rgba(10, 9, 8, 0.82) 45%,
      rgba(8, 7, 6, 0.92) 100%
    );
  }

  .community-hero__glow {
    position: absolute;
    left: 50%;
    bottom: -20%;
    width: 120%;
    height: 85%;
    transform: translateX(-50%);
    z-index: 1;
    background: radial-gradient(
      ellipse 55% 50% at 50% 100%,
      rgba(212, 175, 95, 0.22) 0%,
      rgba(160, 120, 60, 0.08) 45%,
      transparent 70%
    );
    pointer-events: none;
  }

  .community-hero__clay {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
    filter: blur(0.5px);
    opacity: 0.55;
  }

  .community-hero__clay--a {
    width: min(42vw, 320px);
    height: min(42vw, 320px);
    top: -8%;
    left: -6%;
    background: radial-gradient(
      circle at 40% 40%,
      rgba(209, 223, 75, 0.2) 0%,
      rgba(209, 223, 75, 0.05) 45%,
      transparent 70%
    );
    box-shadow:
      inset -8px -12px 28px rgba(0, 0, 0, 0.35),
      16px 22px 48px rgba(0, 0, 0, 0.4);
  }

  .community-hero__clay--b {
    width: min(36vw, 260px);
    height: min(36vw, 260px);
    bottom: -12%;
    right: -4%;
    background: radial-gradient(
      circle at 55% 45%,
      rgba(212, 175, 95, 0.18) 0%,
      rgba(120, 90, 50, 0.08) 50%,
      transparent 72%
    );
    box-shadow:
      inset 6px 8px 20px rgba(0, 0, 0, 0.3),
      -12px 16px 40px rgba(0, 0, 0, 0.35);
  }

  .community-hero__shell {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
  }

  .community-hero__card {
    position: relative;
    width: 100%;
    max-width: 44rem;
    border-radius: 28px;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 2.25rem);
    overflow: hidden;
  }

  .community-hero__card-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    width: 88%;
    height: 100%;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse 70% 60% at 50% 0%,
      rgba(209, 223, 75, 0.12) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .community-hero__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 38rem;
    margin: 0 auto;
  }

  .community-hero__label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-accent);
    border: 1px solid var(--brand-surface-border);
    background: var(--brand-accent-dim);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .community-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.15rem);
    font-weight: 900;
    color: var(--brand-text);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  .community-hero__sub {
    font-size: var(--text-lg);
    color: var(--brand-text-muted);
    line-height: 1.65;
    margin: 0 0 var(--space-8);
  }

  .community-hero__avatars {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .community-hero__avatar {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-full);
    box-sizing: border-box;
    background: linear-gradient(
      135deg,
      rgba(209, 223, 75, 0.25) 0%,
      rgba(80, 76, 68, 0.45) 48%,
      rgba(30, 28, 26, 0.9) 100%
    );
  }

  .community-hero__avatar:nth-child(2) {
    background: linear-gradient(
      135deg,
      rgba(212, 175, 95, 0.3) 0%,
      rgba(60, 55, 48, 0.5) 50%,
      rgba(20, 18, 16, 0.95) 100%
    );
  }

  .community-hero__avatar:nth-child(3) {
    background: linear-gradient(
      135deg,
      rgba(209, 223, 75, 0.2) 0%,
      rgba(100, 96, 88, 0.4) 55%,
      rgba(24, 22, 20, 0.92) 100%
    );
  }

  .community-hero__avatar:nth-child(4) {
    background: linear-gradient(
      135deg,
      rgba(180, 140, 80, 0.22) 0%,
      rgba(70, 66, 58, 0.48) 48%,
      rgba(18, 16, 14, 0.94) 100%
    );
  }

  .community-hero__avatar:nth-child(5) {
    background: linear-gradient(
      135deg,
      rgba(209, 223, 75, 0.28) 0%,
      rgba(90, 86, 78, 0.42) 52%,
      rgba(28, 26, 24, 0.9) 100%
    );
  }

  .community-hero__avatar:nth-child(6) {
    background: linear-gradient(
      135deg,
      rgba(200, 165, 100, 0.26) 0%,
      rgba(55, 50, 44, 0.46) 50%,
      rgba(22, 20, 18, 0.93) 100%
    );
  }

  .community-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-8);
    transition: transform var(--transition-fast);
  }

  .community-hero__cta:hover {
    transform: translateY(-2px);
  }

  /* What */
  .community-what {
    background: var(--brand-bg-base);
    padding: var(--space-16) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .community-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--brand-text);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-10);
    text-align: center;
  }

  .community-section-title--center {
    text-align: center;
  }

  .community-what__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    align-items: stretch;
  }

  .community-pillar {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-radius: var(--radius-xl);
  }

  .community-pillar__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-accent-dim);
    color: var(--brand-accent);
  }

  .community-pillar__heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--brand-text);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .community-pillar__body {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--brand-text-muted);
    margin: 0;
  }

  /* Who */
  .community-who {
    background: var(--brand-bg-deep);
    padding: var(--space-16) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .community-who__inner {
    max-width: 38rem;
  }

  .community-who .community-section-title {
    text-align: left;
    margin-bottom: var(--space-6);
  }

  .community-who__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .community-who__list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--brand-text-muted);
  }

  .community-who__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--brand-accent);
    opacity: 0.85;
  }

  /* Join */
  .community-join {
    background: var(--brand-bg-base);
    padding: var(--space-16) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .community-join__steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
    align-items: stretch;
  }

  .community-step {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
  }

  .community-step__num {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--brand-accent);
    margin: 0 0 var(--space-4);
  }

  .community-step__heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--brand-text);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }

  .community-step__copy {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--brand-text-muted);
    margin: 0;
  }

  /* CTA band: dark + accent button */
  .community-cta-band {
    background: linear-gradient(180deg, #0a0a0c 0%, #050505 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: var(--space-16) 0 var(--space-20);
  }

  .community-cta-band__inner {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto;
  }

  .community-cta-band__heading {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    font-weight: 900;
    color: var(--brand-text);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }

  .community-cta-band__copy {
    font-size: var(--text-lg);
    color: var(--brand-text-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-8);
  }

  .community-cta-band__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--radius-full);
    padding: var(--space-4) var(--space-10);
    transition: transform var(--transition-fast);
  }

  .community-cta-band__btn:hover {
    transform: translateY(-2px);
  }

  :global(body.light-theme) .community-hero {
    border-bottom-color: rgba(0, 0, 0, 0.06);
  }

  :global(body.light-theme) .community-hero__photo {
    opacity: 0.26;
  }

  :global(body.light-theme) .community-hero__photo-scrim {
    background: linear-gradient(
      180deg,
      rgba(252, 252, 250, 0.75) 0%,
      rgba(248, 249, 246, 0.92) 100%
    );
  }

  :global(body.light-theme) .community-hero__clay {
    opacity: 0.35;
  }

  :global(body.light-theme) .community-what,
  :global(body.light-theme) .community-join {
    border-bottom-color: rgba(0, 0, 0, 0.06);
  }

  :global(body.light-theme) .community-who {
    background: var(--brand-bg-deep);
    border-bottom-color: rgba(0, 0, 0, 0.06);
  }

  :global(body.light-theme) .community-hero__avatars .community-hero__avatar {
    border-color: rgba(0, 0, 0, 0.18);
    background: linear-gradient(
      135deg,
      rgba(209, 223, 75, 0.38) 0%,
      #141416 48%,
      #0a0a0a 100%
    );
  }

  :global(body.light-theme) .community-cta-band {
    background: linear-gradient(180deg, #f0f1ed 0%, #e8e9e4 100%);
    border-top-color: rgba(0, 0, 0, 0.08);
  }

  @media (max-width: 900px) {
    .community-what__grid {
      grid-template-columns: 1fr;
    }

    .community-join__steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .community-inner {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }

    .community-hero {
      padding: var(--space-14) 0 var(--space-12);
    }

    .community-what,
    .community-who,
    .community-join,
    .community-cta-band {
      padding-top: var(--space-12);
      padding-bottom: var(--space-12);
    }

    .community-section-title {
      margin-bottom: var(--space-8);
    }
  }

  @media (max-width: 520px) {
    .community-page {
      margin-left: 0;
      margin-right: 0;
      width: 100%;
    }

    .community-inner {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }

    .community-hero {
      padding: var(--space-12) 0 var(--space-10);
    }

    .community-hero__card {
      border-radius: 22px;
      padding: var(--space-5) var(--space-4);
    }

    .community-hero__sub {
      font-size: var(--text-base);
    }

    .community-hero__avatars {
      gap: var(--space-2);
      margin-bottom: var(--space-8);
    }

    .community-hero__avatar {
      width: 40px;
      height: 40px;
    }

