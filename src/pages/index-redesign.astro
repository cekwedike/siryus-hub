---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';

const seo = {
  title: 'SIRYUS Artist Management | Supporting Independent Artists',
  description: 'SIRYUS Artist Management is a creative collective and artist management agency supporting independent artists through marketing, collaboration, and strategic career development.',
  path: '/',
};
---

<MainLayout seo={seo}>
  <!-- Hero Section - Full Width Centered -->
  <section class="relative flex items-center justify-center min-h-screen bg-gradient-to-b from-[#F5F9E9] to-white overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute w-96 h-96 bg-[#D1DF4B]/20 rounded-full blur-3xl top-20 -left-20 animate-pulse"></div>
      <div class="absolute w-96 h-96 bg-[#D1DF4B]/20 rounded-full blur-3xl bottom-20 -right-20 animate-pulse" style="animation-delay: 2s;"></div>
    </div>

    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 py-20 text-center">
      <div class="mb-6">
        <span class="inline-block px-4 py-2 bg-[#D1DF4B] text-[#1B1B1E] text-sm font-semibold rounded-full mb-8">
          Artist Management & Creative Support
        </span>
      </div>
      
      <h1 class="text-4xl md:text-6xl lg:text-7xl xl:text-8xl font-bold text-[#1B1B1E] mb-8 leading-tight max-w-5xl mx-auto">
        Supporting Independent Artists in Building
        <span class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-[#D1DF4B] to-[#C5D340]">
          Sustainable Creative Careers
        </span>
      </h1>
      
      <p class="text-lg md:text-xl lg:text-2xl text-[#323836] mb-12 max-w-3xl mx-auto leading-relaxed">
        A creative collective and artist management agency that works with independent artists to develop their careers through strategy, collaboration, and opportunity.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-lg mx-auto">
        <Button variant="primary" size="lg" href="/contact" class="w-full sm:w-auto min-w-[200px]">
          Work With Us
        </Button>
        <Button variant="outline" size="lg" href="/projects" class="w-full sm:w-auto min-w-[200px]">
          Explore Projects
        </Button>
      </div>

      <div class="mt-20">
        <a href="#about" class="inline-block text-[#949BA0] hover:text-[#D1DF4B] transition-colors">
          <svg class="w-8 h-8 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- About Section - Centered with Side-by-Side Layout -->
  <section id="about" class="py-24 lg:py-32 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="text-sm font-semibold text-[#D1DF4B] uppercase tracking-wider mb-4 block">About Us</span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#1B1B1E] mb-6 leading-tight">
            About SIRYUS Artist Management
          </h2>
          <p class="text-lg text-[#323836] mb-6 leading-relaxed">
            SIRYUS Artist Management, also known as SIRYUS A.M, is an artist management and marketing agency operating as part of a wider creative ecosystem.
          </p>
          <p class="text-lg text-[#323836] mb-8 leading-relaxed">
            We work with independent artists and creative professionals to help them navigate the creative industry with clarity, structure, and long term vision.
          </p>
          <Button variant="secondary" href="/about">
            Learn More About Us
          </Button>
        </div>
        <div class="relative">
          <div class="aspect-square bg-gradient-to-br from-[#D1DF4B] to-[#D5DD85] rounded-2xl flex items-center justify-center">
            <div class="text-center text-[#1B1B1E]">
              <div class="text-6xl font-bold mb-2">10+</div>
              <div class="text-xl font-semibold">Artists Managed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section - Modern Card Grid -->
  <section class="py-24 lg:py-32 bg-[#F5F9E9]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="text-sm font-semibold text-[#D1DF4B] uppercase tracking-wider mb-4 block">What We Offer</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#1B1B1E] mb-6">
          Services for Independent Artists
        </h2>
        <p class="text-lg text-[#323836] max-w-2xl mx-auto">
          We provide comprehensive support to help artists build sustainable careers in the creative industry.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service 1 -->
        <div class="bg-white rounded-2xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="w-16 h-16 bg-[#D1DF4B] rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-[#1B1B1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#1B1B1E] mb-4">Artist Management</h3>
          <p class="text-[#323836] leading-relaxed mb-6">
            Strategic career guidance, opportunity sourcing, and professional representation for independent artists.
          </p>
          <a href="/services" class="text-[#D1DF4B] font-semibold hover:text-[#323836] transition-colors inline-flex items-center">
            Learn More 
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Service 2 -->
        <div class="bg-white rounded-2xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="w-16 h-16 bg-[#D1DF4B] rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-[#1B1B1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#1B1B1E] mb-4">Marketing & Promotion</h3>
          <p class="text-[#323836] leading-relaxed mb-6">
            Content creation, social media strategy, and digital marketing to grow your audience and visibility.
          </p>
          <a href="/services" class="text-[#D1DF4B] font-semibold hover:text-[#323836] transition-colors inline-flex items-center">
            Learn More 
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Service 3 -->
        <div class="bg-white rounded-2xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="w-16 h-16 bg-[#D1DF4B] rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-[#1B1B1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#1B1B1E] mb-4">Community Building</h3>
          <p class="text-[#323836] leading-relaxed mb-6">
            Connect with other creatives, collaborate on projects, and grow through our creative community.
          </p>
          <a href="/services" class="text-[#D1DF4B] font-semibold hover:text-[#323836] transition-colors inline-flex items-center">
            Learn More 
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section - Featured Work -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="text-sm font-semibold text-[#D1DF4B] uppercase tracking-wider mb-4 block">Our Work</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#1B1B1E] mb-6">
          Featured Projects & Campaigns
        </h2>
        <p class="text-lg text-[#323836] max-w-2xl mx-auto">
          Explore some of our recent work with independent artists and creative projects.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-10">
        <!-- Project 1 -->
        <div class="group cursor-pointer">
          <div class="aspect-video bg-gradient-to-br from-[#D1DF4B] to-[#D5DD85] rounded-2xl mb-6 overflow-hidden relative">
            <div class="absolute inset-0 bg-[#323836]/10 group-hover:bg-[#323836]/0 transition-colors duration-300"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-6xl font-bold text-[#1B1B1E]/10">PROJECT 1</span>
            </div>
          </div>
          <h3 class="text-2xl font-bold text-[#1B1B1E] mb-3 group-hover:text-[#D1DF4B] transition-colors">
            Artist Campaign Name
          </h3>
          <p class="text-[#323836] mb-4 leading-relaxed">
            A comprehensive marketing campaign that helped an independent artist grow their audience by 300%.
          </p>
          <span class="text-[#D1DF4B] font-semibold inline-flex items-center">
            View Project 
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </span>
        </div>

        <!-- Project 2 -->
        <div class="group cursor-pointer">
          <div class="aspect-video bg-gradient-to-br from-[#323836] to-[#1B1B1E] rounded-2xl mb-6 overflow-hidden relative">
            <div class="absolute inset-0 bg-[#D1DF4B]/10 group-hover:bg-[#D1DF4B]/20 transition-colors duration-300"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-6xl font-bold text-[#F5F9E9]/10">PROJECT 2</span>
            </div>
          </div>
          <h3 class="text-2xl font-bold text-[#1B1B1E] mb-3 group-hover:text-[#D1DF4B] transition-colors">
            Creative Collaboration
          </h3>
          <p class="text-[#323836] mb-4 leading-relaxed">
            A multi-artist collaboration that showcased the power of community and creative partnership.
          </p>
          <span class="text-[#D1DF4B] font-semibold inline-flex items-center">
            View Project 
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </span>
        </div>
      </div>

      <div class="text-center mt-12">
        <Button variant="outline" href="/projects">
          View All Projects
        </Button>
      </div>
    </div>
  </section>

  <!-- Community CTA - Dark Section -->
  <section class="py-24 lg:py-32 bg-[#323836] text-[#F5F9E9] relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute w-96 h-96 bg-[#D1DF4B]/10 rounded-full blur-3xl bottom-0 right-0"></div>
    </div>

    <div class="max-w-5xl mx-auto px-6 text-center relative z-10">
      <span class="text-sm font-semibold text-[#D1DF4B] uppercase tracking-wider mb-4 block">Community</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        Join Siryus Creative Hub
      </h2>
      <p class="text-xl text-[#D5DD85] mb-10 max-w-3xl mx-auto leading-relaxed">
        Our free community for independent creatives. Connect with other artists, share your work, collaborate on projects, and grow together.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-lg mx-auto">
        <Button variant="primary" size="lg" href="/community" class="w-full sm:w-auto min-w-[200px]">
          Join the Community
        </Button>
        <button class="w-full sm:w-auto min-w-[200px] px-8 py-4 text-lg font-semibold text-[#F5F9E9] hover:text-[#D1DF4B] border-2 border-[#F5F9E9]/30 hover:border-[#D1DF4B] rounded-lg transition-all duration-200">
          Learn More
        </button>
      </div>
    </div>
  </section>

  <!-- Blog Section - Latest Articles -->
  <section class="py-24 lg:py-32 bg-[#F5F9E9]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="text-sm font-semibold text-[#D1DF4B] uppercase tracking-wider mb-4 block">Insights & Tips</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#1B1B1E] mb-6">
          Latest from Our Blog
        </h2>
        <p class="text-lg text-[#323836] max-w-2xl mx-auto">
          Advice, insights, and resources for independent artists navigating the creative industry.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Article 1 -->
        <article class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="p-8">
            <span class="text-xs font-semibold text-[#949BA0] uppercase tracking-wider">Marketing</span>
            <h3 class="text-xl font-bold text-[#1B1B1E] mt-3 mb-3">
              Building Your Artist Brand in 2024
            </h3>
            <p class="text-[#323836] mb-4 leading-relaxed">
              Essential strategies for independent artists to build a strong, authentic brand presence.
            </p>
            <a href="/blog/building-your-artist-brand" class="text-[#D1DF4B] font-semibold hover:text-[#323836] transition-colors inline-flex items-center">
              Read More 
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>

        <!-- Article 2 -->
        <article class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="p-8">
            <span class="text-xs font-semibold text-[#949BA0] uppercase tracking-wider">Industry</span>
            <h3 class="text-xl font-bold text-[#1B1B1E] mt-3 mb-3">
              Navigating the Music Industry as an Independent Artist
            </h3>
            <p class="text-[#323836] mb-4 leading-relaxed">
              Key insights and practical advice for artists managing their own careers.
            </p>
            <a href="/blog/navigating-music-industry" class="text-[#D1DF4B] font-semibold hover:text-[#323836] transition-colors inline-flex items-center">
              Read More 
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>

        <!-- Article 3 -->
        <article class="bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="p-8">
            <span class="text-xs font-semibold text-[#949BA0] uppercase tracking-wider">Community</span>
            <h3 class="text-xl font-bold text-[#1B1B1E] mt-3 mb-3">
              The Power of Creative Collaboration
            </h3>
            <p class="text-[#323836] mb-4 leading-relaxed">
              How collaboration can accelerate your creative growth and expand your reach.
            </p>
            <a href="/blog/power-of-collaboration" class="text-[#D1DF4B] font-semibold hover:text-[#323836] transition-colors inline-flex items-center">
              Read More 
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>
      </div>

      <div class="text-center mt-12">
        <Button variant="secondary" href="/blog">
          View All Articles
        </Button>
      </div>
    </div>
  </section>

  <!-- Final CTA - Bright Section -->
  <section class="py-24 lg:py-32 bg-gradient-to-br from-[#D1DF4B] via-[#D5DD85] to-[#D1DF4B]">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#1B1B1E] mb-6">
        Ready to Take Your Career to the Next Level?
      </h2>
      <p class="text-xl text-[#323836] mb-10 max-w-2xl mx-auto leading-relaxed">
        Let's work together to build a sustainable, strategic approach to your creative career.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-lg mx-auto">
        <Button variant="secondary" size="lg" href="/contact" class="w-full sm:w-auto min-w-[200px]">
          Get in Touch
        </Button>
        <button class="w-full sm:w-auto min-w-[200px] px-8 py-4 text-lg font-semibold border-2 border-[#323836] text-[#323836] hover:bg-[#323836] hover:text-[#D1DF4B] rounded-lg transition-all duration-200">
          Learn More About Us
        </button>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }

  .animate-pulse {
    animation: pulse 4s ease-in-out infinite;
  }
</style>

<script>
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('href');
      if (targetId && targetId !== '#') {
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          const offset = 80;
          const targetPosition = targetElement.offsetTop - offset;
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      }
    });
  });

  // Intersection Observer for fade-in animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  document.querySelectorAll('section').forEach(section => {
    section.style.opacity = '0';
    section.style.transform = 'translateY(30px)';
    section.style.transition = 'opacity 0.6s ease-out, transform 0.6s ease-out';
    observer.observe(section);
  });

  // First section visible immediately
  const firstSection = document.querySelector('section');
  if (firstSection) {
    firstSection.style.opacity = '1';
    firstSection.style.transform = 'translateY(0)';
  }
</script>
