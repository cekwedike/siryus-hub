---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/morphism.css';
import '../styles/artist-pages.css';
import '../styles/indiba-project-series.css';
import { urlFor } from '../lib/sanity';
import { getArtistBySlug } from '../lib/queries';

const pageTitle = 'The Indiba Project Series - Artist Incubator by SIRYUS A.M';
const pageDescription =
  "The Indiba Project Series is SIRYUS A.M's music incubator initiative for independent African artists. Collaborative projects, mentorship and structured releases that have launched real careers across Africa.";

const participantSlugs = ['hidaya-morgan', 'max-prodigy'] as const;

const resolved = await Promise.all(
  participantSlugs.map(async (slug) => {
    const artist = await getArtistBySlug(slug);
    return { slug, artist };
  })
);

type ParticipantRow = {
  slug: string;
  href: string;
  name: string;
  genreLine: string;
  location: string;
  oneLiner: string;
  photoUrl: string | null;
};

const participants: ParticipantRow[] = resolved.map(({ slug, artist }) => {
  const href = `/artists/${slug}`;
  if (!artist) {
    return {
      slug,
      href,
      name: slug === 'hidaya-morgan' ? 'Hidaya Morgan' : 'Max Prodigy',
      genreLine: '',
      location: '',
      oneLiner: 'SIRYUS A.M artist. View full profile.',
      photoUrl: null,
    };
  }
  const genres = Array.isArray(artist.genre) ? artist.genre.filter(Boolean) : [];
  const genreLine = genres.length ? genres.join(' / ') : '';
  const photoUrl = artist.photo
    ? urlFor(artist.photo).width(600).height(800).fit('crop').auto('format').url()
    : null;
  return {
    slug,
    href,
    name: artist.name,
    genreLine,
    location: artist.location?.trim() ?? '',
    oneLiner: artist.oneLiner,
    photoUrl,
  };
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://www.siryushub.com/indiba-project-series"
>
  <div class="indiba-page">
    <section class="indiba-bleed indiba-hero indiba-reveal" aria-labelledby="indiba-hero-heading">
      <div class="indiba-hero__glow" aria-hidden="true"></div>
      <div class="indiba-hero__grain" aria-hidden="true"></div>
      <div class="indiba-inner indiba-hero__content">
        <span class="indiba-hero__label">SIRYUS A.M Initiative</span>
        <h1 id="indiba-hero-heading" class="indiba-hero__title">The Indiba Project Series.</h1>
        <p class="indiba-hero__sub">
          A music incubator built for independent African artists who are ready to create, collaborate and build something
          that lasts.
        </p>
      </div>
    </section>

    <section class="indiba-bleed indiba-what indiba-reveal" aria-labelledby="indiba-what-heading">
      <div class="indiba-inner">
        <h2 id="indiba-what-heading" class="indiba-section-title">What it is</h2>
        <div class="indiba-what__grid">
          <blockquote class="indiba-what__quote">
            We do not just find artists. We build the conditions for them to thrive.
          </blockquote>
          <div class="indiba-what__body">
            <p>
              The Indiba Project Series started with a simple belief. That the best artists in Africa are not always the ones
              with the biggest budgets or the loudest co-signs. Sometimes they are the ones who just need the right room and
              the right people around them. That is what this series creates.
            </p>
            <p>
              Each edition brings together a curated group of independent artists for a structured process of collaboration,
              mentorship and release. The result is music that is genuinely made together and careers that are built on
              something real. Artists who have come through the series include Hidaya Morgan, Max Prodigy, Couronne, Aine
              Arsene and Chriss D.
            </p>
            <p>
              The series has drawn attention beyond Africa. Hip-hop legend Dana Dane has acknowledged the work coming out of
              the Indiba Project, a recognition of what independent African artists can achieve when they have the right
              infrastructure behind them.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="indiba-bleed indiba-benefits indiba-reveal" aria-labelledby="indiba-benefits-heading">
      <div class="indiba-inner">
        <h2 id="indiba-benefits-heading" class="indiba-section-title">What Artists Get</h2>
        <div class="indiba-benefits__grid">
          <article class="morph-clay-card indiba-benefit-card">
            <div class="indiba-benefit-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"></path>
              </svg>
            </div>
            <h3 class="indiba-benefit-card__heading">Collaborative Recording</h3>
            <p class="indiba-benefit-card__copy">
              Artists work together across sessions to create music that crosses genres and borders. The output is released
              as a collective project.
            </p>
          </article>
          <article class="morph-clay-card indiba-benefit-card">
            <div class="indiba-benefit-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3 class="indiba-benefit-card__heading">Mentorship and Development</h3>
            <p class="indiba-benefit-card__copy">
              Each artist receives direct mentorship on career strategy, digital presence, brand building and the business
              side of music.
            </p>
          </article>
          <article class="morph-clay-card indiba-benefit-card">
            <div class="indiba-benefit-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <h3 class="indiba-benefit-card__heading">Structured Release Strategy</h3>
            <p class="indiba-benefit-card__copy">
              Every project that comes out of the series has a proper release plan. Content calendar, platform distribution,
              press outreach and social strategy.
            </p>
          </article>
          <article class="morph-clay-card indiba-benefit-card">
            <div class="indiba-benefit-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <h3 class="indiba-benefit-card__heading">Pan-African Reach</h3>
            <p class="indiba-benefit-card__copy">
              The series is designed to introduce artists to audiences beyond their home market. Distribution and strategy
              are built with cross-border reach in mind.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="indiba-bleed indiba-participants indiba-reveal" aria-labelledby="indiba-participants-heading">
      <div class="indiba-inner">
        <h2 id="indiba-participants-heading" class="indiba-section-title">Artists Who Have Been Through the Series</h2>
        <ul class="indiba-participants__row" role="list">
          {
            participants.map((p) => (
              <li>
                <a href={p.href} class="artists-index-card artists-index-card--lift">
                  <div class={`artists-index-card__photo${p.photoUrl ? '' : ' has-error'}`}>
                    {p.photoUrl ? (
                      <img
                        class="artists-index-card__img"
                        src={p.photoUrl}
                        alt={p.name}
                        width="600"
                        height="800"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : null}
                    <div class="artists-index-card__placeholder" aria-hidden="true" />
                  </div>
                  <div class="artists-index-card__body">
                    <p class="artists-index-card__name">{p.name}</p>
                    <p class="artists-index-card__meta">
                      {p.genreLine}
                      {p.location ? <span class="artists-index-card__loc"> · {p.location}</span> : null}
                    </p>
                    <p class="artists-index-card__line">{p.oneLiner}</p>
                    <span class="artists-index-card__cta">View profile</span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="indiba-participants__note">More artists from past editions coming soon.</p>
      </div>
    </section>

    <section class="indiba-bleed indiba-initiatives indiba-reveal" aria-labelledby="indiba-initiatives-heading">
      <div class="indiba-inner">
        <h2 id="indiba-initiatives-heading" class="indiba-section-title">More From SIRYUS A.M</h2>
        <div class="indiba-initiatives__grid">
          <article class="morph-clay-card indiba-init-card">
            <div class="indiba-init-card__head">
              <h3 class="indiba-init-card__title">Acoustic Rwanda</h3>
              <span class="indiba-init-card__badge">Coming Soon</span>
            </div>
            <p class="indiba-init-card__copy">
              A live music series spotlighting raw unplugged performances from rising artists in intimate settings across
              Rwanda.
            </p>
          </article>
          <article class="morph-clay-card indiba-init-card">
            <div class="indiba-init-card__head">
              <h3 class="indiba-init-card__title">The Abditory Sessions</h3>
              <span class="indiba-init-card__badge">Coming Soon</span>
            </div>
            <p class="indiba-init-card__copy">
              Deep-dive interviews and storytelling-driven content exploring the journeys of independent artists. The
              creative process, unfiltered.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="indiba-bleed indiba-cta indiba-reveal" aria-labelledby="indiba-cta-heading">
      <div class="indiba-inner">
        <div class="indiba-cta__band">
          <h2 id="indiba-cta-heading" class="indiba-cta__heading">Want to Be Part of the Next Edition?</h2>
          <p class="indiba-cta__copy">
            If you are an independent artist ready to collaborate, grow and release music with real strategy behind it, we
            want to hear from you.
          </p>
          <a href="/contact" class="indiba-cta__btn">Apply Now</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    document.querySelectorAll('.indiba-participants .artists-index-card__img').forEach(function (img) {
      var wrap = img.closest('.artists-index-card__photo');
      function markLoaded() {
        if (wrap) wrap.classList.add('has-loaded');
      }
      function markError() {
        if (wrap) {
          wrap.classList.add('has-error');
          wrap.classList.remove('has-loaded');
        }
      }
      if (img.complete && img.naturalHeight > 0) {
        markLoaded();
      } else {
        img.addEventListener('load', markLoaded);
        img.addEventListener('error', markError);
      }
    });

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.indiba-reveal');
    if (reduce) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>
