---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Creative Services - Siryus Creative Media"
  description="Artist management, brand marketing and creative production from Siryus Creative Media. Real services for independent artists and growing brands across Africa."
  canonical="https://www.siryushub.com/services"
>
  <div class="services-page">
    <section class="services-bleed services-hero services-hero--credentials services-reveal" aria-labelledby="services-hero-heading">
      <div class="services-hero__ambient" aria-hidden="true">
        <img
          class="services-hero__ambient-img"
          src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1920&q=80&auto=format&fit=crop"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          decoding="async"
        />
        <div class="services-hero__ambient-scrim"></div>
      </div>
      <div class="services-hero__mesh" aria-hidden="true"></div>
      <span class="services-hero__watermark" aria-hidden="true">SVC</span>
      <div class="services-inner services-hero__center">
        <div class="morph-hero-glass-panel services-hero__glass">
          <div class="services-hero__glass-shine" aria-hidden="true"></div>
          <div class="services-hero__inner">
            <span class="services-hero__label">What We Do</span>
            <h1 id="services-hero-heading" class="services-hero__title">Real Services. Real Results.</h1>
            <p class="services-hero__sub">
              We do not offer packages. We offer partnerships. Here is what that looks like in practice.
            </p>
            <div class="services-hero__stats" role="list">
              <div class="morph-hero-glass-chip services-hero__stat" role="listitem">
                <span class="services-hero__stat-line">3 Service Lines</span>
              </div>
              <div class="morph-hero-glass-chip services-hero__stat" role="listitem">
                <span class="services-hero__stat-line">2+ Artists Managed</span>
              </div>
              <div class="morph-hero-glass-chip services-hero__stat" role="listitem">
                <span class="services-hero__stat-line">Pan-African Reach</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="services-bleed services-overview" aria-labelledby="services-overview-heading">
      <h2 id="services-overview-heading" class="visually-hidden">Services overview</h2>

      <article class="services-block services-block--main-left services-reveal">
        <span class="services-block__watermark" aria-hidden="true">01</span>
        <div class="services-block__inner">
          <div class="services-block__accent" aria-hidden="true"></div>
          <div class="services-block__main">
            <p class="services-block__meta">
              <span class="services-block__num">01</span>
              <span class="services-block__name">SIRYUS A.M</span>
            </p>
            <h3 class="services-block__heading">Artist Management That Moves the Needle</h3>
            <p class="services-block__body">
              Managing an artist career is more than booking shows and sending emails. It is strategy, relationships,
              brand building, and knowing when to push and when to protect. We work directly with independent artists
              who are ready to grow and need a team that is equally invested in the outcome.
            </p>
            <ul class="services-included" role="list">
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Career strategy and roadmapping
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Release planning and campaign management
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Brand identity and positioning
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Industry relationships and partnerships
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Contract guidance and deal review
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Day to day management support
              </li>
            </ul>
            <a href="/siryus-am" class="services-block__cta">Learn about SIRYUS A.M</a>
          </div>
        </div>
      </article>

      <article class="services-block services-block--main-right services-reveal">
        <span class="services-block__watermark" aria-hidden="true">02</span>
        <div class="services-block__inner">
          <div class="services-block__accent" aria-hidden="true"></div>
          <div class="services-block__main">
            <p class="services-block__meta">
              <span class="services-block__num">02</span>
              <span class="services-block__name">Brand Marketing</span>
            </p>
            <h3 class="services-block__heading">Marketing That Actually Sounds Like You</h3>
            <p class="services-block__body">
              Most brand marketing is forgettable. Ours is not. We build content strategies, run social media, write copy
              that converts, and produce creative assets that make your audience stop scrolling. We work with brands that
              want to grow without losing their voice in the process.
            </p>
            <ul class="services-included" role="list">
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Content strategy and editorial planning
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Social media management and growth
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Email marketing and automation
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Copywriting and brand messaging
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Motion graphics and video content
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Campaign planning and execution
              </li>
            </ul>
            <a href="/contact" class="services-block__cta">Talk to us about your brand</a>
          </div>
        </div>
      </article>

      <article class="services-block services-block--main-left services-reveal">
        <span class="services-block__watermark" aria-hidden="true">03</span>
        <div class="services-block__inner">
          <div class="services-block__accent" aria-hidden="true"></div>
          <div class="services-block__main">
            <p class="services-block__meta">
              <span class="services-block__num">03</span>
              <span class="services-block__name">Creative Production</span>
            </p>
            <h3 class="services-block__heading">Production That Tells Your Story</h3>
            <p class="services-block__body">
              From the concept to the final cut, we handle creative production for artists and brands who need content
              that actually looks like something. Music videos, brand films, photography, motion graphics. We bring the
              vision and the execution.
            </p>
            <ul class="services-included" role="list">
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Music video production
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Brand and commercial film
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Photography and visual direction
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Motion graphics and animation
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Post production and color grading
              </li>
              <li>
                <span class="services-included__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                Social media content production
              </li>
            </ul>
            <a href="/contact" class="services-block__cta">Discuss a production project</a>
          </div>
        </div>
      </article>
    </section>

    <section class="services-bleed services-process services-reveal" aria-labelledby="services-process-heading">
      <div class="services-inner">
        <h2 id="services-process-heading" class="services-section-heading">Our Process</h2>
        <div class="services-process__track">
          <article class="services-process-step morph-clay-card">
            <p class="services-process-step__num">01</p>
            <h3 class="services-process-step__heading">We Listen First</h3>
            <p class="services-process-step__copy">
              Before we pitch anything we spend time understanding where you are, where you want to go, and what has
              already been tried.
            </p>
          </article>
          <div class="services-process__between" aria-hidden="true"><span></span></div>
          <article class="services-process-step morph-clay-card">
            <p class="services-process-step__num">02</p>
            <h3 class="services-process-step__heading">We Build the Strategy</h3>
            <p class="services-process-step__copy">
              Every engagement starts with a clear plan. Goals, timelines, deliverables, and how we measure success.
            </p>
          </article>
          <div class="services-process__between" aria-hidden="true"><span></span></div>
          <article class="services-process-step morph-clay-card">
            <p class="services-process-step__num">03</p>
            <h3 class="services-process-step__heading">We Execute Together</h3>
            <p class="services-process-step__copy">
              We are not a hands-off agency. We work alongside you, communicate regularly, and adapt as things move.
            </p>
          </article>
          <div class="services-process__between" aria-hidden="true"><span></span></div>
          <article class="services-process-step morph-clay-card">
            <p class="services-process-step__num">04</p>
            <h3 class="services-process-step__heading">We Review and Grow</h3>
            <p class="services-process-step__copy">
              After every campaign or release we review what worked, what did not, and what we do differently next time.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="services-bleed services-audience services-reveal" aria-labelledby="services-audience-heading">
      <div class="services-inner services-audience__grid">
        <div class="services-audience__intro">
          <h2 id="services-audience-heading" class="services-section-heading">Who This Is For</h2>
          <p class="services-audience__lede">
            We are selective about who we work with. Not because we are difficult, but because the best results come from
            genuine alignment. If you see yourself in this list, we should talk.
          </p>
        </div>
        <ul class="services-audience__list" role="list">
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Independent artists ready to invest in their career
          </li>
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Music labels looking for management support
          </li>
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Brands that want content with a real creative point of view
          </li>
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Startups and growing companies that need marketing without the agency markup
          </li>
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Creative businesses that want to build an audience, not just followers
          </li>
        </ul>
      </div>
    </section>

    <section class="services-bleed services-cta services-reveal" aria-labelledby="services-cta-heading">
      <div class="services-inner services-cta__inner">
        <h2 id="services-cta-heading" class="services-cta__heading">Let's Build Something Together</h2>
        <p class="services-cta__copy">Tell us what you are working on and we will tell you how we can help.</p>
        <a href="/contact" class="services-cta__btn">Work With Us</a>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.services-reveal');
    if (reduce) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .services-page {
    margin-left: calc(-1 * var(--about-pad, 1rem));
    margin-right: calc(-1 * var(--about-pad, 1rem));
    width: calc(100% + 2 * var(--about-pad, 1rem));
    max-width: none;
  }

  .services-bleed {
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .services-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .services-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.65s ease,
      transform 0.65s ease;
  }

  .services-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero: glass command deck + team stock ambience (not home carousel) */
  .services-hero {
    position: relative;
    overflow: hidden;
    background: #060608;
    padding: var(--space-20) 0 var(--space-16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .services-hero__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .services-hero__ambient-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    opacity: 0.35;
    filter: saturate(1.1) contrast(1.08);
    transform: scale(1.04);
  }

  .services-hero__ambient-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 70% at 50% 0%, rgba(8, 8, 10, 0.25) 0%, transparent 55%),
      linear-gradient(180deg, rgba(6, 6, 8, 0.88) 0%, rgba(8, 8, 10, 0.96) 45%, rgba(6, 6, 8, 0.98) 100%);
  }

  .services-hero__mesh {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    background-image:
      linear-gradient(rgba(209, 223, 75, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(209, 223, 75, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 0%, transparent 75%);
    pointer-events: none;
  }

  .services-hero--credentials .services-hero__watermark {
    position: absolute;
    left: 50%;
    top: 40%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(7rem, 28vw, 14rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--brand-text);
    opacity: 0.04;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    z-index: 0;
  }

  .services-hero__center {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .services-hero__glass {
    position: relative;
    width: 100%;
    max-width: 920px;
    border-radius: 28px;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 2.5rem);
    overflow: hidden;
  }

  .services-hero__glass-shine {
    position: absolute;
    top: -40%;
    left: -20%;
    width: 70%;
    height: 90%;
    background: linear-gradient(
      125deg,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.02) 45%,
      transparent 70%
    );
    pointer-events: none;
    border-radius: 50%;
    filter: blur(2px);
  }

  .services-hero__inner {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    text-align: center;
  }

  .services-hero__label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-accent);
    border: 1px solid var(--brand-surface-border);
    background: var(--brand-accent-dim);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .services-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    color: var(--brand-text);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  .services-hero__sub {
    font-size: var(--text-lg);
    color: var(--brand-text-muted);
    line-height: 1.65;
    margin: 0 auto;
    max-width: 38rem;
  }

  .services-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-10);
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .services-hero__stat:nth-child(3) {
    grid-column: 1 / -1;
    justify-self: center;
    min-width: min(100%, 22rem);
  }

  .services-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 4.5rem;
  }

  .services-hero__stat-line {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 700;
    color: var(--brand-text);
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-wrap: balance;
  }

  /* Service blocks */
  .services-overview {
    background: var(--brand-bg-base);
  }

  .services-block {
    position: relative;
