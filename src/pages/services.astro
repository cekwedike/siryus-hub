---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindDecorButton from '../components/WindDecorButton.astro';

const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

const services = [
  {
    num: '01',
    name: 'SIRYUS A.M',
    heading: 'Artist Management That Moves the Needle',
    body: 'Managing an artist career is more than booking shows and sending emails. It is strategy, relationships, brand building, and knowing when to push and when to protect. We work directly with independent artists who are ready to grow and need a team that is equally invested in the outcome.',
    items: [
      'Career strategy and roadmapping',
      'Release planning and campaign management',
      'Brand identity and positioning',
      'Industry relationships and partnerships',
      'Contract guidance and deal review',
      'Day to day management support',
    ],
    cta: 'Learn about SIRYUS A.M',
    href: '/siryus-am',
  },
  {
    num: '02',
    name: 'Brand Marketing',
    heading: 'Marketing That Actually Sounds Like You',
    body: 'Most brand marketing is forgettable. Ours is not. We build content strategies, run social media, write copy that converts, and produce creative assets that make your audience stop scrolling. We work with brands that want to grow without losing their voice in the process.',
    items: [
      'Content strategy and editorial planning',
      'Social media management and growth',
      'Email marketing and automation',
      'Copywriting and brand messaging',
      'Motion graphics and video content',
      'Campaign planning and execution',
    ],
    cta: 'Talk to us about your brand',
    href: '/contact',
  },
  {
    num: '03',
    name: 'Creative Production',
    heading: 'Production That Tells Your Story',
    body: 'From the concept to the final cut, we handle creative production for artists and brands who need content that actually looks like something. Music videos, brand films, photography, motion graphics. We bring the vision and the execution.',
    items: [
      'Music video production',
      'Brand and commercial film',
      'Photography and visual direction',
      'Motion graphics and animation',
      'Post production and color grading',
      'Social media content production',
    ],
    cta: 'Discuss a production project',
    href: '/contact',
  },
  {
    num: '04',
    name: 'Distribution and Rights',
    heading: 'Get Your Work Out There. Keep What Is Yours.',
    body: 'Creating the music is only half the work. Getting it to the right ears and making sure you own what you made is the other half. We help independent artists navigate distribution and rights management so their work reaches audiences worldwide and their intellectual property stays protected.',
    items: [
      'Music distribution to global platforms',
      'Rights management and IP guidance',
      'Distribution strategy and platform selection',
      'Royalty and revenue setup',
      'Deal review for licensing and sync',
      'International reach and cross-border strategy',
    ],
    cta: 'Talk to us about distribution',
    href: '/contact',
  },
  {
    num: '05',
    name: 'Education and Training',
    heading: 'The Business Side Nobody Teaches You',
    body: 'Most creative schools teach you the craft. Nobody teaches you how to turn the craft into a career. We run workshops, create resources, and share practical knowledge on the parts of the creative industry that independent artists and creators often figure out too late. The blog is part of this too.',
    items: [
      'Workshops on branding and audience building',
      'Creative entrepreneurship guidance',
      'Content strategy and storytelling training',
      'Industry education on rights and royalties',
      'Access to the Siryus Hub blog and resources',
      'Skill development for independent creatives',
    ],
    cta: 'Explore the blog',
    href: '/blog',
  },
  {
    num: '06',
    name: 'Mentorship and Networking',
    heading: 'The Right Room Changes Everything',
    body: 'Sometimes what an artist or creative needs most is not another service. It is access to people who have done it before and a community of peers who are doing it now. Through the Indiba Project Series and the Siryus community, we connect creatives with mentors, collaborators, and opportunities that actually move the needle.',
    items: [
      'One on one mentorship for independent artists',
      'Networking events and online forums',
      'Collaborative project opportunities',
      'Access to the Siryus creative community',
      'Connection to the Indiba Project Series',
      'Industry introductions and partnerships',
    ],
    cta: 'Join the community',
    href: '/community',
  },
] as const;
---

<BaseLayout
  title="Creative Services - Siryus Creative Media"
  description="Artist management, brand marketing, creative production, distribution, education and mentorship from Siryus Creative Media Ltd. Real support for independent artists and growing brands across Africa."
  canonical="https://www.siryushub.com/services"
>
  <div class="services-page">
    <section class="services-bleed services-hero services-hero--credentials services-reveal" aria-labelledby="services-hero-heading">
      <div class="services-hero__ambient" aria-hidden="true">
        <img
          class="services-hero__ambient-img"
          src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1920&q=80&auto=format&fit=crop"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          decoding="async"
        />
        <div class="services-hero__ambient-scrim"></div>
      </div>
      <div class="services-hero__mesh" aria-hidden="true"></div>
      <span class="services-hero__watermark" aria-hidden="true">SVC</span>
      <div class="services-inner services-hero__center">
        <div class="morph-hero-glass-panel services-hero__glass">
          <div class="services-hero__glass-shine" aria-hidden="true"></div>
          <div class="services-hero__inner">
            <span class="services-hero__label">What We Do</span>
            <h1 id="services-hero-heading" class="services-hero__title">Real Services. Real Results.</h1>
            <p class="services-hero__sub">
              We do not offer packages. We offer partnerships. Here is what that looks like in practice.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="services-bleed services-overview" aria-labelledby="services-overview-heading">
      <h2 id="services-overview-heading" class="visually-hidden">Services overview</h2>

      {
        services.map((s, i) => (
          <article
            class:list={[
              'services-block',
              'services-reveal',
              i % 2 === 0 ? 'services-block--main-left' : 'services-block--main-right',
            ]}
          >
            <span class="services-block__watermark" aria-hidden="true">
              {s.num}
            </span>
            <div class="services-block__inner">
              <div class="services-block__accent" aria-hidden="true"></div>
              <div class="services-block__main">
                <p class="services-block__meta">
                  <span class="services-block__num">{s.num}</span>
                  <span class="services-block__name">{s.name}</span>
                </p>
                <h3 class="services-block__heading">{s.heading}</h3>
                <p class="services-block__body">{s.body}</p>
                <ul class="services-included" role="list">
                  {s.items.map((item) => (
                    <li>
                      <span class="services-included__icon" aria-hidden="true" set:html={checkIcon} />
                      {item}
                    </li>
                  ))}
                </ul>
                <WindDecorButton href={s.href} class="services-block__cta">
                  {s.cta}
                </WindDecorButton>
              </div>
            </div>
          </article>
        ))
      }
    </section>

    <section class="services-bleed services-process services-reveal" aria-labelledby="services-process-heading">
      <div class="services-inner">
        <h2 id="services-process-heading" class="services-section-heading">Our Process</h2>
        <div class="services-process__track">
          <article class="services-process-step services-process-card">
            <p class="services-process-step__num">01</p>
            <h3 class="services-process-step__heading">We Listen First</h3>
            <p class="services-process-step__copy">
              Before we pitch anything we spend time understanding where you are, where you want to go, and what has
              already been tried.
            </p>
          </article>
          <article class="services-process-step services-process-card">
            <p class="services-process-step__num">02</p>
            <h3 class="services-process-step__heading">We Build the Strategy</h3>
            <p class="services-process-step__copy">
              Every engagement starts with a clear plan. Goals, timelines, deliverables, and how we measure success.
            </p>
          </article>
          <article class="services-process-step services-process-card">
            <p class="services-process-step__num">03</p>
            <h3 class="services-process-step__heading">We Execute Together</h3>
            <p class="services-process-step__copy">
              We are not a hands-off agency. We work alongside you, communicate regularly, and adapt as things move.
            </p>
          </article>
          <article class="services-process-step services-process-card">
            <p class="services-process-step__num">04</p>
            <h3 class="services-process-step__heading">We Review and Grow</h3>
            <p class="services-process-step__copy">
              After every campaign or release we review what worked, what did not, and what we do differently next time.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="services-bleed services-audience services-reveal" aria-labelledby="services-audience-heading">
      <div class="services-inner services-audience__grid">
        <div class="services-audience__intro">
          <h2 id="services-audience-heading" class="services-section-heading">Who This Is For</h2>
          <p class="services-audience__lede">
            We are selective about who we work with. Not because we are difficult, but because the best results come from
            genuine alignment. If you see yourself in this list, we should talk.
          </p>
        </div>
        <ul class="services-audience__list" role="list">
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Independent artists ready to invest in their career
          </li>
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Music labels looking for management support
          </li>
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Brands that want content with a real creative point of view
          </li>
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Startups and growing companies that need marketing without the agency markup
          </li>
          <li>
            <span class="services-audience__check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            Creative businesses that want to build an audience, not just followers
          </li>
        </ul>
      </div>
    </section>

    <section class="services-bleed services-cta services-reveal" aria-labelledby="services-cta-heading">
      <div class="services-inner services-cta__inner">
        <h2 id="services-cta-heading" class="services-cta__heading">Let's Build Something Together</h2>
        <p class="services-cta__copy">
          Tell us what you are working on and we will tell you how we can help.
        </p>
        <WindDecorButton href="/contact" class="services-cta__btn">Work With Us</WindDecorButton>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.services-reveal');
    if (reduce) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .services-page {
    margin-left: calc(-1 * var(--about-pad, 1rem));
    margin-right: calc(-1 * var(--about-pad, 1rem));
    width: calc(100% + 2 * var(--about-pad, 1rem));
    max-width: none;
  }

  .services-bleed {
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .services-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .services-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.65s ease,
      transform 0.65s ease;
  }

  .services-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .services-hero {
    position: relative;
    overflow: hidden;
    background: #060608;
    padding: var(--space-20) 0 var(--space-16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .services-hero__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .services-hero__ambient-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    opacity: 0.35;
    filter: saturate(1.1) contrast(1.08);
    transform: scale(1.04);
  }

  .services-hero__ambient-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 70% at 50% 0%, rgba(8, 8, 10, 0.25) 0%, transparent 55%),
      linear-gradient(180deg, rgba(6, 6, 8, 0.88) 0%, rgba(8, 8, 10, 0.96) 45%, rgba(6, 6, 8, 0.98) 100%);
  }

  .services-hero__mesh {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    background-image:
      linear-gradient(rgba(209, 223, 75, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(209, 223, 75, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 0%, transparent 75%);
    pointer-events: none;
  }

  .services-hero--credentials .services-hero__watermark {
    position: absolute;
    left: 50%;
    top: 40%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(7rem, 28vw, 14rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--brand-text);
    opacity: 0.04;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    z-index: 0;
  }

  .services-hero__center {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .services-hero__glass {
    position: relative;
    width: 100%;
    max-width: 920px;
    border-radius: 28px;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 2.5rem);
    overflow: hidden;
  }

  .services-hero__glass-shine {
    position: absolute;
    top: -40%;
    left: -20%;
    width: 70%;
    height: 90%;
    background: linear-gradient(
      125deg,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.02) 45%,
      transparent 70%
    );
    pointer-events: none;
    border-radius: 50%;
    filter: blur(2px);
  }

  .services-hero__inner {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    text-align: center;
  }

  .services-hero__label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-accent);
    border: 1px solid var(--brand-surface-border);
    background: var(--brand-accent-dim);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .services-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    color: var(--brand-text);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  .services-hero__sub {
    font-size: var(--text-lg);
    color: var(--brand-text-muted);
    line-height: 1.65;
    margin: 0 auto;
    max-width: 38rem;
  }

  .services-overview {
    background: var(--brand-bg-base);
  }

  .services-block {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: clamp(var(--space-16), 8vw, var(--space-24)) 0;
  }

  .services-block__watermark {
    position: absolute;
    right: var(--space-6);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(8rem, 22vw, 14rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--brand-text);
    opacity: 0.04;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .services-block--main-right .services-block__watermark {
    right: auto;
    left: var(--space-6);
  }

  .services-block__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  .services-block--main-left .services-block__inner {
    grid-template-columns: minmax(0, 1fr) minmax(72px, 200px);
  }

  .services-block--main-right .services-block__inner {
    grid-template-columns: minmax(72px, 200px) minmax(0, 1fr);
  }

  .services-block--main-left .services-block__accent {
    order: 2;
  }

  .services-block--main-left .services-block__main {
    order: 1;
  }

  .services-block--main-right .services-block__accent {
    order: 1;
  }

  .services-block--main-right .services-block__main {
    order: 2;
  }

  .services-block__accent {
    min-height: 120px;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--brand-accent-dim) 0%, transparent 100%);
    border: 1px solid var(--brand-surface-border);
  }

  .services-block__main {
    max-width: 42rem;
  }

  .services-block--main-right .services-block__main {
    justify-self: end;
    text-align: left;
  }

  .services-block__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-accent);
  }

  .services-block__num {
    color: var(--brand-text-muted);
    font-weight: 800;
  }

  .services-block__name {
    color: var(--brand-accent);
  }

  .services-block__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    font-weight: 800;
    color: var(--brand-text);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-5);
  }

  .services-block__body {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--brand-text-muted);
    margin: 0 0 var(--space-8);
  }

  .services-included {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .services-included li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--brand-text-muted);
    margin: 0;
  }

  .services-included__icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--brand-accent);
    display: flex;
  }

  .services-block__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-6);
    transition: transform var(--transition-fast);
  }

  .services-block__cta:hover {
    transform: translateY(-2px);
  }

  .services-process {
    background: var(--brand-bg-deep);
    padding: var(--space-16) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .services-section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--brand-text);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-10);
  }

  .services-process__track {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: var(--space-6);
  }

  .services-process-step {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 4vw, 2.35rem);
    min-height: 17rem;
  }

  .services-process-card {
    position: relative;
    background: linear-gradient(165deg, rgba(46, 46, 52, 0.99) 0%, rgba(12, 12, 14, 1) 100%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 3px 0 rgba(0, 0, 0, 0.45),
      0 22px 44px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -3px 0 rgba(0, 0, 0, 0.42);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .services-process-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.06) 0%, transparent 42%);
    opacity: 0.9;
  }

  .services-process-card:hover {
