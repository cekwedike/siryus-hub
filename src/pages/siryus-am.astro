---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindDecorButton from '../components/WindDecorButton.astro';
---

<BaseLayout
  title="SIRYUS A.M - Artist Management Africa"
  description="SIRYUS A.M manages independent artists across Africa and beyond. Career strategy, release campaigns, brand building and hands-on management support."
  canonical="https://www.siryushub.com/siryus-am"
>
  <div class="siryus-am-page">
    <section class="siryus-am-bleed siryus-am-hero siryus-am-reveal" aria-labelledby="siryus-am-hero-heading">
      <div class="siryus-am-hero__cinema" aria-hidden="true">
        <img
          class="siryus-am-hero__cinema-img"
          src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=1920&q=80&auto=format&fit=crop"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          decoding="async"
        />
        <div class="siryus-am-hero__cinema-vignette"></div>
      </div>
      <div class="siryus-am-hero__glow-top" aria-hidden="true"></div>
      <div class="siryus-am-hero__orbs" aria-hidden="true">
        <span class="morph-hero-glass-orb siryus-am-hero__orb siryus-am-hero__orb--a"></span>
        <span class="morph-hero-glass-orb siryus-am-hero__orb siryus-am-hero__orb--b"></span>
      </div>
      <div class="siryus-am-inner siryus-am-hero__wrap">
        <div class="morph-hero-stage siryus-am-hero__stage">
          <span class="siryus-am-hero__label">SIRYUS A.M</span>
          <h1 id="siryus-am-hero-heading" class="siryus-am-hero__title">
            Your Career Deserves More Than a Manager Who Just Replies to Emails.
          </h1>
          <div class="siryus-am-hero__line-track" aria-hidden="true">
            <div class="siryus-am-hero__line"></div>
          </div>
          <p class="siryus-am-hero__sub">
            We are hands-on, strategic, and genuinely invested in what you are building. That is what management should feel
            like.
          </p>
          <div class="siryus-am-hero__actions">
            <WindDecorButton href="/artists" variant="secondary" class="siryus-am-btn siryus-am-btn--secondary">
              See our roster
            </WindDecorButton>
            <WindDecorButton href="/contact" class="siryus-am-btn siryus-am-btn--primary">Work With Us</WindDecorButton>
          </div>
        </div>
      </div>
    </section>

    <section class="siryus-am-bleed siryus-am-pitch siryus-am-reveal" aria-labelledby="siryus-am-pitch-heading">
      <div class="siryus-am-inner siryus-am-pitch__grid">
        <div class="siryus-am-pitch__statement-wrap">
          <h2 id="siryus-am-pitch-heading" class="visually-hidden">Why SIRYUS A.M</h2>
          <p class="siryus-am-pitch__statement">
            Management is not a service. It is a partnership.
          </p>
        </div>
        <div class="siryus-am-pitch__body">
          <p>
            Too many artists sign with managers who treat it like a part-time job. They show up when it is convenient,
            disappear when things get hard, and take their percentage regardless. That is not what we do.
          </p>
          <p>
            SIRYUS A.M works with a small number of artists so we can give each one the attention their career actually
            needs. We are involved in the strategy, the releases, the brand, the deals, and everything in between.
          </p>
          <p>
            We do not promise overnight success. We promise to show up, do the work, and build something that lasts.
          </p>
        </div>
      </div>
    </section>

    <section class="siryus-am-bleed siryus-am-what siryus-am-reveal" aria-labelledby="siryus-am-what-heading">
      <div class="siryus-am-inner">
        <h2 id="siryus-am-what-heading" class="siryus-am-section-title">What We Actually Do</h2>
        <div class="siryus-am-what__grid">
          <article class="morph-clay-card siryus-am-card">
            <div class="siryus-am-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <h3 class="siryus-am-card__heading">Release Strategy</h3>
            <p class="siryus-am-card__copy">
              We plan every release from concept to post-launch. Timelines, content calendars, platform strategy, and
              press outreach. Nothing gets dropped without a plan behind it.
            </p>
          </article>
          <article class="morph-clay-card siryus-am-card">
            <div class="siryus-am-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <h3 class="siryus-am-card__heading">Career Development</h3>
            <p class="siryus-am-card__copy">
              Where are you in five years? We help you answer that and then build the roadmap to get there. Short term
              wins and long term vision together.
            </p>
          </article>
          <article class="morph-clay-card siryus-am-card">
            <div class="siryus-am-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="siryus-am-card__heading">Deal Review and Protection</h3>
            <p class="siryus-am-card__copy">
              Contracts, partnerships, sync deals, and brand collaborations. We review everything before you sign
              anything and make sure you keep what is yours.
            </p>
          </article>
          <article class="morph-clay-card siryus-am-card">
            <div class="siryus-am-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3 class="siryus-am-card__heading">Brand and Presence</h3>
            <p class="siryus-am-card__copy">
              Your image, your story, your online presence. We help you build a brand that is consistent, recognizable,
              and actually you.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="siryus-am-bleed siryus-am-roster siryus-am-reveal" aria-labelledby="siryus-am-roster-heading">
      <div class="siryus-am-inner">
        <h2 id="siryus-am-roster-heading" class="siryus-am-section-title">Our Artists</h2>
        <p class="siryus-am-roster__sub">A small roster by design. Every artist gets our full attention.</p>
        <ul class="siryus-am-roster__grid" role="list">
          <li>
            <a
              href="/artists/max-prodigy"
              class="siryus-am-roster-card"
              aria-label="Max Prodigy, Hip Hop / Rap, Nigeria. View profile"
            >
              <div class="siryus-am-roster-card__photo">
                <img
                  class="siryus-am-roster-card__img"
                  src="/images/artists/max-prodigy.jpg"
                  alt="Max Prodigy"
                  width="600"
                  height="800"
                  loading="lazy"
                />
                <div class="siryus-am-roster-card__placeholder" aria-hidden="true">MP</div>
              </div>
              <div class="siryus-am-roster-card__meta">
                <p class="siryus-am-roster-card__name">Max Prodigy</p>
                <p class="siryus-am-roster-card__tags">
                  <span class="siryus-am-roster-card__genre">Hip Hop / Rap</span>
                  <span class="siryus-am-roster-card__dot" aria-hidden="true">·</span>
                  <span class="siryus-am-roster-card__loc">Nigeria</span>
                </p>
                <span class="siryus-am-roster-card__link">View profile</span>
              </div>
            </a>
          </li>
          <li>
            <a
              href="/artists/hidaya-morgan"
              class="siryus-am-roster-card"
              aria-label="Hidaya Morgan, Afro Soul, East Africa. View profile"
            >
              <div class="siryus-am-roster-card__photo">
                <img
                  class="siryus-am-roster-card__img"
                  src="/images/artists/hidaya-morgan.jpg"
                  alt="Hidaya Morgan"
                  width="600"
                  height="800"
                  loading="lazy"
                />
                <div class="siryus-am-roster-card__placeholder" aria-hidden="true">HM</div>
              </div>
              <div class="siryus-am-roster-card__meta">
                <p class="siryus-am-roster-card__name">Hidaya Morgan</p>
                <p class="siryus-am-roster-card__tags">
                  <span class="siryus-am-roster-card__genre">Afro Soul</span>
                  <span class="siryus-am-roster-card__dot" aria-hidden="true">·</span>
                  <span class="siryus-am-roster-card__loc">East Africa</span>
                </p>
                <span class="siryus-am-roster-card__link">View profile</span>
              </div>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="siryus-am-bleed siryus-am-fit siryus-am-reveal" aria-labelledby="siryus-am-fit-heading">
      <div class="siryus-am-inner">
        <h2 id="siryus-am-fit-heading" class="siryus-am-section-title">Is SIRYUS A.M Right for You?</h2>
        <p class="siryus-am-fit__intro">
          We are honest about who we work with. Here is a straightforward look at who this is for and who it is not.
        </p>
        <div class="siryus-am-fit__columns">
          <div class="siryus-am-fit__col siryus-am-fit__col--yes">
            <h3 class="siryus-am-fit__col-title">You are a good fit if:</h3>
            <ul class="siryus-am-fit__list" role="list">
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--yes" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                You are an independent artist ready to treat your career like a business
              </li>
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--yes" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                You have some momentum but need structure and strategy to scale it
              </li>
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--yes" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                You are open to honest feedback even when it is not what you want to hear
              </li>
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--yes" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                You want a manager who is genuinely invested not just collecting a percentage
              </li>
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--yes" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                You are in it for the long game not just the next single
              </li>
            </ul>
          </div>
          <div class="siryus-am-fit__divider" aria-hidden="true"></div>
          <div class="siryus-am-fit__col siryus-am-fit__col--no">
            <h3 class="siryus-am-fit__col-title">We are probably not the right fit if:</h3>
            <ul class="siryus-am-fit__list" role="list">
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--no" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </span>
                You want someone to do everything while you stay passive
              </li>
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--no" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </span>
                You are looking for a quick fix or viral moment
              </li>
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--no" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </span>
                You are not willing to invest in your own career
              </li>
              <li>
                <span class="siryus-am-fit__mark siryus-am-fit__mark--no" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </span>
                You already have a full management team and just need an extra hand
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="siryus-am-bleed siryus-am-cta-band siryus-am-reveal" aria-labelledby="siryus-am-cta-heading">
      <div class="siryus-am-inner siryus-am-cta-band__inner">
        <h2 id="siryus-am-cta-heading" class="siryus-am-cta-band__heading">Ready to Take Your Career Seriously?</h2>
        <p class="siryus-am-cta-band__copy">
          We take on a limited number of artists each year. If you think we are the right fit, reach out and let us talk.
        </p>
        <WindDecorButton href="/contact" class="siryus-am-cta-band__btn">Get In Touch</WindDecorButton>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    document.querySelectorAll('.siryus-am-roster-card__img').forEach(function (img) {
      var wrap = img.closest('.siryus-am-roster-card__photo');
      function markLoaded() {
        if (wrap) wrap.classList.add('has-loaded');
      }
      function markError() {
        if (wrap) {
          wrap.classList.add('has-error');
          wrap.classList.remove('has-loaded');
        }
      }
      if (img.complete && img.naturalHeight > 0) {
        markLoaded();
      } else {
        img.addEventListener('load', markLoaded);
        img.addEventListener('error', markError);
      }
    });

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.siryus-am-reveal');
    if (reduce) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .siryus-am-page {
    margin-left: calc(-1 * var(--siryus-am-pad, 1rem));
    margin-right: calc(-1 * var(--siryus-am-pad, 1rem));
    width: calc(100% + 2 * var(--siryus-am-pad, 1rem));
    max-width: none;
  }

  .siryus-am-bleed {
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .siryus-am-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .siryus-am-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.65s ease,
      transform 0.65s ease;
  }

  .siryus-am-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero: concert stock + glass stage + floating orbs (not home hero) */
  .siryus-am-hero {
    position: relative;
    overflow: hidden;
    background: #050506;
    padding: var(--space-20) 0 var(--space-16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .siryus-am-hero__cinema {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .siryus-am-hero__cinema-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    opacity: 0.42;
    filter: saturate(1.2) contrast(1.12);
    transform: scale(1.03);
  }

  .siryus-am-hero__cinema-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 70% at 50% 18%, rgba(209, 223, 75, 0.12) 0%, transparent 55%),
      radial-gradient(ellipse 120% 90% at 50% 100%, rgba(0, 0, 0, 0.5) 0%, transparent 55%),
      linear-gradient(180deg, rgba(5, 5, 6, 0.75) 0%, rgba(5, 5, 6, 0.92) 55%, rgba(5, 5, 6, 0.97) 100%);
  }

  .siryus-am-hero__glow-top {
    position: absolute;
    left: 50%;
    top: -35%;
    width: 140%;
    height: 95%;
    transform: translateX(-50%);
    z-index: 1;
    background: radial-gradient(
      ellipse 48% 42% at 50% 0%,
      rgba(209, 223, 75, 0.18) 0%,
      rgba(209, 223, 75, 0.05) 38%,
      transparent 68%
    );
    pointer-events: none;
  }

  .siryus-am-hero__orbs {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .siryus-am-hero__orb {
    position: absolute;
    display: block;
  }

  .siryus-am-hero__orb--a {
    width: 112px;
    height: 112px;
    top: 10%;
    right: min(8%, 4rem);
    opacity: 0.72;
  }

  .siryus-am-hero__orb--b {
    width: 76px;
    height: 76px;
    bottom: 14%;
    left: min(6%, 3rem);
    opacity: 0.55;
  }

  .siryus-am-hero__wrap {
    position: relative;
    z-index: 2;
  }

  .siryus-am-hero__stage {
    max-width: 920px;
    text-align: left;
  }

  .siryus-am-hero.siryus-am-reveal.is-visible .siryus-am-hero__stage {
    animation: siryus-am-hero-fade-in 0.9s ease forwards;
  }

  @keyframes siryus-am-hero-fade-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .siryus-am-hero__line-track {
    width: 100%;
    margin: var(--space-5) 0 var(--space-7);
    overflow: hidden;
    height: 2px;
  }

  .siryus-am-hero__line {
    height: 100%;
    width: 100%;
    background: linear-gradient(
      90deg,
      rgba(209, 223, 75, 0.15) 0%,
      var(--brand-accent) 18%,
      rgba(209, 223, 75, 0.55) 100%
    );
    transform: scaleX(0);
    transform-origin: left center;
  }

  .siryus-am-hero.siryus-am-reveal.is-visible .siryus-am-hero__line {
    animation: siryus-am-line-draw 1.15s cubic-bezier(0.22, 1, 0.36, 1) 0.35s forwards;
  }

  @keyframes siryus-am-line-draw {
    to {
      transform: scaleX(1);
    }
  }

  .siryus-am-hero__label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-accent);
    border: 1px solid var(--brand-surface-border);
    background: var(--brand-accent-dim);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .siryus-am-hero__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.4vw, 3.1rem);
    font-weight: 900;
    color: var(--brand-text);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .siryus-am-hero__sub {
    font-size: var(--text-lg);
    color: var(--brand-text-muted);
    line-height: 1.65;
    margin: 0 0 var(--space-8);
    max-width: 38rem;
  }

  .siryus-am-hero__actions {
    display: flex;
