---
// Siryus Hub - Loading/Splash Screen
// This page displays for 10 seconds before auto-transitioning to home
// Users can skip by clicking or pressing any key
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Siryus Hub - Loading</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@700;900&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Logo Placeholder (Top Left) -->
  <div class="logo-placeholder">
    <div class="logo-box">SIRYUS A.M</div>
  </div>

  <!-- Main Content Container -->
  <div class="splash-container">
    <!-- Background Animated Elements -->
    <div class="particles-container">
      <div class="particle particle-1"></div>
      <div class="particle particle-2"></div>
      <div class="particle particle-3"></div>
      <div class="particle particle-4"></div>
      <div class="particle particle-5"></div>
    </div>

    <!-- Gradient Overlay -->
    <div class="gradient-overlay"></div>

    <!-- Center Content Area -->
    <div class="center-content">
      <!-- Large A Letter (Left) - Only visible when "SIRYUS" is shown -->
      <div class="large-letter letter-a" id="letterA">A</div>

      <!-- Middle Text Rotation Area -->
      <div class="text-rotation-container">
        <div class="rotating-text" id="rotatingText">SIRYUS</div>
      </div>

      <!-- Large M Letter (Right) - Only visible when "SIRYUS" is shown -->
      <div class="large-letter letter-m" id="letterM">M</div>
    </div>

    <!-- Click to Enter Text -->
    <div class="click-to-enter">
      <span class="click-text">Click To Enter</span>
      <div class="pulse-ring"></div>
    </div>
  </div>

  <style>
    /* ===== RESET & BASE STYLES ===== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #000000;
      color: #ffffff;
      overflow: hidden;
      cursor: pointer;
      width: 100vw;
      height: 100vh;
      position: relative;
    }

    /* ===== LOGO PLACEHOLDER (TOP LEFT) ===== */
    .logo-placeholder {
      position: fixed;
      top: 2rem;
      left: 2rem;
      z-index: 100;
      animation: fadeInDown 1s ease-out;
    }

    .logo-box {
      background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 900;
      font-size: 1rem;
      letter-spacing: 2px;
      box-shadow: 0 4px 20px rgba(79, 70, 229, 0.4);
      transition: transform 0.3s ease;
    }

    .logo-box:hover {
      transform: scale(1.05);
    }

    /* ===== MAIN SPLASH CONTAINER ===== */
    .splash-container {
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* ===== ANIMATED BACKGROUND PARTICLES ===== */
    .particles-container {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      overflow: hidden;
      z-index: 1;
    }

    .particle {
      position: absolute;
      background: linear-gradient(135deg, rgba(79, 70, 229, 0.3), rgba(124, 58, 237, 0.3));
      border-radius: 50%;
      animation: float 20s infinite ease-in-out;
    }

    .particle-1 {
      width: 300px;
      height: 300px;
      top: 10%;
      left: 10%;
      animation-delay: 0s;
      animation-duration: 25s;
    }

    .particle-2 {
      width: 200px;
      height: 200px;
      top: 60%;
      right: 15%;
      animation-delay: 3s;
      animation-duration: 30s;
    }

    .particle-3 {
      width: 150px;
      height: 150px;
      bottom: 20%;
      left: 20%;
      animation-delay: 5s;
      animation-duration: 22s;
    }

    .particle-4 {
      width: 250px;
      height: 250px;
      top: 30%;
      right: 30%;
      animation-delay: 8s;
      animation-duration: 28s;
    }

    .particle-5 {
      width: 180px;
      height: 180px;
      bottom: 10%;
      right: 10%;
      animation-delay: 2s;
      animation-duration: 24s;
    }

    /* ===== GRADIENT OVERLAY ===== */
    .gradient-overlay {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      background: radial-gradient(
        ellipse at center,
        rgba(79, 70, 229, 0.15) 0%,
        rgba(0, 0, 0, 0.8) 50%,
        rgba(0, 0, 0, 1) 100%
      );
      z-index: 2;
      animation: gradientPulse 8s ease-in-out infinite;
    }

    /* ===== CENTER CONTENT AREA ===== */
    .center-content {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      animation: fadeInScale 1.2s ease-out;
    }

    /* ===== LARGE A & M LETTERS ===== */
    .large-letter {
      font-size: clamp(8rem, 20vw, 15rem);
      font-weight: 900;
      color: #ffffff;
      text-shadow: 
        0 0 30px rgba(79, 70, 229, 0.8),
        0 0 60px rgba(124, 58, 237, 0.6),
        0 0 90px rgba(79, 70, 229, 0.4);
      animation: floatPulse 3s ease-in-out infinite;
      opacity: 1;
      transition: opacity 0.6s ease, transform 0.6s ease;
      user-select: none;
    }

    .letter-a {
      animation-delay: 0s;
    }

    .letter-m {
      animation-delay: 1.5s;
    }

    /* Hidden state for A and M when not showing "SIRYUS" */
    .large-letter.hidden {
      opacity: 0;
      transform: scale(0.8);
      pointer-events: none;
    }

    /* ===== TEXT ROTATION CONTAINER ===== */
    .text-rotation-container {
      min-width: 300px;
      display: flex;
      align-items: center;
      justify-content: center;
      height: clamp(10rem, 25vw, 18rem);
      position: relative;
    }

    .rotating-text {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 700;
      color: #ffffff;
      text-align: center;
      white-space: nowrap;
      opacity: 1;
      animation: textGlow 2s ease-in-out infinite;
      transition: opacity 0.6s ease;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .rotating-text.fade-out {
      opacity: 0;
    }

    .rotating-text.fade-in {
      opacity: 1;
    }

    /* ===== CLICK TO ENTER ===== */
    .click-to-enter {
      position: fixed;
      bottom: 4rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 100;
      text-align: center;
      animation: fadeInUp 1.5s ease-out 0.5s backwards;
    }

    .click-text {
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #ffffff;
      opacity: 0.9;
      animation: blink 2s ease-in-out infinite;
      display: inline-block;
      position: relative;
      z-index: 2;
    }

    .pulse-ring {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 120px;
      height: 40px;
      border: 2px solid rgba(79, 70, 229, 0.6);
      border-radius: 30px;
      animation: ringPulse 2s ease-out infinite;
      z-index: 1;
    }

    /* ===== ANIMATIONS ===== */
    @keyframes float {
      0%, 100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.3;
      }
      25% {
        transform: translate(50px, -50px) scale(1.1);
        opacity: 0.5;
      }
      50% {
        transform: translate(100px, 50px) scale(0.9);
        opacity: 0.3;
      }
      75% {
        transform: translate(-50px, 100px) scale(1.05);
        opacity: 0.4;
      }
    }

    @keyframes floatPulse {
      0%, 100% {
        transform: translateY(0) scale(1);
      }
      50% {
        transform: translateY(-20px) scale(1.05);
      }
    }

    @keyframes gradientPulse {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.8;
      }
    }

    @keyframes textGlow {
      0%, 100% {
        text-shadow: 
          0 0 20px rgba(255, 255, 255, 0.5),
          0 0 40px rgba(79, 70, 229, 0.3);
      }
      50% {
        text-shadow: 
          0 0 30px rgba(255, 255, 255, 0.8),
          0 0 60px rgba(79, 70, 229, 0.5);
      }
    }

    @keyframes blink {
      0%, 100% {
        opacity: 0.9;
      }
      50% {
        opacity: 0.4;
      }
    }

    @keyframes ringPulse {
      0% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.6;
      }
      50% {
        transform: translate(-50%, -50%) scale(1.2);
        opacity: 0.3;
      }
      100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.6;
      }
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translate(-50%, 30px);
      }
      to {
        opacity: 1;
        transform: translate(-50%, 0);
      }
    }

    @keyframes fadeInScale {
      from {
        opacity: 0;
        transform: scale(0.8);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* ===== RESPONSIVE DESIGN ===== */
    @media (max-width: 1024px) {
      .center-content {
        gap: 2rem;
      }

      .text-rotation-container {
        min-width: 250px;
      }
    }

    @media (max-width: 768px) {
      .logo-placeholder {
        top: 1rem;
        left: 1rem;
      }

      .logo-box {
        font-size: 0.85rem;
        padding: 0.6rem 1.2rem;
      }

      .center-content {
        gap: 1.5rem;
        flex-direction: column;
      }

      .large-letter {
        font-size: clamp(6rem, 15vw, 10rem);
      }

      .text-rotation-container {
        min-width: 200px;
        height: clamp(8rem, 20vw, 12rem);
      }

      .rotating-text {
        font-size: clamp(2rem, 5vw, 3.5rem);
      }

      .click-to-enter {
        bottom: 3rem;
      }

      .click-text {
        font-size: 1rem;
        letter-spacing: 2px;
      }
    }

    @media (max-width: 480px) {
      .center-content {
        gap: 1rem;
      }

      .large-letter {
        font-size: clamp(4rem, 12vw, 8rem);
      }

      .rotating-text {
        font-size: clamp(1.5rem, 4vw, 2.5rem);
      }

      .particle {
        opacity: 0.5;
      }
    }

    /* ===== ACCESSIBILITY: REDUCED MOTION ===== */
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }

      .particle {
        display: none;
      }
    }

    /* ===== FOCUS STATES FOR ACCESSIBILITY ===== */
    body:focus-visible {
      outline: 3px solid rgba(79, 70, 229, 0.8);
      outline-offset: -3px;
    }
  </style>

  <script>
    // ===== CONFIGURATION =====
    const TRANSITION_DELAY = 10000; // 10 seconds
    const TEXT_DISPLAY_DURATION = 2500; // 2.5 seconds per text
    const FADE_DURATION = 600; // 600ms for fade transitions
    
    // Text rotation options
    const textOptions = [
      { text: 'SIRYUS', showLetters: true },
      { text: 'SIRYUS HUB', showLetters: false },
      { text: 'Siryus Creative Media Ltd', showLetters: false },
      { text: 'Siryus Community', showLetters: false }
    ];

    // ===== DOM ELEMENTS =====
    const rotatingTextEl = document.getElementById('rotatingText');
    const letterAEl = document.getElementById('letterA');
    const letterMEl = document.getElementById('letterM');

    // ===== STATE =====
    let currentIndex = 0;
    let rotationInterval;
    let autoTransitionTimeout;
    let hasTransitioned = false;

    // ===== TEXT ROTATION LOGIC =====
    function rotateText() {
      // Fade out current text and letters
      rotatingTextEl.classList.add('fade-out');
      
      setTimeout(() => {
        // Move to next text option
        currentIndex = (currentIndex + 1) % textOptions.length;
        const currentOption = textOptions[currentIndex];
        
        // Update text content
        rotatingTextEl.textContent = currentOption.text;
        
        // Show/hide A and M letters based on current text
        if (currentOption.showLetters) {
          letterAEl.classList.remove('hidden');
          letterMEl.classList.remove('hidden');
        } else {
          letterAEl.classList.add('hidden');
          letterMEl.classList.add('hidden');
        }
        
        // Fade in new text
        rotatingTextEl.classList.remove('fade-out');
        rotatingTextEl.classList.add('fade-in');
        
        setTimeout(() => {
          rotatingTextEl.classList.remove('fade-in');
        }, FADE_DURATION);
      }, FADE_DURATION);
    }

    // ===== TRANSITION TO HOME PAGE =====
    function transitionToHome() {
      if (hasTransitioned) return;
      hasTransitioned = true;

      // Clear all intervals and timeouts
      clearInterval(rotationInterval);
      clearTimeout(autoTransitionTimeout);

      // Add exit animation
      document.body.style.transition = 'opacity 0.5s ease-out';
      document.body.style.opacity = '0';

      // Navigate to home after fade out
      setTimeout(() => {
        window.location.href = '/'; // Change to '/home' if that's your route
      }, 500);
    }

    // ===== SKIP FUNCTIONALITY =====
    function setupSkipListeners() {
      // Click anywhere to skip
      document.body.addEventListener('click', transitionToHome);
      
      // Press any key to skip
      document.addEventListener('keydown', transitionToHome);
    }

    // ===== INITIALIZATION =====
    function init() {
      // Start text rotation
      rotationInterval = setInterval(rotateText, TEXT_DISPLAY_DURATION);
      
      // Set up auto-transition after 10 seconds
      autoTransitionTimeout = setTimeout(transitionToHome, TRANSITION_DELAY);
      
      // Set up skip functionality
      setupSkipListeners();

      // Make body focusable for keyboard accessibility
      document.body.setAttribute('tabindex', '0');
      document.body.focus();
    }

    // Start everything when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</body>
</html>
