---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WindDecorButton from '../../components/WindDecorButton.astro';
import '../../styles/artist-pages.css';
import '../../styles/artist-experience.css';
import { urlFor } from '../../lib/sanity';
import { getAllArtists } from '../../lib/queries';

const artists = await getAllArtists();
---

<BaseLayout
  title="Our Artists - SIRYUS A.M Roster"
  description="Meet the artists managed by SIRYUS A.M. Nigerian rappers, Rwandan singers, afrogospel producers and more. Independent African music going global."
  canonical="https://www.siryushub.com/artists"
>
  <div class="artists-page-root">
    <section class="artists-bleed artists-index-hero artists-index-hero--v2 artist-reveal" aria-labelledby="artists-index-heading">
      <div class="artists-index-hero__glow" aria-hidden="true"></div>
      <div class="artists-inner">
        <span class="artists-index-hero__label">The Roster</span>
        <h1 id="artists-index-heading" class="artists-index-hero__title">The Artists We Back.</h1>
        <p class="artists-index-hero__sub">
          A small roster. Full attention. Every artist here is building something real.
        </p>
      </div>
    </section>

    <section class="artists-bleed artists-index-roster artist-reveal" aria-labelledby="artists-grid-heading">
      <div class="artists-inner">
        <h2 id="artists-grid-heading" class="visually-hidden">Roster</h2>
        {
          artists.length === 0 ? (
            <p class="artists-index-empty">Roster coming soon.</p>
          ) : (
            <ul class="artists-index-grid" role="list">
              {artists.map((artist) => {
                const href = `/artists/${artist.slug?.current ?? ''}`;
                const genres = Array.isArray(artist.genre) ? artist.genre.filter(Boolean) : [];
                const genreLine = genres.length ? genres.join(' / ') : '';
                const photoUrl = artist.photo
                  ? urlFor(artist.photo).width(600).height(800).fit('crop').auto('format').url()
                  : null;
                const alt = artist.name;
                return (
                  <li>
                    <a href={href} class="artists-index-card artists-index-card--lift">
                      <div class={`artists-index-card__photo${photoUrl ? '' : ' has-error'}`}>
                        {photoUrl ? (
                          <img
                            class="artists-index-card__img"
                            src={photoUrl}
                            alt={alt}
                            width="600"
                            height="800"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : null}
                        <div class="artists-index-card__placeholder" aria-hidden="true" />
                      </div>
                      <div class="artists-index-card__body">
                        <p class="artists-index-card__name">{artist.name}</p>
                        <p class="artists-index-card__meta">
                          {genreLine}
                          {artist.location ? (
                            <span class="artists-index-card__loc"> · {artist.location}</span>
                          ) : null}
                        </p>
                        <p class="artists-index-card__line">{artist.oneLiner}</p>
                        <span class="artists-index-card__cta">View profile</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          )
        }
      </div>
    </section>

    <section class="artists-bleed artists-index-cta artist-reveal" aria-labelledby="artists-cta-heading">
      <div class="artists-inner artists-index-cta__inner">
        <h2 id="artists-cta-heading" class="artists-index-cta__heading">Managing Artists Who Mean Business.</h2>
        <p class="artists-index-cta__copy">
          If you are an independent artist serious about your career, we want to hear from you.
        </p>
        <WindDecorButton href="/contact" class="artists-index-cta__btn">Work With Us</WindDecorButton>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    document.querySelectorAll('.artists-index-card__img').forEach(function (img) {
      var wrap = img.closest('.artists-index-card__photo');
      function markLoaded() {
        if (wrap) wrap.classList.add('has-loaded');
      }
      function markError() {
        if (wrap) {
          wrap.classList.add('has-error');
          wrap.classList.remove('has-loaded');
        }
      }
      if (img.complete && img.naturalHeight > 0) {
        markLoaded();
      } else {
        img.addEventListener('load', markLoaded);
        img.addEventListener('error', markError);
      }
    });

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.artist-reveal');
    if (reduce) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .artists-index-empty {
    margin: 0;
    font-size: 1.125rem;
    opacity: 0.85;
    text-align: center;
    padding: 2rem 0 1rem;
  }
</style>
