---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindDecorButton from '../components/WindDecorButton.astro';
import { urlFor } from '../lib/sanity';
import { getAllTeamMembers } from '../lib/queries';
import type { TeamMember } from '../lib/queries';

const teamMembers = await getAllTeamMembers();
const hasTeam = teamMembers.length > 0;
const founders = hasTeam ? teamMembers.filter((m) => m.founder) : [];
const others = hasTeam ? teamMembers.filter((m) => !m.founder) : [];

function dropImagePath(slug: string) {
  if (slug === 'chidiebere-ekwedike') return '/public/images/team/cheedii.jpg';
  return `/public/images/team/${slug}.jpg`;
}

function photoUrl(member: TeamMember, size: number) {
  const p = member.photo as { asset?: { _ref?: string; _id?: string } | null } | null;
  if (!p?.asset) return null;
  return urlFor(member.photo!).width(size).height(size).fit('crop').auto('format').url();
}
---

<BaseLayout
  title="About Siryus Creative Media Ltd"
  description="Siryus Creative Media Ltd is a creative company built for independent artists and brands doing artist management, marketing and production from Kigali, Rwanda."
  canonical="https://www.siryushub.com/about"
>
  <div class="about-page">
    <section class="about-bleed about-hero about-hero--editorial about-reveal" aria-labelledby="about-hero-heading">
      <div class="about-hero__bg" aria-hidden="true">
        <img
          class="about-hero__bg-img"
          src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?w=1920&q=80&auto=format&fit=crop"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          decoding="async"
        />
        <div class="about-hero__bg-scrim"></div>
      </div>
      <div class="about-hero__grain" aria-hidden="true"></div>
      <div class="about-hero__warm-glow" aria-hidden="true"></div>
      <div class="about-inner about-hero__shell">
        <div class="about-hero__grid">
          <div class="about-hero__intro">
            <p class="about-hero__eyebrow">Our Story</p>
            <h1 id="about-hero-heading" class="about-hero__title">
              We Are Not an Agency. We Are Builders.
            </h1>
            <p class="about-hero__sub">
              Siryus Creative Media Ltd was built for the creatives who refuse to fit the mold.
            </p>
          </div>
          <div class="about-hero__visual">
            <div class="morph-skeuo-frame about-hero__frame">
              <img
                src="https://images.unsplash.com/photo-1519682337058-a94d519337bc?w=800&q=80&auto=format&fit=crop"
                alt="Open notebook, pen, and warm desk light suggesting focused creative work"
                width="800"
                height="1000"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="morph-hero-glass-orb about-hero__orb" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="about-bleed about-story about-reveal" aria-labelledby="about-story-heading">
      <div class="about-inner about-story__grid">
        <div class="about-story__quote-wrap">
          <h2 id="about-story-heading" class="about-section-heading">How We Got Here</h2>
          <blockquote class="about-story__pull">
            Art without strategy is a hobby. Strategy without art is noise. We do both.
          </blockquote>
        </div>
        <div class="about-story__body">
          <p>
            Siryus started as a simple idea. What if there was one place where independent creatives could get real
            management, real marketing support, and a real community, without having to deal with the politics of a big
            agency or figure everything out alone?
          </p>
          <p>
            We are incorporated in Nigeria and operate out of Kigali, Rwanda. We work with artists and brands across
            Africa and beyond. Our work spans artist management under SIRYUS A.M, content and brand marketing for
            companies that want to grow, and creative production that actually moves people.
          </p>
          <p>
            We are a small team with a big appetite. We do not take on everyone. We work with people who are serious
            about what they are building and want a partner who is equally serious about helping them get there.
          </p>
        </div>
      </div>
    </section>

    <section class="about-bleed about-values about-reveal" aria-labelledby="about-values-heading">
      <div class="about-inner">
        <h2 id="about-values-heading" class="about-section-heading about-values__title">What We Stand For</h2>
        <div class="about-values__grid">
          <article class="morph-clay-card about-value-card">
            <div class="about-value-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="18" cy="16" r="3"></circle>
              </svg>
            </div>
            <h3 class="about-value-card__heading">Artists First</h3>
            <p class="about-value-card__copy">
              Every decision we make starts with one question. Is this good for the artist? That applies to management,
              marketing, and everything in between.
            </p>
          </article>
          <article class="morph-clay-card about-value-card">
            <div class="about-value-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="22" y1="12" x2="18" y2="12"></line>
                <line x1="6" y1="12" x2="2" y2="12"></line>
                <line x1="12" y1="6" x2="12" y2="2"></line>
                <line x1="12" y1="22" x2="12" y2="18"></line>
              </svg>
            </div>
            <h3 class="about-value-card__heading">Strategy Over Hype</h3>
            <p class="about-value-card__copy">
              Trends fade. A real strategy compounds. We build things that work past the first week and the first drop.
            </p>
          </article>
          <article class="morph-clay-card about-value-card">
            <div class="about-value-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 4 10 4 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <h3 class="about-value-card__heading">African and Global</h3>
            <p class="about-value-card__copy">
              We are rooted in Africa and built for the world. The two are not in conflict. They never were.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-bleed about-team about-reveal" aria-labelledby="about-team-heading">
      <div class="about-inner">
        <h2 id="about-team-heading" class="about-section-heading">The People Behind Siryus</h2>
        <div class="about-team__block">
          {
            hasTeam ? (
              <div class="about-team__sanity-wrap">
                {founders.length > 0 ? (
                  <div class="about-team__founders">
                  {founders.map((member) => {
                    const src = photoUrl(member, 400);
                    return (
                      <article class="about-founder-card about-founder-card--highlight">
                        <div class="team-member-photo founder-photo">
                          {src ? (
                            <>
                              <div
                                class="about-team-drop-hint"
                                aria-hidden="true"
                                set:html={`<!-- DROP IMAGE: ${dropImagePath(member.slug.current)} -->`}
                              />
                              <img
                                class="founder-photo__img"
                                src={src}
                                alt={member.name}
                                width="400"
                                height="400"
                                loading="lazy"
                                decoding="async"
                              />
                              <div class="founder-photo__placeholder" aria-hidden="true">
                                {member.initials}
                              </div>
                            </>
                          ) : (
                            <>
                              <div
                                class="about-team-drop-hint"
                                aria-hidden="true"
                                set:html={`<!-- DROP IMAGE: ${dropImagePath(member.slug.current)} -->`}
                              />
                              <div
                                class="founder-photo__placeholder team-member-photo__placeholder"
                                aria-hidden="true"
                              >
                                {member.initials}
                              </div>
                            </>
                          )}
                        </div>
                        <div class="about-founder-card__text">
                          <p class="about-founder-card__badge">Founder</p>
                          <p class="about-founder-card__name">{member.name}</p>
                          <p class="about-founder-card__title">{member.role}</p>
                          <p class="about-founder-card__resp">{member.responsibilities}</p>
                        </div>
                      </article>
                    );
                  })}
                  </div>
                ) : null}
                {others.length > 0 ? (
                  <ul class="about-team__grid" role="list">
                    {others.map((member) => {
                      const src = photoUrl(member, 600);
                      return (
                        <li>
                          <article class="about-team-card morph-clay-card">
                            {src ? (
                              <div class="team-member-photo about-team-card__photo-wrap">
                                <div
                                  class="about-team-drop-hint"
                                  aria-hidden="true"
                                  set:html={`<!-- DROP IMAGE: ${dropImagePath(member.slug.current)} -->`}
                                />
                                <img
                                  class="about-team-card__photo"
                                  src={src}
                                  alt={member.name}
                                  width="600"
                                  height="600"
                                  loading="lazy"
                                  decoding="async"
                                />
                              </div>
                            ) : (
                              <>
                                <div
                                  class="about-team-drop-hint"
                                  aria-hidden="true"
                                  set:html={`<!-- DROP IMAGE: ${dropImagePath(member.slug.current)} -->`}
                                />
                                <div class="about-team-card__avatar" aria-hidden="true">
                                  {member.initials}
                                </div>
                              </>
                            )}
                            <h3 class="about-team-card__name">{member.name}</h3>
                            <p class="about-team-card__role">{member.role}</p>
                            <p class="about-team-card__resp">{member.responsibilities}</p>
                          </article>
                        </li>
                      );
                    })}
                  </ul>
                ) : null}
              </div>
            ) : (
              <article class="about-founder-card about-founder-card--highlight">
                <div class="team-member-photo founder-photo">
                  <!-- DROP IMAGE: /public/images/team/cheedii.jpg -->
                  <img
                    class="founder-photo__img"
                    src="/images/team/cheedii.jpg"
                    alt="Chidiebere Ekwedike"
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="founder-photo__placeholder" aria-hidden="true">CE</div>
                </div>
                <div class="about-founder-card__text">
                  <p class="about-founder-card__badge">Founder</p>
                  <p class="about-founder-card__name">Chidiebere Ekwedike</p>
                  <p class="about-founder-card__title">Founder, Siryus Creative Media Ltd</p>
                  <p class="about-founder-card__resp">
                    Copywriter, front-end developer, and talent manager. Cheedii started Siryus to bridge the gap between
                    creative talent and the business side of the industry. Based in Kigali. Rooted in Nigeria.
                  </p>
                </div>
              </article>
            )
          }
        </div>
      </div>
    </section>

    <section class="about-bleed about-cta about-reveal" aria-labelledby="about-cta-heading">
      <div class="about-inner about-cta__inner">
        <h2 id="about-cta-heading" class="about-cta__heading">Ready to Build Something?</h2>
        <p class="about-cta__copy">
          Whether you are an artist looking for management or a brand that needs a real creative partner, we want to hear
          from you.
        </p>
        <WindDecorButton href="/contact" class="about-cta__btn">Work With Us</WindDecorButton>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    document.querySelectorAll('.team-member-photo img').forEach(function (img) {
      var wrap = img.closest('.team-member-photo');
      function markLoaded() {
        if (wrap) wrap.classList.add('has-loaded');
      }
      function markError() {
        if (wrap) wrap.classList.add('has-error');
      }
      if (img.complete && img.naturalHeight > 0) {
        markLoaded();
      } else {
        img.addEventListener('load', markLoaded);
        img.addEventListener('error', markError);
      }
    });

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.about-reveal');
    if (reduce) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<style>
  .about-page {
    margin-left: calc(-1 * var(--about-pad, 1rem));
    margin-right: calc(-1 * var(--about-pad, 1rem));
    width: calc(100% + 2 * var(--about-pad, 1rem));
    max-width: none;
  }

  .about-bleed {
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .about-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .about-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.65s ease,
      transform 0.65s ease;
  }

  .about-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero: editorial manuscript + neu plate + skeuo photo (distinct from home carousel) */
  .about-hero {
    position: relative;
    overflow: hidden;
    background: var(--brand-bg-deep);
    padding: var(--space-20) 0 var(--space-16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .about-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .about-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    opacity: 0.22;
    filter: saturate(0.85) contrast(1.05);
  }

  .about-hero__bg-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(8, 8, 10, 0.94) 0%,
      rgba(10, 10, 12, 0.82) 48%,
      rgba(8, 8, 10, 0.75) 100%
    );
  }

  .about-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.07;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  .about-hero__warm-glow {
    position: absolute;
    pointer-events: none;
    bottom: -28%;
    left: -18%;
    width: min(72vw, 520px);
    height: min(52vh, 420px);
    background: radial-gradient(
      ellipse 80% 70% at 35% 75%,
      rgba(200, 140, 88, 0.18) 0%,
      rgba(120, 80, 48, 0.06) 45%,
      transparent 72%
    );
    opacity: 0.95;
  }

  .about-hero__shell {
    position: relative;
    z-index: 1;
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(260px, 0.88fr);
    gap: var(--space-10);
    align-items: center;
  }

  .about-hero__intro {
    text-align: left;
    max-width: 36rem;
    padding: 0;
  }

  .about-hero__eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin: 0 0 var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid rgba(209, 223, 75, 0.35);
    display: inline-block;
    width: auto;
    max-width: 100%;
  }

  .about-hero__visual {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 380px;
  }

  .about-hero__frame {
    position: relative;
    z-index: 1;
    border-radius: 18px;
    transform: rotate(-1.5deg);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-hero__frame:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .about-hero__frame img {
    aspect-ratio: 4 / 5;
    max-height: min(420px, 52vh);
  }

  .about-hero__orb {
    position: absolute;
    width: 88px;
    height: 88px;
    right: -12%;
    bottom: 8%;
    z-index: 0;
    opacity: 0.85;
  }

  .about-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    color: var(--brand-text);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.45);
  }

  .about-hero__sub {
    font-size: var(--text-lg);
    color: rgba(230, 230, 228, 0.88);
    line-height: 1.65;
    margin: 0;
    max-width: 34rem;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
  }

  /* Section headings */
  .about-section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--brand-text);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  /* Story */
  .about-story {
    background: var(--brand-bg-base);
    padding: var(--space-16) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .about-story__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .about-story__quote-wrap .about-section-heading {
    margin-bottom: var(--space-5);
  }

  .about-story__pull {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 700;
    line-height: 1.35;
    color: var(--brand-text);
    margin: 0;
    padding: var(--space-6) 0 0 var(--space-5);
    border-left: 3px solid var(--brand-accent);
    font-style: normal;
  }

  .about-story__body p {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--brand-text-muted);
    margin: 0 0 var(--space-5);
  }

  .about-story__body p:last-child {
    margin-bottom: 0;
  }

  /* Values */
  .about-values {
    background: var(--brand-bg-deep);
    padding: var(--space-16) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .about-values__title {
    margin-bottom: var(--space-10);
  }

  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .about-value-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
  }

  .about-value-card__icon {
    color: var(--brand-text-muted);
    transition: color var(--transition-base);
  }

  .about-value-card:hover .about-value-card__icon {
    color: var(--brand-accent);
  }

  .about-value-card__heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--brand-text);
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .about-value-card__copy {
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--brand-text-muted);
    margin: 0;
  }

  :global(body.light-theme) .about-value-card__heading {
    color: var(--brand-text);
  }

  /* Team */
  .about-team {
    background: var(--brand-bg-base);
    padding: var(--space-16) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .about-team__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .about-team-drop-hint {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .about-team__sanity-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .about-team__founders {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about-founder-card--highlight {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    border: 2px solid var(--brand-accent);
    max-width: 848px;
    box-sizing: border-box;
    background: rgba(0, 0, 0, 0.18);
  }

  .about-founder-card__badge {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-accent);
  }

  .about-founder-card--highlight .about-founder-card__title {
    color: var(--brand-accent);
    font-weight: 700;
  }

  .about-team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-team__grid > li {
    margin: 0;
    min-width: 0;
  }

  .about-team-card {
    position: relative;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    border-radius: var(--radius-xl);
    height: 100%;
    box-sizing: border-box;
  }

  .about-team-card__avatar {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-xs);
