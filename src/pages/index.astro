        <p class="splash-tagline">
          Artist management. Brand marketing. Creative production.
        </p>

        <button type="button" class="splash-enter is-visible" id="enterBtn">
          Enter the Hub
        </button>
      </div>
    </div>

    <p class="splash-footer-loc">Kigali · Nigeria · Worldwide</p>

    <div class="splash-progress-track" aria-hidden="true">
      <div class="splash-progress"></div>
    </div>

