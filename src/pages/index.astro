---
import ThemeToggle from '../components/ThemeToggle.astro';
// Splash: split-screen morphism, no BaseLayout, no Sanity. Analytics only.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Siryus Hub | Creative Media That Means Business</title>
    <meta
      name="description"
      content="Siryus Creative Media Ltd. Artist management, brand marketing, and creative production. Kigali, Nigeria, worldwide."
    />
    <link rel="canonical" href="https://www.siryushub.com/" />

    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Siryus Hub | Creative Media That Means Business"
    />
    <meta
      property="og:description"
      content="Artist management, brand marketing, and creative production for serious creatives."
    />
    <meta property="og:url" content="https://www.siryushub.com/" />
    <meta
      property="og:image"
      content="https://www.siryushub.com/images/logo/dark/siryus-logo-dark.png"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Siryus Hub | Creative Media That Means Business"
    />
    <meta
      name="twitter:description"
      content="Artist management, brand marketing, and creative production for serious creatives."
    />
    <meta
      name="twitter:image"
      content="https://www.siryushub.com/images/logo/dark/siryus-logo-dark.png"
    />

    <link
      rel="icon"
      type="image/x-icon"
      href="/images/logo/dark/favicon.ico"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/logo/dark/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/logo/dark/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/logo/dark/apple-touch-icon.png"
    />

    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />

    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/unbounded/v12/Yq6F-LOTXCb04q32xlpat-6uR42XTqtG67H244rNgQ.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/dmsans/v17/rP2Yp2ywxg089UriI5-g7M8btVsD8Ck0q7u0-K4.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700&family=Unbounded:wght@200;300;400;700;800;900&display=swap"
      rel="stylesheet"
    />

    <script
      is:inline
      defer
      src="https://www.googletagmanager.com/gtag/js?id=G-H882NL8BE3"
    ></script>
    <script is:inline defer>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-H882NL8BE3');
    </script>

    <style is:global>
      :root {
        --font-display: 'Unbounded', sans-serif;
        --font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI',
          sans-serif;
        --text-base: 1rem;
        --text-sm: 0.875rem;
        --brand-text-muted: #8b9098;
        --brand-accent: #d1df4b;
        --brand-on-accent-text: #0f1210;
        --splash-bg: #050505;
        --glass-border: rgba(245, 249, 233, 0.12);
        --glass-fill: rgba(255, 255, 255, 0.04);
        --glass-highlight: rgba(209, 223, 75, 0.15);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: var(--splash-bg);
        color: #f5f9e9;
      }

      @keyframes bgShift {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }

      @keyframes orbDrift {
        0%,
        100% {
          transform: translate(0, 0) scale(1);
        }
        33% {
          transform: translate(8%, -6%) scale(1.05);
        }
        66% {
          transform: translate(-6%, 4%) scale(0.98);
        }
      }

      @keyframes ripplePulse {
        0% {
          transform: translate(-50%, 48%) scale(0.92);
          opacity: 0.35;
        }
        50% {
          opacity: 0.12;
        }
        100% {
          transform: translate(-50%, 48%) scale(1.08);
          opacity: 0.35;
        }
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(28px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes glowPulse {
        0%,
        100% {
          box-shadow:
            0 0 22px rgba(209, 223, 75, 0.35),
            0 0 0 1px rgba(209, 223, 75, 0.2);
        }
        50% {
          box-shadow:
            0 0 48px rgba(209, 223, 75, 0.55),
            0 0 0 1px rgba(209, 223, 75, 0.35);
        }
      }

      @keyframes progressFill {
        from {
          width: 0%;
        }
        to {
          width: 100%;
        }
      }

      @keyframes phoneFloat {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-8px);
        }
      }

      .splash-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        background: linear-gradient(
          145deg,
          #050505 0%,
          #0a1004 35%,
          #050505 55%,
          #0a0e12 100%
        );
        background-size: 280% 280%;
        animation: bgShift 18s ease infinite;
      }

      .splash-glow-orbs {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }

      .splash-glow-orbs::before,
      .splash-glow-orbs::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.45;
        animation: orbDrift 14s ease-in-out infinite;
      }

      .splash-glow-orbs::before {
        width: min(55vw, 420px);
        height: min(55vw, 420px);
        background: radial-gradient(
          circle,
          rgba(209, 223, 75, 0.22) 0%,
          transparent 70%
        );
        top: 8%;
        right: 5%;
      }

      .splash-glow-orbs::after {
        width: min(45vw, 360px);
        height: min(45vw, 360px);
        background: radial-gradient(
          circle,
          rgba(80, 100, 120, 0.25) 0%,
          transparent 72%
        );
        bottom: 12%;
        left: -5%;
        animation-delay: -6s;
      }

      .splash-ripples {
        position: fixed;
        z-index: 1;
        left: 0;
        right: 0;
        bottom: 0;
        height: min(48vh, 420px);
        pointer-events: none;
        overflow: hidden;
      }

      .splash-ripples__origin {
        position: absolute;
        left: 72%;
        bottom: -8%;
        width: 140%;
        height: 85%;
        transform: translateX(-50%);
        opacity: 0.9;
      }

      .splash-ripples__ring {
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 120%;
        padding-bottom: 120%;
        border: 1px solid rgba(209, 223, 75, 0.07);
        border-radius: 50%;
        transform: translate(-50%, 48%);
        animation: ripplePulse 10s ease-in-out infinite;
      }

      .splash-ripples__ring:nth-child(2) {
        width: 95%;
        padding-bottom: 95%;
        animation-delay: -2.5s;
        border-color: rgba(245, 249, 233, 0.04);
      }

      .splash-ripples__ring:nth-child(3) {
        width: 72%;
        padding-bottom: 72%;
        animation-delay: -5s;
        border-color: rgba(209, 223, 75, 0.05);
      }

      .splash-ripples__ring:nth-child(4) {
        width: 50%;
        padding-bottom: 50%;
        animation-delay: -7.5s;
        border-color: rgba(245, 249, 233, 0.06);
      }

      .splash-liquid-shine {
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 90%;
        max-width: 520px;
        height: 120px;
        transform: translateX(-50%);
        background: linear-gradient(
          180deg,
          rgba(209, 223, 75, 0.08) 0%,
          transparent 85%
        );
        filter: blur(20px);
        border-radius: 50% 50% 0 0;
      }

      .splash-stage {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: center;
        min-height: 100dvh;
        min-height: 100vh;
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: clamp(4.5rem, 8vw, 5.5rem) clamp(1.25rem, 4vw, 2.5rem)
          calc(1.25rem + 3px);
      }

      .splash-left {
        text-align: left;
        position: relative;
        z-index: 2;
      }

      .splash-label {
        font-family: var(--font-display);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--brand-accent);
        margin: 0 0 1.5rem;
        opacity: 0;
        animation: fadeUp 0.75s ease forwards;
        animation-delay: 0.05s;
      }

      .splash-headline {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(2.75rem, 7.5vw, 6.25rem);
        line-height: 0.92;
        letter-spacing: -0.04em;
        text-transform: uppercase;
      }

      .splash-headline .line {
        display: block;
        opacity: 0;
        animation: fadeUp 0.88s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      .splash-headline .line--thin {
        font-weight: 200;
        color: rgba(245, 249, 233, 0.92);
      }

      .splash-headline .line--heavy {
        font-weight: 900;
        color: var(--brand-accent);
        text-shadow:
          0 0 60px rgba(209, 223, 75, 0.25),
          0 0 1px rgba(209, 223, 75, 0.8);
      }

      .splash-headline .line--glass {
        font-weight: 300;
        color: rgba(245, 249, 233, 0.55);
        position: relative;
        mix-blend-mode: plus-lighter;
      }

      .splash-headline .line:nth-child(1) {
        animation-delay: 0.15s;
      }

      .splash-headline .line:nth-child(2) {
        animation-delay: 0.42s;
      }

      .splash-headline .line:nth-child(3) {
        animation-delay: 0.68s;
      }

      .splash-headline .line--glass::after {
        content: attr(data-text);
        position: absolute;
        left: 0;
        top: 0;
        font-family: inherit;
        font-size: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
        font-weight: 300;
        color: rgba(245, 249, 233, 0.22);
        -webkit-mask-image: linear-gradient(
          105deg,
          transparent 15%,
          #fff 45%,
          #fff 62%,
          transparent 92%
        );
        mask-image: linear-gradient(
          105deg,
          transparent 15%,
          #fff 45%,
          #fff 62%,
          transparent 92%
        );
        pointer-events: none;
      }

      .splash-tagline {
        margin: 1.5rem 0 0;
        max-width: 28rem;
        font-family: var(--font-body);
        font-size: var(--text-base);
        line-height: 1.6;
        color: var(--brand-text-muted);
        opacity: 0;
        animation: fadeUp 0.72s ease forwards;
        animation-delay: 1.05s;
      }

      .splash-enter {
        margin-top: 1.75rem;
        appearance: none;
        border: none;
        cursor: pointer;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(0.9rem, 1.8vw, 1rem);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 1.05rem 2.35rem;
        border-radius: 9999px;
        background: var(--brand-accent);
        color: var(--brand-on-accent-text);
        opacity: 0;
        animation: fadeUp 0.65s ease forwards;
        animation-delay: 1.35s;
        animation-fill-mode: forwards;
        box-shadow: 0 0 24px rgba(209, 223, 75, 0.35);
      }

      .splash-enter:focus-visible {
        outline: 2px solid var(--brand-accent);
        outline-offset: 4px;
      }

      .splash-enter.is-visible {
        animation:
          fadeUp 0.65s ease forwards,
          glowPulse 2.2s ease infinite;
        animation-delay: 1.35s, 2.1s;
        animation-fill-mode: forwards, none;
      }

      /* Right column: glass phone */
      .splash-right {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 2;
        opacity: 0;
        animation: fadeUp 1s ease forwards;
        animation-delay: 0.35s;
        pointer-events: none;
      }

      .splash-phone-wrap {
        position: relative;
        width: min(100%, 300px);
        animation: phoneFloat 6s ease-in-out infinite;
        animation-delay: 1s;
      }

      .splash-phone {
        position: relative;
        border-radius: 36px;
        padding: 12px;
        background: linear-gradient(
          165deg,
          rgba(255, 255, 255, 0.14) 0%,
          rgba(255, 255, 255, 0.03) 40%,
          rgba(0, 0, 0, 0.35) 100%
        );
        box-shadow:
          0 32px 64px rgba(0, 0, 0, 0.65),
          0 0 0 1px rgba(255, 255, 255, 0.1) inset,
          0 -1px 0 rgba(209, 223, 75, 0.12) inset;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .splash-phone__notch {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        width: 28%;
        height: 22px;
        background: #0a0a0a;
        border-radius: 0 0 14px 14px;
        z-index: 3;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
      }

      .splash-phone__screen {
        position: relative;
        border-radius: 28px;
        overflow: hidden;
        aspect-ratio: 9 / 18.5;
        background: linear-gradient(
          165deg,
          #0d1208 0%,
          #050505 45%,
          #0a0f14 100%
        );
      }

      .splash-phone__screen::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(
          80% 55% at 50% 0%,
          rgba(209, 223, 75, 0.12) 0%,
          transparent 55%
        );
        pointer-events: none;
      }

      .splash-phone__content {
        position: absolute;
        inset: 0;
        padding: 2.25rem 1.35rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.85rem;
      }

      .splash-phone__logo {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(
          135deg,
          rgba(209, 223, 75, 0.35),
          rgba(255, 255, 255, 0.08)
        );
        border: 1px solid var(--glass-border);
        box-shadow:
          0 8px 24px rgba(0, 0, 0, 0.35),
          0 0 0 1px rgba(209, 223, 75, 0.12) inset;
        display: grid;
        place-items: center;
      }

      .splash-phone__logo svg {
        width: 28px;
        height: 28px;
        opacity: 0.95;
      }

      .splash-glass-card {
        width: 100%;
        padding: 1rem 0.85rem;
        border-radius: 18px;
        background: var(--glass-fill);
        border: 1px solid var(--glass-border);
        box-shadow:
          0 12px 40px rgba(0, 0, 0, 0.35),
          0 0 0 1px rgba(209, 223, 75, 0.06) inset;
        backdrop-filter: blur(22px) saturate(160%);
        -webkit-backdrop-filter: blur(22px) saturate(160%);
      }

      .splash-glass-card h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        color: #f5f9e9;
      }

      .splash-glass-card p {
        margin: 0.45rem 0 0;
        font-family: var(--font-body);
        font-size: 0.7rem;
        line-height: 1.45;
        color: rgba(139, 144, 152, 0.95);
      }

      .splash-phone__actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: 100%;
        margin-top: 0.25rem;
      }

      .splash-phone__pill {
        font-family: var(--font-body);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 0.55rem 0.75rem;
        border-radius: 999px;
        border: none;
        cursor: default;
      }

      .splash-phone__pill--lime {
        background: var(--brand-accent);
        color: var(--brand-on-accent-text);
        box-shadow: 0 4px 16px rgba(209, 223, 75, 0.25);
      }

      .splash-phone__pill--glass {
        background: rgba(255, 255, 255, 0.06);
        color: rgba(245, 249, 233, 0.85);
        border: 1px solid var(--glass-border);
      }

      .splash-phone__hint {
        font-family: var(--font-body);
        font-size: 0.6rem;
        color: rgba(139, 144, 152, 0.75);
        margin-top: auto;
        padding-top: 0.5rem;
      }

      .splash-footer-loc {
        position: fixed;
        z-index: 4;
        left: clamp(1rem, 3vw, 1.75rem);
        bottom: clamp(0.75rem, 2.5vw, 1.25rem);
        font-family: var(--font-body);
        font-size: 11px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(245, 249, 233, 0.28);
        pointer-events: none;
      }

      .splash-year {
        position: fixed;
        z-index: 0;
        right: clamp(0.5rem, 2vw, 1.25rem);
        bottom: clamp(0, 1vw, 0.5rem);
        font-family: var(--font-display);
        font-size: clamp(3.5rem, 11vw, 8rem);
        font-weight: 900;
        line-height: 1;
        color: rgba(209, 223, 75, 0.035);
        pointer-events: none;
        user-select: none;
      }

      .splash-nav {
        position: fixed;
        z-index: 5;
        top: clamp(1rem, 3vw, 1.5rem);
        right: clamp(1rem, 3vw, 1.5rem);
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-family: var(--font-body);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .splash-nav a {
        color: rgba(245, 249, 233, 0.42);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .splash-nav a:hover {
        color: rgba(245, 249, 233, 0.88);
      }

      .splash-nav a:focus-visible {
        outline: 1px solid var(--brand-accent);
        outline-offset: 4px;
        border-radius: 2px;
      }

      .splash-nav .sep {
        color: rgba(245, 249, 233, 0.18);
        user-select: none;
      }

      .splash-progress-track {
        position: fixed;
        z-index: 6;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3px;
        background: rgba(209, 223, 75, 0.08);
        pointer-events: none;
      }

      .splash-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        width: 0%;
        background: var(--brand-accent);
        animation: progressFill 12s linear forwards;
      }

      @media (max-width: 960px) {
        .splash-stage {
          grid-template-columns: 1fr;
          text-align: center;
          padding-top: clamp(5rem, 12vw, 6rem);
        }

        .splash-left {
          text-align: center;
        }

        .splash-tagline {
          margin-left: auto;
          margin-right: auto;
        }

        .splash-right {
          order: -1;
        }

        .splash-phone-wrap {
          width: min(260px, 72vw);
        }

        .splash-ripples__origin {
          left: 50%;
        }

        .splash-headline {
          font-size: clamp(2.35rem, 11vw, 4rem);
        }
      }

      @media (max-width: 768px) {
        .splash-nav {
          display: none;
        }
      }

      @media (max-width: 480px) {
        .splash-year {
          display: none;
        }

        .splash-tagline {
          font-size: var(--text-sm);
        }

        .splash-enter {
          width: 80%;
          max-width: 300px;
        }

        .splash-headline .line--glass::after {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .splash-bg,
        .splash-glow-orbs::before,
        .splash-glow-orbs::after,
        .splash-ripples__ring,
        .splash-phone-wrap {
          animation: none !important;
        }

        .splash-glow-orbs::before {
          top: 12%;
          right: 8%;
        }

        .splash-headline .line,
        .splash-label,
        .splash-tagline,
        .splash-enter,
        .splash-right {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }

        .splash-enter.is-visible {
          animation: none !important;
          box-shadow: 0 0 28px rgba(209, 223, 75, 0.4);
        }

        .splash-progress {
          animation-duration: 0.01ms !important;
        }
      }

      /* Light theme (ThemeToggle sets body.light-theme; tokens from ThemeToggle’s brand-tokens import) */
      body.light-theme {
        color: var(--brand-text);
      }

      body.light-theme .splash-bg {
        background: linear-gradient(
          145deg,
          #f5f4f0 0%,
          #ebe9e2 38%,
          #f8f7f3 58%,
          #e8e6df 100%
        );
      }

      body.light-theme .splash-glow-orbs::before {
        background: radial-gradient(
          circle,
          rgba(209, 223, 75, 0.35) 0%,
          transparent 70%
        );
      }

      body.light-theme .splash-glow-orbs::after {
        background: radial-gradient(
          circle,
