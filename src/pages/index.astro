---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';

const seo = {
  title: 'SIRYUS Artist Management | Supporting Independent Artists',
  description: 'SIRYUS Artist Management is a creative collective and artist management agency supporting independent artists through marketing, collaboration, and strategic career development.',
  path: '/',
};
---

<MainLayout seo={seo}>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-[#F5F9E9] via-[#D5DD85]/20 to-[#F5F9E9] overflow-hidden">
    <!-- Parallax Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div 
        class="parallax-layer absolute w-[600px] h-[600px] bg-[#D1DF4B]/10 rounded-full blur-3xl -top-40 -left-40"
        data-speed="0.3"
      ></div>
      <div 
        class="parallax-layer absolute w-[500px] h-[500px] bg-[#323836]/5 rounded-full blur-3xl -bottom-40 -right-40"
        data-speed="0.5"
      ></div>
      <div 
        class="parallax-layer absolute w-[400px] h-[400px] bg-[#D1DF4B]/8 rounded-full blur-2xl top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
        data-speed="0.7"
      ></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center fade-in-section">
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-[#1B1B1E] mb-6 leading-tight">
          Supporting Independent Artists in Building
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#323836] via-[#D1DF4B] to-[#323836]">
            Sustainable Creative Careers
          </span>
        </h1>
        
        <p class="text-lg sm:text-xl md:text-2xl text-[#323836] mb-8 max-w-3xl mx-auto">
          SIRYUS Artist Management is a creative collective and artist management agency that works with independent artists to develop their careers through strategy, collaboration, and opportunity.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <Button variant="primary" size="lg" href="/contact">
            Work With Us
          </Button>
          <Button variant="outline" size="lg" href="/projects">
            Explore Our Projects
          </Button>
        </div>

        <!-- Scroll Indicator -->
        <div class="mt-16">
          <a href="#about" class="inline-block animate-bounce">
            <svg class="w-6 h-6 text-[#949BA0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section id="about" class="py-16 lg:py-24 bg-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[#F5F9E9]/50 to-transparent pointer-events-none"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto fade-in-section">
        <SectionHeader 
          subtitle="About Us"
          title="About SIRYUS Artist Management"
          align="center"
        >
          <p slot="description">
            SIRYUS Artist Management, also known as SIRYUS A.M, is an artist management and marketing agency operating as part of a wider creative ecosystem. We work with independent artists and creative professionals to help them navigate the creative industry with clarity, structure, and long term vision.
          </p>
        </SectionHeader>

        <div class="text-center mt-8">
          <Button variant="secondary" href="/about">
            Learn More About Us
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview Section -->
  <section class="py-16 lg:py-24 bg-[#F5F9E9] relative">
    <div class="parallax-layer absolute top-0 right-0 w-64 h-64 bg-[#D1DF4B]/10 rounded-full blur-3xl" data-speed="0.4"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="fade-in-section">
        <SectionHeader 
          subtitle="What We Offer"
          title="Services for Independent Artists"
          align="center"
        >
          <p slot="description">
            We provide comprehensive support to help artists build sustainable careers in the creative industry.
          </p>
        </SectionHeader>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
          <Card variant="elevated" class="fade-in-section">
            <div class="p-6">
              <div class="w-12 h-12 bg-[#D1DF4B] rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-[#1B1B1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-[#1B1B1E] mb-2">Artist Management</h3>
              <p class="text-[#323836]">
                Strategic career guidance, opportunity sourcing, and professional representation for independent artists.
              </p>
            </div>
          </Card>

          <Card variant="elevated" class="fade-in-section">
            <div class="p-6">
              <div class="w-12 h-12 bg-[#D1DF4B] rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-[#1B1B1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-[#1B1B1E] mb-2">Marketing & Promotion</h3>
              <p class="text-[#323836]">
                Content creation, social media strategy, and digital marketing to grow your audience and visibility.
              </p>
            </div>
          </Card>

          <Card variant="elevated" class="fade-in-section">
            <div class="p-6">
              <div class="w-12 h-12 bg-[#D1DF4B] rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-[#1B1B1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-[#1B1B1E] mb-2">Community Building</h3>
              <p class="text-[#323836]">
                Connect with other creatives, collaborate on projects, and grow through our creative community.
              </p>
            </div>
          </Card>
        </div>

        <div class="text-center mt-12">
          <Button variant="primary" href="/services">
            View All Services
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Preview Section -->
  <section class="py-16 lg:py-24 bg-white relative overflow-hidden">
    <div class="parallax-layer absolute top-1/4 left-0 w-96 h-96 bg-[#323836]/5 rounded-full blur-3xl" data-speed="0.6"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="fade-in-section">
        <SectionHeader 
          subtitle="Our Work"
          title="Featured Projects & Campaigns"
          align="center"
        >
          <p slot="description">
            Explore some of our recent work with independent artists and creative projects.
          </p>
        </SectionHeader>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 max-w-5xl mx-auto">
          <Card variant="elevated" class="fade-in-section group cursor-pointer overflow-hidden">
            <div class="aspect-video bg-gradient-to-br from-[#D1DF4B] to-[#D5DD85] relative overflow-hidden">
              <div class="absolute inset-0 bg-[#323836]/20 group-hover:bg-[#323836]/10 transition-colors duration-300"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-4xl font-bold text-[#1B1B1E]/20">PROJECT 1</span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold text-[#1B1B1E] mb-2 group-hover:text-[#323836] transition-colors">
                Artist Campaign Name
              </h3>
              <p class="text-[#323836] mb-4">
                A comprehensive marketing campaign that helped an independent artist grow their audience by 300%.
              </p>
              <span class="text-sm font-medium text-[#D1DF4B]">View Project →</span>
            </div>
          </Card>

          <Card variant="elevated" class="fade-in-section group cursor-pointer overflow-hidden">
            <div class="aspect-video bg-gradient-to-br from-[#323836] to-[#1B1B1E] relative overflow-hidden">
              <div class="absolute inset-0 bg-[#D1DF4B]/10 group-hover:bg-[#D1DF4B]/20 transition-colors duration-300"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-4xl font-bold text-[#F5F9E9]/20">PROJECT 2</span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold text-[#1B1B1E] mb-2 group-hover:text-[#323836] transition-colors">
                Creative Collaboration
              </h3>
              <p class="text-[#323836] mb-4">
                A multi-artist collaboration that showcased the power of community and creative partnership.
              </p>
              <span class="text-sm font-medium text-[#D1DF4B]">View Project →</span>
            </div>
          </Card>
        </div>

        <div class="text-center mt-12">
          <Button variant="outline" href="/projects">
            View All Projects
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Community Section -->
  <section class="py-16 lg:py-24 bg-[#323836] text-[#F5F9E9] relative overflow-hidden">
    <div class="parallax-layer absolute bottom-0 right-0 w-96 h-96 bg-[#D1DF4B]/10 rounded-full blur-3xl" data-speed="0.5"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center fade-in-section">
        <span class="text-[#D1DF4B] font-semibold text-sm uppercase tracking-wider">Community</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mt-3 mb-6">
          Join Siryus Creative Hub
        </h2>
        <p class="text-lg text-[#D5DD85] mb-8">
          Siryus Creative Hub is our free community for independent creatives. Connect with other artists, share your work, collaborate on projects, and grow together.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/community">
            Join the Community
          </Button>
          <Button variant="ghost" size="lg" href="/community" class="text-[#F5F9E9] hover:text-[#D1DF4B] border-2 border-[#F5F9E9]/20 hover:border-[#D1DF4B]">
            Learn More
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Preview Section -->
  <section class="py-16 lg:py-24 bg-[#F5F9E9] relative">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="fade-in-section">
        <SectionHeader 
          subtitle="Insights & Tips"
          title="Latest from Our Blog"
          align="center"
        >
          <p slot="description">
            Advice, insights, and resources for independent artists navigating the creative industry.
          </p>
        </SectionHeader>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 max-w-6xl mx-auto">
          <Card variant="default" class="fade-in-section hover:shadow-lg transition-shadow duration-300">
            <div class="p-6">
              <span class="text-xs font-semibold text-[#949BA0] uppercase tracking-wider">Marketing</span>
              <h3 class="text-lg font-semibold text-[#1B1B1E] mt-2 mb-3">
                Building Your Artist Brand in 2024
              </h3>
              <p class="text-sm text-[#323836] mb-4">
                Essential strategies for independent artists to build a strong, authentic brand presence.
              </p>
              <a href="/blog/building-your-artist-brand" class="text-sm font-medium text-[#D1DF4B] hover:text-[#323836] transition-colors">
                Read More →
              </a>
            </div>
          </Card>

          <Card variant="default" class="fade-in-section hover:shadow-lg transition-shadow duration-300">
            <div class="p-6">
              <span class="text-xs font-semibold text-[#949BA0] uppercase tracking-wider">Industry</span>
              <h3 class="text-lg font-semibold text-[#1B1B1E] mt-2 mb-3">
                Navigating the Music Industry as an Independent Artist
              </h3>
              <p class="text-sm text-[#323836] mb-4">
                Key insights and practical advice for artists managing their own careers.
              </p>
              <a href="/blog/navigating-music-industry" class="text-sm font-medium text-[#D1DF4B] hover:text-[#323836] transition-colors">
                Read More →
              </a>
            </div>
          </Card>

          <Card variant="default" class="fade-in-section hover:shadow-lg transition-shadow duration-300">
            <div class="p-6">
              <span class="text-xs font-semibold text-[#949BA0] uppercase tracking-wider">Community</span>
              <h3 class="text-lg font-semibold text-[#1B1B1E] mt-2 mb-3">
                The Power of Creative Collaboration
              </h3>
              <p class="text-sm text-[#323836] mb-4">
                How collaboration can accelerate your creative growth and expand your reach.
              </p>
              <a href="/blog/power-of-collaboration" class="text-sm font-medium text-[#D1DF4B] hover:text-[#323836] transition-colors">
                Read More →
              </a>
            </div>
          </Card>
        </div>

        <div class="text-center mt-12">
          <Button variant="secondary" href="/blog">
            View All Articles
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-[#D1DF4B] via-[#D5DD85] to-[#D1DF4B] relative overflow-hidden">
    <div class="parallax-layer absolute top-0 left-0 w-full h-full bg-[#323836]/5" data-speed="0.2"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center fade-in-section">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#1B1B1E] mb-6">
          Ready to Take Your Career to the Next Level?
        </h2>
        <p class="text-lg text-[#323836] mb-8">
          Let's work together to build a sustainable, strategic approach to your creative career.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="secondary" size="lg" href="/contact">
            Get in Touch
          </Button>
          <Button variant="outline" size="lg" href="/about" class="border-[#323836] text-[#323836] hover:bg-[#323836] hover:text-[#D1DF4B]">
            Learn More About Us
          </Button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { createParallax, createFadeIn, createStaggeredFadeIn } from '../lib/utils/parallax';

  document.addEventListener('DOMContentLoaded', () => {
    // Apply parallax effects to background layers
    const parallaxLayers = document.querySelectorAll<HTMLElement>('.parallax-layer');
    parallaxLayers.forEach((layer) => {
      const speed = parseFloat(layer.dataset.speed || '0.5');
      createParallax({
        element: layer,
        speed: speed * 100, // Convert to pixel value
        direction: 'vertical',
      });
    });

    // Apply fade-in effects to sections
    const fadeInSections = document.querySelectorAll<HTMLElement>('.fade-in-section');
    fadeInSections.forEach((section, index) => {
      createFadeIn({
        element: section,
        threshold: 0.15,
        slideDirection: 'up',
        slideDistance: 40,
        delay: Math.min(index * 50, 200), // Stagger with max delay
      });
    });

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        if (targetId && targetId !== '#') {
          const targetElement = document.querySelector<HTMLElement>(targetId);
          if (targetElement) {
            const offset = 80; // Account for fixed header
            const targetPosition = targetElement.offsetTop - offset;
            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
          }
        }
      });
    });
  });
</script>
