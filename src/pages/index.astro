    <style is:global>
      :root {
        --font-display: 'Unbounded', sans-serif;
        --font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI',
          sans-serif;
        --text-base: 1rem;
        --text-sm: 0.875rem;
        --brand-text-muted: #8b9098;
        --brand-accent: #d1df4b;
        --brand-on-accent-text: #0f1210;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #050505;
        color: #f5f9e9;
      }

      @keyframes bgShift {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes glowPulse {
        0%,
        100% {
          box-shadow: 0 0 20px rgba(209, 223, 75, 0.3);
        }
        50% {
          box-shadow: 0 0 40px rgba(209, 223, 75, 0.6);
        }
      }

      @keyframes progressFill {
        from {
          width: 0%;
        }
        to {
          width: 100%;
        }
      }

      .splash-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        background: linear-gradient(
          135deg,
          #050505 0%,
          #0d1200 40%,
          #050505 70%,
          #111800 100%
        );
        background-size: 300% 300%;
        animation: bgShift 12s ease infinite;
      }

      .splash-stage {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: clamp(1.25rem, 4vw, 2.5rem);
        padding-bottom: calc(1rem + 3px);
      }

      .splash-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        max-width: min(100%, 56rem);
      }

      .splash-label {
        font-family: var(--font-display);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--brand-accent);
        margin: 0 0 1.75rem;
        opacity: 0;
        animation: fadeUp 0.75s ease forwards;
        animation-delay: 0.05s;
      }

      .splash-headline {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: clamp(3.5rem, 10vw, 7rem);
        line-height: 0.95;
        letter-spacing: -0.03em;
        color: #f5f9e9;
      }

      .splash-headline .line {
        display: block;
        opacity: 0;
        animation: fadeUp 0.85s ease forwards;
      }

      .splash-headline .line:nth-child(1) {
        animation-delay: 0.2s;
      }

      .splash-headline .line:nth-child(2) {
        color: var(--brand-accent);
        animation-delay: 0.5s;
      }

      .splash-headline .line:nth-child(3) {
        animation-delay: 0.8s;
      }

      .splash-tagline {
        margin: 1.75rem 0 0;
        max-width: 420px;
        font-family: var(--font-body);
        font-size: var(--text-base);
        line-height: 1.55;
        color: var(--brand-text-muted);
        text-align: center;
        opacity: 0;
        animation: fadeUp 0.7s ease forwards;
        animation-delay: 1.2s;
      }

      .splash-enter {
        margin-top: 1.75rem;
        appearance: none;
        border: none;
        cursor: pointer;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(0.95rem, 2.5vw, 1.05rem);
        letter-spacing: 0.04em;
        padding: 1rem 2.5rem;
        border-radius: 9999px;
        background: var(--brand-accent);
        color: var(--brand-on-accent-text);
        opacity: 0;
        animation: fadeUp 0.65s ease forwards;
        animation-delay: 1.6s;
        animation-fill-mode: forwards;
        box-shadow: 0 0 20px rgba(209, 223, 75, 0.3);
      }

      .splash-enter:focus-visible {
        outline: 2px solid var(--brand-accent);
        outline-offset: 3px;
      }

      .splash-enter.is-visible {
        animation:
          fadeUp 0.65s ease forwards,
          glowPulse 2s ease infinite;
        animation-delay: 1.6s, 2s;
        animation-fill-mode: forwards, none;
      }

      .splash-footer-loc {
        position: fixed;
        z-index: 2;
        left: clamp(1rem, 3vw, 1.75rem);
        bottom: clamp(0.75rem, 2.5vw, 1.25rem);
        font-family: var(--font-body);
        font-size: 11px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(245, 249, 233, 0.3);
        pointer-events: none;
      }

      .splash-year {
        position: fixed;
        z-index: 0;
        right: clamp(0.5rem, 2vw, 1.5rem);
        bottom: clamp(-0.5rem, 1vw, 0.25rem);
        font-family: var(--font-display);
        font-size: clamp(4rem, 12vw, 9rem);
        font-weight: 900;
        line-height: 1;
        color: rgba(209, 223, 75, 0.04);
        pointer-events: none;
        user-select: none;
      }

      .splash-nav {
        position: fixed;
        z-index: 3;
        top: clamp(1rem, 3vw, 1.5rem);
        right: clamp(1rem, 3vw, 1.5rem);
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-family: var(--font-body);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .splash-nav a {
        color: rgba(245, 249, 233, 0.45);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .splash-nav a:hover {
        color: rgba(245, 249, 233, 0.85);
      }

      .splash-nav a:focus-visible {
        outline: 1px solid var(--brand-accent);
        outline-offset: 4px;
        border-radius: 2px;
      }

      .splash-nav .sep {
        color: rgba(245, 249, 233, 0.2);
        user-select: none;
      }

      .splash-progress-track {
        position: fixed;
        z-index: 4;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3px;
        background: rgba(209, 223, 75, 0.08);
        pointer-events: none;
      }

      .splash-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        width: 0%;
        background: var(--brand-accent);
        animation: progressFill 5s linear forwards;
      }

      @media (max-width: 768px) {
        .splash-nav {
          display: none;
        }
      }

      @media (max-width: 480px) {
        .splash-year {
          display: none;
        }

        .splash-headline {
          font-size: clamp(2.8rem, 12vw, 4rem);
        }

        .splash-tagline {
          font-size: var(--text-sm);
        }

        .splash-enter {
          width: 80%;
          max-width: 320px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .splash-bg {
          animation: none;
          background-position: 50% 50%;
        }

        .splash-headline .line,
        .splash-label,
        .splash-tagline,
        .splash-enter {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }

        .splash-enter.is-visible {
          animation: none !important;
          box-shadow: 0 0 24px rgba(209, 223, 75, 0.35);
        }

        .splash-progress {
          animation-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
