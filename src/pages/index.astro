---
import EcosystemFooter from '../components/ecosystem/EcosystemFooter.astro'
import EcosystemGrid from '../components/ecosystem/EcosystemGrid.astro'
import EcosystemHeader from '../components/ecosystem/EcosystemHeader.astro'
import { ecosystemCards } from '../data/ecosystem'
import EcosystemLayout from '../layouts/EcosystemLayout.astro'

const title = 'SIRYUS | Four Creative Brands'
const description =
  'Meet the SIRYUS ecosystem: SIRYUS A.M, ARC. Creatives, PAVO, and SIGNAL. Choose the place that fits what you need.'
---

<EcosystemLayout title={title} description={description}>
  <div class="ecosystem-shell">
    <EcosystemHeader />

    <main id="main-content">
      <section class="ecosystem-hero" aria-labelledby="ecosystem-title">
        <h1 id="ecosystem-title">Ideas need the right home.</h1>
        <p class="ecosystem-hero__summary">
          SIRYUS brings together four distinct brands for artists, creators, and creative teams. Start with the one built for you.
        </p>
      </section>

      <EcosystemGrid cards={ecosystemCards} />
    </main>

    <EcosystemFooter />
  </div>
</EcosystemLayout>
