---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';

const seo = {
  title: 'SIRYUS Artist Management | Supporting Independent Artists',
  description: 'SIRYUS Artist Management is a creative collective and artist management agency supporting independent artists through marketing, collaboration, and strategic career development.',
  path: '/',
};
---

<MainLayout seo={seo}>
  <!-- Hero Section - Split Screen Design -->
  <section class="relative w-full min-h-screen flex items-center overflow-hidden bg-[#1B1B1E]">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-[#D1DF4B] rounded-full blur-[200px] animate-blob"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-[#D1DF4B] rounded-full blur-[200px] animate-blob animation-delay-2000"></div>
    </div>

    <div class="container max-w-[1600px] mx-auto px-6 lg:px-12 py-32 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left Content -->
        <div class="space-y-8">
          <div class="inline-block">
            <span class="text-[#D1DF4B] text-sm font-semibold tracking-[0.3em] uppercase">Artist Management</span>
          </div>
          
          <h1 class="text-[#F5F9E9] text-5xl md:text-7xl xl:text-8xl font-bold leading-[1.1] tracking-tight">
            Building
            <span class="block text-[#D1DF4B] italic font-light">Sustainable</span>
            Creative Careers
          </h1>
          
          <p class="text-[#949BA0] text-xl md:text-2xl leading-relaxed max-w-xl">
            We work with independent artists to develop strategic careers through collaboration, marketing, and opportunity creation.
          </p>

          <div class="flex flex-wrap gap-4 pt-4">
            <a href="/contact" class="group relative inline-flex items-center gap-3 bg-[#D1DF4B] text-[#1B1B1E] px-8 py-4 rounded-none font-semibold hover:bg-[#F5F9E9] transition-all duration-300">
              <span>Start Your Journey</span>
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
            <a href="#work" class="inline-flex items-center gap-3 border-2 border-[#D1DF4B] text-[#D1DF4B] px-8 py-4 rounded-none font-semibold hover:bg-[#D1DF4B] hover:text-[#1B1B1E] transition-all duration-300">
              View Our Work
            </a>
          </div>
        </div>

        <!-- Right Visual -->
        <div class="relative h-[600px] lg:h-[700px]">
          <div class="absolute inset-0 grid grid-cols-2 gap-6">
            <div class="space-y-6">
              <div class="aspect-square bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?w=600&h=600&fit=crop');"></div>
              <div class="aspect-[4/3] bg-[#323836] flex items-center justify-center text-[#D1DF4B] text-6xl font-bold">
                10+
                <span class="text-sm ml-2 mt-8">Artists</span>
              </div>
            </div>
            <div class="space-y-6 pt-24">
              <div class="aspect-[4/3] bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&h=400&fit=crop');"></div>
              <div class="aspect-square bg-[#D1DF4B]"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-[#949BA0]">
      <span class="text-xs tracking-wider">SCROLL</span>
      <div class="w-[1px] h-16 bg-[#949BA0] animate-scroll-line"></div>
    </div>
  </section>

  <!-- About Section - Asymmetric Layout -->
  <section id="about" class="relative w-full py-32 bg-[#F5F9E9]">
    <div class="container max-w-[1600px] mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-16">
        <div class="lg:col-span-5">
          <div class="sticky top-32">
            <span class="text-[#D1DF4B] text-sm font-semibold tracking-[0.3em] uppercase">Who We Are</span>
            <h2 class="text-[#1B1B1E] text-5xl md:text-6xl font-bold leading-tight mt-6 mb-8">
              SIRYUS Artist Management
            </h2>
            <div class="w-24 h-1 bg-[#D1DF4B]"></div>
          </div>
        </div>

        <div class="lg:col-span-7 space-y-16">
          <div class="prose prose-lg max-w-none">
            <p class="text-[#323836] text-2xl leading-relaxed">
              SIRYUS A.M is an artist management and marketing agency operating as part of a wider creative ecosystem, dedicated to supporting independent artists.
            </p>
            <p class="text-[#323836] text-xl leading-relaxed mt-8">
              We work with creative professionals to help them navigate the industry with clarity, structure, and long-term vision. Our approach combines strategic planning, marketing expertise, and community building.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8 pt-8">
            <div class="border-l-4 border-[#D1DF4B] pl-6">
              <div class="text-4xl font-bold text-[#1B1B1E] mb-2">10+</div>
              <div class="text-[#323836]">Artists Managed</div>
            </div>
            <div class="border-l-4 border-[#D1DF4B] pl-6">
              <div class="text-4xl font-bold text-[#1B1B1E] mb-2">50+</div>
              <div class="text-[#323836]">Projects Completed</div>
            </div>
            <div class="border-l-4 border-[#D1DF4B] pl-6">
              <div class="text-4xl font-bold text-[#1B1B1E] mb-2">5+</div>
              <div class="text-[#323836]">Years Experience</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section - Staggered Cards -->
  <section class="relative w-full py-32 bg-[#323836]">
    <div class="container max-w-[1600px] mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-16 mb-24">
        <div class="lg:col-span-5">
          <span class="text-[#D1DF4B] text-sm font-semibold tracking-[0.3em] uppercase">What We Do</span>
          <h2 class="text-[#F5F9E9] text-5xl md:text-6xl font-bold leading-tight mt-6">
            Services
          </h2>
          <div class="w-24 h-1 bg-[#D1DF4B] mt-8"></div>
        </div>
        <div class="lg:col-span-7 flex items-end">
          <p class="text-[#949BA0] text-xl leading-relaxed">
            We provide comprehensive support for independent artists, combining strategic planning with hands-on execution to help you build a sustainable creative career.
          </p>
        </div>
      </div>

      <div class="space-y-0">
        <!-- Service 1 -->
        <div class="group border-t border-[#949BA0]/20 py-12 lg:py-16 hover:border-[#D1DF4B] transition-all duration-500">
          <div class="grid lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-2">
              <div class="w-20 h-20 border-2 border-[#D1DF4B] flex items-center justify-center group-hover:bg-[#D1DF4B] transition-all duration-300">
                <svg class="w-10 h-10 text-[#D1DF4B] group-hover:text-[#323836] transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
            </div>
            <div class="lg:col-span-3">
              <h3 class="text-3xl font-bold text-[#F5F9E9]">Artist Management</h3>
            </div>
            <div class="lg:col-span-7">
              <p class="text-[#949BA0] text-lg leading-relaxed">
                Strategic career guidance, opportunity sourcing, and professional representation for independent artists. We handle the business so you can focus on creating.
              </p>
            </div>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="group border-t border-[#949BA0]/20 py-12 lg:py-16 hover:border-[#D1DF4B] transition-all duration-500">
          <div class="grid lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-2">
              <div class="w-20 h-20 border-2 border-[#D1DF4B] flex items-center justify-center group-hover:bg-[#D1DF4B] transition-all duration-300">
                <svg class="w-10 h-10 text-[#D1DF4B] group-hover:text-[#323836] transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
                </svg>
              </div>
            </div>
            <div class="lg:col-span-3">
              <h3 class="text-3xl font-bold text-[#F5F9E9]">Marketing & Promotion</h3>
            </div>
            <div class="lg:col-span-7">
              <p class="text-[#949BA0] text-lg leading-relaxed">
                Content creation, social media strategy, and digital marketing campaigns designed to grow your audience and increase engagement across platforms.
              </p>
            </div>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="group border-t border-[#949BA0]/20 py-12 lg:py-16 hover:border-[#D1DF4B] transition-all duration-500">
          <div class="grid lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-2">
              <div class="w-20 h-20 border-2 border-[#D1DF4B] flex items-center justify-center group-hover:bg-[#D1DF4B] transition-all duration-300">
                <svg class="w-10 h-10 text-[#D1DF4B] group-hover:text-[#323836] transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              </div>
            </div>
            <div class="lg:col-span-3">
              <h3 class="text-3xl font-bold text-[#F5F9E9]">Community Building</h3>
            </div>
            <div class="lg:col-span-7">
              <p class="text-[#949BA0] text-lg leading-relaxed">
                Connect with other creatives and grow through our collaborative network. Access exclusive opportunities and partnerships within the SIRYUS ecosystem.
              </p>
            </div>
          </div>
        </div>

        <!-- Service 4 -->
        <div class="group border-t border-[#949BA0]/20 py-12 lg:py-16 hover:border-[#D1DF4B] transition-all duration-500">
          <div class="grid lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-2">
              <div class="w-20 h-20 border-2 border-[#D1DF4B] flex items-center justify-center group-hover:bg-[#D1DF4B] transition-all duration-300">
                <svg class="w-10 h-10 text-[#D1DF4B] group-hover:text-[#323836] transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                </svg>
              </div>
            </div>
            <div class="lg:col-span-3">
              <h3 class="text-3xl font-bold text-[#F5F9E9]">Creative Strategy</h3>
            </div>
            <div class="lg:col-span-7">
              <p class="text-[#949BA0] text-lg leading-relaxed">
                Develop clear vision and actionable plans for your creative career. We help you define goals, identify opportunities, and create roadmaps for long-term success.
              </p>
            </div>
          </div>
        </div>

        <!-- Service 5 -->
        <div class="group border-t border-[#949BA0]/20 py-12 lg:py-16 hover:border-[#D1DF4B] transition-all duration-500">
          <div class="grid lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-2">
              <div class="w-20 h-20 border-2 border-[#D1DF4B] flex items-center justify-center group-hover:bg-[#D1DF4B] transition-all duration-300">
                <svg class="w-10 h-10 text-[#D1DF4B] group-hover:text-[#323836] transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
            </div>
            <div class="lg:col-span-3">
              <h3 class="text-3xl font-bold text-[#F5F9E9]">Analytics & Growth</h3>
            </div>
            <div class="lg:col-span-7">
              <p class="text-[#949BA0] text-lg leading-relaxed">
                Data-driven insights to optimize your reach and engagement. Track performance metrics, understand your audience, and make informed decisions about your career.
              </p>
            </div>
          </div>
        </div>

        <!-- Service 6 -->
        <div class="group border-t border-b border-[#949BA0]/20 py-12 lg:py-16 hover:border-[#D1DF4B] transition-all duration-500">
          <div class="grid lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-2">
              <div class="w-20 h-20 border-2 border-[#D1DF4B] flex items-center justify-center group-hover:bg-[#D1DF4B] transition-all duration-300">
                <svg class="w-10 h-10 text-[#D1DF4B] group-hover:text-[#323836] transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                </svg>
              </div>
            </div>
            <div class="lg:col-span-3">
              <h3 class="text-3xl font-bold text-[#F5F9E9]">Brand Development</h3>
            </div>
            <div class="lg:col-span-7">
              <p class="text-[#949BA0] text-lg leading-relaxed">
                Build a strong, authentic brand that resonates with your audience. From visual identity to messaging strategy, we help you create a cohesive brand presence.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section - Magazine Style -->
  <section id="work" class="relative w-full py-32 bg-[#F5F9E9]">
    <div class="container max-w-[1600px] mx-auto px-6 lg:px-12">
      <div class="flex justify-between items-end mb-20">
        <div>
          <span class="text-[#D1DF4B] text-sm font-semibold tracking-[0.3em] uppercase">Featured Work</span>
          <h2 class="text-[#1B1B1E] text-5xl md:text-6xl font-bold leading-tight mt-6">
            Recent Projects
          </h2>
        </div>
        <a href="/projects" class="hidden md:flex items-center gap-2 text-[#323836] font-semibold hover:text-[#D1DF4B] transition-colors">
          View All
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <div class="space-y-32">
        <!-- Project 1 -->
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="aspect-[4/3] bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=1200&h=900&fit=crop');"></div>
          <div class="space-y-6">
            <span class="text-[#D1DF4B] text-sm font-semibold tracking-wider">MARKETING CAMPAIGN</span>
            <h3 class="text-4xl md:text-5xl font-bold text-[#1B1B1E]">Independent Artist Growth</h3>
            <p class="text-[#323836] text-lg leading-relaxed">
              A comprehensive campaign that helped an emerging artist grow their audience by 300% through strategic social media marketing and community engagement.
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="px-4 py-2 bg-[#D1DF4B] text-[#1B1B1E] text-sm font-semibold">Social Media</span>
              <span class="px-4 py-2 bg-[#D1DF4B] text-[#1B1B1E] text-sm font-semibold">Content Strategy</span>
              <span class="px-4 py-2 bg-[#D1DF4B] text-[#1B1B1E] text-sm font-semibold">Analytics</span>
            </div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6 lg:order-1">
            <span class="text-[#D1DF4B] text-sm font-semibold tracking-wider">COLLABORATION</span>
            <h3 class="text-4xl md:text-5xl font-bold text-[#1B1B1E]">Multi-Artist Showcase</h3>
            <p class="text-[#323836] text-lg leading-relaxed">
              Curated collaboration bringing together 15 independent artists for a successful digital showcase event, fostering community and creative partnerships.
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="px-4 py-2 bg-[#D1DF4B] text-[#1B1B1E] text-sm font-semibold">Event Planning</span>
              <span class="px-4 py-2 bg-[#D1DF4B] text-[#1B1B1E] text-sm font-semibold">Artist Relations</span>
              <span class="px-4 py-2 bg-[#D1DF4B] text-[#1B1B1E] text-sm font-semibold">Community</span>
            </div>
          </div>
          <div class="aspect-[4/3] bg-cover bg-center lg:order-2" style="background-image: url('https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?w=1200&h=900&fit=crop');"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section - Full Width -->
  <section class="relative w-full py-32 bg-[#D1DF4B] overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-0 w-[600px] h-[600px] bg-[#1B1B1E] rounded-full blur-[150px]"></div>
      <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-[#1B1B1E] rounded-full blur-[150px]"></div>
    </div>

    <div class="container max-w-[1400px] mx-auto px-6 lg:px-12 relative z-10">
      <div class="text-center space-y-8">
        <h2 class="text-[#1B1B1E] text-5xl md:text-7xl font-bold leading-tight">
          Ready to Build Your
          <span class="block italic font-light">Creative Career?</span>
        </h2>
        <p class="text-[#323836] text-xl md:text-2xl max-w-3xl mx-auto leading-relaxed">
          Let's work together to create a strategic, sustainable approach to your artistic journey.
        </p>
        <div class="flex flex-wrap gap-4 justify-center pt-8">
          <a href="/contact" class="inline-flex items-center gap-3 bg-[#1B1B1E] text-[#D1DF4B] px-12 py-5 rounded-none font-bold text-lg hover:bg-[#323836] transition-all duration-300">
            Get Started
          </a>
          <a href="/about" class="inline-flex items-center gap-3 border-2 border-[#1B1B1E] text-[#1B1B1E] px-12 py-5 rounded-none font-bold text-lg hover:bg-[#1B1B1E] hover:text-[#D1DF4B] transition-all duration-300">
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(20px, -50px) scale(1.1); }
    50% { transform: translate(-20px, 20px) scale(0.9); }
    75% { transform: translate(50px, 50px) scale(1.05); }
  }

  @keyframes scroll-line {
    0% { height: 0; }
    50% { height: 64px; }
    100% { height: 0; }
  }

  .animate-blob {
    animation: blob 20s ease-in-out infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animate-scroll-line {
    animation: scroll-line 2s ease-in-out infinite;
  }
</style>

<script>
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('href');
      if (targetId && targetId !== '#') {
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });

  // Parallax effect on scroll
  window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;
    const parallaxElements = document.querySelectorAll('[data-parallax]');
    
    parallaxElements.forEach(el => {
      const speed = el.getAttribute('data-parallax') || 0.5;
      el.style.transform = `translateY(${scrolled * speed}px)`;
    });
  });
</script>

<MainLayout seo={seo}>
  <div class="w-full">
    <!-- Hero Section - Full Width Centered with Fixed Background -->
    <section class="relative w-full flex items-center justify-center min-h-screen overflow-hidden pt-24 md:pt-32 pb-20 md:pb-32">
      <!-- Fixed Background Image -->
      <div class="absolute inset-0 bg-cover bg-center bg-fixed" style="background-image: linear-gradient(rgba(245, 249, 233, 0.9), rgba(255, 255, 255, 0.85)), url('https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=1920&h=1080&fit=crop'); background-attachment: fixed;"></div>
      
      <!-- Parallax Background Elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <!-- Morphing Blobs -->
        <div 
          class="parallax-slow absolute w-96 h-96 bg-[#D1DF4B]/20 rounded-full blur-3xl top-20 -left-20 morph-animation float-animation"
