---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';

const seo = {
  title: 'SIRYUS Artist Management | Supporting Independent Artists',
  description: 'SIRYUS Artist Management is a creative collective and artist management agency supporting independent artists through marketing, collaboration, and strategic career development.',
  path: '/',
};
---

<MainLayout seo={seo}>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100 overflow-hidden">
    <!-- Parallax Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="parallax-bg absolute w-96 h-96 bg-gray-900/5 rounded-full blur-3xl -top-20 -left-20"></div>
      <div class="parallax-bg absolute w-96 h-96 bg-gray-900/5 rounded-full blur-3xl -bottom-20 -right-20" data-speed="0.5"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6 leading-tight">
          Supporting Independent Artists in Building
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-900 to-gray-600">
            Sustainable Creative Careers
          </span>
        </h1>
        
        <p class="text-lg sm:text-xl md:text-2xl text-gray-600 mb-8 max-w-3xl mx-auto">
          SIRYUS Artist Management is a creative collective and artist management agency that works with independent artists to develop their careers through strategy, collaboration, and opportunity.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <Button variant="primary" size="lg" href="/contact">
            Work With Us
          </Button>
          <Button variant="outline" size="lg" href="/projects">
            Explore Our Projects
          </Button>
        </div>

        <!-- Scroll Indicator -->
        <div class="mt-16">
          <a href="#about" class="inline-block animate-bounce">
            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section id="about" class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <SectionHeader 
          subtitle="About Us"
          title="About SIRYUS Artist Management"
          align="center"
        >
          <p slot="description">
            SIRYUS Artist Management, also known as SIRYUS A.M, is an artist management and marketing agency operating as part of a wider creative ecosystem. We work with independent artists and creative professionals to help them navigate the creative industry with clarity, structure, and long term vision.
          </p>
        </SectionHeader>

        <div class="text-center mt-8">
          <Button variant="secondary" href="/about">
            Learn More About Us
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview Section -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader 
        subtitle="What We Do"
        title="Our Services"
        align="center"
      >
        <p slot="description">
          We provide focused services designed to support independent artists at different stages of their creative journey.
        </p>
      </SectionHeader>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 mt-12">
        <Card variant="bordered" class="hover:shadow-lg transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-gray-900 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Artist Management</h3>
            <p class="text-gray-600">Professional career strategy and artistic direction</p>
          </div>
        </Card>

        <Card variant="bordered" class="hover:shadow-lg transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-gray-900 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Marketing & Promotion</h3>
            <p class="text-gray-600">Strategic campaigns that align with your goals</p>
          </div>
        </Card>

        <Card variant="bordered" class="hover:shadow-lg transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-gray-900 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Distribution Guidance</h3>
            <p class="text-gray-600">Navigate rights ownership and revenue structures</p>
          </div>
        </Card>

        <Card variant="bordered" class="hover:shadow-lg transition-shadow">
          <div class="text-center">
            <div class="w-12 h-12 bg-gray-900 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Creative Development</h3>
            <p class="text-gray-600">Workshops, resources, and skill development</p>
          </div>
        </Card>
      </div>

      <div class="text-center mt-12">
        <Button variant="primary" href="/services">
          View All Services
        </Button>
      </div>
    </div>
  </section>

  <!-- Projects Preview Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader 
        subtitle="Our Work"
        title="Creative Projects and Initiatives"
        align="center"
      >
        <p slot="description">
          Alongside our management and marketing work, we develop creative projects that bring artists together, encourage collaboration, and produce tangible creative output.
        </p>
      </SectionHeader>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
        <Card variant="elevated" padding="none" class="overflow-hidden group">
          <div class="h-48 bg-gradient-to-br from-gray-900 to-gray-700"></div>
          <div class="p-6">
            <span class="inline-block px-3 py-1 bg-green-100 text-green-800 text-xs font-medium rounded-full mb-3">
              Active
            </span>
            <h3 class="text-xl font-semibold mb-2">Indiba Project Series</h3>
            <p class="text-gray-600 mb-4">
              A collaborative music initiative bringing together independent artists to create and release curated projects.
            </p>
            <Button variant="ghost" class="group-hover:translate-x-1 transition-transform">
              Learn More →
            </Button>
          </div>
        </Card>

        <Card variant="elevated" padding="none" class="overflow-hidden group">
          <div class="h-48 bg-gradient-to-br from-gray-800 to-gray-600"></div>
          <div class="p-6">
            <span class="inline-block px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-medium rounded-full mb-3">
              Coming Soon
            </span>
            <h3 class="text-xl font-semibold mb-2">The Abditory Sessions</h3>
            <p class="text-gray-600 mb-4">
              An audiovisual project focused on storytelling, creative process, and artistic expression.
            </p>
            <Button variant="ghost" class="group-hover:translate-x-1 transition-transform">
              Learn More →
            </Button>
          </div>
        </Card>

        <Card variant="elevated" padding="none" class="overflow-hidden group">
          <div class="h-48 bg-gradient-to-br from-gray-700 to-gray-500"></div>
          <div class="p-6">
            <span class="inline-block px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-medium rounded-full mb-3">
              Coming Soon
            </span>
            <h3 class="text-xl font-semibold mb-2">Apartment Sessions</h3>
            <p class="text-gray-600 mb-4">
              Live performance and recording concept showcasing artists in intimate and authentic environments.
            </p>
            <Button variant="ghost" class="group-hover:translate-x-1 transition-transform">
              Learn More →
            </Button>
          </div>
        </Card>
      </div>

      <div class="text-center mt-12">
        <Button variant="primary" href="/projects">
          View All Projects
        </Button>
      </div>
    </div>
  </section>

  <!-- Community Preview Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-gray-900 to-gray-800 text-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-sm font-medium text-gray-300 uppercase tracking-wider mb-2">
          Community
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
          The Siryus Creative Hub
        </h2>
        <p class="text-lg md:text-xl text-gray-300 mb-8">
          The Siryus Creative Hub is the community division of SIRYUS Artist Management. It exists to connect independent artists and creative professionals across regions and disciplines, creating opportunities for collaboration and shared growth.
        </p>
        <Button variant="outline" size="lg" href="/community" class="border-white text-white hover:bg-white hover:text-gray-900">
          Join the Community
        </Button>
      </div>
    </div>
  </section>

  <!-- Blog Preview Section -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader 
        subtitle="Insights"
        title="Latest from the Blog"
        align="center"
      >
        <p slot="description">
          Practical insights, industry knowledge, and reflections for independent creatives.
        </p>
      </SectionHeader>

      <div class="flex justify-center mt-12">
        <Button variant="primary" href="/blog">
          Visit Blog
        </Button>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-white border-t border-gray-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
          Ready to Work Together?
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          Whether you're an artist looking for management, a creative seeking collaboration, or an organization interested in partnership, we'd love to hear from you.
        </p>
        <Button variant="primary" size="lg" href="/contact">
          Get in Touch
        </Button>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  // Simple parallax effect
  const parallaxElements = document.querySelectorAll('.parallax-bg');
  
  window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;
    
    parallaxElements.forEach((el) => {
      const speed = parseFloat(el.getAttribute('data-speed') || '0.3');
      const yPos = -(scrolled * speed);
      (el as HTMLElement).style.transform = `translateY(${yPos}px)`;
    });
  });
</script>
