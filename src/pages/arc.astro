      content="ARC. is a community for independent Christian creatives across music, film, poetry, dance, and design. Find structure, belonging, and room to grow. An initiative of Siryus Creative Media Ltd."
    />
    <meta name="twitter:image" content="https://www.siryushub.com/arc/arc-logo.png" />
    <link rel="canonical" href="https://www.siryushub.com/arc" />
