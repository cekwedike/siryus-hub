---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Siryus Hub and SIRYUS A.M for inquiries, collaborations, and support."
>
  <h1>Contact</h1>
  <p class="marketing-lede">
    Reach out for management, marketing, partnerships, or general questions. We read every message and respond as soon as
    we can.
  </p>

  <p>
    <strong>Email:</strong>
    <a href="mailto:management@siryushub.com">management@siryushub.com</a>
  </p>

  <h2>Send a message</h2>
  <form id="contact-form" class="contact-form morph-neu-stack" novalidate>
    <label class="contact-label">
      Name
      <input type="text" name="name" autocomplete="name" class="contact-input morph-neu-input" placeholder="Your name" required />
    </label>
    <label class="contact-label">
      Email
      <input type="email" name="email" autocomplete="email" class="contact-input morph-neu-input" placeholder="you@example.com" required />
    </label>
    <label class="contact-label">
      Message
      <textarea name="message" class="contact-textarea morph-neu-textarea" rows="5" placeholder="How can we help?" required></textarea>
    </label>
    <p class="contact-note">
      Submitting opens your email app with a draft. For embedded forms, connect a backend or form provider in production.
    </p>
    <button type="submit" class="contact-submit morph-neu-btn">Send via email</button>
  </form>
</BaseLayout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 28rem;
    margin-top: 1rem;
  }

  .contact-label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #f5f9e9;
  }

  .contact-input,
  .contact-textarea {
    padding: 0;
  }

  .contact-input:focus,
  .contact-textarea:focus {
    outline: none;
  }

  .contact-note {
    font-size: 0.85rem;
    color: #949ba0;
    margin: 0;
  }

  .contact-submit {
    align-self: flex-start;
  }


</style>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    const fd = new FormData(form);
    const name = String(fd.get('name') ?? '').trim();
    const email = String(fd.get('email') ?? '').trim();
    const message = String(fd.get('message') ?? '').trim();
    const subject = encodeURIComponent(`Siryus Hub inquiry from ${name}`);
    const body = encodeURIComponent(`From: ${name} <${email}>\n\n${message}`);
    window.location.href = `mailto:management@siryushub.com?subject=${subject}&body=${body}`;
  });
</script>
