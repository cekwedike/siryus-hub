---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Brief"
  description="How to brief SIRYUS on a new project."
>
  <h1>Project brief</h1>
  <p class="marketing-lede">A strong brief saves time and unlocks better work.</p>
  <h2>Include</h2>
  <ul>
    <li>Goal and audience</li>
    <li>Timeline and budget range</li>
    <li>References you love (and what to avoid)</li>
    <li>Deliverables and formats</li>
  </ul>
  <p><a href="/contact">Send it through contact</a> and we will respond.</p>
</BaseLayout>
