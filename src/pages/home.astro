---
// Home Page - Main homepage with full-screen parallax sections
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Sidebar from '../components/Sidebar.astro';
import HeroSection from '../components/HeroSection.astro';
import SiryusHubSection from '../components/SiryusHubSection.astro';
import ExploreSection from '../components/ExploreSection.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/brand-tokens.css';
import '../styles/morphism.css';
---

<!DOCTYPE html>
<html lang="en" class="layout-html">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <ClientRouter />
  <title>Siryus Hub - Where Creatives Come to Build</title>

  <meta
    name="description"
    content="Artist management, brand marketing and creative production under one roof. Siryus Creative Media Ltd works with independent artists and brands across Africa."
  />
  <link rel="canonical" href="https://www.siryushub.com/home" />

  <meta property="og:title" content="Siryus Hub - Where Creatives Come to Build" />
  <meta
    property="og:description"
    content="Artist management, brand marketing and creative production under one roof. Siryus Creative Media Ltd works with independent artists and brands across Africa."
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.siryushub.com/home" />
  <meta
    property="og:image"
    content="https://www.siryushub.com/images/logo/dark/siryus-logo-dark.png"
  />
  <meta property="og:site_name" content="Siryus Hub" />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Siryus Hub - Where Creatives Come to Build" />
  <meta
    name="twitter:description"
    content="Artist management, brand marketing and creative production under one roof. Siryus Creative Media Ltd works with independent artists and brands across Africa."
  />
  <meta name="twitter:image" content="https://www.siryushub.com/images/logo/dark/siryus-logo-dark.png" />

  <script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Siryus Creative Media Ltd",
  "alternateName": "SIRYUS A.M",
  "url": "https://www.siryushub.com",
  "logo": "https://www.siryushub.com/images/logo/dark/siryus-logo-dark.png",
  "description": "Artist management, brand marketing and creative production from Kigali, Rwanda.",
  "email": "management@siryushub.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Kigali",
    "addressCountry": "RW"
  },
  "sameAs": [
    "https://www.instagram.com/siryus_hq",
    "https://linktr.ee/siryus_hq"
  ]
}
  </script>

  <script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Siryus Hub",
  "url": "https://www.siryushub.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.siryushub.com/blog?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
  </script>

  <!-- Favicons (match BaseLayout / index — /favicon.svg is not in public) -->
  <link rel="icon" type="image/x-icon" href="/images/logo/dark/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logo/dark/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/logo/dark/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/logo/dark/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Navigation -->
  <Navigation />
  
  <!-- Sidebar Menu -->
  <Sidebar />
  
  <!-- Main Content -->
  <main class="main-content" id="main-content">
    <HeroSection />
    <SiryusHubSection />
    <ExploreSection />
  </main>
  
  <!-- Footer -->
  <Footer />

  <style>
    /* Global Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      /* Brand Colors */
      --color-primary: #D1DF4B;
      --color-primary-light: #D5DD85;
      --color-background: #050505;
      --color-elevated: #323836;
      --color-text-primary: #F5F9E9;
      --color-text-muted: #949BA0;
      
      /* Spacing (8pt Grid) */
      --space-xs: 4px;
      --space-sm: 8px;
      --space-md: 16px;
      --space-lg: 24px;
      --space-xl: 32px;
      --space-2xl: 48px;
      --space-3xl: 64px;
    }

    html.layout-html {
      scroll-behavior: smooth;
      overflow-x: hidden;
      overflow-x: clip;
      width: 100%;
      max-width: 100vw;
    }

    body {
      font-family: var(--font-body);
      background: var(--brand-gradient-page);
      background-color: var(--brand-bg-base, var(--color-background));
      color: var(--color-text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      overflow-x: clip;
      width: 100%;
      max-width: 100vw;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .main-content {
      position: relative;
      z-index: 1;
      overflow-x: hidden;
      overflow-x: clip;
      max-width: 100%;
      min-width: 0;
    }

    section {
      max-width: 100%;
      overflow-x: hidden;
    }

    /* Smooth Scrolling Container */
    @supports (scroll-behavior: smooth) {
      html.layout-html {
        scroll-behavior: smooth;
      }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 10px;
    }

    ::-webkit-scrollbar-track {
      background: #050505;
    }

    ::-webkit-scrollbar-thumb {
      background: #323836;
      border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #D1DF4B;
    }

    /* Selection */
    ::selection {
      background: rgba(209, 223, 75, 0.3);
      color: #F5F9E9;
    }

    /* Focus Styles */
    *:focus-visible {
      outline: 2px solid #D1DF4B;
      outline-offset: 2px;
    }

    /* Parallax Optimization */
    [class*="parallax-"] {
      will-change: transform;
      backface-visibility: hidden;
      perspective: 1000px;
    }

    /* Light Theme Styles - global so body/sections in child components match */

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }

      html.layout-html {
        scroll-behavior: auto;
      }
      
      [class*="parallax-"] {
        transform: none !important;
        will-change: auto !important;
      }
    }

    /* Loading State */
    body.loading {
      overflow: hidden;
    }

    /* Print Styles */
    @media print {
      body {
        background: white;
        color: black;
      }
    }
  </style>

  <style is:global>
    body.light-theme {
      --color-background: #f5f4f0;
      --color-elevated: #ffffff;
      --color-text-primary: #0a0a0a;
      --color-text-muted: #0a0a0a;
      background: linear-gradient(180deg, #fcfcfa 0%, #f5f4f0 42%, #ebe9e2 100%);
      color: var(--color-text-primary);
    }

    body.light-theme .hero-section,
    body.light-theme .explore {
      background: transparent;
    }

    body.light-theme ::-webkit-scrollbar-track {
      background: #f0f1ee;
    }

    body.light-theme ::-webkit-scrollbar-thumb {
      background: #2a2a2a;
    }

    body.light-theme ::-webkit-scrollbar-thumb:hover {
      background: #0a0a0a;
    }

    body.light-theme ::selection {
      background: rgba(209, 223, 75, 0.35);
      color: #0a0a0a;
    }
  </style>

  <script>
    // ===== PARALLAX (damped, section-relative) =====
    function initParallax() {
      const parallaxElements = document.querySelectorAll('[class*="parallax-"]');
      const elementData = Array.from(parallaxElements).map((element) => ({
        element: element as HTMLElement,
        isSlow: element.classList.contains('parallax-slow'),
        isNormal: element.classList.contains('parallax-normal'),
        isFast: element.classList.contains('parallax-fast'),
      }));

      function updateParallax() {
        const vh = window.innerHeight;

        elementData.forEach(({ element, isSlow, isNormal, isFast }) => {
          const section = element.closest('section');
          if (!section) {
            element.style.transform = '';
            return;
          }
          const rect = section.getBoundingClientRect();
          if (rect.bottom < -80 || rect.top > vh + 80) {
            element.style.transform = '';
            return;
          }
          const centerY = rect.top + rect.height / 2;
          const norm = (centerY - vh / 2) / vh;
          let mult = 0.14;
          if (isSlow) mult = 0.2;
          if (isNormal) mult = 0.17;
          if (isFast) mult = 0.11;
          const y = -norm * 40 * mult;
          const clamped = Math.max(-28, Math.min(28, y));
          element.style.transform = `translate3d(0, ${clamped}px, 0)`;
        });
      }

      let ticking = false;
      function requestTick() {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateParallax();
            ticking = false;
          });
          ticking = true;
        }
      }

      window.addEventListener('scroll', requestTick, { passive: true });
      updateParallax();

      let resizeTimeout: ReturnType<typeof globalThis.setTimeout> | undefined;
      window.addEventListener(
        'resize',
        () => {
          if (resizeTimeout !== undefined) globalThis.clearTimeout(resizeTimeout);
          resizeTimeout = globalThis.setTimeout(() => updateParallax(), 150);
        },
        { passive: true }
      );
    }

    // Smooth Scroll to Sections
    function initSmoothScroll() {
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
          const href = this.getAttribute('href');
          
          // Ignore empty hash or null
          if (!href || href === '#') return;
          
          e.preventDefault();
          
          const targetId = href.substring(1);
          const targetElement = document.getElementById(targetId);
          
          if (targetElement) {
            const offsetTop = targetElement.offsetTop - 80; // Account for fixed nav
            
            window.scrollTo({
              top: offsetTop,
              behavior: 'smooth'
            });
          }
        });
      });
    }

    // Intersection Observer for Section Animations
    function initSectionAnimations() {
      const sections = document.querySelectorAll('section[data-section]');
      
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, observerOptions);
      
      sections.forEach(section => {
        observer.observe(section);
      });
    }

    // Active Nav Link
    function updateActiveNavLink() {
      const sections = document.querySelectorAll('section[id]');
      const scrollY = window.scrollY + 100;
      
      sections.forEach(section => {
        const sectionTop = (section as HTMLElement).offsetTop;
        const sectionHeight = (section as HTMLElement).offsetHeight;
        const sectionId = section.getAttribute('id');
        
        if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
          // Update sidebar menu items if needed
          document.querySelectorAll('.menu-item').forEach(item => {
            const link = item.querySelector('a');
            if (link && link.getAttribute('href') === `#${sectionId}`) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
        }
      });
    }

    // Newsletter Form Handler
    function initNewsletterForm() {
      const form = document.querySelector('.newsletter-form');
      
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const input = form.querySelector('.newsletter-input') as HTMLInputElement;
          if (!input) return;
          
          const email = input.value;
          
          // TODO: Implement newsletter subscription API call
          console.log('Newsletter subscription:', email);
          
          // Show success message (placeholder)
          alert('Thank you for subscribing!');
          input.value = '';
        });
      }
    }

    // Page Load Animation
    function initPageLoad() {
      document.body.classList.add('loading');
      
      window.addEventListener('load', () => {
        setTimeout(() => {
          document.body.classList.remove('loading');
        }, 300);
      });
    }

    // Initialize all features
    function init() {
      initPageLoad();
      initParallax();
      initSmoothScroll();
      initSectionAnimations();
      initNewsletterForm();
      
      // Update active nav on scroll
      window.addEventListener('scroll', () => {
        updateActiveNavLink();
      });
      
      // Initial call
      updateActiveNavLink();
    }

    // Run on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Handle resize
    let resizeTimer: ReturnType<typeof globalThis.setTimeout> | undefined;
    window.addEventListener('resize', () => {
      if (resizeTimer !== undefined) globalThis.clearTimeout(resizeTimer);
      resizeTimer = globalThis.setTimeout(() => {
        // Re-calculate parallax positions
        const parallaxElements = document.querySelectorAll('[class*="parallax-"]');
        parallaxElements.forEach(element => {
          (element as HTMLElement).style.transform = 'translateY(0)';
        });
      }, 250);
    });
  </script>

  <ThemeToggle />

  <style is:global>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html.layout-html,
    body {
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
    }
  </style>
</body>
</html>
