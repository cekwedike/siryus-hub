---
import '../styles/global.css';
import type { SEO } from '../types/seo';
import { generateSEO } from '../lib/utils/metadata';

interface Props {
  seo: SEO;
}

const { seo } = Astro.props;
const metadata = generateSEO(seo);
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'SIRYUS Artist Management';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={metadata.canonical} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={metadata.openGraph.basic.title} />
    <meta property="og:type" content={metadata.openGraph.basic.type} />
    <meta property="og:image" content={metadata.openGraph.basic.image} />
    <meta property="og:url" content={metadata.openGraph.basic.url} />
    <meta property="og:description" content={metadata.openGraph.optional.description} />
    <meta property="og:site_name" content={metadata.openGraph.optional.siteName} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content={metadata.twitter.card} />
    <meta name="twitter:title" content={metadata.twitter.title} />
    <meta name="twitter:description" content={metadata.twitter.description} />
    <meta name="twitter:image" content={metadata.twitter.image} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Aeonik Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      @font-face {
        font-family: 'Aeonik';
        src: local('Inter'), local('system-ui'), local('-apple-system');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Aeonik';
        src: local('Inter Medium'), local('system-ui');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Aeonik';
        src: local('Inter SemiBold'), local('system-ui');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Aeonik';
        src: local('Inter Bold'), local('system-ui');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
    </style>
    
    <!-- View Transitions -->
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    <slot />
  </body>
</html>
