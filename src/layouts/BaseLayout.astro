---
import '../styles/marketing-layout.css';
import '../styles/inner-page-heroes-mobile.css';
import '../styles/morphism.css';
import SimpleSiteNav from '../components/SimpleSiteNav.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
  schema?: object;
  /** Preload URL for LCP hero image (e.g. home carousel first slide) */
  lcpImagePreload?: string;
}

const {
  title,
  description = 'Siryus Hub is the creative home of Siryus Creative Media Ltd. We offer artist management, content marketing, and community for independent creatives.',
  canonical,
  ogImage = '/images/og-default.png',
  ogType = 'website',
  noIndex = false,
  schema,
  lcpImagePreload,
} = Astro.props;

const fontPreloadUnbounded =
  'https://fonts.gstatic.com/s/unbounded/v12/Yq6F-LOTXCb04q32xlpat-6uR42XTqtG67H244rNgQ.woff2';
const fontPreloadDmSans =
  'https://fonts.gstatic.com/s/dmsans/v17/rP2Yp2ywxg089UriI5-g7M8btVsD8Ck0q7u0-K4.woff2';

const pageTitle = title.includes('|')
  ? title
  : `${title} | Siryus Hub`;

const canonicalURL = canonical
  ? new URL(canonical, Astro.site).href
  : new URL(Astro.url.pathname, Astro.site).href;

const ogImageURL = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Siryus Creative Media Ltd',
  alternateName: 'Siryus Hub',
  url: 'https://www.siryushub.com',
  logo: 'https://www.siryushub.com/images/logo/dark/siryus-logo-dark.png',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'management@siryushub.com',
    contactType: 'customer service',
  },
  sameAs: [],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kigali',
    addressCountry: 'RW',
  },
};

const finalSchema = schema || organizationSchema;
---

<!DOCTYPE html>
<html lang="en" class="layout-html" style="width: 100%; box-sizing: border-box;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Siryus Hub" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />

    {
      lcpImagePreload ? (
        <link
          rel="preload"
          as="image"
          href={lcpImagePreload}
          fetchpriority="high"
        />
      ) : null
    }

    <link
      rel="preload"
      href={fontPreloadUnbounded}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={fontPreloadDmSans}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Favicons -->
    <link
      rel="icon"
      type="image/x-icon"
      href="/images/logo/dark/favicon.ico"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/logo/dark/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/logo/dark/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/logo/dark/apple-touch-icon.png"
    />

    <!-- Fonts: load async to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;0,9..40,900;1,9..40,400&family=Unbounded:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;0,9..40,900;1,9..40,400&family=Unbounded:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- JSON-LD Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(finalSchema)}
    />

    <!-- Google Analytics (deferred; non-blocking) -->
    <script
      is:inline
      defer
      src="https://www.googletagmanager.com/gtag/js?id=G-H882NL8BE3"
    ></script>
    <script is:inline defer>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H882NL8BE3');
    </script>
  </head>
  <body class="marketing-body" style="width: 100%; box-sizing: border-box;">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PK8BC3TV"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Sidebar />
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SimpleSiteNav />
    <main id="main-content" class="marketing-main">
      <slot />
    </main>
    <Footer />

    <ThemeToggle />

    <!-- Google Tag Manager -->
    <script is:inline
      >(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-PK8BC3TV');</script>

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;
        t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","uix15dy0m8");
    </script>

    <!-- Google AdSense -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3731681794344166"
      crossorigin="anonymous"
    ></script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  html.layout-html,
  body.marketing-body {
    overflow-x: hidden;
    max-width: 100vw;
  }

  .marketing-body {
    width: 100%;
    max-width: 100%;
  }

  body.marketing-body section {
    max-width: 100%;
    overflow-x: hidden;
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    background: var(--brand-accent);
    color: #0a0a0a;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    z-index: var(--z-modal);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
