---
import '../styles/arc-fonts.css';
import '../styles/arc-blog.css';
import ArcFooter from '../components/ArcFooter.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
  schema?: object;
  /** Absolute URL for paginated series SEO (`rel="prev"`) */
  paginationPrev?: string;
  /** Absolute URL for paginated series SEO (`rel="next"`) */
  paginationNext?: string;
}

const {
  title,
  description = 'ARC is a community for independent Christian creatives.',
  canonical,
  ogImage = '/arc/arc-logo.png',
  ogType = 'website',
  noIndex = false,
  schema,
  paginationPrev,
  paginationNext,
} = Astro.props;

const pageTitle = title.includes('|') ? title : `${title} | ARC`;

const canonicalURL = canonical
  ? new URL(canonical, Astro.url.origin).href
  : new URL(Astro.url.pathname, Astro.url.origin).href;

const ogImageURL = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.url.origin).href;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ARC',
  alternateName: 'Ascent. Refuge. Collective.',
  url: 'https://www.siryushub.com/arc',
  logo: 'https://www.siryushub.com/arc/arc-logo.png',
  description:
    'ARC is a community for independent Christian creatives who are serious about their craft and their faith.',
  sameAs: [
    'https://www.instagram.com/wearearc.creatives/',
    'https://www.youtube.com/@wearearc.creatives',
  ],
};

const finalSchema = schema || defaultSchema;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const inBlog = currentPath === '/arc/blog' || currentPath.startsWith('/arc/blog/');
const inEvents = currentPath === '/arc/events' || currentPath.startsWith('/arc/events/');
const inCommunity = currentPath === '/arc/community';
const inAbout = currentPath === '/arc/about';
const inSupporters = currentPath === '/arc/supporters';
const inFaq = currentPath === '/arc/faq';
const inSubscribe = currentPath === '/arc/subscribe';
const inArcHome = currentPath === '/arc';
---

<!DOCTYPE html>
<html lang="en" class="layout-html">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {paginationPrev && <link rel="prev" href={paginationPrev} />}
    {paginationNext && <link rel="next" href={paginationNext} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="ARC" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

    <link rel="icon" href="/arc/arc-png.png" type="image/png" />
    <link rel="shortcut icon" href="/arc/arc-png.png" type="image/png" />
    <link rel="apple-touch-icon" href="/arc/arc-png.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="arc-route">
    <a href="#main-content" class="arc-skip-link">Skip to main content</a>
    <nav class="arc-route-nav arc-route-nav--always" aria-label="ARC page navigation">
      <a href="/arc" class={`arc-route-nav__brand ${inArcHome ? 'is-active' : ''}`.trim()}>ARC.</a>
      <div class="arc-route-nav__links">
        <a href="/arc" class={inArcHome ? 'is-active' : undefined}>Home</a>
        <a href="/arc/blog" class={inBlog ? 'is-active' : undefined}>Blog</a>
        <a href="/arc/events" class={inEvents ? 'is-active' : undefined}>Events</a>
        <a href="/arc/community" class={inCommunity ? 'is-active' : undefined}>Community</a>
        <a href="/arc/about" class={inAbout ? 'is-active' : undefined}>About</a>
        <a href="/arc/supporters" class={inSupporters ? 'is-active' : undefined}>Supporters</a>
        <a href="/arc/faq" class={inFaq ? 'is-active' : undefined}>FAQ</a>
        <a href="https://www.siryushub.com">Back to SiryusHub</a>
      </div>
      <button
        type="button"
        class="arc-route-nav__hamburger"
        id="arcHamburgerBtn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="arcMobileNav"
      >
        <span class="arc-route-nav__hamburger-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </nav>

    <div
      id="arcMobileNav"
      class="arc-mobile-nav"
      aria-label="ARC mobile navigation"
      aria-hidden="true"
      inert
    >
      <button class="arc-mobile-nav__overlay" type="button" aria-label="Close menu" data-arc-nav-close></button>
      <div class="arc-mobile-nav__panel" role="dialog" aria-modal="true" aria-label="ARC menu">
        <div class="arc-mobile-nav__head">
          <span class="arc-mobile-nav__title">ARC.</span>
          <button class="arc-mobile-nav__close" type="button" aria-label="Close menu" data-arc-nav-close>
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="arc-mobile-nav__list" role="list">
          <a href="/arc" class={`arc-mobile-nav__link ${inArcHome ? 'is-active' : ''}`.trim()}>Home</a>
          <a href="/arc/blog" class={`arc-mobile-nav__link ${inBlog ? 'is-active' : ''}`.trim()}>Blog</a>
          <a href="/arc/events" class={`arc-mobile-nav__link ${inEvents ? 'is-active' : ''}`.trim()}>Events</a>
          <a href="/arc/community" class={`arc-mobile-nav__link ${inCommunity ? 'is-active' : ''}`.trim()}>Community</a>
          <a href="/arc/about" class={`arc-mobile-nav__link ${inAbout ? 'is-active' : ''}`.trim()}>About</a>
          <a href="/arc/supporters" class={`arc-mobile-nav__link ${inSupporters ? 'is-active' : ''}`.trim()}>Supporters</a>
          <a href="/arc/faq" class={`arc-mobile-nav__link ${inFaq ? 'is-active' : ''}`.trim()}>FAQ</a>
          <a href="https://www.siryushub.com" class="arc-mobile-nav__link arc-mobile-nav__link--siryus">Back to SiryusHub</a>
        </div>
      </div>
    </div>

    <main id="main-content" class="arc-shell-main">
      <slot />
    </main>
    <ArcFooter />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html.layout-html,
  body.arc-route {
    margin: 0;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  body.arc-route {
    background: #0d0b09;
    color: #ffffff;
    font-family: var(--arc-font-body);
  }

  body.arc-route.light-theme {
    background: #ffffff;
    color: #000000;
  }

  body.arc-route .arc-route-nav {
    position: fixed;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 70;
    width: min(1120px, calc(100vw - 1.4rem));
    margin-inline: auto;
    padding: 0.65rem 0.9rem;
    border: 1px solid rgba(242, 121, 48, 0.42);
    background: rgba(13, 11, 9, 0.92);
    display: flex;
    align-items: center;
    justify-content: space-between;
    backdrop-filter: blur(8px);
  }

  body.arc-route .arc-route-nav__brand {
    color: #f27930;
    text-decoration: none;
    font-family: var(--arc-font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  body.arc-route .arc-route-nav__links {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  body.arc-route .arc-route-nav__links a {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.82;
  }

  body.arc-route .arc-route-nav__hamburger {
    display: none;
    background: transparent;
    border: 1px solid rgba(242, 121, 48, 0.42);
    padding: 0.45rem 0.55rem;
    border-radius: 999px;
    cursor: pointer;
    color: inherit;
  }

  body.arc-route .arc-route-nav__hamburger-icon {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }

  body.arc-route .arc-route-nav__hamburger-icon span {
    width: 20px;
    height: 2px;
    background: currentColor;
    display: block;
  }

  body.arc-route .arc-route-nav a.is-active {
    opacity: 1;
    color: #f27930;
  }

  body.arc-route .arc-route-nav a:hover {
    opacity: 1;
  }

  body.arc-route.light-theme .arc-route-nav {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(0, 0, 0, 0.28);
  }

  body.arc-route.light-theme .arc-route-nav__brand {
    color: #000000;
  }

  body.arc-route.light-theme .arc-route-nav__links a {
    color: #000000;
  }

  .arc-shell-main {
    min-height: 60vh;
    padding-top: 5.25rem;
  }

  .arc-skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 120;
    background: #f27930;
    color: #0d0b09;
    padding: 0.45rem 0.8rem;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .arc-skip-link:focus {
    top: 0.5rem;
  }

  @media (max-width: 940px) {
    body.arc-route .arc-route-nav {
      top: 0.5rem;
      width: calc(100vw - 1rem);
      padding: 0.55rem 0.62rem;
    }

    body.arc-route .arc-route-nav__brand {
      font-size: 1.2rem;
    }

    body.arc-route .arc-route-nav__links {
      gap: 0.55rem;
    }

    body.arc-route .arc-route-nav__links a {
      font-size: 0.66rem;
      letter-spacing: 0.05em;
    }
  }

  @media (max-width: 768px) {
    body.arc-route .arc-route-nav__links {
      display: none;
    }

    body.arc-route .arc-route-nav__hamburger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  .arc-mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 120;
    pointer-events: none;
  }

  .arc-mobile-nav.is-open {
    pointer-events: auto;
  }

  .arc-mobile-nav__overlay {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    background: rgba(0, 0, 0, 0.65);
    opacity: 0;
    transition: opacity 0.22s ease;
    cursor: pointer;
  }

  .arc-mobile-nav.is-open .arc-mobile-nav__overlay {
    opacity: 1;
  }

  .arc-mobile-nav__panel {
    position: absolute;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    left: max(0.75rem, env(safe-area-inset-left));
    border: 1px solid rgba(242, 121, 48, 0.35);
    background: rgba(13, 11, 9, 0.96);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    transform: translateY(-8px);
    opacity: 0;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
    padding: 0.9rem 0.9rem 1rem;
    max-height: calc(100vh - 1.5rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    overflow: auto;
  }

  .arc-mobile-nav.is-open .arc-mobile-nav__panel {
    transform: translateY(0);
    opacity: 1;
  }

  .arc-mobile-nav__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(242, 121, 48, 0.18);
  }

  .arc-mobile-nav__title {
    font-family: var(--arc-font-heading);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #f27930;
  }

  .arc-mobile-nav__close {
    border: 1px solid rgba(242, 121, 48, 0.3);
    background: transparent;
    color: #ffffff;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    line-height: 1;
  }

  .arc-mobile-nav__list {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.8rem;
  }

  .arc-mobile-nav__link {
    text-decoration: none;
    color: rgba(245, 240, 232, 0.92);
    font-family: var(--arc-font-body);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.82rem;
    padding: 0.7rem 0.7rem;
    border-radius: 10px;
    border: 1px solid rgba(242, 121, 48, 0.14);
    background: rgba(255, 255, 255, 0.02);
  }

  .arc-mobile-nav__link.is-active {
    border-color: rgba(242, 121, 48, 0.45);
    color: #ffffff;
  }

  .arc-mobile-nav__link--siryus {
    border-style: dashed;
    opacity: 0.92;
  }

  body.arc-route.light-theme .arc-mobile-nav__panel {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(0, 0, 0, 0.18);
  }

  body.arc-route.light-theme .arc-mobile-nav__overlay {
    background: rgba(0, 0, 0, 0.45);
  }

  body.arc-route.light-theme .arc-mobile-nav__link {
    color: rgba(13, 11, 9, 0.9);
    border-color: rgba(0, 0, 0, 0.14);
    background: rgba(0, 0, 0, 0.03);
  }

  body.arc-route.light-theme .arc-mobile-nav__close {
    color: #0d0b09;
    border-color: rgba(0, 0, 0, 0.18);
  }

  body.arc-route.light-theme .arc-mobile-nav__head {
    border-bottom-color: rgba(0, 0, 0, 0.12);
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('arcHamburgerBtn');
    const nav = document.getElementById('arcMobileNav');
    if (!(btn instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

    const closeEls = Array.from(nav.querySelectorAll('[data-arc-nav-close]'));
    const links = Array.from(nav.querySelectorAll('a'));

    const open = () => {
      nav.classList.add('is-open');
      nav.setAttribute('aria-hidden', 'false');
      nav.removeAttribute('inert');
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      nav.classList.remove('is-open');
      nav.setAttribute('aria-hidden', 'true');
      nav.setAttribute('inert', '');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    btn.addEventListener('click', () => {
      const isOpen = nav.classList.contains('is-open');
      if (isOpen) close();
      else open();
    });

    closeEls.forEach((el) => el.addEventListener('click', close));
    links.forEach((a) => a.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (nav.classList.contains('is-open')) close();
    });
  })();
</script>
