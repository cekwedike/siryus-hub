---
import '../styles/ecosystem.css'

interface Props {
  title: string
  description: string
  canonical?: string
}

const { title, description, canonical = 'https://www.siryushub.com/' } = Astro.props

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SIRYUS',
  legalName: 'Siryus Creative Media Ltd',
  url: 'https://www.siryushub.com',
  email: 'management@siryushub.com',
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SIRYUS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23090909'/%3E%3C/svg%3E" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline defer src="https://www.googletagmanager.com/gtag/js?id=G-H882NL8BE3"></script>
    <script is:inline defer>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H882NL8BE3');
    </script>
  </head>
  <body>
    <a class="ecosystem-skip" href="#main-content">Skip to main content</a>
    <slot />
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","uix15dy0m8");
    </script>
  </body>
</html>
