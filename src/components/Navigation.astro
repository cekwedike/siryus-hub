---
import '../styles/morphism.css';
import BrandWordmark from './BrandWordmark.astro';
---

<nav class="top-nav nav-glass" aria-label="Main navigation">
  <div class="nav-container">
    <div class="nav-logo">
      <BrandWordmark variant="nav" href="/home" />
    </div>

    <ul class="nav-links" role="list">
      <li><a href="/about" class="nav-link">About</a></li>
      <li><a href="/services" class="nav-link">Services</a></li>
      <li><a href="/siryus-am" class="nav-link">SIRYUS A.M</a></li>
      <li><a href="/artists" class="nav-link">Artists</a></li>
      <li><a href="/blog" class="nav-link">Blog</a></li>
    </ul>

    <div class="nav-right">
      <a href="/contact" class="nav-cta">Work with us</a>
      <button
        class="hamburger-btn"
        id="hamburgerBtn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="sidebar"
      >
        <div class="hamburger-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </button>
    </div>
  </div>
</nav>

<style>
  .top-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 80px;
    z-index: var(--z-nav);
  }

  .nav-container {
    max-width: 1920px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-12);
  }

  .nav-logo {
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: var(--space-10);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--brand-text);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    transition: color var(--transition-base);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--brand-accent);
    transition: width var(--transition-base);
  }

  .nav-link:hover {
    color: var(--brand-accent);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 100%;
  }

  .nav-link[aria-current="page"] {
    color: var(--brand-accent);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-cta {
    color: var(--brand-accent);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    border: 1px solid var(--brand-accent);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    transition: all var(--transition-base);
  }

  .nav-cta:visited {
    color: var(--brand-accent);
  }

  .nav-cta:visited:hover {
    color: #0a0a0a;
  }

  .nav-cta:hover {
    background: var(--brand-accent);
    color: #0a0a0a;
  }

  .hamburger-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(245, 249, 233, 0.2);
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
    padding: 0;
  }

  .hamburger-btn:hover {
    border-color: var(--brand-accent);
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hamburger-icon span {
    width: 20px;
    height: 2px;
    background: var(--brand-text);
    transition: all var(--transition-base);
    display: block;
  }

  .hamburger-btn:hover .hamburger-icon span {
    background: var(--brand-accent);
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-icon span:nth-child(2) {
    opacity: 0;
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .nav-links {
      gap: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .nav-container {
      padding: 0 var(--space-5);
    }

    .nav-links {
      display: none;
    }

    .nav-cta {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .top-nav {
      height: 70px;
    }
  }

  :global(body.light-theme) .top-nav.nav-glass {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.94) 0%,
      rgba(248, 249, 246, 0.92) 100%
    );
    backdrop-filter: blur(22px) saturate(1.2);
    -webkit-backdrop-filter: blur(22px) saturate(1.2);
    border-bottom: 1px solid rgba(27, 27, 30, 0.1);
  }

  :global(body.light-theme) .nav-link {
    color: var(--brand-text);
  }

  :global(body.light-theme) .hamburger-icon span {
    background: var(--brand-text);
  }
</style>

<script>
  const btn = document.getElementById('hamburgerBtn');

  function openSidebar() {
    const sidebar = document.getElementById('sidebar');
    if (!sidebar || !btn) return;
    sidebar.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    const sidebar = document.getElementById('sidebar');
    if (!sidebar || !btn) return;
    sidebar.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeSidebar();
    } else {
      openSidebar();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSidebar();
  });
</script>
