---
import '../styles/morphism.css';
import BrandWordmark from './BrandWordmark.astro';
import WindDecorButton from './WindDecorButton.astro';
---

<nav class="top-nav" aria-label="Main navigation">
  <div class="top-nav__pill">
    <div class="nav-container">
      <div class="nav-logo">
        <BrandWordmark variant="nav" href="/home" />
      </div>

      <ul class="nav-links" role="list">
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/services" class="nav-link">Services</a></li>
        <li><a href="/siryus-am" class="nav-link">SIRYUS A.M</a></li>
        <li><a href="/artists" class="nav-link">Artists</a></li>
        <li><a href="/blog" class="nav-link">Blog</a></li>
      </ul>

      <div class="nav-right">
        <WindDecorButton href="/contact" class="nav-cta simple-nav__cta" splash={false}>
          Work With Us
        </WindDecorButton>
        <button
          class="hamburger-btn"
          id="hamburgerBtn"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="sidebar"
        >
          <div class="hamburger-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</nav>

<style>
  .top-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    padding: var(--space-4) var(--space-5) 0;
    background: transparent;
    pointer-events: none;
  }

  .top-nav__pill {
    pointer-events: auto;
    width: 100%;
    max-width: min(1120px, calc(100vw - var(--space-5) * 2));
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(
      165deg,
      rgba(22, 22, 26, 0.82) 0%,
      rgba(8, 8, 10, 0.92) 100%
    );
    backdrop-filter: blur(38px) saturate(1.75);
    -webkit-backdrop-filter: blur(38px) saturate(1.75);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.13),
      0 14px 44px rgba(0, 0, 0, 0.48),
      0 0 0 1px rgba(0, 0, 0, 0.38);
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.38s ease,
      backdrop-filter 0.38s ease,
      -webkit-backdrop-filter 0.38s ease,
      border-color 0.38s ease;
  }

  .top-nav__pill.is-scrolled {
    transform: scale(0.982);
    border-color: rgba(255, 255, 255, 0.11);
    backdrop-filter: blur(48px) saturate(1.9);
    -webkit-backdrop-filter: blur(48px) saturate(1.9);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 10px 36px rgba(0, 0, 0, 0.52),
      0 0 0 1px rgba(0, 0, 0, 0.42);
  }

  .nav-container {
    max-width: none;
    margin: 0 auto;
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-6);
  }

  .nav-logo {
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: var(--space-10);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--brand-text);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    transition: color var(--transition-base);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--brand-accent-ink);
    transition: width var(--transition-base);
  }

  .nav-link:hover {
    color: var(--brand-accent-ink-hover);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 100%;
  }

  .nav-link[aria-current="page"] {
    color: var(--brand-accent-ink);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-cta {
    -webkit-tap-highlight-color: transparent;
    padding: var(--space-2) var(--space-5) !important;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: var(--radius-full) !important;
  }

  .hamburger-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(245, 249, 233, 0.2);
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
    padding: 0;
  }

  .hamburger-btn:hover {
    border-color: var(--brand-accent-ink);
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hamburger-icon span {
    width: 20px;
    height: 2px;
    background: var(--brand-text);
    transition: all var(--transition-base);
    display: block;
  }

  .hamburger-btn:hover .hamburger-icon span {
    background: var(--brand-accent-ink);
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-icon span:nth-child(2) {
    opacity: 0;
  }

  .hamburger-btn[aria-expanded="true"] .hamburger-icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .nav-links {
      gap: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .top-nav {
      padding: var(--space-3) var(--space-4) 0;
      justify-content: center;
    }

    .top-nav__pill {
      width: fit-content;
      max-width: calc(100vw - var(--space-4) * 2);
      min-width: 0;
    }

    .nav-container {
      padding: 0 var(--space-4);
      min-height: 54px;
      gap: var(--space-3);
      justify-content: space-between;
    }

    .nav-links {
      display: none !important;
    }

    .nav-cta,
    .simple-nav__cta {
      display: none !important;
    }
  }

  @media (max-width: 480px) {
    .nav-container {
      min-height: 50px;
    }
  }

  :global(body.light-theme) .top-nav__pill {
    border-color: rgba(27, 27, 30, 0.14);
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.88) 0%,
      rgba(248, 249, 246, 0.94) 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 12px 36px rgba(0, 0, 0, 0.1),
      0 0 0 1px rgba(0, 0, 0, 0.06);
  }

  :global(body.light-theme) .top-nav__pill.is-scrolled {
    border-color: rgba(27, 27, 30, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 10px 32px rgba(0, 0, 0, 0.12),
      0 0 0 1px rgba(0, 0, 0, 0.07);
  }

  :global(body.light-theme) .nav-link {
    color: var(--brand-text);
  }

  :global(body.light-theme) .hamburger-icon span {
    background: var(--brand-text);
  }
</style>

<script>
  function initNavScroll() {
    const pill = document.querySelector('.top-nav__pill');
    if (!pill) return;

    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop;
      pill.classList.toggle('is-scrolled', y > 24);
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavScroll, {
      once: true,
    });
  } else {
    initNavScroll();
  }
</script>
