---
import '../styles/morphism.css';
import BrandWordmark from './BrandWordmark.astro';
// Footer Component - Global site footer
// Includes company info, links, contact, social media, newsletter
---

<footer class="site-footer morph-footer-glass" id="contact">
  <div class="footer-container">
    <!-- Footer Top -->
    <div class="footer-top">
      <!-- Company Info Column -->
      <div class="footer-column brand-column">
        <div class="footer-logo">
          <BrandWordmark variant="footer" href="/home" />
        </div>
        <p class="brand-tagline">
          A collaboration between art and tech. We're misfits making magic.
        </p>
      </div>

      <!-- Quick Links Column -->
      <div class="footer-column">
        <h4 class="column-title">Platform</h4>
        <nav class="footer-nav">
          <a href="/home" class="footer-link">Siryus Hub</a>
          <a href="/services" class="footer-link">Services</a>
          <a href="/siryus-am" class="footer-link">SIRYUS A.M</a>
          <a href="/projects" class="footer-link">Projects</a>
          <a href="/community" class="footer-link">Community</a>
          <a href="/blog" class="footer-link">Blog</a>
        </nav>
      </div>

      <!-- Services Column -->
      <div class="footer-column">
        <h4 class="column-title">Creative Services</h4>
        <nav class="footer-nav">
          <a href="/services" class="footer-link">Management</a>
          <a href="/services" class="footer-link">Marketing</a>
          <a href="/services" class="footer-link">Education</a>
          <a href="/artists" class="footer-link">Artists</a>
          <a href="/contact" class="footer-link">Contact</a>
        </nav>
      </div>

      <!-- Company Column -->
      <div class="footer-column">
        <h4 class="column-title">Company</h4>
        <nav class="footer-nav">
          <a href="/about" class="footer-link">About</a>
          <a href="/faq" class="footer-link">FAQ</a>
          <a href="/blog" class="footer-link">Blog</a>
          <a href="/sitemap" class="footer-link">Sitemap</a>
          <a href="/contact" class="footer-link">Contact</a>
        </nav>
      </div>

      <!-- Newsletter Column -->
      <div class="footer-column newsletter-column">
        <h4 class="column-title">Stay Updated</h4>
        <p class="newsletter-text">
          Get the latest updates, resources, and exclusive offers delivered to your inbox.
        </p>
        <form class="newsletter-form morph-neu-row">
          <input 
            type="email" 
            placeholder="Your email address" 
            class="newsletter-input morph-neu-input"
            required
          />
          <button type="submit" class="newsletter-button morph-neu-btn morph-neu-btn--icon" aria-label="Subscribe">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <!-- Footer Middle -->
    <div class="footer-middle">
      <!-- Contact Info -->
      <div class="contact-info">
        <div class="contact-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <a href="mailto:management@siryushub.com" class="contact-link">management@siryushub.com</a>
        </div>
        <div class="contact-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <a href="tel:+1234567890" class="contact-link">+1 (234) 567-890</a>
        </div>
      </div>

      <!-- Social Media Links -->
      <div class="social-links">
        <a href="https://instagram.com/siryusam" class="social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span class="social-label">Instagram</span>
        </a>
        <a href="https://x.com/siryusam" class="social-link" aria-label="Twitter/X" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
          <span class="social-label">X</span>
        </a>
        <a href="https://linkedin.com/company/siryusam" class="social-link" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          <span class="social-label">LinkedIn</span>
        </a>
        <a href="https://www.youtube.com/@siryusam" class="social-link" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
          </svg>
          <span class="social-label">YouTube</span>
        </a>
      </div>

      <!-- Theme Toggle -->
      <div class="theme-toggle-footer morph-neu-toggle-row">
        <button class="theme-btn-footer morph-neu-chip" data-theme="device" aria-label="Device theme">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </button>
        <button class="theme-btn-footer morph-neu-chip" data-theme="light" aria-label="Light theme">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
        <button class="theme-btn-footer morph-neu-chip" data-theme="dark" aria-label="Dark theme">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <p class="copyright">
          © {new Date().getFullYear()} Siryus Hub. All rights reserved.
        </p>
        <nav class="legal-nav">
          <a href="/privacy-policy" class="legal-link">Privacy Policy</a>
          <span class="separator">•</span>
          <a href="/terms-of-use" class="legal-link">Terms of Use</a>
          <span class="separator">•</span>
          <a href="/cookie-policy" class="legal-link">Cookie Policy</a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 80px 50px 40px;
    position: relative;
  }

  .footer-container {
    max-width: 1600px;
    margin: 0 auto;
  }

  /* Footer Top */
  .footer-top {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr) 1.5fr;
    gap: 48px;
    margin-bottom: 64px;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(245, 249, 233, 0.1);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Brand Column */
  .brand-column {
    gap: 24px;
  }

  .footer-logo {
    width: 120px;
  }

  .logo-img {
    width: 100%;
    height: auto;
  }

  .brand-tagline {
    font-size: 15px;
    line-height: 1.6;
    color: #949BA0;
    margin: 0;
  }

  /* Footer Navigation */
  .column-title {
    font-size: 14px;
    font-weight: 700;
    color: #F5F9E9;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-size: 15px;
    color: #949BA0;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-link:hover {
    color: #D1DF4B;
  }

  /* Newsletter Column */
  .newsletter-column {
    gap: 16px;
  }

  .newsletter-text {
    font-size: 14px;
    line-height: 1.6;
    color: #949BA0;
    margin: 0;
  }

  .newsletter-form {
    display: flex;
    gap: 10px;
    align-items: stretch;
    flex-wrap: wrap;
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  .newsletter-form.morph-neu-stack--inline {
    flex-direction: row;
    align-items: stretch;
  }

  .newsletter-input {
    flex: 1;
    min-width: 0;
    font-size: 14px;
  }

  .newsletter-input::placeholder {
    color: #949ba0;
  }

  .newsletter-button svg {
    stroke: currentColor;
  }

  /* Footer Middle */
  .footer-middle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 40px 0;
    border-bottom: 1px solid rgba(245, 249, 233, 0.1);
    margin-bottom: 40px;
  }

  .contact-info {
    display: flex;
    gap: 32px;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .contact-item svg {
    stroke: #D1DF4B;
    flex-shrink: 0;
  }

  .contact-link {
    font-size: 15px;
    color: #F5F9E9;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-link:hover {
    color: #D1DF4B;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: 20px;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #949BA0;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .social-link:hover {
    color: #D1DF4B;
  }

  .social-link svg {
    stroke: currentColor;
  }

  .social-label {
    font-size: 14px;
    font-weight: 500;
  }

  /* Theme Toggle Footer */
  .theme-toggle-footer {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .theme-btn-footer {
    width: 40px;
    height: 40px;
    min-width: 40px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    color: #949ba0;
  }

  .theme-btn-footer svg {
    stroke: currentColor;
  }

  /* Footer Bottom */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom-left {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .copyright {
    font-size: 14px;
    color: #949BA0;
    margin: 0;
  }

  .legal-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .legal-link {
    font-size: 14px;
    color: #949BA0;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .legal-link:hover {
    color: #D1DF4B;
  }

  .separator {
    color: #949BA0;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .footer-top {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 40px;
    }

    .brand-column {
      grid-column: span 3;
    }

    .newsletter-column {
      grid-column: span 3;
    }
  }

  @media (max-width: 1024px) {
    .site-footer {
      padding: 60px 40px 30px;
    }

    .footer-middle {
      flex-direction: column;
      gap: 32px;
      align-items: flex-start;
    }

    .theme-toggle-footer {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 50px 20px 25px;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 48px;
      padding-bottom: 48px;
    }

    .brand-column,
    .newsletter-column {
      grid-column: span 1;
    }

    .contact-info {
      flex-direction: column;
      gap: 20px;
    }

    .social-links {
      flex-wrap: wrap;
    }

    .social-label {
      display: none;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 24px;
      align-items: flex-start;
    }

    .footer-bottom-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      gap: 28px;
    }

    .newsletter-form {
      flex-direction: column;
    }

    .newsletter-button {
      width: 100%;
    }

    .contact-item {
      font-size: 14px;
    }

    .legal-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .separator {
      display: none;
    }
  }

  /* Light Theme — base surface from morphism.css (.morph-footer-glass) */
  :global(body.light-theme) .site-footer {
    border-top-color: rgba(27, 27, 30, 0.08);
  }

  :global(body.light-theme) .column-title,
  :global(body.light-theme) .contact-link {
    color: #1B1B1E;
  }

  :global(body.light-theme) .brand-tagline,
  :global(body.light-theme) .newsletter-text,
  :global(body.light-theme) .footer-link,
  :global(body.light-theme) .social-link,
  :global(body.light-theme) .copyright,
  :global(body.light-theme) .legal-link,
  :global(body.light-theme) .separator {
    color: #5A5A5D;
  }

  :global(body.light-theme) .footer-link:hover,
  :global(body.light-theme) .contact-link:hover,
  :global(body.light-theme) .social-link:hover,
  :global(body.light-theme) .legal-link:hover {
    color: #D1DF4B;
  }

  :global(body.light-theme) .newsletter-input.morph-neu-input {
    background: #f5f6f3;
    color: #1b1b1e;
    box-shadow: inset 4px 4px 10px rgba(0, 0, 0, 0.06), inset -2px -2px 8px rgba(255, 255, 255, 0.95);
  }

  :global(body.light-theme) .newsletter-input::placeholder {
    color: #949ba0;
  }

  :global(body.light-theme) .theme-btn-footer {
    color: #5a5a5d;
  }

  :global(body.light-theme) .footer-top,
  :global(body.light-theme) .footer-middle {
    border-bottom-color: rgba(27, 27, 30, 0.1);
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .contact-link,
    .social-link,
    .legal-link,
    .newsletter-button {
      transition: none;
    }
  }
</style>
