---
import '../styles/morphism.css';
import BrandWordmark from './BrandWordmark.astro';
import WindDecorButton from './WindDecorButton.astro';
---

<footer class="site-footer" id="footer" aria-label="Site footer">
  <div class="footer-inner">

    <div class="footer-top">

      <!-- Brand column -->
      <div class="footer-col footer-col--brand">
        <BrandWordmark variant="footer" href="/home" />
        <p class="footer-tagline">
          A collaboration between art and tech.
          We are misfits making magic.
        </p>
        <div class="footer-social">
          <a
            href="https://www.instagram.com/siryus.am"
            class="footer-social__link"
            aria-label="SIRYUS A.M on Instagram"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@siryus-am?sub_confirmation=1"
            class="footer-social__link"
            aria-label="SIRYUS A.M on YouTube"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path>
              <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"></polygon>
            </svg>
          </a>
          <a
            href="https://www.tiktok.com/@siryus.a.m"
            class="footer-social__link"
            aria-label="SIRYUS A.M on TikTok"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.73v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
              ></path>
            </svg>
          </a>
          <a
            href="https://open.spotify.com/artist/2EG2NnuWqrFQauR3T8Jfpo"
            class="footer-social__link"
            aria-label="SIRYUS A.M on Spotify"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 11.973c2.5-1.473 5.5-.973 7.5.527"></path>
              <path d="M9 14.92c1.8-1.1 3.9-.733 5.4.38"></path>
              <path d="M7 9c2.8-1.4 6.2-1 8.5 1"></path>
            </svg>
          </a>
          <a
            href="https://audiomack.com/siryus-am"
            class="footer-social__link"
            aria-label="SIRYUS A.M on Audiomack"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 18V6"></path>
              <path d="M8 18v-5"></path>
              <path d="M12 18V9"></path>
              <path d="M16 18v-3"></path>
              <path d="M20 18v-7"></path>
            </svg>
          </a>
          <a
            href="https://x.com/siryus_am"
            class="footer-social__link"
            aria-label="SIRYUS A.M on X"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.912-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a
            href="https://www.facebook.com/profile.php?id=61568049759998"
            class="footer-social__link"
            aria-label="SIRYUS A.M on Facebook"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/company/105166666"
            class="footer-social__link"
            aria-label="Siryus on LinkedIn"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            href="https://linktr.ee/siryus_hq"
            class="footer-social__link"
            aria-label="Siryus on Linktree"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Platform links -->
      <div class="footer-col">
        <h3 class="footer-col__heading">Platform</h3>
        <ul class="footer-nav" role="list">
          <li><a href="/home" class="footer-nav__link">Siryus Hub</a></li>
          <li><a href="/about" class="footer-nav__link">About</a></li>
          <li>
            <a href="/siryus-am" class="footer-nav__link">SIRYUS A.M</a>
          </li>
          <li>
            <a href="/artists" class="footer-nav__link">Artists</a>
          </li>
          <li>
            <a href="/projects" class="footer-nav__link">Projects</a>
          </li>
          <li><a href="/studio" class="footer-nav__link">The Studio</a></li>
        </ul>
      </div>

      <!-- Services links -->
      <div class="footer-col">
        <h3 class="footer-col__heading">Services</h3>
        <ul class="footer-nav" role="list">
          <li>
            <a href="/services" class="footer-nav__link">
              Artist Management
            </a>
          </li>
          <li>
            <a href="/services" class="footer-nav__link">
              Content Marketing
            </a>
          </li>
          <li>
            <a href="/services" class="footer-nav__link">
              Creative Production
            </a>
          </li>
          <li>
            <a href="/community" class="footer-nav__link">Community</a>
          </li>
          <li><a href="/blog" class="footer-nav__link">Blog</a></li>
        </ul>
      </div>

      <!-- Company links -->
      <div class="footer-col">
        <h3 class="footer-col__heading">Company</h3>
        <ul class="footer-nav" role="list">
          <li><a href="/about" class="footer-nav__link">About</a></li>
          <li><a href="/contact" class="footer-nav__link">Contact</a></li>
          <li><a href="/faq" class="footer-nav__link">FAQ</a></li>
          <li>
            <a href="/privacy-policy" class="footer-nav__link">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms-of-use" class="footer-nav__link">
              Terms of Use
            </a>
          </li>
          <li>
            <a href="/cookie-policy" class="footer-nav__link">
              Cookie Policy
            </a>
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="footer-col footer-col--newsletter">
        <h3 class="footer-col__heading">Stay in the loop</h3>
        <p class="footer-newsletter__text">
          New releases, creative resources, and updates from the
          Siryus world. No spam.
        </p>
        <form class="footer-newsletter__form" id="footerNewsletterForm">
          <label for="footerEmail" class="sr-only">
            Your email address
          </label>
          <div class="footer-newsletter__row">
            <input
              type="email"
              id="footerEmail"
              name="email"
              placeholder="your@email.com"
              class="footer-newsletter__input morph-neu-input"
              required
            />
            <WindDecorButton
              type="submit"
              class="footer-newsletter__btn"
              splash={false}
              aria-label="Subscribe"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </WindDecorButton>
          </div>
          <p class="footer-newsletter__success" id="newsletterSuccess">
            You are in. Welcome to the Siryus world.
          </p>
        </form>
      </div>

    </div>

    <!-- Footer bottom bar -->
    <div class="footer-bottom">
      <p class="footer-bottom__copy">
        &copy; {new Date().getFullYear()} Siryus Creative Media Ltd.
        All rights reserved.
      </p>

      <div class="footer-bottom__theme">
        <span class="footer-bottom__theme-label">Theme</span>
        <div class="footer-theme-pill">
          <button
            class="footer-theme-btn theme-btn-footer"
            data-theme="dark"
            aria-label="Dark theme"
            title="Dark"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <button
            class="footer-theme-btn theme-btn-footer"
            data-theme="light"
            aria-label="Light theme"
            title="Light"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>
          <button
            class="footer-theme-btn theme-btn-footer"
            data-theme="device"
            aria-label="Device theme"
            title="System"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </button>
        </div>
      </div>

      <p class="footer-bottom__location">
        Kigali, Rwanda &nbsp;&middot;&nbsp; management@siryushub.com
      </p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: var(--brand-bg-deep);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: var(--space-16) 0 0;
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-8);
  }

  .footer-top {
    display: grid;
    grid-template-columns:
      2fr 1fr 1fr 1fr 1.5fr;
    gap: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .footer-col__heading {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-text-muted);
    margin: 0 0 var(--space-5);
  }

  .footer-tagline {
    color: var(--brand-text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: var(--space-4) 0 var(--space-6);
    max-width: 280px;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    max-width: 22rem;
  }

  .footer-social__link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-text-muted);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .footer-social__link:hover {
    border-color: var(--brand-accent-ink);
    color: var(--brand-accent-ink-hover);
  }

  .footer-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-nav__link {
    color: var(--brand-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1.5;
    transition: color var(--transition-base);
  }

  .footer-nav__link:hover {
    color: var(--brand-accent-ink-hover);
  }

  .footer-nav__link:visited {
    color: var(--brand-text-muted);
  }

  .footer-nav__link:visited:hover {
    color: var(--brand-accent-ink-hover);
  }

  .footer-newsletter__text {
    color: var(--brand-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }

  .footer-newsletter__row {
    display: flex;
    gap: var(--space-2);
  }

  .footer-newsletter__input {
    flex: 1;
    font-size: var(--text-sm);
  }

  .footer-newsletter__btn {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 !important;
    border-radius: var(--radius-md) !important;
  }

  .footer-newsletter__btn :global(.wind-decor-btn__label) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-newsletter__success {
    display: none;
    color: var(--brand-success);
    font-size: var(--text-sm);
    margin: var(--space-3) 0 0;
  }

  .footer-newsletter__success.is-visible {
    display: block;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: var(--space-6) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer-bottom__copy {
    color: var(--brand-text-faint);
    font-size: var(--text-xs);
    margin: 0;
  }

  .footer-bottom__location {
    color: var(--brand-text-faint);
    font-size: var(--text-xs);
    margin: 0;
  }

  .footer-bottom__theme {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-bottom__theme-label {
    color: var(--brand-text-faint);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
  }

  .footer-theme-pill {
    display: flex;
    gap: var(--space-1);
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-full);
    padding: 3px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-theme-btn {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    border: none;
    background: transparent;
    color: var(--brand-text-faint);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
  }

  .footer-theme-btn:hover,
  .footer-theme-btn.active {
    background: var(--brand-accent);
    color: #0a0a0a;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1200px) {
    .footer-top {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .footer-col--brand {
      grid-column: 1 / -1;
    }

    .footer-col--newsletter {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .footer-col--brand {
      grid-column: 1;
    }

    .footer-col--newsletter {
      grid-column: 1;
    }

    .footer-newsletter__row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
    }

    .footer-newsletter__input {
      width: 100%;
      min-height: 44px;
    }

    .footer-newsletter__btn {
      align-self: stretch;
      width: 100%;
      max-width: none;
      min-height: 44px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
      text-align: center;
    }

    .footer-bottom__copy,
    .footer-bottom__location {
      width: 100%;
    }

    .footer-bottom__theme {
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 480px) {
    .footer-inner {
      padding: 0 var(--space-4);
    }

    .site-footer {
      padding-top: var(--space-12);
    }
  }

  :global(body.light-theme) .site-footer {
    background: #f0f1ee;
    border-top-color: rgba(0, 0, 0, 0.08);
  }

  :global(body.light-theme) .footer-bottom {
    border-top-color: rgba(0, 0, 0, 0.08);
  }

  :global(body.light-theme) .footer-theme-pill {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
  }
</style>

<script is:inline>
  const form = document.getElementById('footerNewsletterForm');
  const success = document.getElementById('newsletterSuccess');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (success) {
      success.classList.add('is-visible');
    }
    if (form instanceof HTMLFormElement) {
      form.reset();
    }
  });

  document.querySelectorAll('.theme-btn-footer').forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.getAttribute('data-theme');
      if (theme) {
        window.dispatchEvent(
          new CustomEvent('theme-change', { detail: theme })
        );
      }
    });
  });
</script>
