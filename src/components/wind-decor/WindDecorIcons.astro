---
import { WIND_DECOR_PATH_1, WIND_DECOR_PATH_2, WIND_DECOR_PATH_3 } from './paths';

const svgStyle =
  'shape-rendering:geometricPrecision;text-rendering:geometricPrecision;image-rendering:optimizeQuality;fill-rule:evenodd;clip-rule:evenodd';
---

<div class="wind-decor-btn__icon wind-decor-btn__icon--1" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26.3 65.33" style={svgStyle}>
    <path fill="currentColor" d={WIND_DECOR_PATH_1} />
  </svg>
</div>
<div class="wind-decor-btn__icon wind-decor-btn__icon--2" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 11.67 37.63" style={svgStyle}>
    <path fill="currentColor" d={WIND_DECOR_PATH_2} />
  </svg>
</div>
<div class="wind-decor-btn__icon wind-decor-btn__icon--3" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25.29 76.92" style={svgStyle}>
    <path fill="currentColor" d={WIND_DECOR_PATH_3} />
  </svg>
</div>
