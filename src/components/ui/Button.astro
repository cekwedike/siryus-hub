---
import { cn } from '../../lib/utils/cn';

export interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed';

const variants = {
  primary: 'bg-[#D1DF4B] text-[#1B1B1E] hover:bg-[#C5D340] focus:ring-[#D1DF4B]',
  secondary: 'bg-[#323836] text-[#D1DF4B] hover:bg-[#1B1B1E] focus:ring-[#323836]',
  outline: 'border-2 border-[#323836] text-[#323836] hover:bg-[#323836] hover:text-[#D1DF4B] focus:ring-[#323836]',
  ghost: 'text-[#323836] hover:bg-[#D1DF4B]/20 focus:ring-[#D1DF4B]',
};

const sizes = {
  sm: 'text-xs sm:text-sm px-3 sm:px-4 py-2 rounded-md',
  md: 'text-sm sm:text-base px-4 sm:px-6 py-2.5 sm:py-3 rounded-md',
  lg: 'text-base sm:text-lg px-6 sm:px-8 py-3 sm:py-4 rounded-lg',
};

const classes = cn(baseStyles, variants[variant], sizes[size], className);

const Tag = href ? 'a' : 'button';
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  {...rest}
>
  <slot />
</Tag>
