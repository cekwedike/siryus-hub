---
import { cn } from '../../lib/utils/cn';

export interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  class?: string;
}

const {
  title,
  subtitle,
  align = 'left',
  class: className,
} = Astro.props;

const alignments = {
  left: 'text-left',
  center: 'text-center mx-auto',
  right: 'text-right ml-auto',
};
---

<div class={cn('mb-6 md:mb-8 lg:mb-12 max-w-4xl', alignments[align], className)}>
  {subtitle && (
    <p class="text-xs sm:text-sm font-semibold text-[#949BA0] uppercase tracking-wider mb-2">
      {subtitle}
    </p>
  )}
  <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-[#1B1B1E] leading-tight">
    {title}
  </h2>
  {Astro.slots.has('description') && (
    <div class="mt-3 md:mt-4 text-base md:text-lg text-[#323836] max-w-3xl">
      <slot name="description" />
    </div>
  )}
</div>
