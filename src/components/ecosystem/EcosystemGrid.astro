---
import EcosystemCard from './EcosystemCard.astro'
import type { EcosystemCard as EcosystemCardData } from '../../data/ecosystem'

interface Props {
  cards: EcosystemCardData[]
}

const { cards } = Astro.props
---

<section class="ecosystem-grid" aria-labelledby="ecosystem-grid-title">
  <div class="ecosystem-grid__intro">
    <h2 id="ecosystem-grid-title">Find your place.</h2>
    <p>Four distinct brands. One clear way into each.</p>
  </div>

  <div class="ecosystem-grid__cards">
    {cards.map((card, index) => <EcosystemCard card={card} index={index} />)}
  </div>
</section>
