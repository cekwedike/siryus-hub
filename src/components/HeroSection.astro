---
// Section 1: SIRYUS A.M Hero Section
// First full-screen section with 3D character, hero text, and CTA
---

<section class="hero-section" id="hero" data-section="1">
  <div class="hero-container">
    <!-- Left Side: 3D Character Card -->
    <div class="hero-left parallax-slow">
      <div class="character-card">
        <div class="character-content">
          <!-- Placeholder for 3D character/image -->
          <div class="character-placeholder">
            <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=900&q=80&auto=format&fit=crop" alt="Creative studio and performance" class="character-img" width="900" height="1200" loading="eager" decoding="async" />
          </div>
        </div>
      </div>
      <h3 class="tagline">WE CREATE MAGIC</h3>
    </div>

    <!-- Right Side: Hero Content -->
    <div class="hero-right parallax-normal">
      <!-- Main Headline -->
      <div class="hero-headline">
        <h1 class="headline-line-1">LET'S MAKE</h1>
        <h1 class="headline-line-2">SOME MAGIC!</h1>
      </div>

      <!-- CTA Button -->
      <a href="/contact" class="cta-button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>Contact us</span>
      </a>

      <!-- Description Text -->
      <div class="hero-description">
        <p>
          We are misfits; we are not an agency, and we don't just do production; 
          we are a combination of both thinkers and doers. We're a combination of 
          human and more than human. A collaboration between art and tech.
        </p>
      </div>
    </div>

    <!-- Top Right Decorative Element -->
    <div class="decorative-character parallax-fast">
      <svg width="150" height="120" viewBox="0 0 150 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Stick figure -->
        <circle cx="20" cy="20" r="10" stroke="#D1DF4B" stroke-width="2" fill="none"/>
        <line x1="20" y1="30" x2="20" y2="55" stroke="#D1DF4B" stroke-width="2"/>
        <line x1="20" y1="38" x2="10" y2="48" stroke="#D1DF4B" stroke-width="2"/>
        <line x1="20" y1="38" x2="30" y2="48" stroke="#D1DF4B" stroke-width="2"/>
        <line x1="20" y1="55" x2="10" y2="70" stroke="#D1DF4B" stroke-width="2"/>
        <line x1="20" y1="55" x2="30" y2="70" stroke="#D1DF4B" stroke-width="2"/>
        <!-- Curved climbing path -->
        <path d="M 35 75 Q 70 50 105 60 Q 130 65 140 45" stroke="#D1DF4B" stroke-width="2" fill="none"/>
        <!-- Large H -->
        <text x="120" y="35" font-size="48" font-weight="900" fill="#D1DF4B" font-family="Arial, sans-serif">H</text>
      </svg>
    </div>

    <!-- Contact Form Arrow -->
    <div class="contact-arrow">
      <span>Contact form</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #050505;
    position: relative;
    overflow: hidden;
    padding: 120px 50px 80px;
  }

  .hero-container {
    max-width: 1600px;
    width: 100%;
    display: grid;
    grid-template-columns: 35% 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
  }

  /* Left Side - Character Card */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .character-card {
    background: #121212;
    border: 1px solid rgba(245, 249, 233, 0.1);
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4), 
                0 0 60px rgba(209, 223, 75, 0.1);
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .character-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(209, 223, 75, 0.1) 0%, transparent 70%);
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .character-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.5), 
                0 0 80px rgba(209, 223, 75, 0.2);
  }

  .character-content {
    position: relative;
    z-index: 1;
  }

  .character-placeholder {
    width: 100%;
    aspect-ratio: 3/4;
    background: linear-gradient(135deg, rgba(209, 223, 75, 0.1) 0%, rgba(209, 223, 75, 0.05) 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .character-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .tagline {
    font-size: 24px;
    font-weight: 900;
    color: #F5F9E9;
    text-align: center;
    letter-spacing: 0.05em;
    margin: 0;
  }

  /* Right Side - Hero Content */
  .hero-right {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .hero-headline {
    margin-bottom: 20px;
  }

  .headline-line-1,
  .headline-line-2 {
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 900;
    color: #F5F9E9;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    text-transform: uppercase;
  }

  .headline-line-2 {
    font-size: clamp(56px, 10vw, 120px);
    color: #D1DF4B;
    text-shadow: 0 0 40px rgba(209, 223, 75, 0.3);
  }

  /* CTA Button */
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #D1DF4B;
    color: #1B1B1E;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    padding: 16px 32px;
    border-radius: 8px;
    transition: all 0.3s ease;
    width: fit-content;
    border: 2px solid #D1DF4B;
  }

  .cta-button:hover {
    background: #D5DD85;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(209, 223, 75, 0.3);
  }

  .cta-button svg {
    stroke: currentColor;
  }

  /* Description */
  .hero-description {
    max-width: 600px;
  }

  .hero-description p {
    font-size: 18px;
    line-height: 1.7;
    color: #949BA0;
    margin: 0;
  }

  /* Decorative Character */
  .decorative-character {
    position: absolute;
    top: 10%;
    right: 5%;
    z-index: 10;
  }

  /* Contact Arrow */
  .contact-arrow {
    position: absolute;
    bottom: 40px;
    right: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #949BA0;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .contact-arrow:hover {
    color: #D1DF4B;
  }

  .contact-arrow svg {
    animation: bounce-arrow 2s infinite;
  }

  @keyframes bounce-arrow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .hero-container {
      gap: 60px;
    }

    .headline-line-1,
    .headline-line-2 {
      font-size: clamp(40px, 7vw, 80px);
    }

    .decorative-character {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .hero-section {
      padding: 100px 40px 60px;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .hero-left {
      max-width: 400px;
      margin: 0 auto;
    }

    .contact-arrow {
      bottom: 30px;
      right: 40px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 90px 20px 50px;
    }

    .hero-container {
      gap: 40px;
    }

    .hero-left {
      max-width: 350px;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
    }

    .hero-description p {
      font-size: 16px;
    }

    .contact-arrow {
      bottom: 20px;
      right: 20px;
    }
  }

  @media (max-width: 480px) {
    .hero-left {
      max-width: 100%;
    }

    .character-card {
      padding: 24px;
    }

    .tagline {
      font-size: 20px;
    }

    .headline-line-1,
    .headline-line-2 {
      font-size: clamp(32px, 10vw, 48px);
    }

    .cta-button {
      padding: 14px 24px;
      font-size: 15px;
    }

    .hero-description p {
      font-size: 15px;
      line-height: 1.6;
    }
  }

  /* Parallax Classes */
  .parallax-slow {
    transition: transform 0.5s ease-out;
  }

  .parallax-normal {
    transition: transform 0.3s ease-out;
  }

  .parallax-fast {
    transition: transform 0.2s ease-out;
  }

  /* Light Theme */
  :global(body.light-theme) .hero-section {
    background: #F5F9E9;
  }

  :global(body.light-theme) .character-card {
    background: #FFFFFF;
    border-color: rgba(27, 27, 30, 0.1);
  }

  :global(body.light-theme) .tagline,
  :global(body.light-theme) .headline-line-1 {
    color: #1B1B1E;
  }

  :global(body.light-theme) .hero-description p {
    color: #5A5A5D;
  }

  :global(body.light-theme) .contact-arrow {
    color: #5A5A5D;
  }

  :global(body.light-theme) .contact-arrow:hover {
    color: #D1DF4B;
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .character-card,
    .character-img,
    .cta-button,
    .contact-arrow svg {
      animation: none;
    }

    .parallax-slow,
    .parallax-normal,
    .parallax-fast {
      transition: none;
    }
  }
</style>
