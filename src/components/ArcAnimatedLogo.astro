<style>
  .arc-logo-wrap {
    width: clamp(220px, 35vw, 320px);
  }

  .arc-mark {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .arc-mark > :is(circle, path):not(.arc-wordmark) {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }

  .arc-mark > .arc-wordmark {
    opacity: 0;
    animation: arc-text-fade 1.2s ease 2.5s forwards;
  }

  @keyframes arc-text-fade {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc-mark > * {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const mark = document.querySelector('.arc-mark');
    if (!(mark instanceof SVGElement)) return;
    const parts = Array.from(mark.querySelectorAll(':scope > path:not(.arc-wordmark), :scope > circle'));
    parts.forEach((part) => {
      const x = Math.round((Math.random() * 600) - 300);
      const y = Math.round((Math.random() * 600) - 300);
      const rotation = Math.round((Math.random() * 360) - 180);
      const delay = Math.random() * 2;
      const duration = 2.8 + (Math.random() * 1.4);
      part.animate(
        [
          { transform: `translate(${x}px, ${y}px) rotate(${rotation}deg) scale(0)`, opacity: 0 },
          { transform: 'translate(0px, 0px) rotate(0deg) scale(1)', opacity: 1 }
        ],
        {
          duration: duration * 1000,
          delay: delay * 1000,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          fill: 'forwards',
          iterations: 1
        }
      );
    });
  })();
</script>
