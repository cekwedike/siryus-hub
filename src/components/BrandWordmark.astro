---
/**
 * SIRYUS text logo only. No underline (removed decorative accent line).
 */
interface Props {
  href?: string;
  variant?: 'nav' | 'sidebar' | 'footer' | 'marketing';
  ariaLabel?: string;
}

const {
  href = '/home',
  variant = 'nav',
  ariaLabel = 'SIRYUS, go to home',
} = Astro.props;
---

<a href={href} class={"brand-wordmark brand-wordmark--" + variant} aria-label={ariaLabel}>
  <span class="brand-wordmark__primary">SIRYUS</span>
</a>

<style>
  .brand-wordmark {
    display: inline-block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, color 0.2s ease;
  }

  .brand-wordmark:hover {
    transform: scale(1.02);
  }

  .brand-wordmark__primary {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: 0.28em;
    color: #f5f9e9;
    line-height: 1.1;
    transition: color 0.2s ease, letter-spacing 0.25s ease;
  }

  .brand-wordmark:hover .brand-wordmark__primary {
    color: var(--brand-accent-ink);
    letter-spacing: 0.3em;
  }

  .brand-wordmark--nav .brand-wordmark__primary {
    font-size: clamp(0.78rem, 1.1vw, 0.95rem);
    letter-spacing: 0.32em;
  }

  .brand-wordmark--sidebar .brand-wordmark__primary {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    letter-spacing: 0.3em;
  }

  .brand-wordmark--footer .brand-wordmark__primary {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    letter-spacing: 0.26em;
  }

  .brand-wordmark--marketing .brand-wordmark__primary {
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    letter-spacing: 0.28em;
  }

  :global(body.light-theme) .brand-wordmark__primary {
    color: #1b1b1e;
  }
</style>
