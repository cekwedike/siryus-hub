---
import { cn } from '../../lib/utils/cn';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/artists', label: 'Artists' },
  { href: '/community', label: 'Community' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#F5F9E9]/95 backdrop-blur-md border-b border-[#D5DD85]/30">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 hover:opacity-80 transition-opacity">
        <div class="h-8 w-8 bg-[#323836] rounded-md flex items-center justify-center text-[#D1DF4B] font-bold text-sm">
          SA
        </div>
        <span class="hidden sm:block font-semibold text-lg text-[#1B1B1E]">
          SIRYUS A.M
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class={cn(
              "px-4 py-2 rounded-md text-sm font-medium transition-colors",
              isActive(item.href)
                ? "bg-[#323836] text-[#D1DF4B]"
                : "text-[#323836] hover:bg-[#D1DF4B]/20 hover:text-[#1B1B1E]"
            )}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- CTA Button (Desktop) -->
      <div class="hidden lg:flex items-center space-x-4">
        <a
          href="/contact"
          class="px-6 py-2 bg-[#D1DF4B] text-[#1B1B1E] rounded-md font-semibold hover:bg-[#C5D340] transition-colors"
        >
          Work With Us
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 rounded-md text-[#323836] hover:bg-[#D1DF4B]/20 transition-colors"
        aria-label="Toggle mobile menu"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu (Hidden by default) -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[#D5DD85]/30 bg-[#F5F9E9]">
    <nav class="container mx-auto px-4 py-4 space-y-1">
      {navItems.map(item => (
        <a
          href={item.href}
          class={cn(
            "block px-4 py-3 rounded-md text-sm font-medium transition-colors",
            isActive(item.href)
              ? "bg-[#323836] text-[#D1DF4B]"
              : "text-[#323836] hover:bg-[#D1DF4B]/20 hover:text-[#1B1B1E]"
          )}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact"
        class="block px-4 py-3 bg-[#D1DF4B] text-[#1B1B1E] rounded-md font-semibold text-center hover:bg-[#C5D340] transition-colors"
      >
        Work With Us
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!mobileMenuButton?.contains(e.target as Node) && 
        !mobileMenu?.contains(e.target as Node)) {
      mobileMenu?.classList.add('hidden');
    }
  });

  // Close mobile menu on route change
  document.addEventListener('astro:after-swap', () => {
    mobileMenu?.classList.add('hidden');
  });
</script>
