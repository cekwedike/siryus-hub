<style>
  .arc-footer {
    position: relative;
    overflow: hidden;
    background: #0d0b09;
    border-top: 1px solid rgba(242, 121, 48, 0.2);
    color: #ffffff;
    padding: 2.75rem 1.25rem 2.5rem;
    font-family: 'Syne', sans-serif;
  }

  .arc-footer__texture {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 12% 28%, rgba(242, 121, 48, 0.13), transparent 33%),
      radial-gradient(circle at 84% 76%, rgba(242, 121, 48, 0.1), transparent 35%);
    pointer-events: none;
  }

  .arc-footer__inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .arc-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 2.75rem);
  }

  .arc-footer__primary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .arc-footer__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .arc-footer__brand-text {
    min-width: 0;
  }

  .arc-footer__logo-wrap {
    position: relative;
    flex-shrink: 0;
    width: 3.25rem;
    height: 3.25rem;
  }

  .arc-footer__logo {
    width: 3.25rem;
    height: 3.25rem;
    object-fit: contain;
    display: block;
  }

  .arc-footer__logo--on-light {
    display: none;
  }

  :global(body.arc-route.light-theme) .arc-footer__logo--on-dark {
    display: none;
  }

  :global(body.arc-route.light-theme) .arc-footer__logo--on-light {
    display: block;
  }

  .arc-footer__title {
    margin: 0;
    letter-spacing: 0.03em;
    font-size: 1.22rem;
    font-weight: 600;
  }

  .arc-footer__back {
    margin: 0.15rem 0 0;
    font-size: 0.92rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f27930;
  }

  .arc-footer__nav {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin: 0;
    padding: 0 0 0 calc(3.25rem + 0.75rem);
    list-style: none;
  }

  .arc-footer__link-sep {
    opacity: 0.45;
    user-select: none;
  }

  .arc-footer__nav-link {
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f27930;
    text-decoration: none;
    font-weight: 600;
  }

  .arc-footer__nav-link:hover {
    text-decoration: underline;
  }

  .arc-footer__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.1rem;
    flex-shrink: 0;
  }

  .arc-footer__legal {
    margin-top: 1.65rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(242, 121, 48, 0.22);
  }

  .arc-footer__attribution {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.45;
    color: #ffffff;
    max-width: 42rem;
  }

  .arc-footer__attribution a,
  .arc-footer__socials a {
    color: #ffffff;
    text-decoration-color: rgba(242, 121, 48, 0.7);
    text-underline-offset: 0.2em;
  }

  .arc-footer__socials {
