<footer class="arc-footer" aria-label="ARC footer">
  <div class="arc-footer__texture" aria-hidden="true"></div>
  <div class="arc-footer__inner">
    <div class="arc-footer__top">
      <a class="arc-footer__brand" href="https://www.siryushub.com" aria-label="Go to Siryus Hub homepage">
        <img src="/arc/ARC LOGO.png" alt="ARC logo" loading="lazy" />
        <div>
          <p class="arc-footer__title">Ascent. Refuge. Collective.</p>
          <p class="arc-footer__back">Back to siryushub.com</p>
        </div>
      </a>
      <div class="arc-footer__socials" aria-label="ARC social links">
        <a href="" aria-label="ARC Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.8A3.95 3.95 0 0 0 3.8 7.75v8.5a3.95 3.95 0 0 0 3.95 3.95h8.5a3.95 3.95 0 0 0 3.95-3.95v-8.5a3.95 3.95 0 0 0-3.95-3.95h-8.5Zm8.95 1.45a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8A3.2 3.2 0 1 0 12 15.2 3.2 3.2 0 0 0 12 8.8Z"/></svg>
        </a>
        <a href="" aria-label="ARC YouTube">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.2a2.92 2.92 0 0 0-2.06-2.06C17.75 4.6 12 4.6 12 4.6s-5.75 0-7.54.54A2.92 2.92 0 0 0 2.4 7.2 30.9 30.9 0 0 0 1.9 12a30.9 30.9 0 0 0 .5 4.8 2.92 2.92 0 0 0 2.06 2.06c1.79.54 7.54.54 7.54.54s5.75 0 7.54-.54a2.92 2.92 0 0 0 2.06-2.06 30.9 30.9 0 0 0 .5-4.8 30.9 30.9 0 0 0-.5-4.8ZM10.1 15.25V8.75L15.8 12l-5.7 3.25Z"/></svg>
        </a>
        <a href="" aria-label="ARC Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8.2h2.77l.42-3.2H13.5V8.56c0-.93.26-1.56 1.59-1.56h1.7V4.15a22.8 22.8 0 0 0-2.47-.13c-2.45 0-4.12 1.49-4.12 4.24v2.34H7.4v3.2h2.8V22h3.3Z"/></svg>
        </a>
      </div>
    </div>
    <div class="arc-footer__divider" aria-hidden="true"></div>
    <div class="arc-footer__meta">
      <p class="arc-footer__attribution">
        An initiative of
        <a href="https://www.siryushub.com">Siryus Creative Media Ltd</a>
      </p>
      <div class="arc-footer__theme-toggle" role="group" aria-label="Theme">
        <button type="button" data-theme="dark">Dark</button>
        <button type="button" data-theme="light">Light</button>
        <button type="button" data-theme="device">System</button>
      </div>
    </div>

  </div>
</footer>

<style>
  .arc-footer {
    position: relative;
    overflow: hidden;
    background: #0d0b09;
    border-top: 1px solid rgba(242, 121, 48, 0.2);
    color: #ffffff;
    padding: 2.75rem 1.25rem 2.5rem;
    font-family: 'Syne', sans-serif;
  }

  .arc-footer__texture {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 12% 28%, rgba(242, 121, 48, 0.13), transparent 33%),
      radial-gradient(circle at 84% 76%, rgba(242, 121, 48, 0.1), transparent 35%);
    pointer-events: none;
  }

  .arc-footer__inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
  }

  .arc-footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .arc-footer__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .arc-footer__brand img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }

  .arc-footer__title {
    margin: 0;
    letter-spacing: 0.03em;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .arc-footer__back {
    margin: 0.15rem 0 0;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f27930;
  }

  .arc-footer__divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(242, 121, 48, 0.25), rgba(242, 121, 48, 0.55), rgba(242, 121, 48, 0.25));
  }

  .arc-footer__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .arc-footer__attribution {
    margin: 0;
    font-size: 0.9rem;
    color: #ffffff;
  }

  .arc-footer__attribution a,
  .arc-footer__socials a {
    color: #ffffff;
    text-decoration-color: rgba(242, 121, 48, 0.7);
    text-underline-offset: 0.2em;
  }

  .arc-footer__socials {
    display: flex;
    gap: 0.6rem;
  }

  .arc-footer__socials a {
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid rgba(242, 121, 48, 0.5);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    text-decoration: none;
  }

  .arc-footer__socials a:hover {
    background: #f27930;
    color: #0d0b09;
    transform: translateY(-2px);
  }

  .arc-footer__socials svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
  }

  .arc-footer__theme-toggle {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .arc-footer__theme-toggle button {
    border: 1px solid rgba(242, 121, 48, 0.5);
    background: rgba(13, 11, 9, 0.42);
    color: #ffffff;
    font: inherit;
    font-size: 0.84rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .arc-footer__theme-toggle button:hover {
    border-color: rgba(242, 121, 48, 0.85);
  }

  .arc-footer__theme-toggle button.active {
    background: #f27930;
    color: #0d0b09;
    border-color: #f27930;
  }

  :global(body.arc-route.light-theme) .arc-footer__theme-toggle button {
    color: #000000;
    border-color: rgba(0, 0, 0, 0.28);
    background: rgba(255, 255, 255, 0.9);
  }

  :global(body.arc-route.light-theme) .arc-footer {
    background: #ffffff;
    color: #000000;
    border-top-color: rgba(0, 0, 0, 0.2);
  }

  :global(body.arc-route.light-theme) .arc-footer__texture {
    background:
      radial-gradient(circle at 12% 28%, rgba(242, 121, 48, 0.1), transparent 33%),
      radial-gradient(circle at 84% 76%, rgba(0, 0, 0, 0.05), transparent 35%);
  }

  :global(body.arc-route.light-theme) .arc-footer__attribution,
  :global(body.arc-route.light-theme) .arc-footer__attribution a,
  :global(body.arc-route.light-theme) .arc-footer__title {
    color: #000000;
  }

  :global(body.arc-route.light-theme) .arc-footer__socials a {
    color: #000000;
    border-color: rgba(0, 0, 0, 0.28);
  }

  :global(body.arc-route.light-theme) .arc-footer__socials a:hover {
    color: #ffffff;
  }

  :global(body.arc-route.light-theme) .arc-footer__back {
    color: #a0522d;
  }

  @media (max-width: 700px) {
    .arc-footer__top {
      align-items: flex-start;
      flex-direction: column;
    }
    .arc-footer__meta {
      align-items: flex-start;
      flex-direction: column;
    }
    .arc-footer__theme-toggle button {
      font-size: 0.78rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const THEMES = { dark: 'dark', light: 'light', device: 'device' };
    const buttons = Array.from(document.querySelectorAll('.arc-footer__theme-toggle button[data-theme]'));
    if (buttons.length === 0) return;
    const getResolvedTheme = (theme) => {
      if (theme === THEMES.device) return media.matches ? THEMES.dark : THEMES.light;
      return theme;
    };
    const applyTheme = (theme) => {
      const resolved = getResolvedTheme(theme);
      if (resolved === THEMES.light) document.body.classList.add('light-theme');
      else document.body.classList.remove('light-theme');
      localStorage.setItem('theme', theme);
    };
    const applyActive = () => {
      const saved = localStorage.getItem('theme') || THEMES.dark;
      buttons.forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-theme') === saved);
      });
    };
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const theme = button.getAttribute('data-theme');
        if (!theme) return;
        applyTheme(theme);
        applyActive();
      });
    });
    media.addEventListener('change', () => {
      const saved = localStorage.getItem('theme') || THEMES.dark;
      if (saved === THEMES.device) applyTheme(THEMES.device);
      applyActive();
    });
    applyTheme(localStorage.getItem('theme') || THEMES.dark);
    applyActive();
    document.addEventListener('astro:page-load', () => {
      applyTheme(localStorage.getItem('theme') || THEMES.dark);
      applyActive();
    });
  })();
</script>
