---
import '../styles/brand-tokens.css';
---

<div
  class="theme-toggle"
  role="group"
  aria-label="Color theme"
>
  <div class="theme-toggle__island">
    <button
      type="button"
      class="theme-toggle__btn"
      data-theme="device"
      aria-label="Use device theme"
      title="System"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
    </button>
    <button
      type="button"
      class="theme-toggle__btn"
      data-theme="light"
      aria-label="Light theme"
      title="Light"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>
    <button
      type="button"
      class="theme-toggle__btn"
      data-theme="dark"
      aria-label="Dark theme"
      title="Dark"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .theme-toggle {
    position: fixed;
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
    z-index: var(--z-overlay);
    pointer-events: auto;
  }

  @media (max-width: 768px) and (min-width: 481px) {
    .theme-toggle {
      top: auto;
      bottom: 24px;
      right: 12px;
      transform: none;
    }

    .theme-toggle__island {
      padding: 5px;
      gap: 4px;
    }

    .theme-toggle__btn {
      width: 32px;
      height: 32px;
    }

    .theme-toggle__btn svg {
      width: 16px;
      height: 16px;
    }
  }

  @media (max-width: 480px) {
    .theme-toggle {
      display: none;
    }
  }

  .theme-toggle__island {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 8px;
    border-radius: 999px;
    background: rgba(10, 10, 12, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  :global(body.light-theme) .theme-toggle__island {
    background: rgba(255, 255, 255, 0.65);
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .theme-toggle__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
  }

  :global(body.light-theme) .theme-toggle__btn {
    color: #0a0a0a;
  }

  .theme-toggle__btn:hover {
    background: rgba(209, 223, 75, 0.18);
    color: #f5f9e9;
  }

  :global(body.light-theme) .theme-toggle__btn:hover {
    background: rgba(61, 71, 0, 0.12);
    color: #0a0a0a;
  }

  .theme-toggle__btn.active {
    background: #d1df4b;
    color: #0a0a0a;
  }

  .theme-toggle__btn.active:hover {
    background: #d1df4b;
    color: #0a0a0a;
  }

</style>

<script is:inline>
  // This component is the single source of truth for theme management across the site
  (function () {
    const THEMES = { DARK: 'dark', LIGHT: 'light', DEVICE: 'device' };

    function getDeviceTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? THEMES.DARK
        : THEMES.LIGHT;
    }

    function getThemeControlButtons() {
      return document.querySelectorAll(
        '.theme-toggle__btn[data-theme], .theme-btn-footer[data-theme]'
      );
    }

    function applyTheme(theme) {
      var effective =
        theme === THEMES.DEVICE ? getDeviceTheme() : theme;
      if (effective === THEMES.LIGHT) {
        document.body.classList.add('light-theme');
      } else {
        document.body.classList.remove('light-theme');
      }
      try {
        localStorage.setItem('theme', theme);
      } catch (e) {}

      getThemeControlButtons().forEach(function (btn) {
        if (btn.getAttribute('data-theme') === theme) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    function init() {
      var saved = localStorage.getItem('theme') || THEMES.DARK;
      applyTheme(saved);

      document.querySelectorAll('.theme-toggle__btn[data-theme]').forEach(
        function (btn) {
          btn.addEventListener('click', function () {
            var t = btn.getAttribute('data-theme');
            if (t) applyTheme(t);
          });
        }
      );

      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', function () {
          var current = localStorage.getItem('theme') || THEMES.DARK;
          if (current === THEMES.DEVICE) applyTheme(THEMES.DEVICE);
        });

      window.addEventListener('theme-change', function (e) {
        var d = e.detail;
        if (d === THEMES.DARK || d === THEMES.LIGHT || d === THEMES.DEVICE) {
          applyTheme(d);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('astro:page-load', function () {
      var saved = localStorage.getItem('theme') || THEMES.DARK;
      applyTheme(saved);
    });
  })();
</script>
