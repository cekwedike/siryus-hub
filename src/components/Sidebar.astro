---
---

<aside
  id="sidebar"
  class="sidebar"
  aria-label="Site menu"
  aria-hidden="true"
>
  <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

  <div class="sidebar-panel">
    <div class="sidebar-header">
      <span class="sidebar-wordmark">SIRYUS</span>
      <button
        class="sidebar-close"
        id="sidebarClose"
        aria-label="Close menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="sidebar-nav" aria-label="Sidebar navigation">
      <ul class="sidebar-links" role="list">
        <li>
          <a href="/home" class="sidebar-link">
            <span class="sidebar-link__num">01</span>
            <span class="sidebar-link__label">Home</span>
          </a>
        </li>
        <li>
          <a href="/about" class="sidebar-link">
            <span class="sidebar-link__num">02</span>
            <span class="sidebar-link__label">About</span>
          </a>
        </li>
        <li>
          <a href="/siryus-am" class="sidebar-link">
            <span class="sidebar-link__num">03</span>
            <span class="sidebar-link__label">SIRYUS A.M</span>
          </a>
        </li>
        <li>
          <a href="/artists" class="sidebar-link">
            <span class="sidebar-link__num">04</span>
            <span class="sidebar-link__label">Artists</span>
          </a>
        </li>
        <li>
          <a href="/services" class="sidebar-link">
            <span class="sidebar-link__num">05</span>
            <span class="sidebar-link__label">Services</span>
          </a>
        </li>
        <li>
          <a href="/community" class="sidebar-link">
            <span class="sidebar-link__num">06</span>
            <span class="sidebar-link__label">Community</span>
          </a>
        </li>
        <li>
          <a href="/blog" class="sidebar-link">
            <span class="sidebar-link__num">07</span>
            <span class="sidebar-link__label">Blog</span>
          </a>
        </li>
        <li>
          <a href="/projects" class="sidebar-link">
            <span class="sidebar-link__num">08</span>
            <span class="sidebar-link__label">Projects</span>
          </a>
        </li>
        <li>
          <a href="/reels" class="sidebar-link">
            <span class="sidebar-link__num">09</span>
            <span class="sidebar-link__label">Reels</span>
          </a>
        </li>
        <li>
          <a href="/contact" class="sidebar-link">
            <span class="sidebar-link__num">10</span>
            <span class="sidebar-link__label">Contact</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="sidebar-footer">
      <a href="mailto:management@siryushub.com" class="sidebar-email">
        management@siryushub.com
      </a>
      <p class="sidebar-legal">
        &copy; {new Date().getFullYear()} Siryus Creative Media Ltd
      </p>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset: 0;
    z-index: var(--z-sidebar);
    pointer-events: none;
  }

  .sidebar.is-open {
    pointer-events: all;
  }

  .sidebar-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity var(--transition-slow);
    backdrop-filter: blur(4px);
  }

  .sidebar.is-open .sidebar-overlay {
    opacity: 1;
  }

  .sidebar-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(420px, 100vw);
    height: 100%;
    background: #0a0a0a;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    transform: translateX(100%);
    transition: transform var(--transition-slow);
    overflow-y: auto;
  }

  .sidebar.is-open .sidebar-panel {
    transform: translateX(0);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-12);
  }

  .sidebar-wordmark {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--brand-accent);
    letter-spacing: 0.08em;
  }

  .sidebar-close {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    color: var(--brand-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
  }

  .sidebar-close:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
  }

  .sidebar-nav {
    flex: 1;
  }

  .sidebar-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    text-decoration: none;
    padding: var(--space-4) var(--space-3);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
    border: 1px solid transparent;
  }

  .sidebar-link:hover {
    background: rgba(209, 223, 75, 0.06);
    border-color: rgba(209, 223, 75, 0.15);
  }

  .sidebar-link__num {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--brand-text-muted);
    letter-spacing: 0.06em;
    flex-shrink: 0;
    transition: color var(--transition-base);
  }

  .sidebar-link__label {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--brand-text);
    letter-spacing: -0.01em;
    transition: color var(--transition-base);
  }

  .sidebar-link:hover .sidebar-link__num {
    color: var(--brand-accent);
  }

  .sidebar-link:hover .sidebar-link__label {
    color: var(--brand-accent);
  }

  .sidebar-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-email {
    color: var(--brand-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .sidebar-email:hover {
    color: var(--brand-accent);
  }

  .sidebar-legal {
    color: var(--brand-text-faint);
    font-size: var(--text-xs);
    margin: 0;
  }
</style>

<script>
  const overlay = document.getElementById('sidebarOverlay');
  const closeBtn = document.getElementById('sidebarClose');
  const sidebar = document.getElementById('sidebar');
  const hamburger = document.getElementById('hamburgerBtn');

  function closeSidebar() {
    if (!sidebar || !hamburger) return;
    sidebar.classList.remove('is-open');
    sidebar.setAttribute('aria-hidden', 'true');
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  overlay?.addEventListener('click', closeSidebar);
  closeBtn?.addEventListener('click', closeSidebar);

  sidebar?.querySelectorAll('.sidebar-link').forEach((link) => {
    link.addEventListener('click', closeSidebar);
  });
</script>
