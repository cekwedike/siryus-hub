---
import WindDecorButton from './WindDecorButton.astro';
---

<aside
  id="sidebar"
  class="sidebar"
  aria-label="Site menu"
  aria-hidden="true"
  inert
>
  <div
    class="sidebar-overlay"
    id="sidebarOverlay"
    aria-hidden="true"
  ></div>

  <div class="sidebar-panel">
    <div class="sidebar-header">
      <span class="sidebar-wordmark">SIRYUS</span>
      <button
        class="sidebar-close"
        id="sidebarClose"
        aria-label="Close menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="sidebar-nav" aria-label="Sidebar navigation">
      <!-- Siryus Hub arm -->
      <div class="sidebar-group">
        <span class="sidebar-group__label">Siryus Hub</span>
        <ul class="sidebar-links" role="list">
          <li>
            <a href="/" class="sidebar-link">
              <span class="sidebar-link__num">01</span>
              <span class="sidebar-link__label">Home</span>
            </a>
          </li>
          <li>
            <a href="/about" class="sidebar-link">
              <span class="sidebar-link__num">02</span>
              <span class="sidebar-link__label">About</span>
            </a>
          </li>
          <li>
            <a href="/blog" class="sidebar-link">
              <span class="sidebar-link__num">03</span>
              <span class="sidebar-link__label">Blog</span>
            </a>
          </li>
          <li>
            <a href="/community" class="sidebar-link">
              <span class="sidebar-link__num">04</span>
              <span class="sidebar-link__label">Community</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="sidebar-divider" aria-hidden="true"></div>

      <!-- SIRYUS A.M arm -->
      <div class="sidebar-group">
        <span class="sidebar-group__label">SIRYUS A.M</span>
        <ul class="sidebar-links" role="list">
          <li>
            <a href="/siryus-am" class="sidebar-link">
              <span class="sidebar-link__num">05</span>
              <span class="sidebar-link__label">
                Artist Management
              </span>
            </a>
          </li>
          <li>
            <a href="/artists" class="sidebar-link">
              <span class="sidebar-link__num">06</span>
              <span class="sidebar-link__label">Artists</span>
            </a>
          </li>
          <li>
            <a href="/projects" class="sidebar-link">
              <span class="sidebar-link__num">07</span>
              <span class="sidebar-link__label">Projects</span>
            </a>
          </li>
          <li>
            <a href="/studio" class="sidebar-link">
              <span class="sidebar-link__num">08</span>
              <span class="sidebar-link__label">The Studio</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="sidebar-divider" aria-hidden="true"></div>

      <!-- Services arm -->
      <div class="sidebar-group">
        <span class="sidebar-group__label">Services</span>
        <ul class="sidebar-links" role="list">
          <li>
            <a href="/services" class="sidebar-link">
              <span class="sidebar-link__num">09</span>
              <span class="sidebar-link__label">What We Do</span>
            </a>
          </li>
          <li>
            <a href="/contact" class="sidebar-link">
              <span class="sidebar-link__num">10</span>
              <span class="sidebar-link__label">Contact</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="sidebar-divider" aria-hidden="true"></div>

      <!-- Legal arm -->
      <div class="sidebar-group sidebar-group--legal">
        <ul class="sidebar-links sidebar-links--legal" role="list">
          <li>
            <a
              href="/privacy-policy"
              class="sidebar-link sidebar-link--small"
            >
              <span class="sidebar-link__label">
                Privacy Policy
              </span>
            </a>
          </li>
          <li>
            <a
              href="/terms-of-use"
              class="sidebar-link sidebar-link--small"
            >
              <span class="sidebar-link__label">
                Terms of Use
              </span>
            </a>
          </li>
          <li>
            <a href="/faq" class="sidebar-link sidebar-link--small">
              <span class="sidebar-link__label">FAQ</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="sidebar-footer">
      <WindDecorButton href="/contact" class="sidebar-cta">
        Work With Us
      </WindDecorButton>
      <a
        href="mailto:management@siryushub.com"
        class="sidebar-email"
      >
        management@siryushub.com
      </a>
      <p class="sidebar-legal">
        &copy; {new Date().getFullYear()} Siryus Creative Media Ltd
      </p>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset: 0;
    z-index: var(--z-sidebar);
    pointer-events: none;
  }

  .sidebar.is-open {
    pointer-events: all;
  }

  .sidebar-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    opacity: 0;
    transition: opacity var(--transition-slow);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .sidebar.is-open .sidebar-overlay {
    opacity: 1;
  }

  .sidebar-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(440px, 100vw);
    height: 100%;
    background: #080808;
    border-left: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--transition-slow);
    overflow-y: auto;
    overflow-x: hidden;
  }

  .sidebar.is-open .sidebar-panel {
    transform: translateX(0);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-8) var(--space-8) var(--space-6);
    flex-shrink: 0;
  }

  .sidebar-wordmark {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 900;
    color: var(--brand-accent-ink);
    letter-spacing: 0.1em;
  }

  .sidebar-close {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: transparent;
    color: var(--brand-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
    flex-shrink: 0;
  }

  .sidebar-close:hover {
    border-color: var(--brand-accent-ink);
    color: var(--brand-accent-ink-hover);
  }

  .sidebar-nav {
    flex: 1;
    padding: 0 var(--space-6) var(--space-6);
    overflow-y: auto;
  }

  .sidebar-group {
    padding: var(--space-4) 0;
  }

  .sidebar-group__label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-accent-ink);
    display: block;
    margin-bottom: var(--space-2);
    padding: 0 var(--space-2);
  }

  .sidebar-group--legal {
    padding-top: var(--space-3);
  }

  .sidebar-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 0 var(--space-2);
  }

  .sidebar-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    text-decoration: none;
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
    border: 1px solid transparent;
  }

  .sidebar-link:hover {
    background: rgba(209, 223, 75, 0.06);
    border-color: rgba(209, 223, 75, 0.12);
  }

  .sidebar-link:visited {
    color: inherit;
  }

  .sidebar-link__num {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--brand-text-muted);
    letter-spacing: 0.06em;
    flex-shrink: 0;
    width: 20px;
    transition: color var(--transition-base);
  }

  .sidebar-link__label {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--brand-text);
    letter-spacing: -0.01em;
    transition: color var(--transition-base);
    line-height: 1.3;
  }

  .sidebar-link:hover .sidebar-link__num {
    color: var(--brand-accent-ink-hover);
  }

  .sidebar-link:hover .sidebar-link__label {
    color: var(--brand-accent-ink-hover);
  }

  /* Small legal links */
  .sidebar-link--small {
    padding: var(--space-2) var(--space-2);
  }

  .sidebar-link--small .sidebar-link__label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--brand-text-muted);
  }

  .sidebar-link--small:hover .sidebar-link__label {
    color: var(--brand-accent-ink-hover);
  }

  /* Footer */
  .sidebar-footer {
    flex-shrink: 0;
    padding: var(--space-6) var(--space-8) var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sidebar-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-weight: 800;
    font-size: var(--text-base);
    letter-spacing: 0.02em;
    padding: var(--space-4) var(--space-6) !important;
    border-radius: var(--radius-full) !important;
  }

  .sidebar-email {
    color: var(--brand-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    text-align: center;
    transition: color var(--transition-base);
  }

  .sidebar-email:hover {
    color: var(--brand-accent-ink-hover);
  }

  .sidebar-email:visited {
    color: var(--brand-text-muted);
  }

  .sidebar-legal {
    color: var(--brand-text-faint);
    font-size: var(--text-xs);
    margin: 0;
    text-align: center;
  }

  /* Light theme: panel must follow page tokens (vars switch to dark text on light bg) */
  :global(body.light-theme) .sidebar-overlay {
    background: rgba(245, 246, 242, 0.82);
  }

  :global(body.light-theme) .sidebar-panel {
    background: var(--brand-bg-base);
    border-left-color: rgba(0, 0, 0, 0.08);
  }

  :global(body.light-theme) .sidebar-close {
    border-color: rgba(0, 0, 0, 0.12);
    color: var(--brand-text);
  }

  :global(body.light-theme) .sidebar-divider {
    background: rgba(0, 0, 0, 0.08);
  }

  :global(body.light-theme) .sidebar-link__label {
    color: var(--brand-text);
  }

  :global(body.light-theme) .sidebar-link__num {
    color: var(--brand-text-muted);
  }

  :global(body.light-theme) .sidebar-link:hover {
    background: rgba(209, 223, 75, 0.12);
    border-color: rgba(209, 223, 75, 0.22);
  }

  :global(body.light-theme) .sidebar-footer {
    border-top-color: rgba(0, 0, 0, 0.1);
  }

  :global(body.light-theme) .sidebar-email {
    color: var(--brand-text-muted);
  }

  :global(body.light-theme) .sidebar-email:visited {
    color: var(--brand-text-muted);
  }

  :global(body.light-theme) .sidebar-legal {
    color: var(--brand-text-faint);
  }

  @media (max-width: 768px) {
    .sidebar-panel {
      width: 100vw;
      max-width: 100vw;
    }
  }
</style>

<script>
  const overlay = document.getElementById('sidebarOverlay');
  const closeBtn = document.getElementById('sidebarClose');
  const sidebar = document.getElementById('sidebar');
  const hamburger = document.getElementById('hamburgerBtn');

  function openSidebar() {
    if (!sidebar) return;
    sidebar.classList.add('is-open');
    sidebar.setAttribute('aria-hidden', 'false');
    sidebar.removeAttribute('inert');
    hamburger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    if (!sidebar) return;
    sidebar.classList.remove('is-open');
    sidebar.setAttribute('aria-hidden', 'true');
    sidebar.setAttribute('inert', '');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', () => {
    const isOpen = sidebar?.classList.contains('is-open');
    if (isOpen) closeSidebar();
    else openSidebar();
  });

  overlay?.addEventListener('click', closeSidebar);
  closeBtn?.addEventListener('click', closeSidebar);

  sidebar?.querySelectorAll('.sidebar-link').forEach((link) => {
    link.addEventListener('click', closeSidebar);
  });

  sidebar?.querySelectorAll('.sidebar-cta').forEach((link) => {
    link.addEventListener('click', closeSidebar);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    var studioModal = document.getElementById('studio-modal');
    if (studioModal && !studioModal.hidden) return;
    if (sidebar?.classList.contains('is-open')) closeSidebar();
  });
</script>
