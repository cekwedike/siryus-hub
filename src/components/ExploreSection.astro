---
import type { SanityImageSource } from '@sanity/image-url'
import WindDecorButton from './WindDecorButton.astro'
import { sanityClient, urlFor, blogCoverImageUrl } from '../lib/sanity'
import { getAllPosts } from '../lib/queries'

type ArtistCard = {
  name: string
  slug: { current: string }
  oneLiner: string
  photo: SanityImageSource | null
  genre: string[] | null
}

type ProjectCard = {
  title: string
  slug: { current: string }
  excerpt: string | null
  description: string
  category: string
  status: string
}

const featuredArtistQuery = `*[_type == "artist" && active == true && featured == true] | order(coalesce(order, 999) asc, name asc) [0] {
  name,
  slug,
  oneLiner,
  photo,
  genre
}`

const latestInitiativeQuery = `*[_type == "project"
  && status in ["Active", "Coming Soon"]
  && category != "Release Campaign"
] | order(coalesce(publishedAt, _createdAt) desc) [0] {
  title,
  slug,
  excerpt,
  description,
  category,
  status
}`

async function safeFetch<T>(query: string): Promise<T | null> {
  try {
    const row = await sanityClient.fetch<T | null>(query)
    return row ?? null
  } catch {
    return null
  }
}

const latestBlog = (await getAllPosts())[0] ?? null
const featuredArtist = await safeFetch<ArtistCard>(featuredArtistQuery)
const latestProject = await safeFetch<ProjectCard>(latestInitiativeQuery)

function formatBlogDate(iso: string | undefined): string {
  if (!iso) return ''
  const d = new Date(iso)
  if (Number.isNaN(d.getTime())) return ''
  return new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(d)
}

function projectCardText(excerpt: string | null, description: string | null | undefined): string {
  const ex = excerpt?.trim()
  if (ex) return ex
  const desc = typeof description === 'string' ? description.trim() : ''
  if (!desc) return ''
  if (desc.length <= 120) return desc
  return `${desc.slice(0, 120)}…`
}

function genreLabel(genre: string[] | null): string {
  if (!genre?.length) return ''
  return genre.filter(Boolean).join(', ')
}

const FALLBACK_ARTIST = {
  name: 'Max Prodigy',
  oneLiner: 'Nigerian rapper. Deep lyricism. Now managed by SIRYUS A.M.',
  href: '/artists/max-prodigy',
  genreLabel: '',
} as const

const artistDisplay = featuredArtist
  ? {
      name: featuredArtist.name,
      oneLiner: featuredArtist.oneLiner,
      href: `/artists/${featuredArtist.slug.current}`,
      genreLabel: genreLabel(featuredArtist.genre),
      photo: featuredArtist.photo,
    }
  : {
      name: FALLBACK_ARTIST.name,
      oneLiner: FALLBACK_ARTIST.oneLiner,
      href: FALLBACK_ARTIST.href,
      genreLabel: FALLBACK_ARTIST.genreLabel,
      photo: null as SanityImageSource | null,
    }

const blogCoverUrl = blogCoverImageUrl(latestBlog?.coverImage ?? null, 960, 420)

let artistPhotoUrl: string | null = null
if (artistDisplay.photo) {
  try {
    artistPhotoUrl = urlFor(artistDisplay.photo).width(400).height(600).fit('crop').auto('format').url()
  } catch {
    artistPhotoUrl = null
  }
}

const blogMetaLine = latestBlog
  ? (() => {
      const d = formatBlogDate(latestBlog.publishedAt)
      return d ? `${latestBlog.author} · ${d}` : latestBlog.author
    })()
  : 'Coming Soon'
---

<section
  class="latest"
  id="latest"
  aria-labelledby="latest-heading"
>
  <div class="latest__inner">
    <div class="latest__header">
      <h2
        id="latest-heading"
        class="latest__heading"
      >
        Latest From Siryus
      </h2>
      <WindDecorButton href="/blog" variant="secondary" class="latest__view-all" splash={false}>
        View all
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </WindDecorButton>
    </div>

    <div class="latest__grid">
      <!-- Blog -->
      <article class="latest-card latest-card--wide">
        <div class="latest-card__media">
          {latestBlog && blogCoverUrl ? (
            <img
              class="latest-card__img"
              src={blogCoverUrl}
              alt=""
              width="960"
              height="420"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="latest-card__media-placeholder"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="40"
                height="40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
          )}
        </div>
        <div class="latest-card__body">
          <div class="latest-card__meta">
            <span class="latest-card__type">
              {latestBlog?.category?.trim() ? latestBlog.category : 'Blog'}
            </span>
            <span class="latest-card__date">{blogMetaLine}</span>
          </div>
          <h3 class="latest-card__heading">
            {latestBlog?.title ?? 'What Independent Artists Get Wrong About Marketing'}
          </h3>
          <p class="latest-card__excerpt">
            {latestBlog?.excerpt ??
              'Most artists treat marketing as an afterthought. The ones who break through treat it like part of the music.'}
          </p>
          <a
            href={latestBlog?.slug?.current ? `/blog/${latestBlog.slug.current}` : '/blog'}
            class="latest-card__link"
          >
            Read on the blog
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>

      <!-- Artist -->
      <article class="latest-card">
        <div class="latest-card__media">
          {artistPhotoUrl ? (
            <img
              class="latest-card__img"
              src={artistPhotoUrl}
              alt=""
              width="400"
              height="600"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="latest-card__media-placeholder latest-card__media-placeholder--accent"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="40"
                height="40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="18" cy="16" r="3"></circle>
              </svg>
            </div>
          )}
        </div>
        <div class="latest-card__body">
          <div class="latest-card__meta">
            <span class="latest-card__type">Artist</span>
            {artistDisplay.genreLabel ? (
              <span class="latest-card__date">{artistDisplay.genreLabel}</span>
            ) : null}
          </div>
          <h3 class="latest-card__heading">{artistDisplay.name}</h3>
          <p class="latest-card__excerpt">{artistDisplay.oneLiner}</p>
          <a href={artistDisplay.href} class="latest-card__link">
            View profile
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>

      <!-- Project -->
      <article class="latest-card">
        <div class="latest-card__media">
          <div
            class="latest-card__media-placeholder latest-card__media-placeholder--gold"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="40"
              height="40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
        </div>
        <div class="latest-card__body">
          <div class="latest-card__meta">
            <span class="latest-card__type">
              {latestProject?.category?.trim() ? latestProject.category : 'Project'}
            </span>
            {latestProject?.status ? (
              <span class="latest-card__badge">{latestProject.status}</span>
            ) : null}
          </div>
          <h3 class="latest-card__heading">
            {latestProject?.title ?? 'Coming Soon'}
          </h3>
          <p class="latest-card__excerpt">
            {latestProject
              ? projectCardText(latestProject.excerpt, latestProject.description) ||
                'New Siryus initiatives will appear here.'
              : 'New Siryus initiatives will appear here.'}
          </p>
          <a
            href={latestProject ? `/projects/${latestProject.slug.current}` : '/projects'}
            class="latest-card__link"
          >
            See the project
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .latest {
    background: var(--brand-bg-base);
    padding: var(--space-24) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .latest__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-12);
  }

  .latest__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-10);
    gap: var(--space-6);
  }

  .latest__heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 900;
    color: var(--brand-text);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .latest__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    flex-shrink: 0;
    padding: var(--space-2) var(--space-4);
    transition: gap var(--transition-base);
  }

  .latest__view-all:hover {
    gap: var(--space-3);
  }

  .latest__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-5);
    align-items: stretch;
  }

  .latest-card {
    background: var(--brand-surface);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
  }

  .latest-card:hover {
    border-color: rgba(209, 223, 75, 0.2);
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
  }

  .latest-card__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }

  .latest-card--wide .latest-card__media {
    aspect-ratio: 16 / 7;
  }

  .latest-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .latest-card__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      #0e0e0e 0%,
      #1a1a1a 100%
    );
    color: rgba(255, 255, 255, 0.15);
  }

  .latest-card__media-placeholder--accent {
    background: linear-gradient(
      135deg,
      rgba(209, 223, 75, 0.08) 0%,
      #0e0e0e 100%
    );
    color: rgba(209, 223, 75, 0.3);
  }

  .latest-card__media-placeholder--gold {
    background: linear-gradient(
      135deg,
      rgba(184, 146, 74, 0.1) 0%,
      #0e0e0e 100%
    );
    color: rgba(184, 146, 74, 0.35);
  }

  .latest-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    min-height: 0;
  }

  .latest-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .latest-card__type {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-accent);
  }

  .latest-card__date {
    font-size: var(--text-xs);
    color: var(--brand-text-faint);
  }

  .latest-card__badge {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--brand-text-muted);
    text-transform: capitalize;
  }

  .latest-card__heading {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--brand-text);
    line-height: 1.3;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .latest-card--wide .latest-card__heading {
    font-size: var(--text-xl);
  }

  .latest-card__excerpt {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--brand-text-muted);
    margin: 0;
    flex: 1 1 auto;
    min-height: 0;
  }

  .latest-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--brand-accent);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 700;
    margin-top: auto;
    padding-top: var(--space-2);
    transition: gap var(--transition-base);
  }

  .latest-card__link:visited {
    color: var(--brand-accent);
  }

  .latest-card__link:hover {
    gap: var(--space-3);
  }

  @media (max-width: 1100px) {
    .latest__grid {
      grid-template-columns: 1fr 1fr;
    }

    .latest-card--wide {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .latest {
      padding: var(--space-12) 0;
    }

    .latest__inner {
      padding: 0 var(--space-5);
    }

    .latest__grid {
      grid-template-columns: 1fr;
    }

    .latest-card {
      width: 100%;
      max-width: 100%;
    }

    .latest-card--wide {
      grid-column: auto;
    }

    .latest-card__media {
      aspect-ratio: 16 / 9;
    }

    .latest-card--wide .latest-card__media {
      aspect-ratio: 16 / 9;
    }
  }

  :global(body.light-theme) .latest {
    background: var(--brand-bg-base);
    border-top-color: rgba(0, 0, 0, 0.06);
  }

  :global(body.light-theme) .latest-card {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(body.light-theme) .latest-card:hover {
    border-color: rgba(60, 71, 0, 0.2);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
  }

  :global(body.light-theme) .latest-card__media-placeholder {
    background: linear-gradient(
      135deg,
      #f0f1ee 0%,
      #e8e9e5 100%
    );
    color: rgba(0, 0, 0, 0.55);
  }

  :global(body.light-theme) .latest-card__media-placeholder--accent {
    background: linear-gradient(
      135deg,
      rgba(209, 223, 75, 0.15) 0%,
      #f0f1ee 100%
    );
    color: rgba(0, 0, 0, 0.55);
  }

  :global(body.light-theme) .latest-card__media-placeholder--gold {
    background: linear-gradient(
      135deg,
      rgba(184, 146, 74, 0.15) 0%,
      #f0f1ee 100%
    );
    color: rgba(0, 0, 0, 0.55);
  }

  :global(body.light-theme) .latest-card__heading {
    color: var(--brand-text);
  }

  :global(body.light-theme) .latest__heading {
    color: var(--brand-text);
  }
</style>
