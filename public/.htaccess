Options -MultiViews
RewriteEngine On
RewriteBase /

# 301 Redirects from old site URLs
Redirect 301 /max-prodigy /artists/max-prodigy
Redirect 301 /hidaya-morgan /artists/hidaya-morgan
Redirect 301 /siryus-blog /blog
Redirect 301 /services-independent-creatives /services
Redirect 301 /contact-page-siryus /contact
Redirect 301 /siryus-hub-projects /projects
Redirect 301 /indiba-project-series /projects/indiba-project-series
Redirect 301 /kickstart-your-career-as-a-creative /blog
Redirect 301 /monetizing-creativity-earn-living-passion /blog
Redirect 301 /essential-tools-for-creative-professionals /blog
Redirect 301 /overcoming-creative-blocks-like-a-pro /blog
Redirect 301 /networking-in-the-creative-industry /blog
Redirect 301 /sustainability-african-creative-practices /blog

# Serve existing files and directories first
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route clean URLs to Astro static output
RewriteRule ^(.*)$ /$1/index.html [L]
