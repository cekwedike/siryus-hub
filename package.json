{
  "name": "siryus-ecosystem",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter @siryus/hub dev",
    "dev:hub": "pnpm --filter @siryus/hub dev",
    "dev:am": "pnpm --filter @siryus/am dev",
    "dev:signal": "pnpm --filter @siryus/signal dev",
    "dev:arc": "pnpm --filter @siryus/arc dev",
    "build": "pnpm -r --filter @siryus/hub --filter @siryus/am --filter @siryus/signal --filter @siryus/arc build",
    "build:hub": "pnpm --filter @siryus/hub build",
    "build:am": "pnpm --filter @siryus/am build",
    "build:signal": "pnpm --filter @siryus/signal build",
    "build:arc": "pnpm --filter @siryus/arc build",
    "check": "pnpm -r --filter @siryus/hub --filter @siryus/am --filter @siryus/signal --filter @siryus/arc check",
    "preview": "pnpm --filter @siryus/hub preview",
    "lint:max-lines": "node scripts/check-line-length.mjs",
    "seed:artists": "node scripts/seed-artists.mjs",
    "seed:projects": "node scripts/seed-projects.mjs",
    "update:indiba": "node scripts/update-indiba.mjs",
    "seed:team": "node scripts/seed-team.mjs",
    "patch:artist-keys": "node scripts/patch-artist-release-keys.mjs",
    "studio": "pnpm --dir studio dev",
    "studio:arc": "pnpm --dir studio-arc dev"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@portabletext/to-html": "^5.0.2",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^7.20.0",
    "@sanity/image-url": "^2.1.0",
    "astro": "^6.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/sitemap": "^3.7.2",
    "@sanity/vision": "^5.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "sanity": "^5.18.0"
  }
}
