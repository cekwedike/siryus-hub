---
import '../styles/global.css'
import Head from '../components/Head.astro'
import Cosmos from '../components/Cosmos.astro'
import { worlds } from '../data/worlds'

const title = 'SIRYUS | Different Worlds. One Creative Universe.'
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://siryushub.com/#organization',
      name: 'Siryus Creative Media Ltd',
      alternateName: 'SIRYUS',
      url: 'https://siryushub.com/',
      logo: 'https://siryushub.com/icon-512.png',
      slogan: 'Different worlds. One creative universe.',
      brand: worlds.filter((world) => !world.external).map((world) => ({ '@type': 'Brand', name: world.name + (world.period ? '.' : ''), url: world.href })),
    },
    { '@type': 'WebSite', '@id': 'https://siryushub.com/#website', name: 'SIRYUS', url: 'https://siryushub.com/', publisher: { '@id': 'https://siryushub.com/#organization' } },
  ],
}
const description = 'SIRYUS is home to SIRYUS A.M, ARC. Creatives and SIGNAL., with PAVO Create alongside. Choose a world to enter.'
---
<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} schema={schema} />
  </head>
  <body>
    <a class="skip" href="#worlds">Skip to the worlds</a>
    <div class="portal">
      <Cosmos />
      <header class="top">
        <a class="lockup" href="/" aria-label="SIRYUS home">
          <img src="/brand/siryus/lockup-black.png" width="1200" height="567" alt="SIRYUS" />
        </a>
        <h1>Different Worlds. One Creative Universe.</h1>
      </header>

      <main class="stage">
        <span class="crop" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <nav class="shards" id="worlds" aria-label="SIRYUS worlds">
          {worlds.map((world, w) => (
            <a
              class:list={['shard', world.id]}
              href={world.href}
              data-domain={world.domain}
              target={world.external ? '_blank' : undefined}
              rel={world.external ? 'noopener' : undefined}
              style={`--w:${w}`}
            >
              <span class="media" aria-hidden="true">
                {world.images.map((src, i) => (
                  <img src={src} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" style={`--i:${i}`} />
                ))}
              </span>
              <span class="copy">
                {world.logo && (
                  <img class="mark" src={world.logo.src} width={world.logo.width} height={world.logo.height} alt="" />
                )}
                <span class="name">{world.name}{world.period && <span class="period" aria-hidden="true"></span>}</span>
                <span class="note">{world.note}</span>
                <span class="go">
                  {world.domain}
                  {world.external && <span class="sr"> (opens in a new tab)</span>}
                </span>
                <span class="ticks" aria-hidden="true"><i style="--i:0"></i><i style="--i:1"></i><i style="--i:2"></i></span>
              </span>
            </a>
          ))}
        </nav>
      </main>

      <footer class="foot">
        <div class="foot-meta">
          <p>© 2026 Siryus Creative Media Ltd</p>
          <nav class="legal-links" aria-label="Legal"><a href="/privacy-policy">Privacy</a><a href="/terms-of-use">Terms</a><a href="/cookie-policy">Cookies</a></nav>
        </div>
        <p class="status" aria-hidden="true" data-default="siryushub.com">siryushub.com</p>
      </footer>
    </div>

    <script>
      const status = document.querySelector<HTMLElement>('.status')
      if (status) {
        const fallback = status.dataset.default ?? ''
        const show = (text: string) => { status.textContent = text }
        document.querySelectorAll<HTMLAnchorElement>('.shard').forEach((shard) => {
          const domain = shard.dataset.domain ?? fallback
          shard.addEventListener('pointerenter', () => show(domain))
          shard.addEventListener('focus', () => show(domain))
          shard.addEventListener('pointerleave', () => show(fallback))
          shard.addEventListener('blur', () => show(fallback))
        })
      }
    </script>
  </body>
</html>
