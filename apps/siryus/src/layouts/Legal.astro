---
import '../styles/global.css'
import Head from '../components/Head.astro'

interface Props {
  title: string
  description: string
  path: string
}

const { title, description, path } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} path={path} noIndex />
  </head>
  <body>
    <div class="legal-shell">
      <header class="top">
        <a class="lockup" href="/" aria-label="SIRYUS home">
          <img src="/brand/siryus/lockup-black.png" width="1200" height="567" alt="SIRYUS" />
        </a>
        <a class="home" href="/">Back to SIRYUS</a>
      </header>
      <main class="legal">
        <slot />
      </main>
      <footer class="foot">
        <p>© 2026 Siryus Creative Media Ltd</p>
        <nav class="legal-links" aria-label="Legal">
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms-of-use">Terms</a>
          <a href="/cookie-policy">Cookies</a>
        </nav>
      </footer>
    </div>
    <script>
      // Label every cell with its column name so tables can stack on small screens.
      document.querySelectorAll<HTMLTableElement>('.legal table').forEach((table) => {
        const labels = [...table.querySelectorAll('thead th')].map((th) => th.textContent ?? '')
        table.querySelectorAll('tbody tr').forEach((row) => [...row.children].forEach((cell, i) => cell.setAttribute('data-label', labels[i] ?? '')))
        table.classList.add('stack')
      })
    </script>
  </body>
</html>
