---
import SiryusStar from '../components/SiryusStar.astro';
import '../styles/arc-fonts.css';
import '../styles/arc-blog.css';
import '../styles/arc-x.css';
import ArcFooter from '../components/ArcFooter.astro';
import ArcMenuButton from '../components/ArcMenuButton.astro';
import ArcMobileMenu from '../components/ArcMobileMenu.astro';
import { arcGraph } from '../lib/arcSchema';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
  schema?: object;
  /** Absolute URL for paginated series SEO (`rel="prev"`) */
  paginationPrev?: string;
  /** Absolute URL for paginated series SEO (`rel="next"`) */
  paginationNext?: string;
}

const {
  title,
  description = 'ARC is a community for independent Christian creatives.',
  canonical,
  ogImage = '/share.jpg',
  ogType = 'website',
  noIndex = false,
  schema,
  paginationPrev,
  paginationNext,
} = Astro.props;

// Older CMS titles carry the retired "Siryus Hub" name; search results show about 60 characters, so long titles keep
// only their first part and drop the brand suffix.
const cleanTitle = title.replace(/\s*-\s*Siryus Hub/gi, '').replace(/&amp;/g, '&');
const pageTitle = cleanTitle.length > 52 ? cleanTitle.split(' | ')[0] : cleanTitle.includes('|') ? cleanTitle : `${cleanTitle} | ARC. Creatives`;

const canonicalURL = canonical
  ? new URL(canonical, Astro.url.origin).href
  : new URL(Astro.url.pathname, Astro.url.origin).href;

// Sanity's auto format can hand crawlers the original file (for example HEIF), so share images ask for JPEG.
const ogImageURL = ogImage.startsWith('http')
  ? ogImage.replace('auto=format', 'fm=jpg')
  : new URL(ogImage, Astro.url.origin).href;

// Search results show about 160 characters, so long CMS excerpts are trimmed at a word for meta tags only.
const metaDescription =
  description.length <= 160
    ? description
    : `${description.slice(0, 157).replace(/\s+\S*$/, '')}...`;

// ARC.'s organisation graph is on every page; a page's own schema (article, event, FAQ) is added alongside it.
const pageSchema = schema;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const inBlog = currentPath === '/arc/blog' || currentPath.startsWith('/arc/blog/');
const inEvents = currentPath === '/arc/events' || currentPath.startsWith('/arc/events/');
const inCommunity = currentPath === '/arc/community';
const inAbout = currentPath === '/arc/about';
const inSupporters = currentPath === '/arc/supporters';
const inFaq = currentPath === '/arc/faq';
const inSubscribe = currentPath === '/arc/subscribe';
const inArcHome = currentPath === '/';
---

<!DOCTYPE html>
<html lang="en" class="layout-html">
  <Fragment set:html={'<!--email_off-->'} />
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#0a0908" />
    <link rel="canonical" href={canonicalURL} />
    {paginationPrev && <link rel="prev" href={paginationPrev} />}
    {paginationNext && <link rel="next" href={paginationNext} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="ARC. Creatives" />
    {ogImage === '/share.jpg' && <meta property="og:image:width" content="1200" />}
    {ogImage === '/share.jpg' && <meta property="og:image:height" content="630" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(arcGraph)} />
    {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}

    <link rel="icon" href="/favicon-arc.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon-arc.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-arc.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="arc-route">
    <a href="#main-content" class="arc-skip-link">Skip to main content</a>
    <nav class="arc-route-nav arc-route-nav--always" aria-label="ARC page navigation">
      <a href="/" class={`arc-route-nav__brand ${inArcHome ? 'is-active' : ''}`.trim()}>ARC. Creatives</a>
      <div class="arc-route-nav__links">
        <a href="/" class={inArcHome ? 'is-active' : undefined}>Home</a>
        <a href="/arc/blog" class={inBlog ? 'is-active' : undefined}>Blog</a>
        <a href="/arc/events" class={inEvents ? 'is-active' : undefined}>Events</a>
        <a href="/arc/music" class={currentPath === '/arc/music' ? 'is-active' : undefined}>Music &amp; Projects</a>
        <a href="/arc/community" class={inCommunity ? 'is-active' : undefined}>Community</a>
        <a href="/arc/about" class={inAbout ? 'is-active' : undefined}>About</a>
        <a href="/arc/supporters" class={inSupporters ? 'is-active' : undefined}>Supporters</a>
        <a href="/arc/faq" class={inFaq ? 'is-active' : undefined}>FAQ</a>
        <a href="/arc/subscribe" class={inSubscribe ? 'is-active' : undefined}>Letter</a>
        <a class="arc-siryus" href="https://siryushub.com"><SiryusStar />Back to SIRYUS</a>
      </div>
      <ArcMenuButton />
    </nav>

    <ArcMobileMenu />

    <main id="main-content" class="arc-shell-main">
      <slot />
    </main>
    <ArcFooter />
  </body>
  <Fragment set:html={'<!--/email_off-->'} />
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html.layout-html,
  body.arc-route {
    margin: 0;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  body.arc-route {
    background: #0d0b09;
    color: #ffffff;
    font-family: var(--arc-font-body);
  }

  body.arc-route.light-theme {
    background: #ffffff;
    color: #000000;
  }

  body.arc-route .arc-route-nav {
    box-sizing: border-box;
    position: fixed;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 70;
    width: min(1180px, calc(100% - 1.4rem));
    margin-inline: auto;
    padding: 0.65rem 0.9rem;
    border: 1px solid rgba(242, 121, 48, 0.42);
    background: rgba(13, 11, 9, 0.92);
    display: flex;
    align-items: center;
    justify-content: space-between;
    backdrop-filter: blur(8px);
  }

  body.arc-route .arc-route-nav__brand {
    white-space: nowrap;
    color: #f27930;
    text-decoration: none;
    font-family: var(--arc-font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  body.arc-route .arc-route-nav__links {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  body.arc-route .arc-route-nav__links a {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.82;
  }

  body.arc-route .arc-route-nav a.is-active {
    opacity: 1;
    color: #f27930;
  }

  body.arc-route .arc-route-nav a:hover {
    opacity: 1;
  }

  body.arc-route.light-theme .arc-route-nav {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(0, 0, 0, 0.28);
  }

  body.arc-route.light-theme .arc-route-nav__brand {
    color: #000000;
  }

  body.arc-route.light-theme .arc-route-nav__links a {
    color: #000000;
  }

  .arc-shell-main {
    min-height: 60vh;
    padding-top: 5.25rem;
  }

  .arc-skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 120;
    background: #f27930;
    color: #0d0b09;
    padding: 0.45rem 0.8rem;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .arc-skip-link:focus {
    top: 0.5rem;
  }

  /* The ten links need about 1180px on one line. Below that, the menu button takes over. */
  @media (max-width: 1180px) {
    body.arc-route .arc-route-nav {
      top: 0.5rem;
      width: calc(100% - 1rem);
      padding: 0.55rem 0.7rem;
    }

    body.arc-route .arc-route-nav__brand {
      font-size: 1.25rem;
    }

    body.arc-route .arc-route-nav__links {
      display: none;
    }
  }

</style>

