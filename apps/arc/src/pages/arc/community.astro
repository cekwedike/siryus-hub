---
import ArcLayout from '../../layouts/ArcLayout.astro';
import '../../styles/arc-sections-reuse.css';
import { getCanonicalOrigin } from '../../lib/siteCanonical';

const origin = getCanonicalOrigin();
const pageTitle = 'ARC Community | A home for the ones building in faith';
const pageDescription =
  'ARC is a faith-rooted creative community for Christian creatives in Nigeria, Rwanda, and beyond. Ascent. Refuge. Collective.';
---

<ArcLayout title={pageTitle} description={pageDescription} canonical={`${origin}/arc/community`}>
  <div class="blog-page">
    <section class="blog-bleed blog-hero blog-reveal" aria-labelledby="arc-community-hero-heading">
      <div class="blog-hero__photo-layer" aria-hidden="true">
        <img
          class="blog-hero__photo"
          src="/arc/hero-section.webp"
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          decoding="async"
        />
        <div class="blog-hero__photo-scrim"></div>
      </div>
      <div class="blog-hero__glow" aria-hidden="true"></div>
      <div class="blog-inner blog-hero__shell">
        <div class="morph-hero-glass-panel blog-hero__glass" style="max-width: 50rem;">
          <div class="blog-hero__inner" style="padding: 2rem 1.75rem;">
            <h1 id="arc-community-hero-heading" class="blog-hero__title">
              A home for the ones building in faith.
            </h1>
            <p class="blog-hero__sub">
              A community where Christian creatives grow in their craft and their calling, together.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="blog-bleed arc-list-bridge blog-reveal">
      <div class="blog-inner arc-bridge__inner">
        <p class="arc-bridge__tagline">Community over isolation. Craft over noise.</p>
        <div class="arc-bridge__actions">
          <a class="arc-bridge__pill" href="/arc/blog">Journal</a>
          <a class="arc-bridge__pill" href="/arc/events">Events</a>
          <a class="arc-bridge__pill arc-bridge__pill--ghost" href="/">ARC home</a>
        </div>
      </div>
    </div>

    <section class="x-intro" aria-labelledby="arc-community-what-heading">
      <div class="x-wrap x-intro__grid">
        <div>
          <h2 id="arc-community-what-heading" class="x-display" data-x-reveal>What this place is.</h2>
          <p class="x-lede" data-x-reveal>A faith-rooted community that supports, protects and grows Christian creatives in every art form. A modern ark for the talented, the faithful and the serious, building in silence.</p>
        </div>
        <div class="x-collage" aria-hidden="true">
          <img class="x-collage__a" src="/arc/young-christians.webp" alt="" width="900" height="1200" loading="lazy" decoding="async" />
          <img class="x-collage__b" src="/arc/praise-to-jesus.jpg" alt="" width="900" height="900" loading="lazy" decoding="async" />
          <img class="x-collage__c" src="/arc/the-bible.avif" alt="" width="900" height="900" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <section class="x-section" style="padding-top:0" aria-labelledby="arc-community-who-heading">
      <div class="x-wrap">
        <h2 id="arc-community-who-heading" class="x-display" data-x-reveal>Who belongs here.</h2>
        <div class="x-tiles">
          <div class="x-path" data-x-reveal><img src="/arc/arc-mic.webp" alt="" width="900" height="900" loading="lazy" decoding="async" /><span><strong>Sound</strong>Musicians, singers, producers and worship leaders.</span></div>
          <div class="x-path" data-x-reveal><img src="/arc/arc-write.webp" alt="" width="900" height="900" loading="lazy" decoding="async" /><span><strong>Words</strong>Poets, songwriters, authors and spoken word artists.</span></div>
          <div class="x-path" data-x-reveal><img src="/arc/praise-and-pray.jpg" alt="" width="900" height="900" loading="lazy" decoding="async" /><span><strong>Movement</strong>Dancers and choreographers.</span></div>
          <div class="x-path" data-x-reveal><img src="/arc/arc-image.webp" alt="" width="900" height="900" loading="lazy" decoding="async" /><span><strong>Vision</strong>Filmmakers, photographers and visual storytellers.</span></div>
          <div class="x-path" data-x-reveal><img src="/arc/arc.creatives.avif" alt="" width="900" height="900" loading="lazy" decoding="async" /><span><strong>Design</strong>Illustrators, designers and fashion creatives.</span></div>
          <div class="x-path" data-x-reveal><img src="/arc/young-and-for-christ.jpg" alt="" width="900" height="900" loading="lazy" decoding="async" /><span><strong>Experimental</strong>If your work fits no category, it fits here.</span></div>
        </div>
      </div>
    </section>

    <section class="x-why" aria-labelledby="arc-community-principles-heading">
      <div class="x-why__photo"><img src="/arc/praise-god.avif" alt="Hands raised in worship" width="1200" height="1500" loading="lazy" decoding="async" /></div>
      <div class="x-why__copy">
        <h2 id="arc-community-principles-heading" class="x-display" data-x-reveal>How we grow together.</h2>
        <ul class="x-why__list">
          <li data-x-reveal><strong>Real conversations.</strong> About faith, craft and the parts that never make the highlight reel.</li>
          <li data-x-reveal><strong>Mutual growth.</strong> We share what we learn and celebrate each other's progress.</li>
        </ul>
      </div>
    </section>

    <section class="x-values" aria-labelledby="arc-community-involve-heading">
      <div class="x-values__bg" aria-hidden="true"><img src="/arc/cross-of-jesus.avif" alt="" width="1600" height="1000" loading="lazy" decoding="async" /></div>
      <div class="x-wrap">
        <h2 id="arc-community-involve-heading" class="x-display" data-x-reveal>How to plug in.</h2>
        <ul class="x-values__grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr))">
          <li data-x-reveal><h3>Follow the journey</h3><p>Follow ARC. on social media and watch it grow.</p></li>
          <li data-x-reveal><h3>Join the Letter</h3><p>Where the community lives between events.</p></li>
          <li data-x-reveal><h3>Show up</h3><p>Apartment Sessions and Collaboration Labs are where the work happens.</p></li>
          <li data-x-reveal><h3>Bring your tribe</h3><p>Know someone who belongs here? Bring them.</p></li>
        </ul>
      </div>
    </section>

    <section class="x-cta" aria-labelledby="arc-community-cta-heading">
      <img class="x-cta__bg" src="/arc/hero-section.webp" alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      <div class="x-wrap">
        <h2 id="arc-community-cta-heading" class="x-display" data-x-reveal>Ready to be part of it?</h2>
        <p class="x-lede" data-x-reveal>Join the Letter and stay close to everything ARC. is building.</p>
        <div class="x-actions" data-x-reveal><a class="x-btn" href="/arc/subscribe">Join the ARC. Letter</a></div>
      </div>
    </section>
  </div>
</ArcLayout>

<script is:inline>
  // Reveal for the photo-led sections. Content shows at once with reduced motion or without support.
  (() => {
    const items = document.querySelectorAll('[data-x-reveal]');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) { items.forEach((el) => el.classList.add('is-in')); return; }
    document.documentElement.classList.add('x-motion');
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
    items.forEach((el) => io.observe(el));
  })();
</script>
<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.blog-reveal');
    if (reduce) {
      els.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -24px 0px' }
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>
