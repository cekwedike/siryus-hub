---
import '../styles/morphism.css';
---

<section
  class="brand-arms"
  id="explore"
  aria-labelledby="brand-arms-heading"
>
  <div class="brand-arms__inner">
    <div class="brand-arms__header">
      <span class="brand-arms__eyebrow">
        The Siryus Universe
      </span>
      <h2
        id="brand-arms-heading"
        class="brand-arms__heading"
      >
        Everything We Do<br />Lives Here
      </h2>
      <p class="brand-arms__sub">
        Four arms. One creative home.
      </p>
    </div>

    <div class="brand-arms__grid">
      <article class="brand-card morph-clay-card">
        <div class="brand-card__top">
          <span class="brand-card__tag">
            Artist Management
          </span>
          <div
            class="brand-card__icon"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </div>
        </div>
        <h3 class="brand-card__heading">
          We Build Artist Careers
        </h3>
        <p class="brand-card__body">
          From strategy to execution, we work directly with independent artists to
          grow their presence, protect their work, and build careers that last beyond the
          hype.
        </p>
        <a href="/artists" class="brand-card__link">
          <span>Meet the roster</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </article>

      <article class="brand-card morph-clay-card">
        <div class="brand-card__top">
          <span class="brand-card__tag">
            Creative Platform
          </span>
          <div
            class="brand-card__icon"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
        </div>
        <h3 class="brand-card__heading">
          Your Creative Home Base
        </h3>
        <p class="brand-card__body">
          Blog posts, project showcases, creative resources, and community. Everything you
          need to stay informed, connected, and inspired.
        </p>
        <a href="/about" class="brand-card__link">
          <span>Explore the hub</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </article>

      <article class="brand-card morph-clay-card">
        <div class="brand-card__top">
          <span class="brand-card__tag">
            Brand Marketing
          </span>
          <div
            class="brand-card__icon"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
        </div>
        <h3 class="brand-card__heading">
          We Market What Matters
        </h3>
        <p class="brand-card__body">
          Content strategy, social media, email marketing, and creative production for
          brands that want to grow without sounding like everyone else.
        </p>
        <a href="/services" class="brand-card__link">
          <span>See what we offer</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </article>

      <article class="brand-card morph-clay-card">
        <div class="brand-card__top">
          <span class="brand-card__tag">
            Siryus Community
          </span>
          <div
            class="brand-card__icon"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
        </div>
        <h3 class="brand-card__heading">
          Built for Creatives Like You
        </h3>
        <p class="brand-card__body">
          A space for independent artists, marketers, and makers to connect, share work,
          and grow together. No gatekeeping. No noise.
        </p>
        <a href="/community" class="brand-card__link">
          <span>Join the community</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .brand-arms {
    background: var(--brand-bg-deep);
    padding: var(--space-24) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    scroll-margin-top: calc(88px + env(safe-area-inset-top, 0px));
  }

  .brand-arms__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-12);
  }

  .brand-arms__header {
    margin-bottom: var(--space-16);
    max-width: 600px;
  }

  .brand-arms__eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-accent);
    border: 1px solid var(--brand-surface-border);
    background: var(--brand-accent-dim);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-5);
  }

  .brand-arms__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    color: var(--brand-text);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }

  .brand-arms__sub {
    font-size: var(--text-lg);
    color: var(--brand-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .brand-arms__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .brand-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border-radius: var(--radius-xl);
    transition: transform var(--transition-base), box-shadow var(--transition-base),
      border-color var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .brand-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--brand-accent),
      transparent
    );
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .brand-card:hover::before {
    opacity: 1;
  }

  .brand-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .brand-card__tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-accent);
  }

  .brand-card__icon {
    color: var(--brand-text-muted);
    flex-shrink: 0;
    transition: color var(--transition-base);
  }

  .brand-card:hover .brand-card__icon {
    color: var(--brand-accent);
  }

  .brand-card__heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--brand-text);
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .brand-card__body {
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--brand-text-muted);
    margin: 0;
    flex: 1;
  }

  .brand-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--brand-accent);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: gap var(--transition-base), color var(--transition-base);
    margin-top: auto;
  }

  .brand-card__link:visited {
    color: var(--brand-accent);
  }

  .brand-card__link:hover {
    gap: var(--space-3);
  }

  .brand-card__link svg {
    transition: transform var(--transition-base);
    flex-shrink: 0;
  }

  .brand-card__link:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 1200px) {
    .brand-arms__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .brand-arms {
      padding: var(--space-12) 0;
    }

    .brand-arms__inner {
      padding: 0 var(--space-5);
    }

    .brand-arms__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .brand-card {
      padding: var(--space-6);
    }

    .brand-arms__header {
      margin-bottom: var(--space-10);
    }
  }

  :global(body.light-theme) .brand-arms {
    background: var(--brand-bg-base);
    border-top-color: rgba(0, 0, 0, 0.06);
  }

  :global(body.light-theme) .brand-card__heading {
    color: var(--brand-text);
  }

  :global(body.light-theme) .brand-card__body {
    color: var(--brand-text-muted);
  }

  :global(body.light-theme) .brand-arms__heading {
    color: var(--brand-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-card,
    .brand-card::before,
    .brand-card__icon,
    .brand-card__link,
    .brand-card__link svg {
      transition: none;
    }

    .brand-card:hover::before {
      opacity: 1;
    }

    .brand-card__link:hover svg {
      transform: none;
    }
  }
</style>
