---
// The menu button inside ARC.'s navbar. It opens <ArcMobileMenu />, and shows only below 1180px wide.
---
<button
  type="button"
  class="arc-route-nav__hamburger"
  id="arcHamburgerBtn"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="arcMobileNav"
>
  <span class="arc-route-nav__hamburger-icon" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </span>
</button>
