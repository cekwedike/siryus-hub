<footer class="legal-footer" aria-label="Page footer">
  <div class="legal-footer__inner">
    <p class="legal-footer__copy">
      &copy; {new Date().getFullYear()} Siryus Creative Media Ltd.
      All rights reserved.
    </p>
    <nav class="legal-footer__nav" aria-label="Legal navigation">
      <a href="/privacy-policy" class="legal-footer__link">
        Privacy Policy
      </a>
      <a href="/terms-of-use" class="legal-footer__link">
        Terms of Use
      </a>
      <a href="/cookie-policy" class="legal-footer__link">
        Cookie Policy
      </a>
      <a href="/contact" class="legal-footer__link">Contact</a>
    </nav>
  </div>
</footer>

<style>
  .legal-footer {
    background: var(--brand-bg-deep);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: var(--space-6) 0;
  }

  .legal-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .legal-footer__copy {
    color: var(--brand-text-faint);
    font-size: var(--text-xs);
    margin: 0;
  }

  .legal-footer__nav {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .legal-footer__link {
    color: var(--brand-text-faint);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .legal-footer__link:hover {
    color: var(--brand-accent-ink-hover);
  }

  .legal-footer__link:visited {
    color: var(--brand-text-faint);
  }

  .legal-footer__link:visited:hover {
    color: var(--brand-accent-ink-hover);
  }

  @media (max-width: 600px) {
    .legal-footer__inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 0 var(--space-5);
    }

    .legal-footer__nav {
      gap: var(--space-4);
    }
  }

  :global(body.light-theme) .legal-footer {
    background: #f0f1ee;
    border-top-color: rgba(0, 0, 0, 0.08);
  }
</style>
