---
// ARC.'s mobile menu panel, shared by every page (ArcLayout and the home page). Opened by <ArcMenuButton />.
import SiryusStar from './SiryusStar.astro';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
    <div
      id="arcMobileNav"
      class="arc-mobile-nav"
      aria-label="ARC mobile navigation"
      aria-hidden="true"
      inert
    >
      <button class="arc-mobile-nav__overlay" type="button" aria-label="Close menu" data-arc-nav-close></button>
      <div class="arc-mobile-nav__panel" role="dialog" aria-modal="true" aria-label="ARC menu">
        <div class="arc-mobile-nav__head">
          <span class="arc-mobile-nav__title">ARC. Creatives</span>
          <button class="arc-mobile-nav__close" type="button" aria-label="Close menu" data-arc-nav-close>
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="arc-mobile-nav__list" role="list">
          <a href="/" class={`arc-mobile-nav__link ${path === '/' ? 'is-active' : ''}`.trim()}>Home</a>
          <a href="/arc/blog" class={`arc-mobile-nav__link ${path.startsWith('/arc/blog') ? 'is-active' : ''}`.trim()}>Blog</a>
          <a href="/arc/events" class={`arc-mobile-nav__link ${path.startsWith('/arc/events') ? 'is-active' : ''}`.trim()}>Events</a>
          <a href="/arc/music" class={`arc-mobile-nav__link ${path === '/arc/music' ? 'is-active' : ''}`.trim()}>Music &amp; Projects</a>
          <a href="/arc/community" class={`arc-mobile-nav__link ${path === '/arc/community' ? 'is-active' : ''}`.trim()}>Community</a>
          <a href="/arc/about" class={`arc-mobile-nav__link ${path === '/arc/about' ? 'is-active' : ''}`.trim()}>About</a>
          <a href="/arc/supporters" class={`arc-mobile-nav__link ${path === '/arc/supporters' ? 'is-active' : ''}`.trim()}>Supporters</a>
          <a href="/arc/faq" class={`arc-mobile-nav__link ${path === '/arc/faq' ? 'is-active' : ''}`.trim()}>FAQ</a>
          <a href="/arc/subscribe" class={`arc-mobile-nav__link ${path === '/arc/subscribe' ? 'is-active' : ''}`.trim()}>Letter</a>
          <a href="https://siryushub.com" class="arc-mobile-nav__link arc-mobile-nav__link--siryus arc-siryus"><SiryusStar />Back to SIRYUS</a>
        </div>
      </div>
    </div>

<script is:inline>
  (() => {
    const btn = document.getElementById('arcHamburgerBtn');
    const nav = document.getElementById('arcMobileNav');
    if (!(btn instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

    const closeEls = Array.from(nav.querySelectorAll('[data-arc-nav-close]'));
    const links = Array.from(nav.querySelectorAll('a'));

    const open = () => {
      nav.classList.add('is-open');
      nav.setAttribute('aria-hidden', 'false');
      nav.removeAttribute('inert');
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      nav.classList.remove('is-open');
      nav.setAttribute('aria-hidden', 'true');
      nav.setAttribute('inert', '');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    btn.addEventListener('click', () => {
      const isOpen = nav.classList.contains('is-open');
      if (isOpen) close();
      else open();
    });

    closeEls.forEach((el) => el.addEventListener('click', close));
    links.forEach((a) => a.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (nav.classList.contains('is-open')) close();
    });
  })();
</script>

<style is:global>
  body.arc-route .arc-route-nav__hamburger {
    display: none;
    background: transparent;
    border: 1px solid rgba(242, 121, 48, 0.42);
    padding: 0.45rem 0.55rem;
    border-radius: 0;
    cursor: pointer;
    color: inherit;
  }
  body.arc-route .arc-route-nav__hamburger-icon {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }
  body.arc-route .arc-route-nav__hamburger-icon span {
    width: 20px;
    height: 2px;
    background: currentColor;
    display: block;
  }

  @media (max-width: 1180px) {
    body.arc-route .arc-route-nav__hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
  }
  }

  .arc-mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 120;
    pointer-events: none;
  }

  .arc-mobile-nav.is-open {
    pointer-events: auto;
  }

  .arc-mobile-nav__overlay {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    background: rgba(0, 0, 0, 0.65);
    opacity: 0;
    transition: opacity 0.22s ease;
    cursor: pointer;
  }

  .arc-mobile-nav.is-open .arc-mobile-nav__overlay {
    opacity: 1;
  }

  .arc-mobile-nav__panel {
    position: absolute;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    left: max(0.75rem, env(safe-area-inset-left));
    border: 1px solid rgba(242, 121, 48, 0.35);
    background: rgba(13, 11, 9, 0.96);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    transform: translateY(-8px);
    opacity: 0;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
    padding: 0.9rem 0.9rem 1rem;
    max-height: calc(100vh - 1.5rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    overflow: auto;
  }

  .arc-mobile-nav.is-open .arc-mobile-nav__panel {
    transform: translateY(0);
    opacity: 1;
  }

  .arc-mobile-nav__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(242, 121, 48, 0.18);
  }

  .arc-mobile-nav__title {
    font-family: var(--arc-font-heading);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #f27930;
  }

  .arc-mobile-nav__close {
    border: 1px solid rgba(242, 121, 48, 0.3);
    background: transparent;
    color: #ffffff;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    line-height: 1;
  }

  .arc-mobile-nav__list {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.8rem;
  }

  .arc-mobile-nav__link {
    text-decoration: none;
    color: rgba(245, 240, 232, 0.92);
    font-family: var(--arc-font-body);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.82rem;
    padding: 0.7rem 0.7rem;
    border-radius: 10px;
    border: 1px solid rgba(242, 121, 48, 0.14);
    background: rgba(255, 255, 255, 0.02);
  }

  .arc-mobile-nav__link.is-active {
    border-color: rgba(242, 121, 48, 0.45);
    color: #ffffff;
  }

  .arc-mobile-nav__link--siryus {
    border-style: dashed;
    opacity: 0.92;
  }

  body.arc-route.light-theme .arc-mobile-nav__panel {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(0, 0, 0, 0.18);
  }

  body.arc-route.light-theme .arc-mobile-nav__overlay {
    background: rgba(0, 0, 0, 0.45);
  }

  body.arc-route.light-theme .arc-mobile-nav__link {
    color: rgba(13, 11, 9, 0.9);
    border-color: rgba(0, 0, 0, 0.14);
    background: rgba(0, 0, 0, 0.03);
  }

  body.arc-route.light-theme .arc-mobile-nav__close {
    color: #0d0b09;
    border-color: rgba(0, 0, 0, 0.18);
  }

  body.arc-route.light-theme .arc-mobile-nav__head {
    border-bottom-color: rgba(0, 0, 0, 0.12);
  }
</style>
