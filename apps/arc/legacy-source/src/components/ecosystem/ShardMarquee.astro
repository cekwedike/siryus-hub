---
const shards = [
  { id: 'am-portrait', image: '/images/hero/jlinez.webp', tone: 'lime', shape: 'a', depth: 2, tilt: -18 },
  { id: 'arc-room', image: '/arc/hero-section.webp', tone: 'orange', shape: 'b', depth: 4, tilt: 13 },
  { id: 'signal-paths', image: '/brand/signal/symbol.png', tone: 'red', shape: 'c', depth: 1, tilt: -7 },
  { id: 'am-stage', image: '/images/hero/siryus-violin.webp', tone: 'silver', shape: 'd', depth: 5, tilt: 17 },
  { id: 'arc-craft', image: '/arc/arc-write.webp', tone: 'warm', shape: 'e', depth: 3, tilt: -12 },
  { id: 'parent', image: '/images/hero/siryus-hub-home.webp', tone: 'mirror', shape: 'f', depth: 6, tilt: 8 },
  { id: 'am-portrait-2', image: '/images/artists/max-prodigy.webp', tone: 'lime', shape: 'b', depth: 4, tilt: -15 },
  { id: 'arc-community', image: '/arc/young-and-for-christ.jpg', tone: 'orange', shape: 'a', depth: 2, tilt: 14 },
]

const repeatedShards = [...shards, ...shards]
---

<section class="shard-marquee" aria-label="A moving glass sculpture representing the SIRYUS creative worlds">
  <div class="shard-marquee__light" aria-hidden="true"></div>
  <div class="shard-marquee__scene" data-shard-scene>
    <div class="shard-marquee__track">
      {repeatedShards.map((shard, index) => (
        <div
          class={`mirror-shard mirror-shard--${shard.shape} mirror-shard--${shard.tone}`}
          style={`--depth:${shard.depth};--tilt:${shard.tilt}deg;--order:${index};--image:url('${shard.image}')`}
          aria-hidden="true"
        >
          <span class="mirror-shard__image"></span>
          <span class="mirror-shard__reflection"></span>
          <span class="mirror-shard__edge"></span>
        </div>
      ))}
    </div>
  </div>
  <p class="shard-marquee__caption">Four worlds, seen from a different angle.</p>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-shard-scene]')

  if (scene && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0
    const updateTilt = (event: PointerEvent) => {
      cancelAnimationFrame(frame)
      frame = requestAnimationFrame(() => {
        const bounds = scene.getBoundingClientRect()
        const x = (event.clientX - bounds.left) / bounds.width - 0.5
        const y = (event.clientY - bounds.top) / bounds.height - 0.5
        scene.style.setProperty('--pointer-x', `${x * 8}deg`)
        scene.style.setProperty('--pointer-y', `${y * -5}deg`)
        scene.style.setProperty('--light-x', `${(x + 0.5) * 100}%`)
      })
    }

    scene.addEventListener('pointermove', updateTilt, { passive: true })
    scene.addEventListener('pointerleave', () => {
      scene.style.setProperty('--pointer-x', '0deg')
      scene.style.setProperty('--pointer-y', '0deg')
      scene.style.setProperty('--light-x', '50%')
    })
  }
</script>
