---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getAllPosts } from '../../../lib/queries'
import { blogCoverImageUrl } from '../../../lib/sanity'
import { isSiryusAmArticle } from '../../../data/articleOwnership'
import '../../../styles/blog.css'

const posts = (await getAllPosts()).filter((post) => isSiryusAmArticle(post.slug?.current ?? ''))
---

<BaseLayout
  title="SIRYUS A.M Journal"
  description="Practical guidance for independent artists from SIRYUS A.M."
  canonical="https://www.siryushub.com/siryus-am/blog"
>
  <div class="blog-page">
    <section class="blog-bleed blog-hero" aria-labelledby="journal-title">
      <div class="blog-inner blog-hero__shell">
        <div class="blog-hero__inner">
          <h1 id="journal-title" class="blog-hero__title">The SIRYUS A.M journal.</h1>
          <p class="blog-hero__sub">Clear guidance for artists building steady, independent careers.</p>
        </div>
      </div>
    </section>

    <section class="blog-bleed blog-section" aria-labelledby="journal-posts-title">
      <div class="blog-inner">
        <h2 id="journal-posts-title" class="visually-hidden">Articles</h2>
        <div class="blog-grid">
          {posts.map((post) => {
            const cover = blogCoverImageUrl(post.coverImage, 800, 500)
            return (
              <a class="blog-card" href={`/siryus-am/blog/${post.slug.current}`}>
                {cover ? <img src={cover} alt="" width="800" height="500" loading="lazy" /> : null}
                <div class="blog-card__body">
                  <h2 class="blog-card__title">{post.title}</h2>
                  <p class="blog-card__excerpt">{post.excerpt}</p>
                  <span class="blog-card__cta">Read article</span>
                </div>
              </a>
            )
          })}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
