---
import '../styles/error-404.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found | Siryus Hub</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/x-icon" href="/images/logo/dark/favicon.ico" />
  </head>
  <body class="error-404-body">
    <div class="error-404">
      <p class="error-404__num" aria-hidden="true">404</p>
      <h1 class="error-404__title">This Page Does Not Exist.</h1>
      <p class="error-404__sub">
        You might have followed a broken link or typed something wrong. Either way, we can get you back on track.
      </p>

      <div class="error-404__grid">
        <a href="/" class="error-404__card morph-clay-card">
          <span class="error-404__card-title">Home</span>
          <p class="error-404__card-desc">Go back to the start</p>
        </a>
        <a href="/about" class="error-404__card morph-clay-card">
          <span class="error-404__card-title">About</span>
          <p class="error-404__card-desc">Learn about Siryus</p>
        </a>
        <a href="/artists" class="error-404__card morph-clay-card">
          <span class="error-404__card-title">Artists</span>
          <p class="error-404__card-desc">Meet the roster</p>
        </a>
        <a href="/contact" class="error-404__card morph-clay-card">
          <span class="error-404__card-title">Contact</span>
          <p class="error-404__card-desc">Get in touch</p>
        </a>
      </div>

      <p class="error-404__email">
        If you think this is a mistake, email us at{' '}
        <a href="mailto:management@siryushub.com">management@siryushub.com</a>
      </p>
    </div>
  </body>
</html>
