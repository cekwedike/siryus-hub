---
import Site from '../layouts/Site.astro'
import Cosmos from '../components/Cosmos.astro'
import Paths from '../components/Paths.astro'

const briefs = [
  ['Launch something new', 'A product, a service, an event or a release that needs to land with the right people from day one.', 'Story, launch plan, campaign assets, email', 'A clear message and a rollout your team can run'],
  ['Make a brand make sense', 'You have grown, changed or drifted, and people are no longer sure what you stand for.', 'Story, positioning, messaging, website copy', 'One sentence everyone can say, and the words to back it up'],
  ['Run a campaign', 'You have a moment, a season or a goal, and need an idea strong enough to carry it.', 'Concept, content, paid social, reporting', 'Work that moves across channels and a report you can read'],
  ['Keep people close', 'People find you once and then forget you. You want them to come back.', 'Email and CRM journeys, content calendar', 'Useful messages people are glad to open'],
]
---
<Site title="Work" description="The kinds of projects SIGNAL. takes on: launches, brand messaging, campaigns and customer journeys. Client work is shown only with permission.">
  <header class="page-hero">
    <Cosmos />
    <div class="wrap" style="position:relative;z-index:1">
      <h1 data-split>The work should prove the idea.</h1>
      <p class="lede" data-reveal>We publish client work only with permission, so you will not find mock-ups dressed up as results here. Instead, these are the problems we are built to solve.</p>
    </div>
    <Paths class="corner" />
  </header>
  <section class="section white">
    <div class="wrap ways" style="grid-template-columns:repeat(auto-fit,minmax(20rem,1fr))">
      {briefs.map(([title, problem, scope, result], i) => (
        <article class="way" data-reveal style={`--d:${i}`}>
          <h2 style="font:clamp(1.9rem,3vw,2.6rem)/1 var(--display)">{title}</h2>
          <p>{problem}</p>
          <p><strong>What we usually do:</strong> {scope}</p>
          <p><strong>What you walk away with:</strong> {result}</p>
          <a class="btn solid" href="/contact"><span class="dot" aria-hidden="true"></span>Book a meeting</a>
        </article>
      ))}
    </div>
  </section>
  <section class="cta">
    <div class="rings" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap">
      <h2 data-split>Want to see more?</h2>
      <p data-reveal>Ask us. We are happy to walk you through relevant work on a call, with our clients' permission.</p>
      <a class="btn solid" href="/contact" data-reveal><span class="dot" aria-hidden="true"></span>Book a meeting</a>
    </div>
  </section>
</Site>
<style>
  .corner { position: absolute; right: var(--gutter); bottom: -4rem; width: clamp(10rem, 24vw, 20rem); z-index: 0; }
</style>
