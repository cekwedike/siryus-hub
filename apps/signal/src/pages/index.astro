---
import Site from '../layouts/Site.astro'
import Cosmos from '../components/Cosmos.astro'
import Marquee from '../components/Marquee.astro'
import Paths from '../components/Paths.astro'
import Pic from '../components/Pic.astro'
import { services, engagements } from '../data/services'

const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13L13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>'
---
<Site
  title="SIGNAL. by SIRYUS"
  description="SIGNAL. is a story-led marketing and growth agency. We find the story people care about, shape the strategy and build campaigns that move people to act."
  preload="billboard-night"
>
  <section class="s-hero" data-scrub>
    <Cosmos />
    <p class="ghost" aria-hidden="true" data-speed="-0.12">SIGNAL.</p>
    <figure class="photo" data-speed="0.06">
      <Pic name="billboard-night" alt="An empty, lit billboard at a quiet bus stop at night" eager sizes="(max-width: 62rem) 100vw, 28vw" />
      <figcaption>Every space is waiting for a message worth stopping for.</figcaption>
    </figure>
    <Paths />
    <div class="wrap copy">
      <h1 data-split>Make your message matter<span class="dot-red keep" aria-hidden="true"></span></h1>
      <div class="sub">
        <p data-reveal style="--d:5">Good marketing starts with a story people care about. We find that story, shape the strategy, and build campaigns that move people to act.</p>
        <div class="actions" data-reveal style="--d:7">
          <a class="btn solid" href="/contact"><span class="dot" aria-hidden="true"></span>Book a meeting</a>
          <a class="btn" href="/services">Our services</a>
        </div>
      </div>
    </div>
  </section>

  <Marquee items={services.map((s) => s.name)} />

  <section class="section white">
    <Cosmos />
    <div class="wrap statement-row">
      <p class="statement" data-split>People meet thousands of messages a day. They remember the ones that mean something.</p>
      <div class="side" data-reveal>
        <p>That is the gap SIGNAL. works in. We help brands, companies and organisations decide what to say, say it clearly, and get it to the people who need to hear it.</p>
        <a class="btn solid" href="/about">About SIGNAL.</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="head">
        <h2 id="svc-title" data-split>From the first idea to the final result.</h2>
        <p data-reveal>We connect storytelling with smart marketing. Use one service, or bring us in for all of it.</p>
      </div>
      <ul class="svc-list" data-preview>
        {services.map((s, i) => (
          <li data-reveal>
            <a href={`/services/${s.slug}`} data-img={`/images/${s.image}-800.webp`}>
              <span class="grp">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <p>{s.short}</p>
              <span class="go" set:html={arrow} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section light" aria-labelledby="method-title">
    <div class="wrap">
      <div class="head">
        <h2 id="method-title" data-split>Find the story. Shape the strategy. Move the message.</h2>
        <p data-reveal>Three paths, one point. It is how we work on every project, big or small.</p>
      </div>
      <ol class="method">
        <li data-reveal style="--d:0"><h3>Find the story</h3><p>We learn the business, the audience and the real problem, then find the one idea worth building around.</p></li>
        <li data-reveal style="--d:1"><h3>Shape the strategy</h3><p>We choose who to reach, what to say and where to say it, so every part of the plan pulls the same way.</p></li>
        <li data-reveal style="--d:2"><h3>Move the message</h3><p>We make the campaign, the content and the journeys, then measure what happens and sharpen what works.</p></li>
      </ol>
    </div>
  </section>

  <section class="feature" aria-labelledby="band-title">
    <div class="bg" data-speed="0.12"><Pic name="london-billboard" alt="" sizes="100vw" /></div>
    <div class="wrap">
      <h2 id="band-title" data-split>Attention is rented. Meaning is owned.</h2>
      <div data-reveal>
        <p>Anyone can buy a moment on a screen. We help you build a message people carry with them after it is gone.</p>
        <a class="btn" href="/approach">How we work</a>
      </div>
    </div>
  </section>

  <section class="section white" aria-labelledby="ways-title">
    <div class="wrap">
      <div class="head">
        <h2 id="ways-title" data-split>Ways to work with us.</h2>
        <p data-reveal>Every engagement starts with a meeting. Scope and price are agreed in writing before any work begins.</p>
      </div>
      <div class="ways">
        {engagements.map((e, i) => (
          <article class="way" data-reveal style={`--d:${i}`}>
            <h3>{e.name}</h3>
            <p>{e.line}</p>
            <a class="btn solid" href="/contact"><span class="dot" aria-hidden="true"></span>Book a meeting</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-title">
    <div class="wrap">
      <div class="head">
        <h2 id="who-title" data-split>Who we work with.</h2>
        <p data-reveal>Not just music, and not just big budgets. Anyone with something real to say and a reason to say it well.</p>
      </div>
      <div class="audience">
        <div data-reveal style="--d:0"><h3>Growing brands</h3><p>Products and services ready to be known for one clear thing.</p></div>
        <div data-reveal style="--d:1"><h3>Companies</h3><p>Teams launching, rebranding or reaching a new audience.</p></div>
        <div data-reveal style="--d:2"><h3>Organisations</h3><p>Non-profits, faith groups and institutions with a cause to share.</p></div>
        <div data-reveal style="--d:3"><h3>Creators</h3><p>Artists, founders and public voices building a name that lasts.</p></div>
      </div>
    </div>
  </section>

  <section class="cta red" aria-labelledby="cta-title">
    <div class="rings" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap">
      <h2 id="cta-title" data-split>Tell us what you're building.</h2>
      <p data-reveal>Share where you are, where it feels stuck and what a good result would change. We will reply with honest next steps.</p>
      <a class="btn solid" href="/contact" data-reveal><span class="dot" aria-hidden="true"></span>Book a meeting</a>
    </div>
  </section>
</Site>
