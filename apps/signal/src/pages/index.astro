---
import Site from '../layouts/Site.astro'
import Pic from '../components/Pic.astro'
import Sig from '../components/Sig.astro'
import Arrow from '../components/Arrow.astro'
import { services, engagements } from '../data/services'

// The rolling word in the headline. Each one ends with the red full stop.
const words = ['listen', 'care', 'remember', 'act', 'come back']
const wallA = services.slice(0, 3)
const wallB = services.slice(3)
const manifesto = 'People meet thousands of messages a day. They forget almost all of them. They remember the ones that mean something, said clearly, in the right place.'
const steps = [
  ['Find the story', 'We learn the business, the audience and the real problem, then find the one idea worth building around.'],
  ['Shape the strategy', 'We choose who to reach, what to say and where to say it, so every part of the plan pulls the same way.'],
  ['Move the message', 'We make the campaign, the content and the journeys that carry the story to the right people.'],
  ['Learn and sharpen', 'We measure what people actually do, keep what works and fix what does not.'],
]
---
<Site
  title="SIGNAL. by SIRYUS"
  description="SIGNAL. is a story-led marketing and growth agency. We find the story people care about, shape the strategy and build campaigns that move people to act."
  preload="video-camera"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>
          <span data-split>Make them</span>
          <span class="roll" data-roll aria-hidden="true">
            <span class="roll-track">{[...words, words[0]].map((w) => <span>{w}<span class="pd">.</span></span>)}</span>
          </span>
          <span class="sr">{words.join(', ')}.</span>
        </h1>
        <p class="hero-lede" data-reveal style="--d:4">Good marketing starts with a story people care about. <Sig /> finds that story, shapes the strategy and builds the campaigns that move people to act.</p>
        <div class="actions" data-reveal style="--d:6">
          <a class="btn" href="/contact">Book a meeting <Arrow /></a>
          <a class="text-link" href="/services">See what we do</a>
        </div>
      </div>
      <div class="wall" aria-hidden="true">
        <div class="col">{[...wallA, ...wallA].map((s, i) => <Pic name={s.image} alt="" sizes="(max-width: 56rem) 40vw, 20vw" eager={i === 0} width={800} height={1000} />)}</div>
        <div class="col">{[...wallB, ...wallB].map((s) => <Pic name={s.image} alt="" sizes="20vw" width={800} height={1000} />)}</div>
      </div>
    </div>
    <div class="wrap">
      <nav class="disciplines" aria-label="Disciplines">{services.map((s) => <a href={`/services/${s.slug}`}>{s.name}</a>)}</nav>
    </div>
  </section>

  <section class="section stone manifesto" data-scrub aria-label="What we believe">
    <div class="wrap">
      <p data-words>{manifesto}</p>
      <div class="after">
        <p data-reveal>That is the gap <Sig /> works in. We help brands, companies and organisations decide what to say, say it clearly, and get it to the people who need to hear it.</p>
        <div data-reveal style="--d:1"><a class="btn quiet" href="/about"><span>About <Sig /></span></a></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="head">
        <h2 id="svc-title" data-split>From the first idea to the final result<span class="pd keep">.</span></h2>
        <p data-reveal>Six disciplines, one story running through all of them. Use one, or bring us in for everything.</p>
      </div>
      <div class="mag">
        {services.map((s, i) => (
          <a class="story" href={`/services/${s.slug}`} data-reveal style={`--d:${i % 3}`}>
            <div class="img"><Pic name={s.image} alt={s.alt} sizes={i === 0 ? '(max-width: 60rem) 100vw, 60vw' : '(max-width: 36rem) 100vw, (max-width: 60rem) 50vw, 30vw'} /></div>
            <h3><span>{s.name}</span><span class="pd">.</span></h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section paper" data-scrub aria-labelledby="method-title">
    <div class="wrap">
      <div class="head">
        <h2 id="method-title" data-split>How a story gets told<span class="pd keep">.</span></h2>
        <p data-reveal>Every project, big or small, runs the same way. You always know where we are and what comes next.</p>
      </div>
      <ol class="sequence">
        {steps.map(([title, text], i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="n">Step {i + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <div class="actions" style="margin-top:3rem" data-reveal><a class="text-link" href="/approach">More on our approach</a></div>
    </div>
  </section>

  <section class="pull" aria-label="A principle we work by">
    <div class="bg" data-speed="0.1"><Pic name="london-billboard" alt="" sizes="100vw" /></div>
    <div class="wrap">
      <blockquote data-split>Attention is rented. Meaning is owned<span class="pd keep">.</span></blockquote>
      <p data-reveal>Anyone can buy a moment on a screen. We help you build a message people carry with them after the ad is gone.</p>
    </div>
  </section>

  <section class="section stone" aria-labelledby="ways-title">
    <div class="wrap">
      <div class="head">
        <h2 id="ways-title" data-split>Ways to work with us<span class="pd keep">.</span></h2>
        <p data-reveal>Every engagement starts with a meeting. Scope and price are agreed in writing before any work begins.</p>
      </div>
      <div class="ways">
        {engagements.map((e, i) => (
          <article class="way" data-reveal style={`--d:${i}`}>
            <h3>{e.name}</h3>
            <p>{e.line}</p>
            <a class="text-link" href="/contact">Book a meeting</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-title">
    <div class="wrap">
      <div class="head">
        <h2 id="who-title" data-split>Who we work with<span class="pd keep">.</span></h2>
        <p data-reveal>Not just music, and not just big budgets. Anyone with something real to say and a reason to say it well.</p>
      </div>
      <div class="audience">
        <div data-reveal style="--d:0"><h3>Growing brands</h3><p>Products and services ready to be known for one clear thing.</p></div>
        <div data-reveal style="--d:1"><h3>Companies</h3><p>Teams launching, rebranding or reaching a new audience.</p></div>
        <div data-reveal style="--d:2"><h3>Organisations</h3><p>Non-profits, faith groups and institutions with a cause to share.</p></div>
        <div data-reveal style="--d:3"><h3>Creators</h3><p>Artists, founders and public voices building a name that lasts.</p></div>
      </div>
    </div>
  </section>

  <section class="call" aria-labelledby="cta-title">
    <div class="wrap">
      <h2 id="cta-title" data-split>Tell us what you're building<span class="pd keep">.</span></h2>
      <div class="row">
        <p data-reveal>Share where you are, where it feels stuck and what a good result would change. We will reply with honest next steps.</p>
        <a class="btn" href="/contact" data-reveal>Book a meeting <Arrow /></a>
      </div>
    </div>
  </section>
</Site>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

  // Roll the headline word. The last item repeats the first so the loop can reset without a jump.
  const roll = document.querySelector<HTMLElement>('[data-roll] .roll-track')
  if (roll && !reduce) {
    const count = roll.children.length
    let i = 0
    setInterval(() => {
      if (document.hidden) return
      i += 1
      roll.style.transition = ''
      roll.style.transform = `translateY(${-i * 1.05}em)`
      if (i === count - 1) {
        setTimeout(() => {
          roll.style.transition = 'none'
          roll.style.transform = 'translateY(0)'
          i = 0
        }, 1000)
      }
    }, 2400)
  }

  // Split the manifesto into words; each word lights up as the section scrolls past (see .manifesto .k).
  document.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
    const words = (el.textContent ?? '').trim().split(/\s+/)
    el.textContent = ''
    const sr = document.createElement('span')
    sr.className = 'sr'
    sr.textContent = words.join(' ')
    el.append(sr)
    words.forEach((word, n) => {
      const span = document.createElement('span')
      span.className = 'k'
      span.setAttribute('aria-hidden', 'true')
      span.style.setProperty('--k', (n / words.length).toFixed(3))
      span.textContent = word
      el.append(span, ' ')
    })
  })
</script>
