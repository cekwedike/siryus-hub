---
import Site from '../../layouts/Site.astro'
import Pic from '../../components/Pic.astro'
import Arrow from '../../components/Arrow.astro'
import { services, type Service } from '../../data/services'

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }))
}
const { service } = Astro.props as { service: Service }
const i = services.indexOf(service)
const others = [1, 2, 3].map((n) => services[(i + n) % services.length])
const schema = [{
  '@type': 'Service',
  name: service.name,
  description: service.long,
  serviceType: service.name,
  url: new URL(`/services/${service.slug}`, Astro.site).href,
  provider: { '@id': 'https://growth.siryushub.com/#organization' },
  areaServed: 'Worldwide',
}]
---
<Site title={service.name} description={`${service.short} ${service.long}`.slice(0, 158)} image={new URL(`/images/${service.image}-1600.webp`, Astro.site).href} schema={schema}>
  <header class="phero">
    <div class="wrap grid">
      <div>
        <a class="crumb" href="/services">Services</a>
        <h1 data-split>{service.name}<span class="pd keep">.</span></h1>
      </div>
      <div>
        <p class="lede" data-reveal>{service.short}</p>
        <div class="actions" data-reveal style="margin-top:1.6rem">
          <a class="btn" href={`/contact?service=${service.slug}`}>Book a meeting <Arrow /></a>
          <a class="text-link" href="/services">All services</a>
        </div>
      </div>
    </div>
  </header>
  <div class="cover"><div data-speed="0.08" style="position:absolute;inset:0"><Pic name={service.image} alt={service.alt} eager sizes="100vw" /></div></div>

  <section class="section stone">
    <div class="wrap cols">
      <div>
        <h2 data-split>What it is<span class="pd keep">.</span></h2>
        <p data-reveal>{service.long}</p>
        <p class="muted" data-reveal style="margin-top:1.2rem">{service.forWho}</p>
      </div>
      <div>
        <h2 data-split>What you get<span class="pd keep">.</span></h2>
        <ul class="list">{service.includes.map((x, n) => <li data-reveal style={`--d:${n}`}>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section paper" data-scrub>
    <div class="wrap">
      <div class="head"><h2 data-split>How it works<span class="pd keep">.</span></h2></div>
      <ol class="sequence" style="--n:3">
        <li data-reveal style="--d:0"><span class="n">Step 1</span><h3>Book a meeting</h3><p>Tell us about the business, the audience and what you want to change.</p></li>
        <li data-reveal style="--d:1"><span class="n">Step 2</span><h3>Agree the plan</h3><p>We put scope, timeline and price in writing before any work begins.</p></li>
        <li data-reveal style="--d:2"><span class="n">Step 3</span><h3>We do the work</h3><p>We deliver, report in plain language and sharpen what works.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="more">
    <div class="wrap">
      <div class="head"><h2 id="more" data-split>Pairs well with<span class="pd keep">.</span></h2></div>
      <div class="mag trio">
        {others.map((s, n) => (
          <a class="story" href={`/services/${s.slug}`} data-reveal style={`--d:${n}`}>
            <div class="img"><Pic name={s.image} alt={s.alt} sizes="(max-width: 36rem) 100vw, 30vw" /></div>
            <h3><span>{s.name}</span><span class="pd">.</span></h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="call" aria-labelledby="cta-title">
    <div class="wrap">
      <h2 id="cta-title" data-split>Let's talk about it<span class="pd keep">.</span></h2>
      <div class="row">
        <p data-reveal>Book a meeting and tell us what you are building. You will leave with honest next steps, whether we work together or not.</p>
        <a class="btn" href={`/contact?service=${service.slug}`} data-reveal>Book a meeting <Arrow /></a>
      </div>
    </div>
  </section>
</Site>
