---
import Site from '../../layouts/Site.astro'
import Pic from '../../components/Pic.astro'
import Arrow from '../../components/Arrow.astro'
import { services, engagements } from '../../data/services'

const schema = services.map((s) => ({ '@type': 'Service', name: s.name, description: s.long, url: new URL(`/services/${s.slug}`, Astro.site).href, provider: { '@id': 'https://growth.siryushub.com/#organization' } }))
---
<Site title="Services" description="SIGNAL. services: storytelling, brand strategy, campaigns, content and copy, email and CRM, and growth. Connected marketing around one clear message." schema={schema}>
  <header class="phero">
    <div class="wrap grid">
      <h1 data-split>Connected work. One clear message<span class="pd keep">.</span></h1>
      <div>
        <p class="lede" data-reveal>Each service works on its own. They work best together, because they all start from the same story.</p>
        <div class="actions" data-reveal style="margin-top:1.6rem"><a class="btn" href="/contact">Book a meeting <Arrow /></a></div>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap mag">
      {services.map((s, i) => (
        <a class="story" href={`/services/${s.slug}`} data-reveal style={`--d:${i % 3}`}>
          <div class="img"><Pic name={s.image} alt={s.alt} sizes={i === 0 ? '(max-width: 60rem) 100vw, 60vw' : '(max-width: 36rem) 100vw, (max-width: 60rem) 50vw, 30vw'} eager={i === 0} /></div>
          <h2 style="font-size:clamp(1.6rem,2.4vw,2.2rem);line-height:1.02"><span>{s.name}</span><span class="pd">.</span></h2>
          <p>{s.long}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section stone" aria-labelledby="ways-title">
    <div class="wrap">
      <div class="head">
        <h2 id="ways-title" data-split>Ways to work with us<span class="pd keep">.</span></h2>
        <p data-reveal>Scope and price are agreed in writing after a short meeting. Ad budgets are always separate and only spent with your approval.</p>
      </div>
      <div class="ways">
        {engagements.map((e, i) => (
          <article class="way" data-reveal style={`--d:${i}`}>
            <h3>{e.name}</h3>
            <p>{e.line}</p>
            <a class="text-link" href="/contact">Book a meeting</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Site>
