---
import Site from '../layouts/Site.astro'
import Cosmos from '../components/Cosmos.astro'
import Pic from '../components/Pic.astro'
import Paths from '../components/Paths.astro'

const steps = [
  ['Listen', 'We learn the business, the audience and the real problem before we reach for a format.', 'Expect questions. Some of the best answers come from your customers, your team and the things you have already tried.'],
  ['Find the story', 'We shape the one clear idea that can guide the work and hold attention.', 'You get it in writing: what we say, who we say it to and why they should care.'],
  ['Build the system', 'We connect campaign, content, email and growth so each part helps the next.', 'Plans come with timelines and budgets you approve before anything goes live.'],
  ['Learn and sharpen', 'We study what people actually do, keep what works and fix what does not.', 'Reports are plain and regular. If something is not working, you hear it from us first.'],
]
---
<Site title="Approach" description="How SIGNAL. works: listen, find the story, build the system, then learn and sharpen. Story-led marketing, step by step.">
  <header class="page-hero">
    <Cosmos />
    <div class="wrap" style="position:relative;z-index:1">
      <h1 data-split>Start with what must be heard.</h1>
      <p class="lede" data-reveal>Then build the strategy, message and system that can carry it. Here is how a project with us runs.</p>
    </div>
    <Paths class="corner" />
  </header>
  <section class="section white">
    <div class="wrap">
      <ol class="steps" style="grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))">
        {steps.map(([title, lead, detail], i) => (
          <li data-reveal style={`--d:${i}`}><h3 style="font:clamp(1.6rem,2.4vw,2.2rem)/1.05 var(--display);margin-bottom:.8rem">{title}</h3><p>{lead}</p><p style="margin-top:.8rem">{detail}</p></li>
        ))}
      </ol>
    </div>
  </section>
  <section class="feature" aria-labelledby="band-title">
    <div class="bg" data-speed="0.12"><Pic name="sticky-wall" alt="" sizes="100vw" /></div>
    <div class="wrap">
      <h2 id="band-title" data-split>Your team stays in the room.</h2>
      <div data-reveal>
        <p>We work with you, not around you. You will always know what we are doing, why, and what it costs.</p>
        <a class="btn" href="/contact">Book a meeting</a>
      </div>
    </div>
  </section>
  <section class="cta red">
    <div class="rings" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap">
      <h2 data-split>Ready when you are.</h2>
      <p data-reveal>Tell us what you are building and we will suggest a sensible first step.</p>
      <a class="btn solid" href="/contact" data-reveal><span class="dot" aria-hidden="true"></span>Book a meeting</a>
    </div>
  </section>
</Site>
<style>
  .corner { position: absolute; right: var(--gutter); bottom: -4rem; width: clamp(10rem, 24vw, 20rem); z-index: 0; }
</style>
