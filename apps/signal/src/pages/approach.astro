---
import Site from '../layouts/Site.astro'
import Pic from '../components/Pic.astro'
import Arrow from '../components/Arrow.astro'

const steps = [
  ['Listen', 'We learn the business, the audience and the real problem before we reach for a format.', 'Expect questions. Some of the best answers come from your customers, your team and the things you have already tried.'],
  ['Find the story', 'We shape the one clear idea that can guide the work and hold attention.', 'You get it in writing: what we say, who we say it to and why they should care.'],
  ['Build the system', 'We connect campaign, content, email and growth so each part helps the next.', 'Plans come with timelines and budgets you approve before anything goes live.'],
  ['Learn and sharpen', 'We study what people actually do, keep what works and fix what does not.', 'Reports are plain and regular. If something is not working, you hear it from us first.'],
]
---
<Site title="Approach" description="How SIGNAL. works: listen, find the story, build the system, then learn and sharpen. Story-led marketing, step by step.">
  <header class="phero">
    <div class="wrap grid">
      <h1 data-split>Start with what must be heard<span class="pd keep">.</span></h1>
      <p class="lede" data-reveal>Then build the strategy, message and system that can carry it. Here is how a project with us runs.</p>
    </div>
  </header>
  <section class="section paper" data-scrub>
    <div class="wrap">
      <ol class="sequence">
        {steps.map(([title, lead, detail], i) => (
          <li data-reveal style={`--d:${i}`}><span class="n">Step {i + 1}</span><h2 style="font-size:clamp(1.6rem,2.4vw,2.1rem);line-height:1.05;margin-bottom:.7rem">{title}</h2><p>{lead}</p><p>{detail}</p></li>
        ))}
      </ol>
    </div>
  </section>
  <section class="pull" aria-labelledby="band-title">
    <div class="bg" data-speed="0.1"><Pic name="sticky-wall" alt="" sizes="100vw" /></div>
    <div class="wrap">
      <h2 id="band-title" data-split style="font-size:clamp(2.2rem,5.6vw,5.2rem);line-height:1.02;max-width:18ch">Your team stays in the room<span class="pd keep">.</span></h2>
      <p data-reveal>We work with you, not around you. You will always know what we are doing, why, and what it costs.</p>
    </div>
  </section>
  <section class="call">
    <div class="wrap">
      <h2 data-split>Ready when you are<span class="pd keep">.</span></h2>
      <div class="row">
        <p data-reveal>Tell us what you are building and we will suggest a sensible first step.</p>
        <a class="btn" href="/contact" data-reveal>Book a meeting <Arrow /></a>
      </div>
    </div>
  </section>
</Site>
