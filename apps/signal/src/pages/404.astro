---
import Site from '../layouts/Site.astro'

const routes = [
  ['Services', 'Strategy, campaigns, content and growth', '/services'],
  ['Work', 'See the kind of work we do', '/work'],
  ['Approach', 'How story shapes every choice', '/approach'],
  ['Contact', 'Tell us what you are building', '/contact'],
]
---
<Site noIndex title="Page not found" description="This page moved or never existed. Find your way back to SIGNAL. by SIRYUS."><section class="lost"><div class="lost-copy"><p class="lost-tag">Error 404</p><h1>Signal lost<span class="dot" aria-hidden="true"></span></h1><p>We couldn't find that page. It may have moved, or the link may be broken. Here is where the story picks up again.</p><nav class="routes" aria-label="Pages to try">{routes.map(([name, note, href]) => <a href={href}>{name}<span>{note}</span></a>)}</nav><p><a class="button" href="/">Back to SIGNAL.</a></p></div><div class="broadcast" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b><img src="/brand/signal/symbol.png" alt=""/></div></section></Site>
