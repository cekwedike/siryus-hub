---
import Site from '../layouts/Site.astro'
import Cosmos from '../components/Cosmos.astro'
import { services } from '../data/services'

const options = [...services.map((s) => [s.slug, s.name]), ['not-sure', 'Not sure yet']]
---
<Site title="Book a meeting" description="Book a meeting with SIGNAL. Tell us what you are building and we will reply with honest next steps for your story, strategy and campaigns.">
  <header class="page-hero">
    <Cosmos />
    <div class="wrap" style="position:relative">
      <h1 data-split>Tell us what you're building.</h1>
      <p class="lede" data-reveal>Where are you now, where does it feel stuck, and what would a good result change? We will reply to set up a meeting, usually within two working days.</p>
    </div>
  </header>
  <section class="section white">
    <div class="wrap contact-grid">
      <form class="form" action="/api/contact" method="post" data-contact>
        <p class="form-status full" role="status" aria-live="polite" tabindex="-1"></p>
        <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div>
        <div class="field"><label for="email">Work email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="company">Company or brand</label><input id="company" name="company" autocomplete="organization" /></div>
        <div class="field"><label for="need">What would you like to talk about?</label><select id="need" name="need">{options.map(([slug, label]) => <option value={label} data-slug={slug}>{label}</option>)}</select></div>
        <div class="field"><label for="budget">Budget <small>(optional)</small></label><input id="budget" name="budget" placeholder="A rough range helps" /></div>
        <div class="field"><label for="timing">Best time for a meeting</label><input id="timing" name="timing" placeholder="For example, Tuesday mornings (WAT)" /></div>
        <div class="field full"><label for="message">Tell us about it</label><textarea id="message" name="message" required minlength="10"></textarea></div>
        <div class="trap" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
        <input type="hidden" name="started" value="" />
        <p class="full"><small>We use these details only to reply and arrange your meeting. See our <a href="https://siryushub.com/privacy-policy">privacy policy</a>.</small></p>
        <button class="btn solid" type="submit"><span class="dot" aria-hidden="true"></span>Request a meeting</button>
      </form>
      <aside class="contact-aside" data-reveal>
        <h2>Prefer email?</h2>
        <p>Write to <a href="mailto:signal@siryushub.com">signal@siryushub.com</a>.</p>
        <p>Every first meeting is free and comes with no obligation. You will leave with honest next steps either way.</p>
      </aside>
    </div>
  </section>
</Site>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]')
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!
    const button = form.querySelector<HTMLButtonElement>('button')!
    const label = button.innerHTML
    const inbox = 'signal@siryushub.com'
    ;(form.elements.namedItem('started') as HTMLInputElement).value = String(Date.now())
    const params = new URLSearchParams(location.search)
    if (params.get('sent')) status.textContent = 'Thanks. Your request is in, and a copy is in your inbox. We will reply to arrange a time.'
    if (params.get('error')) status.textContent = `Something went wrong. Please try again or email ${inbox}.`
    const select = form.elements.namedItem('need') as HTMLSelectElement
    const match = [...select.options].find((o) => o.dataset.slug === params.get('service'))
    if (match) match.selected = true
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      button.disabled = true
      button.textContent = 'Sending…'
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } })
        const data = await res.json()
        status.textContent = data.message
        if (res.ok) form.reset()
      } catch {
        status.textContent = `We could not reach the server. Please email ${inbox}.`
      }
      button.disabled = false
      button.innerHTML = label
      status.focus()
    })
  }
</script>
