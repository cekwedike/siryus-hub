---
// Self-hosted photo at 800 and 1600 px (see docs/IMAGE_CREDITS.md).
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; width?: number; height?: number }
const { name, alt, sizes = '(max-width: 52rem) 100vw, 50vw', eager = false, width = 1600, height = 1067 } = Astro.props
---
<img
  src={`/images/${name}-1600.webp`}
  srcset={`/images/${name}-800.webp 800w, /images/${name}-1600.webp 1600w`}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
