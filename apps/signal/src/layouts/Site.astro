---
import '../styles/site.css'
import Return from '../../../../shared/astro/Return.astro'

interface Props {
  title: string
  description: string
  noIndex?: boolean
  schema?: Record<string, unknown>[]
  preload?: string
}
const { title, description, noIndex = false, schema = [], preload } = Astro.props
const pageTitle = title === 'SIGNAL. by SIRYUS' ? title : `${title} | SIGNAL. by SIRYUS`
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href
const ogImage = new URL('/og.png', Astro.site).href
const org = 'https://growth.siryushub.com/#organization'
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': org,
      name: 'SIGNAL. by SIRYUS',
      alternateName: 'SIGNAL.',
      url: 'https://growth.siryushub.com/',
      logo: new URL('/icon-512.png', Astro.site).href,
      email: 'signal@siryushub.com',
      description: 'A story-led marketing and growth agency: brand strategy, campaigns, content and copy, email and CRM, growth and storytelling.',
      knowsAbout: ['Brand strategy', 'Marketing campaigns', 'Content marketing', 'Copywriting', 'Email marketing', 'CRM', 'Growth marketing', 'Storytelling'],
      parentOrganization: { '@type': 'Organization', name: 'Siryus Creative Media Ltd', url: 'https://siryushub.com/' },
    },
    { '@type': 'WebSite', '@id': 'https://growth.siryushub.com/#website', name: 'SIGNAL. by SIRYUS', url: 'https://growth.siryushub.com/', publisher: { '@id': org } },
    ...schema,
  ],
}
const nav = [
  ['Services', '/services'],
  ['Approach', '/approach'],
  ['Work', '/work'],
  ['About', '/about'],
]
const here = Astro.url.pathname.replace(/\/$/, '') || '/'
---
<!doctype html>
<html lang="en">
  <Fragment set:html={'<!--email_off-->'} />
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f3ede4" />
    <link rel="preload" href="/fonts/dm-serif-display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" as="image" imagesrcset={`/images/${preload}-800.webp 800w, /images/${preload}-1600.webp 1600w`} imagesizes="(max-width: 56rem) 100vw, 48vw" fetchpriority="high" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SIGNAL. by SIRYUS" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Return />
    <header class="masthead">
      <a class="brand" href="/" aria-label="SIGNAL. by SIRYUS home">
        <img src="/brand/signal/lockup-light.webp" alt="" width="156" height="52" />
      </a>
      <details class="menu">
        <summary aria-label="Menu"><span></span><span></span></summary>
        <nav aria-label="Main">
          {nav.map(([label, href]) => <a href={href} aria-current={here === href ? 'page' : undefined}>{label}</a>)}
          <a class="cta" href="/contact" aria-current={here === '/contact' ? 'page' : undefined}>Talk to us</a>
        </nav>
      </details>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-top">
        <div>
          <img src="/brand/signal/lockup-dark.webp" alt="SIGNAL. by SIRYUS" width="208" height="52" loading="lazy" />
          <p>Make your message matter.</p>
        </div>
        <nav aria-label="Footer">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
          <a href="/contact">Contact</a>
        </nav>
        <div class="footer-contact">
          <p>New project?</p>
          <a href="mailto:signal@siryushub.com">signal@siryushub.com</a>
        </div>
      </div>
      <div class="footer-base">
        <Return variant="footer" />
        <p>© 2026 Siryus Creative Media Ltd. <a href="https://siryushub.com/privacy-policy">Privacy</a> <a href="https://siryushub.com/terms-of-use">Terms</a></p>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.menu')
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)))
      document.addEventListener('keydown', (e) => e.key === 'Escape' && menu && (menu.open = false))
    </script>
  </body>
  <Fragment set:html={'<!--/email_off-->'} />
</html>
