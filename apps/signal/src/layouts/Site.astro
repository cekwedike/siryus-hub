---
import '../styles/site.css'
interface Props { title: string; description: string; noIndex?: boolean }
const { title, description, noIndex = false } = Astro.props
const pageTitle = `${title} | SIGNAL. by SIRYUS`
const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL('/og.png', Astro.site).href
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://growth.siryushub.com/#organization', name: 'SIGNAL. by SIRYUS', url: 'https://growth.siryushub.com/', logo: new URL('/icon-512.png', Astro.site).href, description: 'A story-led marketing and growth agency: strategy, campaigns, content, CRM and growth.', parentOrganization: { '@type': 'Organization', name: 'Siryus Creative Media Ltd', url: 'https://siryushub.com/' } },
    { '@type': 'WebSite', '@id': 'https://growth.siryushub.com/#website', name: 'SIGNAL. by SIRYUS', url: 'https://growth.siryushub.com/', publisher: { '@id': 'https://growth.siryushub.com/#organization' } },
  ],
}
const nav = [['Services', '/services'], ['Approach', '/approach'], ['Work', '/work'], ['Insights', '/insights'], ['About', '/about']]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{pageTitle}</title>
    <meta name="description" content={description}/>
    {noIndex ? <meta name="robots" content="noindex"/> : <link rel="canonical" href={canonical}/>}
    <meta name="theme-color" content="#f4eadb"/>
    <link rel="icon" href="/favicon.ico" sizes="48x48"/><link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
    <meta property="og:type" content="website"/><meta property="og:site_name" content="SIGNAL. by SIRYUS"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>
  </head>
  <body><a class="skip" href="#main">Skip to content</a><header class="nav"><a class="logo" href="/"><img src="/brand/signal/symbol.png" alt=""/>SIGNAL<span>.</span></a><nav aria-label="Main navigation">{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav><a class="talk" href="/contact">Talk to us</a></header><main id="main"><slot/></main><footer><div><a class="logo inverse" href="/">SIGNAL<span>.</span></a><p>Story-led marketing for brands ready to mean more.</p></div><nav aria-label="Footer navigation">{nav.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/contact">Contact</a></nav><p>by SIRYUS<br/>© 2026 Siryus Creative Media Ltd<br/><a href="https://siryushub.com/privacy-policy">Privacy policy</a></p></footer></body>
</html>
