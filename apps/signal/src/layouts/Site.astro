---
import '../styles/site.css'
interface Props { title: string; description: string }
const { title, description } = Astro.props
const nav = [['Services', '/services'], ['Approach', '/approach'], ['Work', '/work'], ['Insights', '/insights'], ['About', '/about']]
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#f4eadb"/><link rel="icon" href="/favicon.ico" sizes="48x48"/><link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><title>{title} | SIGNAL. by SIRYUS</title></head>
  <body><a class="skip" href="#main">Skip to content</a><header class="nav"><a class="logo" href="/"><img src="/brand/signal/symbol.png" alt=""/>SIGNAL<span>.</span></a><nav aria-label="Main navigation">{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav><a class="talk" href="/contact">Talk to us</a></header><main id="main"><slot/></main><footer><div><a class="logo inverse" href="/">SIGNAL<span>.</span></a><p>Story-led marketing for brands ready to mean more.</p></div><nav aria-label="Footer navigation">{nav.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/contact">Contact</a></nav><p>by SIRYUS<br/>© 2026 Siryus Creative Media Ltd</p></footer></body>
</html>
