---
import Site from '../layouts/Site.astro'
import Ticker from '../components/Ticker.astro'
import { photosOf } from '../lib/sanity'

const wall = [...photosOf('max-prodigy').slice(1, 3), ...photosOf('jlinez').slice(1, 2), ...photosOf('hidaya-morgan').slice(0, 1)]
---
<Site title="About" description="SIRYUS A.M is a music management company and creative collective based in Abuja, Nigeria, working with artists across Africa. Part of SIRYUS.">
  <header class="phero">
    <div class="wrap grid">
      <h1 data-split>Music people, working for artists.</h1>
      <div>
        <p class="lede" data-reveal>SIRYUS A.M is a music management company and creative collective based in Abuja, Nigeria, working with artists across Africa. It is one of the SIRYUS worlds, alongside ARC. Creatives and SIGNAL.</p>
        <div class="actions" data-reveal style="margin-top:1.8rem"><a class="btn" href="/contact">Book a meeting</a></div>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <p class="display" data-split style="font-size:clamp(2rem,4.6vw,4.2rem);line-height:1;max-width:22ch">Too much great music goes unheard. Not because the songs are weak, but because nobody planned the release.</p>
      <div class="split" style="margin-top:clamp(3rem,6vw,5rem)">
        <div data-reveal>
          <h2>A management company.</h2>
          <p>Artists book us for one service, a full release package or complete management. Every engagement starts with a meeting and a clear plan, agreed in writing before any work begins.</p>
          <div class="actions" style="margin-top:1.6rem"><a class="more" href="/services">Our services</a></div>
        </div>
        <div data-reveal style="--d:1">
          <h2>A creative collective.</h2>
          <p>We make records too. SIRYUS A.M has its own releases on every major platform, and we run projects like the Indiba Project Series that bring artists together to create and grow.</p>
          <div class="actions" style="margin-top:1.6rem"><a class="more" href="/music">Our music</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section smoke" aria-labelledby="arc-title">
    <div class="wrap split" style="align-items:end">
      <h2 id="arc-title" data-split>Home of ARC. Creatives' music.</h2>
      <div data-reveal>
        <p>SIRYUS A.M releases the music of ARC. Creatives, our sister community for Christian creatives. We work with gospel and Christian artists on distribution, release strategy, marketing and management.</p>
        <div class="actions" style="margin-top:1.6rem"><a class="btn" href="/contact?service=distribution&amp;about=a%20release%20via%20ARC.%20Creatives">Book a meeting</a><a class="more" href="https://collective.siryushub.com/arc/music">ARC. Creatives music</a></div>
      </div>
    </div>
  </section>

  <section class="section ink" aria-label="Artists we have worked with">
    <div class="wrap">
      <div class="gallery" style="margin:0;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr))">
        {wall.map((p, i) => <img class="bw" src={p.src} alt={p.alt} width="640" height="640" loading="lazy" data-reveal style={`--d:${i}`} />)}
      </div>
    </div>
  </section>

  <Ticker items={['Release', 'Grow', 'Build', 'Music management', 'Creative collective']} />

  <section class="section">
    <div class="wrap band">
      <h2 data-split>Part of SIRYUS. Different worlds, one creative universe.</h2>
      <div class="actions" data-reveal><a class="btn line" href="https://siryushub.com">Visit SIRYUS</a></div>
    </div>
  </section>
</Site>
