---
import Site from '../layouts/Site.astro'
import Bars from '../components/Bars.astro'
---
<Site title="About" description="SIRYUS A.M is the music management company and creative collective of Siryus Creative Media Ltd, based in Abuja, Nigeria.">
  <header class="page-hero">
    <div class="wrap">
      <h1>Music people, working for artists.</h1>
      <p>SIRYUS A.M is the music arm of Siryus Creative Media Ltd. We are a music management company and a creative collective, based in Abuja, Nigeria, and working with artists across Africa.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap closing">
      <h2>Why we exist.</h2>
      <div class="prose">
        <p>Too many independent artists make great music that goes nowhere. Not because the songs are weak, but because nobody planned the release, nobody pitched it, and nobody explained the business side.</p>
        <p>We fix that. We distribute releases, plan rollouts, pitch to playlists, run marketing and help artists build their brand. For a small roster, we go further and manage the whole career.</p>
        <p>We also make music ourselves. Through the Indiba Project Series and our own releases, we bring artists together to record, learn and grow as a group.</p>
      </div>
    </div>
  </section>
  <section class="section lime">
    <div class="wrap closing">
      <h2>Fair by design.</h2>
      <div class="prose">
        <p>Artists keep their masters. Fees are agreed in writing before any work starts. Every budget is approved by the artist, and every report comes with proof. If it is not written down, it does not apply.</p>
        <Bars count={14} />
      </div>
    </div>
  </section>
  <section class="section dark">
    <div class="wrap closing">
      <h2>Part of something bigger.</h2>
      <div>
        <p>SIRYUS A.M sits alongside ARC. Creatives and SIGNAL. in the SIRYUS family of creative brands. Different worlds, one creative universe.</p>
        <a class="btn btn-lime" href="https://siryushub.com">Visit SIRYUS</a>
      </div>
    </div>
  </section>
</Site>
