---
import Site from '../../layouts/Site.astro'
import Cosmos from '../../components/Cosmos.astro'
import { getRoster, img } from '../../lib/sanity'

const roster = await getRoster()
---
<Site title="Artists" description={`Meet ${roster.map((a) => a.name).join(' and ')}, the artists managed by SIRYUS A.M.`}>
  <header class="page-hero">
    <Cosmos />
    <div class="wrap" style="position:relative">
      <h1 data-split>Artists with a world of their own.</h1>
      <p class="lede" data-reveal>We keep the roster small on purpose. Every artist gets real time, a plan built around who they are, and a team that stays close.</p>
    </div>
  </header>
  <section class="section" style="padding-top:0">
    <div class="wrap roster">
      {roster.map((a) => (
        <a class="artist" href={`/artists/${a.slug}`} data-reveal>
          <div class="frame"><img src={img(a.photo, 900)} alt={a.name} width="640" height="640" data-speed="0.06" /></div>
          <h2 style="font:clamp(2.2rem,5.2vw,4.8rem)/.9 var(--display);margin-top:-.55em;position:relative;padding-left:.2rem">{a.name}</h2>
          <div class="meta">
            <p class="line">{a.oneLiner}</p>
            <ul class="chips">{a.genre?.map((g) => <li>{g}</li>)}</ul>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="cta white">
    <div class="rings" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap">
      <h2 data-split>Not on the roster? We can still help.</h2>
      <p data-reveal>Most of our work is with independent artists who book a single service or a release package.</p>
      <a class="btn solid" href="/services" data-reveal>See our services</a>
    </div>
  </section>
</Site>
