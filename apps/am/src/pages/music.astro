---
import Site from '../layouts/Site.astro'
import Disc from '../components/Disc.astro'
import Releases from '../components/Releases.astro'
import { releases, features, spotify } from '../lib/collective'

const schema = [{
  '@type': 'MusicGroup',
  '@id': 'https://artists.siryushub.com/#organization',
  album: releases.map((r) => ({ '@type': 'MusicAlbum', name: r.title, byArtist: r.credit, datePublished: r.date, url: r.apple, image: new URL(r.cover, Astro.site).href })),
}]
---
<Site title="Music" description="Music from SIRYUS A.M, the collective: Me & You, Nyongorera, LAVO and Tarama, made with Jlinez, Hidaya Morgan, Couronne., Max Prodigy, ARC. Creatives and more." schema={schema}>
  <header class="phero">
    <div class="wrap grid">
      <div>
        <h1 data-split>We make records too.</h1>
        <p class="lede" data-reveal style="margin-top:1.6rem">SIRYUS A.M is a creative collective as well as a management company. We release our own records and bring artists together on them.</p>
        <div class="actions" data-reveal style="margin-top:1.8rem"><a class="btn" href={spotify} target="_blank" rel="noopener">Follow on Spotify</a></div>
      </div>
      <div class="mini"><Disc /></div>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <div class="title"><h2 data-split>Releases.</h2><p data-reveal>Open a record to listen on Apple Music, or follow us on your favourite platform.</p></div>
      <Releases />
    </div>
  </section>
  <section class="section smoke">
    <div class="wrap">
      <div class="title"><h2 data-split>Also featured on.</h2></div>
      <ol class="tracklist" style="margin-top:0">
        {features.map(([title, credit]) => (
          <li data-reveal><a href={spotify} target="_blank" rel="noopener"><span><strong>{title}</strong><br /><span>{credit}</span></span><span>Listen</span></a></li>
        ))}
      </ol>
    </div>
  </section>
</Site>
