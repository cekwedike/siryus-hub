---
import Site from '../layouts/Site.astro'
import Turntable from '../components/Turntable.astro'
import Releases from '../components/Releases.astro'
import { releases, features, spotify } from '../lib/collective'
import { getReleases, linksOf } from '../lib/sanity'

// Appearances: Studio releases marked "We feature on it", else the list in lib/collective.ts.
const studioFeatures = (await getReleases()).filter((r) => r.kind === 'feature')
const featured = studioFeatures.length
  ? studioFeatures.map((r) => ({ title: r.title, credit: r.credit, links: linksOf(r) }))
  : features.map((f) => ({ title: f.title, credit: f.credit, links: f.links as unknown as [string, string][] }))

const schema = [{
  '@type': 'MusicGroup',
  '@id': 'https://artists.siryushub.com/#organization',
  album: releases.map((r) => ({ '@type': 'MusicAlbum', name: r.title, byArtist: r.credit, datePublished: r.date, url: r.apple, image: new URL(r.cover, Astro.site).href })),
}]
---
<Site title="Music" description="Music from SIRYUS A.M, the collective: Me & You, Nyongorera, LAVO and Tarama, made with Jlinez, Hidaya Morgan, Couronne., Max Prodigy, ARC. Creatives and more." schema={schema}>
  <header class="phero">
    <div class="wrap grid">
      <div>
        <h1 data-split>We make records too.</h1>
        <p class="lede" data-reveal style="margin-top:1.6rem">SIRYUS A.M is a creative collective as well as a management company. We release our own records and bring artists together on them.</p>
        <div class="actions" data-reveal style="margin-top:1.8rem"><a class="btn" href={spotify} target="_blank" rel="noopener">Follow on Spotify</a></div>
      </div>
      <div class="mini"><Turntable /></div>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <div class="title"><h2 data-split>Releases.</h2><p data-reveal>Listen on Spotify, Apple Music and more, or follow us on your favourite platform.</p></div>
      <Releases />
    </div>
  </section>
  <section class="section smoke">
    <div class="wrap">
      <div class="title"><h2 data-split>Also featured on.</h2></div>
      <ol class="tracklist" style="margin-top:0">
        {featured.map((f) => (
          <li data-reveal><span class="row"><span><strong>{f.title}</strong><br /><span>{f.credit}</span></span><span class="record-links" style="margin:0">{f.links.map(([label, url]) => <a href={url} target="_blank" rel="noopener">{label}</a>)}</span></span></li>
        ))}
      </ol>
    </div>
  </section>
</Site>
