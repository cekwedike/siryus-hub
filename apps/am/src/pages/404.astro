---
import Site from '../layouts/Site.astro'

const tracks = [
  ['What we do', 'Distribution, marketing, production and management', '/services'],
  ['Artists', 'Meet Max Prodigy and Jlinez', '/artists'],
  ['Projects', 'The Indiba Project Series and more', '/projects'],
  ['Contact', 'Start a release with us', '/contact'],
]
---
<Site noIndex title="Page not found" description="This page moved or never existed. Find your way back to SIRYUS A.M.">
  <section class="section">
    <div class="wrap lost">
      <div>
        <h1>This track isn't on the record.</h1>
        <p>The page moved or never existed. Pick another track and keep listening.</p>
        <ol class="tracks">
          {tracks.map(([name, note, href], i) => (
            <li><a href={href}><b>{String(i + 1).padStart(2, '0')}</b><span>{name}<small>{note}</small></span></a></li>
          ))}
        </ol>
      </div>
      <div class="record" aria-hidden="true"></div>
    </div>
  </section>
</Site>
