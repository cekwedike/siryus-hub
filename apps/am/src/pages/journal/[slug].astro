---
import Site from '../../layouts/Site.astro'
import { getPosts, img, toHtml, date, type Post } from '../../lib/sanity'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({ params: { slug: post.slug }, props: { post, next: posts[(i + 1) % posts.length] } }))
}

const { post, next } = Astro.props as { post: Post; next: Post }
const description = post.seoDescription ?? post.excerpt ?? post.title
const schema = [{
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  datePublished: post.publishedAt,
  image: img(post.coverImage, 1200, 630),
  author: { '@type': 'Person', name: post.author ?? 'SIRYUS A.M' },
  publisher: { '@id': 'https://artists.siryushub.com/#organization' },
  mainEntityOfPage: new URL(`/journal/${post.slug}`, Astro.site).href,
}]
---
<Site title={post.title} description={description} image={img(post.coverImage, 1200, 630)} type="article" schema={schema}>
  <header class="phero">
    <div class="wrap">
      <a class="crumb" href="/journal">Journal{post.category ? `, ${post.category}` : ''}</a>
      <h1 data-split style="max-width:20ch;font-size:clamp(2.4rem,6.4vw,6rem)">{post.title}</h1>
      <p data-reveal style="margin-top:1.6rem;font-weight:600">{post.author && <>By {post.author}, </>}<time datetime={post.publishedAt}>{date(post.publishedAt)}</time></p>
    </div>
  </header>
  <article class="section">
    <div class="wrap">
      <div class="prose" set:html={toHtml(post.body)} />
    </div>
  </article>
  {next && next.slug !== post.slug && (
    <section class="ink final">
      <div class="wrap">
        <p style="font-weight:700;margin-bottom:1rem">Read next</p>
        <h2 data-split style="font-size:clamp(2.4rem,7vw,6.4rem)"><a href={`/journal/${next.slug}`}>{next.title}</a></h2>
      </div>
    </section>
  )}
</Site>
