---
import Site from '../../layouts/Site.astro'
import Cosmos from '../../components/Cosmos.astro'
import { getPosts, img, toHtml, date, type Post } from '../../lib/sanity'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({ params: { slug: post.slug }, props: { post, next: posts[(i + 1) % posts.length] } }))
}
const { post, next } = Astro.props as { post: Post; next: Post }
const description = post.seoDescription ?? post.excerpt ?? post.title
const schema = [{
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  datePublished: post.publishedAt,
  image: img(post.coverImage, 1200, 630),
  author: { '@type': 'Person', name: post.author ?? 'SIRYUS A.M' },
  publisher: { '@id': 'https://artists.siryushub.com/#organization' },
  mainEntityOfPage: new URL(`/journal/${post.slug}`, Astro.site).href,
}]
---
<Site title={post.title} description={description} image={img(post.coverImage, 1200, 630)} type="article" schema={schema}>
  <header class="page-hero">
    <Cosmos />
    <div class="wrap" style="position:relative">
      <a class="crumb" href="/journal">Journal / {post.category}</a>
      <h1 data-split style="max-width:18ch;font-size:clamp(2.4rem,6vw,5.4rem)">{post.title}</h1>
      <p class="lede" data-reveal>{post.author && <>By {post.author}, </>}<time datetime={post.publishedAt}>{date(post.publishedAt)}</time></p>
    </div>
  </header>
  <article class="section white" style="padding-top:clamp(2rem,5vw,4rem)">
    <div class="wrap">
      <img class="cover-img" src={img(post.coverImage, 1600, 800)} srcset={`${img(post.coverImage, 900, 450)} 900w, ${img(post.coverImage, 1600, 800)} 1600w`} sizes="(max-width: 88rem) 92vw, 88rem" alt="" width="1600" height="800" fetchpriority="high" />
      <div class="prose" set:html={toHtml(post.body)} />
    </div>
  </article>
  {next && next.slug !== post.slug && (
    <section class="section">
      <div class="wrap statement-row">
        <a href={`/journal/${next.slug}`} class="statement" style="text-decoration:none">{next.title}</a>
        <div class="side"><p>Read next</p><a class="btn" href={`/journal/${next.slug}`}>Read the article</a></div>
      </div>
    </section>
  )}
</Site>
