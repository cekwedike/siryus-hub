---
import Site from '../../../layouts/Site.astro'
import JournalList from '../../../components/JournalList.astro'
import { getPosts, POSTS_PER_PAGE, type Post } from '../../../lib/sanity'

// Pages 2 and up. Nothing is generated until there are more than nine posts.
export async function getStaticPaths() {
  const posts = await getPosts()
  const pages = Math.ceil(posts.length / POSTS_PER_PAGE)
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => i + 2).map((page) => ({
    params: { page: String(page) },
    props: { posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE), page, pages },
  }))
}

const { posts, page, pages } = Astro.props as { posts: Post[]; page: number; pages: number }
---
<Site title={`Journal, page ${page}`} description={`Page ${page} of the SIRYUS A.M journal for independent artists.`}>
  <header class="phero">
    <div class="wrap grid">
      <h1 data-split>Notes for independent artists.</h1>
      <p class="lede" data-reveal>Page {page} of {pages}.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <JournalList posts={posts} page={page} pages={pages} />
    </div>
  </section>
</Site>
