---
import Site from '../../layouts/Site.astro'
import JournalList from '../../components/JournalList.astro'
import { getPosts, POSTS_PER_PAGE } from '../../lib/sanity'

const posts = await getPosts()
const pages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE))
---
<Site title="Journal" description="Straight talk for independent artists on marketing, copyright and the life behind the music, from SIRYUS A.M.">
  <header class="phero">
    <div class="wrap grid">
      <h1 data-split>Notes for independent artists.</h1>
      <p class="lede" data-reveal>What we have learned working with artists, written plainly so you can use it.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <JournalList posts={posts.slice(0, POSTS_PER_PAGE)} page={1} pages={pages} />
    </div>
  </section>
</Site>
