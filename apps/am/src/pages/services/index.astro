---
import Site from '../../layouts/Site.astro'
import Disc from '../../components/Disc.astro'
import { services, groups, groupLines } from '../../data/services'

const schema = services.map((s) => ({ '@type': 'Service', name: s.name, description: s.intro, url: new URL(`/services/${s.slug}`, Astro.site).href, provider: { '@id': 'https://artists.siryushub.com/#organization' } }))
---
<Site title="Services" description="Music services from SIRYUS A.M: distribution, release strategy, playlist pitching, content strategy, marketing plans, campaign management, artist branding, career sessions and artist management." schema={schema}>
  <header class="phero">
    <div class="wrap grid">
      <div>
        <h1 data-split>Services for every stage.</h1>
        <p class="lede" data-reveal style="margin-top:1.6rem">Release, grow and build. Pick the service you need now, or let us put a full plan together for your next release.</p>
        <div class="actions" data-reveal style="margin-top:1.8rem"><a class="btn" href="/contact">Book a meeting</a><a class="more" href="/packages">See packages</a></div>
      </div>
      <div class="mini"><Disc /></div>
    </div>
  </header>

  {groups.map((g, gi) => (
    <section class:list={['section', gi === 1 && 'smoke']} aria-labelledby={`g-${g}`}>
      <div class="wrap">
        <div class="title">
          <h2 id={`g-${g}`} data-split>{g}.</h2>
          <p data-reveal>{groupLines[g]}</p>
        </div>
        <div class="svc-grid">
          {services.filter((s) => s.group === g).map((s, i) => (
            <a class="svc" href={`/services/${s.slug}`} data-reveal style={`--d:${i}`}>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
              <span class="grp">Read more</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section ink" aria-labelledby="pk">
    <div class="wrap band">
      <h2 id="pk" data-split>Or take a package for your next single or EP.</h2>
      <div class="actions" data-reveal><a class="btn" href="/packages">See the packages</a></div>
    </div>
  </section>
</Site>
