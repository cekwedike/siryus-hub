---
import Site from '../../layouts/Site.astro'
import Disc from '../../components/Disc.astro'
import { services, packages, type Service } from '../../data/services'

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }))
}

const { service } = Astro.props as { service: Service }
const others = services.filter((s) => s.slug !== service.slug && s.group === service.group).concat(services.filter((s) => s.group !== service.group)).slice(0, 3)
const inPackages = packages.some((p) => p.includes.some((x) => x.toLowerCase().startsWith(service.name.toLowerCase().split(' ')[0])))
const schema = [{
  '@type': 'Service',
  name: service.name,
  description: service.intro,
  serviceType: service.name,
  url: new URL(`/services/${service.slug}`, Astro.site).href,
  provider: { '@id': 'https://artists.siryushub.com/#organization' },
  areaServed: 'Worldwide',
}]
---
<Site title={service.name} description={`${service.line} ${service.intro}`.slice(0, 158)} schema={schema}>
  <header class="phero">
    <div class="wrap grid">
      <div>
        <a class="crumb" href="/services">Services, {service.group}</a>
        <h1 data-split>{service.name}</h1>
        <p class="lede" data-reveal style="margin-top:1.6rem">{service.line}</p>
        <div class="actions" data-reveal style="margin-top:1.8rem">
          <a class="btn" href={`/contact?service=${service.slug}`}>Book a meeting</a>
          <a class="more" href="/services">All services</a>
        </div>
      </div>
      <div class="mini"><Disc /></div>
    </div>
  </header>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2 data-split>What it is.</h2>
        <p data-reveal>{service.intro}</p>
        <p data-reveal style="margin-top:1.4rem;font-weight:700">{service.forWho}</p>
      </div>
      <div>
        <h2 data-split>What you get.</h2>
        <ul class="ticks">{service.includes.map((x, i) => <li data-reveal style={`--d:${i}`}>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section smoke">
    <div class="wrap">
      <div class="title"><h2 data-split>How it works.</h2></div>
      <ol class="steps">
        <li data-reveal style="--d:0"><h3>Book a meeting</h3><p>Tell us about your music, your goals and your timeline.</p></li>
        <li data-reveal style="--d:1"><h3>Get a clear plan</h3><p>We agree what we will do, by when, and what it costs, in writing.</p></li>
        <li data-reveal style="--d:2"><h3>We get to work</h3><p>We deliver, keep you updated and show you the results.</p></li>
      </ol>
    </div>
  </section>

  {inPackages && (
    <section class="section ink">
      <div class="wrap band">
        <h2 data-split>{service.name} is part of our release packages.</h2>
        <div class="actions" data-reveal><a class="btn" href="/packages">See the packages</a></div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="more">
    <div class="wrap">
      <div class="title"><h2 id="more" data-split>More services.</h2></div>
      <div class="svc-grid">
        {others.map((s, i) => (
          <a class="svc" href={`/services/${s.slug}`} data-reveal style={`--d:${i}`}>
            <h3>{s.name}</h3>
            <p>{s.line}</p>
            <span class="grp">{s.group}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ink final" aria-labelledby="cta-title">
    <div class="wrap">
      <h2 id="cta-title" data-split><a href={`/contact?service=${service.slug}`}>Let's talk.</a></h2>
      <div class="row">
        <p data-reveal>Book a meeting and tell us what you are working on. No pressure, just a clear conversation about what fits.</p>
        <a class="btn" href={`/contact?service=${service.slug}`} data-reveal>Book a meeting</a>
      </div>
    </div>
  </section>
</Site>
