---
import Site from '../../layouts/Site.astro'
import { getProjects, img, toHtml, type Project } from '../../lib/sanity'

export async function getStaticPaths() {
  const projects = await getProjects()
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}
const { project } = Astro.props as { project: Project }
const body = project.longDescription?.length ? toHtml(project.longDescription) : project.description ? `<p>${project.description}</p>` : ''
const hero = project.slug === 'indiba-project-series' ? project.galleryImages?.[0] ?? project.coverImage : project.coverImage
const gallery = (project.galleryImages ?? []).filter((g) => g !== hero)
---
<Site title={project.title} description={project.excerpt ?? project.title} image={img(hero, 1200, 630)} type="article">
  <header class="page-hero">
    <div class="wrap">
      <a class="crumb" href="/projects">Projects</a>
      <h1>{project.title}</h1>
      <p>{project.excerpt}</p>
      <ul class="genres">{[project.status, project.category].filter(Boolean).map((t) => <li>{t}</li>)}</ul>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <img class="article-cover" src={img(hero, 1600, 800)} srcset={`${img(hero, 900, 450)} 900w, ${img(hero, 1600, 800)} 1600w`} sizes="(max-width: 82rem) 92vw, 82rem" alt={hero?.alt ?? project.title} width="1600" height="800" fetchpriority="high" />
      <div class="prose" set:html={body} />
      {gallery.length > 0 && (
        <div class="gallery">
          {gallery.map((g) => <img src={img(g, 800, 800)} alt={g.alt ?? project.title} width="800" height="800" loading="lazy" />)}
        </div>
      )}
    </div>
  </section>
  <section class="section dark">
    <div class="wrap closing">
      <h2>{project.registrationOpen ? 'Applications are open.' : 'Want in on the next one?'}</h2>
      <div>
        <p>{project.registrationClosedText ?? 'Tell us about yourself and your music, and we will let you know when the next edition opens.'}</p>
        <a class="btn btn-lime" href={`/contact?about=${encodeURIComponent(project.title)}`}>Get in touch</a>
      </div>
    </div>
  </section>
</Site>
