---
import Site from '../../layouts/Site.astro'
import { getProjects, img, linksOf, toHtml, indibaFacilitators, type Project } from '../../lib/sanity'

export async function getStaticPaths() {
  const projects = await getProjects()
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}

const { project } = Astro.props as { project: Project }
const body = project.longDescription?.length ? toHtml(project.longDescription) : project.description ? `<p>${project.description}</p>` : ''
const gallery = [project.coverImage, ...(project.galleryImages ?? [])].filter(Boolean)
const facilitators = project.slug === 'indiba-project-series' ? indibaFacilitators : []
const albums = project.albums?.filter(Boolean) ?? []
const contact = `/contact?about=${encodeURIComponent(project.title)}`
const apply = project.registrationUrl ?? contact
---
<Site title={project.title} description={project.excerpt ?? project.title} image={img(project.coverImage, 1200, 630)} type="article">
  <header class="phero">
    <div class="wrap grid">
      <div>
        <a class="crumb" href="/projects">Projects</a>
        <h1 data-split>{project.title}</h1>
      </div>
      <div>
        <p class="facts" data-reveal>{[project.status, project.category, project.year].filter(Boolean).map((t) => <span>{t}</span>)}</p>
        <p class="lede" data-reveal>{project.excerpt}</p>
      </div>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <div class="prose" set:html={body} />
      {gallery.length > 0 && <div class="gallery">{gallery.map((g) => <img src={img(g, 900, 900)} alt={typeof g === 'string' ? project.title : g?.alt ?? `${project.title} artwork`} width="900" height="900" loading="lazy" data-reveal />)}</div>}
    </div>
  </section>
  {facilitators.length > 0 && (
    <section class="section smoke" aria-labelledby="room-title">
      <div class="wrap">
        <div class="title">
          <h2 id="room-title" data-split>In the room.</h2>
          <p data-reveal>The facilitators who shared their experience with the first cohort.</p>
        </div>
        <div class="posters">
          {facilitators.map((f, i) => <a href={f.large} target="_blank" rel="noopener" data-reveal style={`--d:${i % 4}`}><img src={f.src} srcset={`${f.src} 600w, ${f.large} 1000w`} sizes="(max-width: 40rem) 46vw, 23vw" alt={f.alt} width="600" height="600" loading="lazy" decoding="async" /></a>)}
        </div>
      </div>
    </section>
  )}

  {albums.length > 0 && (
    <section class="section" aria-labelledby="albums-title">
      <div class="wrap">
        <div class="title">
          <h2 id="albums-title" data-split>The albums.</h2>
          <p data-reveal>At the end of each cohort, selected artists come together on a collaborative album.</p>
        </div>
        <div class="crate">
          {albums.map((r) => (
            <article class="record">
              <a class="art" href={linksOf(r)[0]?.[1]} target="_blank" rel="noopener" aria-label={`Listen to ${r.title}`}>{r.cover && <img src={img(r.cover, 800, 800)} alt={`${r.title} cover art`} width="800" height="800" loading="lazy" />}</a>
              <h3>{r.title}</h3>
              <p>{r.format ?? 'Album'}, {r.releaseDate?.slice(0, 4)}. {r.credit}</p>
              <p class="record-links">{linksOf(r).map(([label, url]) => <a href={url} target="_blank" rel="noopener">{label}</a>)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="ink final">
    <div class="wrap">
      {project.registrationOpen ? (
        <>
          <h2 data-split><a href={apply}>Applications are open.</a></h2>
          <div class="row">
            <p data-reveal>Tell us about yourself and your music. We read every application.</p>
            <a class="btn" href={apply} data-reveal>{project.registrationButtonText ?? 'Apply now'}</a>
          </div>
        </>
      ) : (
        <>
          <h2 data-split><a href={contact}>Want in next time?</a></h2>
          <div class="row">
            <p data-reveal>{project.registrationClosedText ?? 'Tell us about yourself and your music, and we will let you know when the next edition opens.'}</p>
            <a class="btn" href={contact} data-reveal>Get in touch</a>
          </div>
        </>
      )}
    </div>
  </section>
</Site>
