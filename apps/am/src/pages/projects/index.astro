---
import Site from '../../layouts/Site.astro'
import { getProjects, img } from '../../lib/sanity'

const projects = await getProjects()
---
<Site title="Projects" description="SIRYUS A.M projects: the Indiba Project Series music incubator for independent African artists, and The Abditory Sessions.">
  <header class="phero">
    <div class="wrap grid">
      <h1 data-split>Projects that build careers.</h1>
      <p class="lede" data-reveal>Some of our best work happens when artists are in the room together. These projects are where that happens.</p>
    </div>
  </header>
  {projects.map((p, i) => (
    <section class:list={['section', i % 2 === 1 && 'smoke']} aria-labelledby={`p-${p.slug}`}>
      <div class="wrap split" style="align-items:center">
        <div>
          <p class="facts" data-reveal>{[p.status, p.category, p.year].filter(Boolean).map((t) => <span>{t}</span>)}</p>
          <h2 id={`p-${p.slug}`} data-split style="font-size:clamp(2.6rem,6vw,5.6rem)">{p.title}</h2>
          <p data-reveal>{p.excerpt}</p>
          <div class="actions" data-reveal style="margin-top:1.8rem"><a class="btn" href={`/projects/${p.slug}`}>Read more</a></div>
        </div>
        {p.coverImage && <img class="artwork" src={img(p.coverImage, 900)} alt={`${p.title} artwork`} width="900" height="570" loading={i === 0 ? 'eager' : 'lazy'} data-reveal />}
      </div>
    </section>
  ))}
</Site>
