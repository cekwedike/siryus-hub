---
import Site from '../layouts/Site.astro'
import Cosmos from '../components/Cosmos.astro'
import Marquee from '../components/Marquee.astro'
import Ring from '../components/Ring.astro'
import Wave from '../components/Wave.astro'
import Releases from '../components/Releases.astro'
import { getRoster, getProjects, getPosts, img, srcset, date } from '../lib/sanity'
import { services, packages } from '../data/services'

const [roster, projects, posts] = await Promise.all([getRoster(), getProjects(), getPosts()])
const indiba = projects.find((p) => p.slug === 'indiba-project-series')
const heroShots = ['/images/scenes/singer-stage-1600.webp', ...roster.map((a) => img(a.photo, 640)!)]
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13L13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>'
---
<Site
  title="SIRYUS A.M"
  description="SIRYUS A.M is a music management company and creative collective. Release strategy, playlist pitching, content, marketing, artist branding and distribution for independent artists."
>
  <section class="hero" data-scrub>
    <Cosmos />
    <p class="hero-ghost" aria-hidden="true" data-speed="-0.15">A.M</p>
    <div class="hero-stage" data-speed="0.08">
      <div class="hero-hex" data-rotate>
        {heroShots.map((src, i) => (
          <img class={i === 0 ? 'on' : undefined} src={src} alt="" width="800" height="800" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} />
        ))}
      </div>
      <div class="hero-ring"><Ring /></div>
    </div>
    <div class="wrap hero-copy">
      <h1 data-split>We move music.</h1>
      <div class="hero-sub">
        <p data-reveal style="--d:4">SIRYUS A.M is a music management company and creative collective. We plan releases, pitch to playlists, build content and run the marketing, so the right people hear your music.</p>
        <div class="hero-actions" data-reveal style="--d:6">
          <a class="btn solid" href="/contact"><span class="dot" aria-hidden="true"></span>Book a meeting</a>
          <a class="btn" href="/services">Explore services</a>
        </div>
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true">Scroll</span>
    <Wave />
  </section>

  <Marquee items={services.map((s) => s.name)} />

  <section class="section white">
    <Cosmos />
    <div class="wrap statement-row">
      <p class="statement" data-split>Great songs don't find people by accident. We plan the path from release day to the long run.</p>
      <div class="side" data-reveal>
        <p>From a single to a full EP, from your first release to your next big move. Tell us where you are and we will show you the way forward.</p>
        <a class="btn solid" href="/about">About SIRYUS A.M</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="head">
        <h2 id="svc-title" data-split>What we do for artists.</h2>
        <p data-reveal>Book one service or bring us in for the whole release. Every service starts with a conversation.</p>
      </div>
      <ul class="svc-list" data-preview>
        {services.map((s) => (
          <li data-reveal>
            <a href={`/services/${s.slug}`} data-img={`/images/scenes/${s.image}-800.webp`}>
              <span class="grp">{s.group}</span>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
              <span class="go" set:html={arrow} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section light" aria-labelledby="pack-title">
    <div class="wrap">
      <div class="head">
        <h2 id="pack-title" data-split>Release packages.</h2>
        <p data-reveal>Put the essentials together for one release. We shape each package around your music in a short meeting.</p>
      </div>
      <div class="packages">
        {packages.map((p, i) => (
          <article class="pack" data-reveal style={`--d:${i}`}>
            <span class="tag">{i === 0 ? 'For a single' : 'For an EP'}</span>
            <h3>{p.name}</h3>
            <p>{p.line}</p>
            <ul>{p.includes.map((x) => <li>{x}</li>)}</ul>
            <a class="btn solid" href={`/contact?service=${p.slug}`}><span class="dot" aria-hidden="true"></span>Book a meeting</a>
            <span class="big" aria-hidden="true">{i === 0 ? '01' : 'EP'}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="roster-title">
    <div class="wrap">
      <div class="head">
        <h2 id="roster-title" data-split>The roster.</h2>
        <p data-reveal>A small roster on purpose. Every artist gets real time and a plan built around who they are.</p>
      </div>
      <div class="roster">
        {roster.map((a) => (
          <a class="artist" href={`/artists/${a.slug}`} data-reveal>
            <div class="frame"><img src={img(a.photo, 900)} alt={a.name} width="640" height="640" loading="lazy" decoding="async" data-speed="0.06" /></div>
            <h3>{a.name}</h3>
            <div class="meta">
              <p class="line">{a.oneLiner}</p>
              <ul class="chips">{a.genre?.map((g) => <li>{g}</li>)}</ul>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section white" aria-labelledby="music-title">
    <div class="wrap">
      <div class="head">
        <h2 id="music-title" data-split>We make music too.</h2>
        <p data-reveal>SIRYUS A.M is also a creative collective with its own releases, made with artists we believe in.</p>
      </div>
      <Releases />
    </div>
  </section>

  {indiba && (
    <section class="feature" aria-labelledby="indiba-title">
      <div class="bg" data-speed="0.12"><img src="/images/scenes/crowd-lights-1600.webp" srcset="/images/scenes/crowd-lights-800.webp 800w, /images/scenes/crowd-lights-1600.webp 1600w" sizes="100vw" alt="" width="1600" height="1067" loading="lazy" /></div>
      <div class="wrap">
        <h2 id="indiba-title" data-split>The Indiba Project Series.</h2>
        <div data-reveal>
          <p>{indiba.excerpt}</p>
          <a class="btn" href="/projects/indiba-project-series">Discover Indiba</a>
        </div>
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section" aria-labelledby="journal-title">
      <div class="wrap">
        <div class="head">
          <h2 id="journal-title" data-split>From the journal.</h2>
          <p data-reveal><a class="btn" href="/journal">All articles</a></p>
        </div>
        <div class="cards">
          {posts.map((post, i) => (
            <a class="card" href={`/journal/${post.slug}`} data-reveal style={`--d:${i}`}>
              <div class="img"><img src={img(post.coverImage, 720, 540)} srcset={srcset(post.coverImage, [420, 720], 0.75)} sizes="(max-width: 38rem) 92vw, 30vw" alt="" width="720" height="540" loading="lazy" decoding="async" /></div>
              <p class="meta">{post.category} · {date(post.publishedAt)}</p>
              <h3>{post.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="cta white" aria-labelledby="cta-title">
    <div class="rings" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap">
      <h2 id="cta-title" data-split>Have a release coming?</h2>
      <p data-reveal>Book a meeting with the team. Tell us about the music and we will plan the next move together.</p>
      <a class="btn solid" href="/contact" data-reveal><span class="dot" aria-hidden="true"></span>Book a meeting</a>
    </div>
  </section>
</Site>

<script>
  // Cycle the hero portraits slowly. Skipped when motion is reduced.
  const frame = document.querySelector('[data-rotate]')
  const shots = frame ? [...frame.querySelectorAll('img')] : []
  if (shots.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0
    setInterval(() => {
      if (document.hidden) return
      shots[i].classList.remove('on')
      i = (i + 1) % shots.length
      shots[i].classList.add('on')
    }, 5200)
  }
</script>
