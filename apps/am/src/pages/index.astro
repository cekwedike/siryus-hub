---
import ArtistPanel from '../components/ArtistPanel.astro'
import Site from '../layouts/Site.astro'
import Disc from '../components/Disc.astro'
import Ticker from '../components/Ticker.astro'
import Releases from '../components/Releases.astro'
import { getRoster, getDistributed, getAlumni, getProjects, getPosts, shotsOf, date, type Artist } from '../lib/sanity'
import { services, packages, groups, groupLines } from '../data/services'

const [roster, distributed, alumni, projects, posts] = await Promise.all([getRoster(), getDistributed(), getAlumni(), getProjects(), getPosts()])
const indiba = projects.find((p) => p.slug === 'indiba-project-series')
// The hero sleeve cycles through everyone in the Studio: managed artists (two portraits each), then
// distribution artists and alumni (one each), each captioned with their relationship to SIRYUS A.M.
const slides = (list: Artist[], count: number, tag: string) => list.flatMap((a) => shotsOf(a).slice(0, count).map((p) => ({ ...p, name: a.name, tag })))
const sleeve = [
  ...slides(roster, 2, 'On the SIRYUS A.M roster'),
  ...slides(distributed, 1, 'Distributed by SIRYUS A.M'),
  ...slides(alumni, 1, 'SIRYUS A.M alumni'),
]
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13L13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>'
const letters = ['A', 'B', 'C']
---
<Site
  title="SIRYUS A.M"
  description="SIRYUS A.M is a music management company and creative collective. Release strategy, playlist pitching, content, marketing, artist branding and distribution for independent artists."
>
  <section class="hero" data-scrub>
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <h1 data-split>We move music.</h1>
          <p class="hero-lede" data-reveal style="--d:4">SIRYUS A.M is a music management company and creative collective. We plan releases, pitch to playlists, build content and run the marketing, so the right people hear your music.</p>
          <div class="actions" data-reveal style="--d:6">
            <a class="btn" href="/contact">Book a meeting</a>
            <a class="more" href="/services">Explore services</a>
          </div>
        </div>
        <div class="stage" data-reveal style="--d:2">
          <div class="disc-slot"><Disc /></div>
          <div class="sleeve" data-sleeve>
            {sleeve.map((shot, i) => (
              <img class={i === 0 ? 'on bw' : 'bw'} src={shot.large ?? shot.src} alt={shot.alt} width="640" height="640" data-name={shot.name} data-tag={shot.tag} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
            <p class="cap"><span><strong data-sleeve-name>{sleeve[0]?.name}</strong><span data-sleeve-tag>{sleeve[0]?.tag}</span></span></p>
          </div>
        </div>
      </div>
      <div class="now" aria-hidden="true">
        <span class="eq">{Array.from({ length: 5 }, (_, i) => <b style={`--i:${i}`}></b>)}</span>
        <span>Now playing</span>
        <span class="bar"><i data-sleeve-bar></i></span>
        <span data-sleeve-count>01 / {String(sleeve.length).padStart(2, '0')}</span>
      </div>
    </div>
  </section>

  <Ticker items={services.map((s) => s.name)} />

  <section class="section" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="title">
        <h2 id="svc-title" data-split>The tracklist.</h2>
        <p data-reveal>Nine services in three sides. Book one, or bring us in for the whole release. Every service starts with a meeting.</p>
      </div>
      <div class="sides">
        {groups.map((g, gi) => (
          <div class="side">
            <div class="side-head" data-reveal>
              <span class="glyph" aria-hidden="true">{letters[gi]}</span>
              <h3>Side {letters[gi]}: {g}</h3>
              <p>{groupLines[g]}</p>
            </div>
            <ul class="tracks">
              {services.filter((s) => s.group === g).map((s, i) => (
                <li class="track" data-reveal style={`--d:${i}`}>
                  <a href={`/services/${s.slug}`}>
                    <h4>{s.name}</h4>
                    <p>{s.line}</p>
                    <span class="go" set:html={arrow} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="roster-title">
    <div class="wrap section" style="padding-bottom:clamp(2.5rem,5vw,4rem)">
      <div class="title" style="margin:0">
        <h2 id="roster-title" data-split>The roster.</h2>
        <p data-reveal>A small roster on purpose. Every artist gets real time and a plan built around who they are.</p>
      </div>
    </div>
    <div class="stack">
      {roster.map((a) => <ArtistPanel artist={a} heading="h3" />)}
    </div>
  </section>

  <section class="section smoke" aria-labelledby="pack-title">
    <div class="wrap">
      <div class="title">
        <h2 id="pack-title" data-split>Release packages.</h2>
        <p data-reveal>The essentials for one release, put together. We shape each package around your music in a short meeting.</p>
      </div>
      <div class="packs" data-reveal>
        {packages.map((p, i) => (
          <article class="pack">
            <p class="for">{i === 0 ? 'For a single' : 'For an EP/Album'}</p>
            <h3>{p.name}</h3>
            <p>{p.line}</p>
            <ul>{p.includes.map((x) => <li>{x}</li>)}</ul>
            <a class="btn" href={`/contact?service=${p.slug}`}>Book a meeting</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="music-title">
    <div class="wrap">
      <div class="title">
        <h2 id="music-title" data-split>We make records too.</h2>
        <p data-reveal>SIRYUS A.M is also a creative collective with its own releases on every major platform, made with artists we believe in.</p>
      </div>
      <Releases />
    </div>
  </section>

  {alumni.length > 0 && (
    <section class="section ink" id="alumni" aria-labelledby="alumni-title">
      <div class="wrap">
        <div class="title">
          <h2 id="alumni-title" data-split>Alumni.</h2>
          <p data-reveal>Artists we have managed and released with before. The work stays part of our story.</p>
        </div>
        {alumni.slice(0, 1).map((a) => {
          const shots = shotsOf(a)
          return (
            <article class="alumni">
              <div class="shots" data-reveal>
                {shots.slice(0, 2).map((s) => <img class="bw" src={s.src} alt={s.alt} width="640" height="640" loading="lazy" decoding="async" />)}
              </div>
              <div data-reveal style="--d:2">
                <h3>{a.name}</h3>
                <p class="note">{a.alumniNote}{a.alumniPeriod ? ` ${a.alumniPeriod}.` : ''}</p>
                <p class="bio">{a.oneLiner} {a.bioParagraph1?.split('. ').slice(1, 2).join('')}.</p>
                <a class="btn" href={`/artists/${a.slug}`}>Read {a.name}'s profile</a>
              </div>
            </article>
          )
        })}
        {alumni.length > 1 && (
          <div class="alumni-list">{alumni.slice(1).map((a) => <a href={`/artists/${a.slug}`}><span>{a.name}</span><span set:html={arrow} /></a>)}</div>
        )}
      </div>
    </section>
  )}

  {indiba && (
    <section class="section indiba" data-scrub aria-labelledby="indiba-title">
      <p class="big" aria-hidden="true">Indiba <span>Project</span> Series</p>
      <div class="wrap body">
        <h2 id="indiba-title" class="sr">The Indiba Project Series</h2>
        <p data-reveal>{indiba.excerpt}</p>
        <div data-reveal style="--d:1"><a class="btn line" href="/projects/indiba-project-series">Discover Indiba</a></div>
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section smoke" aria-labelledby="journal-title">
      <div class="wrap">
        <div class="title">
          <h2 id="journal-title" data-split>From the journal.</h2>
          <p data-reveal><a class="more" href="/journal">All articles</a></p>
        </div>
        <ul class="notes">
          {posts.slice(0, 3).map((post) => (
            <li class="note-row" data-reveal>
              <a href={`/journal/${post.slug}`}>
                <time datetime={post.publishedAt}>{date(post.publishedAt)}</time>
                <h3>{post.title}</h3>
                <span class="go" set:html={arrow} />
                {post.excerpt && <p>{post.excerpt}</p>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="ink final" aria-labelledby="cta-title">
    <div class="wrap">
      <h2 id="cta-title" data-split><a href="/contact">Book a meeting.</a></h2>
      <div class="row">
        <p data-reveal>Have a release coming? Tell us about the music and we will plan the next move together.</p>
        <a class="more" href="mailto:management@siryushub.com" data-reveal>management@siryushub.com</a>
      </div>
    </div>
  </section>
</Site>

<script>
  // Turn the sleeve: crossfade portraits, update the name and run the progress bar. Skipped with reduced motion.
  const sleeve = document.querySelector<HTMLElement>('[data-sleeve]')
  const shots = sleeve ? [...sleeve.querySelectorAll<HTMLImageElement>('img')] : []
  const name = document.querySelector<HTMLElement>('[data-sleeve-name]')
  const tag = document.querySelector<HTMLElement>('[data-sleeve-tag]')
  const bar = document.querySelector<HTMLElement>('[data-sleeve-bar]')
  const count = document.querySelector<HTMLElement>('[data-sleeve-count]')
  const total = String(shots.length).padStart(2, '0')
  if (shots.length > 1 && bar && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0
    const run = () => {
      bar.classList.remove('run')
      void bar.offsetWidth
      bar.classList.add('run')
    }
    run()
    bar.addEventListener('animationend', () => {
      if (document.hidden) return run()
      shots[i].classList.remove('on')
      i = (i + 1) % shots.length
      shots[i].classList.add('on')
      if (name) name.textContent = shots[i].dataset.name ?? ''
      if (tag) tag.textContent = shots[i].dataset.tag ?? ''
      if (count) count.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`
      run()
    })
  }
</script>
