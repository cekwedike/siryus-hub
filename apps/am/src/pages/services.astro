---
import Site from '../layouts/Site.astro'

const groups = [
  {
    name: 'Release',
    lead: 'Get the music out properly, on time and with the right details.',
    items: [
      ['Distribution', 'We deliver your songs to the major streaming and download stores, set up titles, credits, artwork and lyrics, and send everything to you for approval before it goes live.'],
      ['Artist profiles', 'Help claiming and setting up your artist profiles on the main platforms, so your page looks like you.'],
      ['Release strategy', 'A release date, rollout timeline, pre-save plan, and a clear guide to what to post and when.'],
      ['Playlist pitching', 'Editorial pitches plus outreach to independent curators and platform contacts. We work hard for placements, but nobody can honestly promise one.'],
    ],
  },
  {
    name: 'Grow',
    lead: 'Help the right listeners find the music and remember it.',
    items: [
      ['Content strategy', 'Four weeks of content ideas, hooks, captions and a posting calendar built around your release.'],
      ['Marketing plans', 'A written plan with a full budget breakdown. Nothing is spent until you approve it.'],
      ['Campaign management', 'We run and watch your approved ad campaigns and send weekly updates, then receipts and results.'],
      ['Reports you can check', 'Quarterly reports covering streams, listeners, countries and income, with screenshots from the distribution dashboard.'],
    ],
  },
  {
    name: 'Build',
    lead: 'The foundations of a career that lasts longer than one song.',
    items: [
      ['Artist branding', 'Your bio, an electronic press kit and photo direction, so press and promoters see a clear picture of you.'],
      ['Production with Jlinez', 'Song production with mixing and mastering by Jlinez. You own the final song, and payments are held and passed on with proof at every step.'],
      ['Career sessions', 'One-on-one time on the music business, releases or strategy. Bring your questions.'],
      ['Management', 'Full artist management for a small roster. Direction, planning, partnerships and day-to-day support, by invitation.'],
    ],
  },
]
---
<Site
  title="What we do"
  description="Music distribution, release strategy, playlist pitching, content and marketing, artist branding, production with Jlinez and artist management from SIRYUS A.M."
>
  <header class="page-hero">
    <div class="wrap">
      <h1>Everything your release needs.</h1>
      <p>Distribution is where most artists start with us. Everything else is optional. Choose what you need for each release, and skip what you don't.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {groups.map((group) => (
        <div class="service-group">
          <h2>{group.name}</h2>
          <div>
            <p class="lead">{group.lead}</p>
            <div class="service-list">
              {group.items.map(([title, copy]) => (
                <div><h3>{title}</h3><p>{copy}</p></div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section mist" aria-labelledby="bundles-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="bundles-title">Or take the whole rollout.</h2>
        <p>Bundles put release strategy, playlist pitching, content strategy and a marketing plan together for one price.</p>
      </div>
      <div class="bundles">
        <div class="bundle"><h3>Single release</h3><p>Everything a single needs, from the release plan to the marketing plan, built around one song.</p></div>
        <div class="bundle"><h3>EP release</h3><p>The same full rollout, shaped for a multi-track project and a longer campaign.</p></div>
      </div>
      <p class="note">Prices depend on the project. Ad and promotion budgets are always separate from our fees and only spent with your written OK.</p>
    </div>
  </section>

  <section class="section dark" aria-labelledby="start-title">
    <div class="wrap closing">
      <h2 id="start-title">Tell us about the music.</h2>
      <div>
        <p>Send a link, a release date if you have one, and what you need help with. We will reply with a plan and a clear price.</p>
        <a class="btn btn-lime" href="/contact">Start a release</a>
      </div>
    </div>
  </section>
</Site>
