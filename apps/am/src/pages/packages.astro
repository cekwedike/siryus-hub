---
import Site from '../layouts/Site.astro'
import Turntable from '../components/Turntable.astro'
import { packages, services } from '../data/services'

const featured = ['release-strategy', 'playlist-pitching', 'content-strategy', 'marketing-plans'].map((s) => services.find((x) => x.slug === s)!)
---
<Site title="Release packages" description="SIRYUS A.M release packages for singles and EPs: release strategy, playlist pitching, content strategy and a marketing plan, shaped around your music. Book a meeting to get started.">
  <header class="phero">
    <div class="wrap grid">
      <div>
        <h1 data-split>One release. Everything it needs.</h1>
        <p class="lede" data-reveal style="margin-top:1.6rem">Our packages bring the four things every release needs into one plan, so nothing gets missed and every part works together.</p>
      </div>
      <div class="mini"><Turntable /></div>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <div class="packs" data-reveal>
        {packages.map((p, i) => (
          <article class="pack">
            <p class="for">{i === 0 ? 'For a single' : 'For an EP/Album'}</p>
            <h2 style="font:clamp(2.2rem,4.4vw,4rem)/.9 var(--display)">{p.name}</h2>
            <p>{p.line}</p>
            <ul>{p.includes.map((x) => <li>{x}</li>)}</ul>
            <a class="btn" href={`/contact?service=${p.slug}`}>Book a meeting</a>
          </article>
        ))}
      </div>
      <p data-reveal style="margin-top:2rem;max-width:42rem;color:var(--grey)">Advertising budgets are always separate and only spent with your approval. Every package is priced for your project after a short meeting.</p>
    </div>
  </section>
  <section class="section smoke">
    <div class="wrap">
      <div class="title">
        <h2 data-split>What goes into a package.</h2>
        <p data-reveal>Each part is a full service on its own. Together, they cover the whole release.</p>
      </div>
      <div class="svc-grid four">
        {featured.map((s, i) => (
          <a class="svc" href={`/services/${s.slug}`} data-reveal style={`--d:${i}`}>
            <h3>{s.name}</h3>
            <p>{s.line}</p>
            <span class="grp">Read more</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="ink final" aria-labelledby="cta-title">
    <div class="wrap">
      <h2 id="cta-title" data-split><a href="/contact?service=single-release">Plan your release.</a></h2>
      <div class="row">
        <p data-reveal>Tell us about the song or the project, and when you want it out.</p>
        <a class="btn" href="/contact?service=single-release" data-reveal>Book a meeting</a>
      </div>
    </div>
  </section>
</Site>
