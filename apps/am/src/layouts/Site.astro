---
import '../styles/site.css'
import Return from '../../../../shared/astro/Return.astro'
import { ids, parentNodes } from '../../../../shared/seo'
import { profiles } from '../lib/collective'
import { services, groups } from '../data/services'

interface Props {
  title: string
  description: string
  noIndex?: boolean
  image?: string
  type?: 'website' | 'article' | 'profile'
  schema?: Record<string, unknown>[]
}
const { title, description, noIndex = false, image, type = 'website', schema = [] } = Astro.props
// Search results show about 60 characters of a title and 160 of a description: long titles drop the brand suffix
// and long descriptions are cut at a word.
const pageTitle = title === 'SIRYUS A.M' ? 'SIRYUS A.M | Music management for independent artists' : title.length > 46 ? title : `${title} | SIRYUS A.M`
const metaDescription = description.length <= 160 ? description : `${description.slice(0, 157).replace(/\s+\S*$/, '')}...`
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href
const ogImage = image ?? new URL('/share.jpg', Astro.site).href
const org = ids.am
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'MusicGroup'],
      '@id': org,
      name: 'SIRYUS A.M',
      url: 'https://artists.siryushub.com/',
      logo: new URL('/icon-512.png', Astro.site).href,
      email: 'management@siryushub.com',
      description: 'Music management company and creative collective: release strategy, playlist pitching, content strategy, marketing, artist branding, distribution and artist management.',
      sameAs: profiles.map(([, url]) => url),
      address: { '@type': 'PostalAddress', addressLocality: 'Abuja', addressCountry: 'NG' },
      parentOrganization: { '@id': ids.siryus },
    },
    ...parentNodes,
    { '@type': 'WebSite', '@id': 'https://artists.siryushub.com/#website', name: 'SIRYUS A.M', url: 'https://artists.siryushub.com/', publisher: { '@id': org } },
    ...schema,
  ],
}
const nav = [
  ['Artists', '/artists'],
  ['Music', '/music'],
  ['Projects', '/projects'],
  ['Journal', '/journal'],
  ['About', '/about'],
]
const here = Astro.url.pathname.replace(/\/$/, '') || '/'
const current = (href: string) => here === href || here.startsWith(`${href}/`)
---
<!doctype html>
<html lang="en">
  <Fragment set:html={'<!--email_off-->'} />
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.add('js')
      setTimeout(() => document.documentElement.classList.contains('motion-ready') || document.documentElement.classList.add('motion-fallback'), 2500)
    </script>
    <link rel="preload" href="/fonts/cenzo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="SIRYUS A.M" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Return />
    <header class="nav" data-nav>
      <div class="nav-inner">
        <a class="brand" href="/" aria-label="SIRYUS A.M home">
          <img src="/brand/mark-dark.png" alt="" width="112" height="104" />
          <span>SIRYUS A.M</span>
        </a>
        <nav class="links" aria-label="Main">
          <div class="drop">
            <button type="button" aria-haspopup="true" aria-current={current('/services') || current('/packages') ? 'page' : undefined}>
              Services
              <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
            </button>
            <div class="panel">
              {groups.map((g) => (
                <div>
                  <h4>{g}</h4>
                  {services.filter((s) => s.group === g).map((s) => <a href={`/services/${s.slug}`}>{s.name}</a>)}
                </div>
              ))}
              <div class="pk">
                <p>Two release packages that put the essentials together for a single or an EP.</p>
                <a href="/packages">See the packages</a>
              </div>
            </div>
          </div>
          {nav.map(([label, href]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="btn nav-cta" href="/contact">Book a meeting</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="sheet"><span>Menu</span><i aria-hidden="true"></i></button>
      </div>
    </header>
    <div class="sheet" id="sheet">
      <nav aria-label="Mobile">
        {[['Services', '/services'], ['Packages', '/packages'], ...nav, ['Book a meeting', '/contact']].map(([label, href], i) => <a href={href} style={`--i:${i}`}>{label}</a>)}
      </nav>
      <div class="sub">{services.map((s) => <a href={`/services/${s.slug}`}>{s.name}</a>)}</div>
    </div>

    <main id="content">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-top">
          <div>
            <h2>Let's move your music.</h2>
            <div class="footer-cta">
              <a class="btn" href="/contact">Book a meeting</a>
              <a class="footer-mail" href="mailto:management@siryushub.com">management@siryushub.com</a>
            </div>
          </div>
          <div>
            <h3>Services</h3>
            <nav aria-label="Services">{services.slice(0, 6).map((s) => <a href={`/services/${s.slug}`}>{s.name}</a>)}<a href="/packages">Packages</a></nav>
          </div>
          <div>
            <h3>SIRYUS A.M</h3>
            <nav aria-label="Footer">{nav.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/artists#alumni">Alumni</a><a href="/contact">Contact</a></nav>
          </div>
          <div>
            <h3>Follow</h3>
            <div class="list">
              {profiles.map(([label, url]) => <a href={url} target="_blank" rel="noopener">{label}</a>)}
            </div>
          </div>
        </div>
        <p class="footer-mark" aria-hidden="true">SIRYUS A.M</p>
        <div class="footer-base">
          <Return variant="footer" />
          <nav aria-label="Legal">
            <a href="https://siryushub.com/privacy-policy">Privacy</a>
            <a href="https://siryushub.com/terms-of-use">Terms</a>
            <a href="https://siryushub.com/cookie-policy">Cookies</a>
          </nav>
          <p>© 2026 Siryus Creative Media Ltd</p>
        </div>
      </div>
    </footer>
    <script>
      import '../../../../shared/motion'
      document.documentElement.classList.add('motion-ready')
      const nav = document.querySelector<HTMLElement>('[data-nav]')!
      const toggle = nav.querySelector<HTMLButtonElement>('.menu-toggle')!
      const setOpen = (open: boolean) => {
        nav.classList.toggle('open', open)
        toggle.setAttribute('aria-expanded', String(open))
        toggle.querySelector('span')!.textContent = open ? 'Close' : 'Menu'
        document.body.style.overflow = open ? 'hidden' : ''
      }
      toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')))
      document.querySelectorAll('#sheet a').forEach((a) => a.addEventListener('click', () => setOpen(false)))
      addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false))
      const onScroll = () => nav.classList.toggle('scrolled', scrollY > 10)
      addEventListener('scroll', onScroll, { passive: true })
      onScroll()
    </script>
  </body>
  <Fragment set:html={'<!--/email_off-->'} />
</html>
