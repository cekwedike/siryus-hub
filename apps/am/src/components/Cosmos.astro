---
// The parent SIRYUS sky (dashed orbits and four-point sparkles), carried into A.M so it reads as a SIRYUS world.
const sparks = [
  { x: 8, y: 18, s: 12, t: 0 },
  { x: 46, y: 9, s: 9, t: 1.1 },
  { x: 88, y: 22, s: 16, t: 2 },
  { x: 72, y: 70, s: 10, t: 0.6 },
  { x: 18, y: 64, s: 8, t: 1.6 },
]
---
<div class="cosmos" aria-hidden="true">
  <span class="orbit"></span><span class="orbit"></span>
  {sparks.map((p) => <i class="spark" style={`left:${p.x}%;top:${p.y}%;--s:${p.s}px;--t:${p.t}s`}></i>)}
</div>
