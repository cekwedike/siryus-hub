---
// Posts to the Pages Function at /api/contact. Works without JavaScript (the function redirects back here);
// with JavaScript it submits in place and shows the result.
const needs = ['Distribution', 'Release strategy and playlist pitching', 'Marketing and campaigns', 'Artist branding', 'Production with Jlinez', 'Management', 'Indiba Project Series', 'Something else']
---
<form class="form" action="/api/contact" method="post" data-contact>
  <p class="form-status full" role="status" aria-live="polite" tabindex="-1"></p>
  <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div>
  <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
  <div class="field"><label for="artist">Artist or project name</label><input id="artist" name="artist" /></div>
  <div class="field">
    <label for="need">What do you need?</label>
    <select id="need" name="need">{needs.map((n) => <option>{n}</option>)}</select>
  </div>
  <div class="field"><label for="release">Release date <small>(if you have one)</small></label><input id="release" name="release" type="date" /></div>
  <div class="field"><label for="link">Link to your music</label><input id="link" name="link" type="url" placeholder="https://" /></div>
  <div class="field full"><label for="message">Tell us about it</label><textarea id="message" name="message" required minlength="10"></textarea></div>
  <div class="trap" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
  <input type="hidden" name="started" value="" />
  <p class="full"><small>We use these details only to reply to you. See our <a href="https://siryushub.com/privacy-policy">privacy policy</a>.</small></p>
  <button class="btn btn-ink" type="submit">Send message</button>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]')
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!
    const button = form.querySelector<HTMLButtonElement>('button')!
    const inbox = 'management@siryushub.com'
    ;(form.elements.namedItem('started') as HTMLInputElement).value = String(Date.now())
    const params = new URLSearchParams(location.search)
    if (params.get('sent')) status.textContent = 'Thanks. Your message is on its way, and a copy is in your inbox.'
    if (params.get('error')) {
      status.textContent = `Something went wrong. Please try again or email ${inbox}.`
      status.classList.add('error')
    }
    const about = params.get('about')
    const message = form.elements.namedItem('message') as HTMLTextAreaElement
    if (about && !message.value) message.value = `About ${about}: `
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      button.disabled = true
      button.textContent = 'Sending…'
      status.classList.remove('error')
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } })
        const data = await res.json()
        status.textContent = data.message
        if (res.ok) form.reset()
        else status.classList.add('error')
      } catch {
        status.textContent = `We could not reach the server. Please email ${inbox}.`
        status.classList.add('error')
      }
      button.disabled = false
      button.textContent = 'Send message'
      status.focus()
    })
  }
</script>
