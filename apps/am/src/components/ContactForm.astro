---
// Book-a-meeting form. Posts to the Pages Function at /api/contact. Works without JavaScript (the
// function redirects back here); with JavaScript it submits in place. ?service= preselects the service.
import { services, packages } from '../data/services'
const options = [...services.map((s) => [s.slug, s.name]), ...packages.map((p) => [p.slug, p.name]), ['other', 'Something else']]
---
<form class="form" action="/api/contact" method="post" data-contact>
  <p class="form-status full" role="status" aria-live="polite" tabindex="-1"></p>
  <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div>
  <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
  <div class="field"><label for="artist">Artist or project name</label><input id="artist" name="artist" /></div>
  <div class="field">
    <label for="need">What would you like to talk about?</label>
    <select id="need" name="need">{options.map(([value, label]) => <option value={label} data-slug={value}>{label}</option>)}</select>
  </div>
  <div class="field"><label for="meeting">Best time for a meeting</label><input id="meeting" name="meeting" placeholder="For example, weekday afternoons (WAT)" /></div>
  <div class="field"><label for="link">Link to your music</label><input id="link" name="link" type="url" placeholder="https://" /></div>
  <div class="field full"><label for="message">Tell us about it</label><textarea id="message" name="message" required minlength="10"></textarea></div>
  <div class="trap" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
  <input type="hidden" name="started" value="" />
  <p class="full"><small>We use these details only to reply and arrange your meeting. See our <a href="https://siryushub.com/privacy-policy">privacy policy</a>.</small></p>
  <button class="btn solid" type="submit"><span class="dot" aria-hidden="true"></span>Request a meeting</button>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]')
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!
    const button = form.querySelector<HTMLButtonElement>('button')!
    const label = button.innerHTML
    const inbox = 'management@siryushub.com'
    ;(form.elements.namedItem('started') as HTMLInputElement).value = String(Date.now())
    const params = new URLSearchParams(location.search)
    if (params.get('sent')) status.textContent = 'Thanks. Your request is in, and a copy is in your inbox. We will reply to arrange a time.'
    if (params.get('error')) status.textContent = `Something went wrong. Please try again or email ${inbox}.`
    const service = params.get('service')
    const select = form.elements.namedItem('need') as HTMLSelectElement
    const match = [...select.options].find((o) => o.dataset.slug === service)
    if (match) match.selected = true
    const about = params.get('about')
    const message = form.elements.namedItem('message') as HTMLTextAreaElement
    if (about && !message.value) message.value = `About ${about}: `
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      button.disabled = true
      button.textContent = 'Sending…'
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } })
        const data = await res.json()
        status.textContent = data.message
        if (res.ok) form.reset()
      } catch {
        status.textContent = `We could not reach the server. Please email ${inbox}.`
      }
      button.disabled = false
      button.innerHTML = label
      status.focus()
    })
  }
</script>
