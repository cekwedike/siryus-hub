---
// The circle badge from the A.M mark: a waveform in a white disc, wrapped in rotating text.
interface Props { text?: string }
const { text = 'Music management · SIRYUS A.M · Release · Grow · Build · ' } = Astro.props
const bars = [10, 18, 26, 18, 30, 14, 22, 12]
---
<svg viewBox="0 0 120 120" aria-hidden="true">
  <defs><path id="ring-path" d="M60,60 m-50,0 a50,50 0 1,1 100,0 a50,50 0 1,1 -100,0" /></defs>
  <g class="ring-spin"><text><textPath href="#ring-path">{text}</textPath></text></g>
  <circle class="core" cx="60" cy="60" r="30" />
  {bars.map((h, i) => <rect class="bar" x={41 + i * 5} y={60 - h / 2} width="2.6" height={h} rx="1.3" />)}
</svg>
