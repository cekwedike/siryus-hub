---
// SIRYUS A.M's own records, from three sources matched by title:
//   1. Apple Music's SIRYUS A.M catalogue, so new releases appear on the next build with no work;
//   2. the Studio's Releases ("Our release"), which add Spotify and other links, covers or releases Apple lacks;
//   3. the built-in list in lib/collective.ts (local cover art), used when neither has a better value.
import Disc from './Disc.astro'
import { releases as builtIn, profiles, spotify, year } from '../lib/collective'
import { appleCatalog, getReleases, img, linksOf, titleKey } from '../lib/sanity'

interface Props { limit?: number }
const { limit } = Astro.props

type Item = { title: string; credit: string; format: string; date: string; cover?: string; links: [string, string][] }
const SIRYUS_AM_APPLE_ID = '1800520219'
const items = new Map<string, Item>()
const add = (item: Item) => {
  const key = titleKey(item.title)
  const existing = items.get(key)
  if (!existing) return items.set(key, item)
  // Keep every platform link once, the newer source's version first.
  const links = [...item.links, ...existing.links].filter(([label], i, all) => all.findIndex(([l]) => l === label) === i)
  items.set(key, { ...existing, ...Object.fromEntries(Object.entries(item).filter(([, v]) => v)), links })
}

for (const d of await appleCatalog(SIRYUS_AM_APPLE_ID)) add({ title: d.title, credit: d.credit, format: d.format, date: d.date, cover: d.cover, links: [['Spotify', spotify], ['Apple Music', d.apple]] })
for (const r of builtIn) add({ title: r.title, credit: r.credit, format: r.type, date: r.date, cover: r.cover, links: [['Apple Music', r.apple]] })
for (const r of (await getReleases()).filter((r) => r.kind !== 'feature')) add({ title: r.title, credit: r.credit, format: r.format ?? 'Single', date: r.releaseDate, cover: img(r.cover, 800, 800), links: linksOf(r) })

const order = ['Spotify', 'Apple Music']
const all = [...items.values()]
  .map((r) => ({ ...r, links: [...r.links].sort(([a], [b]) => ((order.indexOf(a) + 9) % 9) - ((order.indexOf(b) + 9) % 9)) }))
  .sort((a, b) => b.date.localeCompare(a.date))
const list = limit ? all.slice(0, limit) : all
---
<div class="crate">
  {list.map((r, i) => (
    <article class="record" data-reveal style={`--d:${i % 4}`}>
      <a class="art" href={r.links[0]?.[1]} target="_blank" rel="noopener" aria-label={`Listen to ${r.title}`}>
        {r.cover && <img src={r.cover} alt={`${r.title} cover art`} width="800" height="800" loading="lazy" decoding="async" />}
        <Disc />
      </a>
      <h3>{r.title}</h3>
      <p>{r.format}, {year(r.date)}. {r.credit}</p>
      <p class="record-links">{r.links.map(([label, url]) => <a href={url} target="_blank" rel="noopener">{label}</a>)}</p>
    </article>
  ))}
</div>
<div class="listen">
  {profiles.slice(0, 4).map(([label, url]) => <a class="more" href={url} target="_blank" rel="noopener">Follow on {label}</a>)}
</div>
