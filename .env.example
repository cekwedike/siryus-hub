PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
# Only needed for running seed scripts locally
# Never commit the actual token to git
SANITY_TOKEN=

# ARC blog: separate Sanity project (create at sanity.io/manage). Used by Astro at build/runtime.
PUBLIC_SANITY_ARC_PROJECT_ID=
PUBLIC_SANITY_ARC_DATASET=
# Optional: read token if the ARC dataset is private (same pattern as main site if you add one)
SANITY_ARC_TOKEN=

# Optional: override canonical/OG absolute URLs when ARC is served on its own primary domain later
PUBLIC_CANONICAL_ORIGIN=

# SIRYUS A.M Studio: copy these keys into studio/.env.local.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# ARC. Creatives Studio: copy these keys into studio-arc/.env.local.
SANITY_STUDIO_ARC_PROJECT_ID=
SANITY_STUDIO_ARC_DATASET=
