# Build-time values for the sites. All are public IDs; the defaults below are what production uses.
# Copy to apps/<site>/.env.local only if you need to point a local build somewhere else.
PUBLIC_SANITY_PROJECT_ID=h16wl0pr
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_ARC_PROJECT_ID=qi12mdx6
PUBLIC_SANITY_ARC_DATASET=production
PUBLIC_CANONICAL_ORIGIN=https://collective.siryushub.com

# Studios (optional; both default to their production project).
SANITY_STUDIO_PROJECT_ID=h16wl0pr
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_ARC_PROJECT_ID=qi12mdx6
SANITY_STUDIO_ARC_DATASET=production

# Contact forms (Cloudflare Pages secrets on siryus-artists and siryus-growth, never committed).
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
