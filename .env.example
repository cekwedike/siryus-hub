PUBLIC_SANITY_PROJECT_ID=your_project_id_here
PUBLIC_SANITY_DATASET=production
# Only needed for running seed scripts locally
# Never commit the actual token to git
SANITY_TOKEN=your_sanity_write_token_here

# ARC blog: separate Sanity project (create at sanity.io/manage). Used by Astro at build/runtime.
PUBLIC_SANITY_ARC_PROJECT_ID=your_arc_project_id_here
PUBLIC_SANITY_ARC_DATASET=production
# Optional: read token if the ARC dataset is private (same pattern as main site if you add one)
# SANITY_ARC_TOKEN=

# Optional: override canonical/OG absolute URLs when ARC is served on its own primary domain later
# PUBLIC_CANONICAL_ORIGIN=https://www.siryushub.com

# ARC Studio (studio-arc): copy into studio-arc/.env.local. See studio-arc/README.md.
# SANITY_STUDIO_ARC_PROJECT_ID=your_arc_project_id_here
# SANITY_STUDIO_ARC_DATASET=production
